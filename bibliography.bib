  keywords = {Mathematics - Spectral Theory},
  file = {C:\Users\furuh\Zotero\storage\BYZBSRVI\Sardellitti et al. - 2017 - On the Graph Fourier Transform for Directed Graphs.pdf}
}

@inproceedings{sasakiSparseRegularizationBased2024,
  title = {Sparse {{Regularization Based}} on {{Reverse Ordered Weighted L1-Norm}} and {{Its Application}} to {{Edge-Preserving Smoothing}}},
  booktitle = {Proceedings of {{International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}}},
