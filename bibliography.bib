@article{solodskikhIntegralNeuralNetworks2023,
  title = {Integral {{Neural Networks}}},
  author = {Solodskikh, Kirill and Kurbanov, Azim and Aydarkhanov, Ruslan and Zhelavskaya, Irina and Parfenov, Yury and Song, Dehua and Lefkimmiatis, Stamatios},
  year = {2023},
  month = jun,
  journal = {2023 IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)},
  pages = {16113--16122},
  publisher = {IEEE},
  address = {Vancouver, BC, Canada},
  doi = {10.1109/CVPR52729.2023.01546},
  urldate = {2023-12-01},
  abstract = {We introduce a new family of deep neural networks, where instead of the conventional representation of network layers as N-dimensional weight tensors, we use a continuous layer representation along the filter and channel dimensions. We call such networks Integral Neural Networks (INNs). In particular, the weights of INNs are represented as continuous functions defined on N-dimensional hypercubes, and the discrete transformations of inputs to the layers are replaced by continuous integration operations, accordingly. During the inference stage, our continuous layers can be converted into the traditional tensor representation via numerical integral quadratures. Such kind of representation allows the discretization of a network to an arbitrary size with various discretization intervals for the integral kernels. This approach can be applied to prune the model directly on an edge device while suffering only a small performance loss at high rates of structural pruning without any fine-tuning. To evaluate the practical benefits of our proposed approach, we have conducted experiments using various neural network architectures on multiple tasks. Our reported results show that the proposed INNs achieve the same performance with their conventional discrete counterparts, while being able to preserve approximately the same performance (2\% accuracy loss for ResNet18 on Imagenet) at a high rate (up to 30\%) of structural pruning without fine-tuning, compared to 65\% accuracy loss of the conventional pruning methods under the same conditions. Code is available at gitee.},
  isbn = {9798350301298},
  file = {C:\Users\furuh\Zotero\storage\3DCTZRN3\Solodskikh et al. - 2023 - Integral Neural Networks.pdf}
}

@article{songBrainNetworkAnalysis2023,
  title = {Brain {{Network Analysis}} of {{Schizophrenia Patients Based}} on {{Hypergraph Signal Processing}}},
  author = {Song, Xiaoying and Wu, Ke and Chai, Li},
  year = {2023},
  journal = {IEEE Transactions on Image Processing},
  volume = {32},
  pages = {4964--4976},
  issn = {1057-7149, 1941-0042},
  doi = {10.1109/TIP.2023.3307975},
  urldate = {2024-08-16},
  abstract = {Since high-order relationships among multiple brain regions-of-interests (ROIs) are helpful to explore the pathogenesis of neurological diseases more deeply, hypergraph-based brain networks are more suitable for brain science research. Unlike the existing hypergraph based brain network (brain hypernetwork), where hyperedges containing the same number of ROIs are assumed to have equal weights (to some extent, the network is unweighted), and the underlying structure is described only by an incidence/adjacency matrix, in this paper, we propose a framework for constructing a truly weighted brain hypernetwork described by an adjacency tensor. Considering the relationships among vertices within a hyperedge, we propose a novel hyperedge weight estimation method and convert the incidence matrix into a weighted adjacency tensor. On the basis of tensor decomposition, we apply hypergraph signal processing tools, such as hypergraph Fourier transform, to analyze and compare the spectrum between schizophrenia patients and normal controls. It is found that there are more high frequency components in the spectrum of patients than controls, and the average amplitude is significantly greater than that of controls. Instead of extracting some simple topological features from brain hypernetworks for classification, we innovatively use the hypergraph spectrum and the spectral signal as classification features, and the classification results on two public datasets demonstrate the effectiveness of our proposed method.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  annotation = {abstractTranslation:  複数の脳関心領域（ROI）間の高次の関係は、神経疾患の病態をより深く探求するのに有用であるため、ハイパーグラフに基づく脳ネットワークは脳科学研究に適している。既存のハイパーグラフに基づく脳ネットワーク（脳ハイパーネットワーク）では、同じ数のROIを含むハイパーゲッジは等しい重みを持つと仮定され（ある程度は重み付けされていない）、基本的な構造は入射/隣接行列によってのみ記述されるが、本論文では、隣接テンソルによって記述される真に重み付けされた脳ハイパーネットワークを構築するためのフレームワークを提案する。ハイパーページ内の頂点間の関係を考慮し、新しいハイパーページ重み推定法を提案し、入射率行列を重み付き隣接テンソルに変換する。テンソル分解に基づいて、ハイパーグラフフーリエ変換などのハイパーグラフ信号処理ツールを適用し、統合失調症患者と健常対照者のスペクトルを分析・比較する。その結果、患者のスペクトルには対照群よりも高周波成分が多く、平均振幅は対照群よりも有意に大きいことがわかった。分類のために脳のハイパーネットワークから単純な位相的特徴を抽出する代わりに、我々は革新的にハイパーグラフスペクトルとスペクトル信号を分類特徴として使用する。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\KGY722YU\\Hypergraph Brain Networks in Schizophrenia.wav;C\:\\Users\\furuh\\Zotero\\storage\\X7P4V4JQ\\Song et al. - 2023 - Brain Network Analysis of Schizophrenia Patients Based on Hypergraph Signal Processing.pdf}
}

@article{songCombiningTimeseriesEvidence2022,
  title = {Combining Time-Series Evidence: {{A}} Complex Network Model Based on a Visibility Graph and Belief Entropy},
  shorttitle = {Combining Time-Series Evidence},
  author = {Song, Xingjian and Xiao, Fuyuan},
  year = {2022},
  month = jul,
  journal = {Applied Intelligence},
  volume = {52},
  number = {9},
  pages = {10706--10715},
  issn = {0924-669X, 1573-7497},
  doi = {10.1007/s10489-021-02956-5},
  urldate = {2024-07-08},
  abstract = {Combining basic probability assignments (BPAs) with time series is common in real-life cases. Therefore, a new evidence fusion approach based on belief entropy and a visibility graph (BE-VG) is proposed. The approach converts a time-series BPA into a weighted visibility graph (WVG). In addition, some numerical examples are illustrated to illustrate the efficiency and applicability of the proposed method. Finally, to demonstrate the effect of the BE-VG method, the proposed method is applied to electroencephalogram (EEG) dynamic fusion. Experimentally, the results indicate that the BE-VG method is effective and accurate in conducting EEG signal fusion.},
  langid = {english}
}

