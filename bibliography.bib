@article{luSparseRecoveryPartial2018,
  title = {Sparse {{Recovery}} via {{Partial Regularization}}: {{Models}}, {{Theory}}, and {{Algorithms}}},
  shorttitle = {Sparse {{Recovery}} via {{Partial Regularization}}},
  author = {Lu, Zhaosong and Li, Xiaorui},
  year = {2018},
  month = nov,
  journal = {Mathematics of Operations Research},
  volume = {43},
  number = {4},
  pages = {1290--1316},
  publisher = {INFORMS},
  issn = {0364-765X},
  doi = {10.1287/moor.2017.0905},
  urldate = {2025-02-24},
  abstract = {In the context of sparse recovery, it is known that most of the existing regularizers such as {$\ell$}1 suffer from some bias incurred by some leading entries (in magnitude) of the associated vector. To neutralize this bias, we propose a class of models with partial regularizers for recovering a sparse solution of a linear system. We show that every local minimizer of these models is substantially sparse or the magnitude of all of its nonzero entries is above a uniform constant depending only on the data of the linear system. Moreover, for a class of partial regularizers, any global minimizer of these models is a sparsest solution to the linear system. We also establish some sufficient conditions for local or global recovery of the sparsest solution to the linear system, among which one of the conditions is weaker than the best-known restricted isometry property condition for sparse recovery by {$\ell$}1. In addition, a first-order augmented Lagrangian (FAL) method is proposed for solving these models, in which each subproblem is solved by a nonmonotone proximal gradient (NPG) method. Despite the complication of the partial regularizers, we show that each proximal subproblem in NPG can be solved as a certain number of one-dimensional optimization problems, which usually have a closed-form solution. We also show that any accumulation point of the sequence generated by FAL is a first-order stationary point of the models. Numerical results on compressed sensing and sparse logistic regression demonstrate that the proposed models substantially outperform the widely used ones in the literature in terms of solution quality.},
  langid = {english},
  keywords = {augmented Lagrangian method,compressed sensing,null space property,partial regularization,proximal gradient method,restricted isometry property,sparse logistic regression,sparse recovery},
  annotation = {abstractTranslation: まばらな回復の文脈では、L1などの既存の正統派のほとんどが、関連するベクトルのいくつかの主要なエントリ（大きさで）が発生するバイアスに悩まされることが知られています。このバイアスを中和するために、線形システムのまばらなソリューションを回復するための部分的な正則化装置を備えたモデルのクラスを提案します。これらのモデルのすべての局所ミニマイザーが実質的にまばらであるか、すべての非ゼロエントリの大きさが線形システムのデータのみに依存する均一な定数を上回っていることを示します。さらに、部分的な正統派のクラスの場合、これらのモデルのグローバルなミニマイザーは、線形システムに対する最もまばらなソリューションです。また、線形システムに対する最もスパースのある溶液のローカルまたはグローバルな回復のための十分な条件を確立します。その中で、L1によるスパース回復のために最も知られている制限された等尺性特性条件よりも条件の1つが弱いです。さらに、これらのモデルを解決するために、一次拡張ラグランジアン（FAL）法が提案されており、各サブ問題は非モノトーン近位勾配（NPG）メソッドによって解決されます。部分的な正規化剤の合併症にもかかわらず、NPGの各近位のサブ問題は、通常、閉じた溶液がある特定の数の1次元最適化問題として解決できることを示しています。また、FALによって生成されたシーケンスの蓄積点は、モデルの1次の固定点であることを示しています。圧縮センシングとスパースロジスティック回帰の数値結果は、提案されたモデルがソリューションの品質の観点から文献で広く使用されているものを大幅に上回ることを示しています。},
  file = {C:\Users\furuh\Zotero\storage\Y732LLSC\Lu と Li - 2018 - Sparse Recovery via Partial Regularization Models, Theory, and Algorithms.pdf}
}

