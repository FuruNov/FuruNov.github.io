@article{zhangDynamicSparseNo2023,
  title = {Dynamic {{Sparse No Training}}: {{Training-Free Fine-tuning}} for {{Sparse LLMs}}},
  shorttitle = {Dynamic {{Sparse No Training}}},
  author = {Zhang, Yuxin and Zhao, Lirui and Lin, Mingbao and Sun, Yunyun and Yao, Yiwu and Han, Xingjia and Tanner, Jared and Liu, Shiwei and Ji, Rongrong},
  year = {2023},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2310.08915},
  urldate = {2024-10-13},
  abstract = {The ever-increasing large language models (LLMs), though opening a potential path for the upcoming artificial general intelligence, sadly drops a daunting obstacle on the way towards their on-device deployment. As one of the most well-established pre-LLMs approaches in reducing model complexity, network pruning appears to lag behind in the era of LLMs, due mostly to its costly fine-tuning (or re-training) necessity under the massive volumes of model parameter and training data. To close this industry-academia gap, we introduce Dynamic Sparse No Training (DSnoT), a training-free fine-tuning approach that slightly updates sparse LLMs without the expensive backpropagation and any weight updates. Inspired by the Dynamic Sparse Training, DSnoT minimizes the reconstruction error between the dense and sparse LLMs, in the fashion of performing iterative weight pruning-and-growing on top of sparse LLMs. To accomplish this purpose, DSnoT particularly takes into account the anticipated reduction in reconstruction error for pruning and growing, as well as the variance w.r.t. different input data for growing each weight. This practice can be executed efficiently in linear time since its obviates the need of backpropagation for fine-tuning LLMs. Extensive experiments on LLaMA-V1/V2, Vicuna, and OPT across various benchmarks demonstrate the effectiveness of DSnoT in enhancing the performance of sparse LLMs, especially at high sparsity levels. For instance, DSnoT is able to outperform the state-of-the-art Wanda by 26.79 perplexity at 70\% sparsity with LLaMA-7B. Our paper offers fresh insights into how to fine-tune sparse LLMs in an efficient training-free manner and open new venues to scale the great potential of sparsity to LLMs. Codes are available at https://github.com/zyxxmu/DSnoT.},
  copyright = {Creative Commons Attribution 4.0 International},
  langid = {american},
  keywords = {Artificial Intelligence (cs.AI),FOS: Computer and information sciences},
  annotation = {abstractTranslation: 増え続ける大規模言語モデル（LLMs）は、来るべき人工知能への道を開く可能性を秘めているが、悲しいことに、デバイス上での展開に向けた道のりに困難な障害を落としている。モデルの複雑性を軽減するLLMs以前のアプローチとして最も確立されたものの1つであるネットワークの刈り込みは、LLMsの時代には遅れをとっているように見える。その主な理由は、膨大な量のモデルパラメータと学習データの下でコストのかかる微調整（または再学習）を行う必要があるためである。この産学間のギャップを埋めるために、我々は、高価なバックプロパゲーションや重みの更新を行わずに、スパースLLMをわずかに更新する、訓練不要の微調整アプローチである動的スパース訓練なし（DSnoT）を導入する。DSnoTは、動的スパース訓練に触発され、スパースLLMの上で反復的に重みの刈り込みと成長を行うことで、密なLLMとスパースLLMの間の再構成誤差を最小化する。この目的を達成するために、DSnoTは、特に、刈り込みと成長における再構成誤差の予想される低減と、各重みを成長させるための異なる入力データに対する分散を考慮する。DSnoTは、LLMを微調整するためのバックプロパゲーションを必要としないため、線形時間で効率的に実行することができる。様々なベンチマークにおけるLLaMA-V1/V2、Vicuna、OPTでの広範な実験により、特に高いスパースレベルにおいて、DSnoTがスパースLLMの性能を向上させる有効性が実証された。例えば、DSnoTはLLaMA-7Bのスパース度70\%において、最新鋭のWandaを26.79パープレキシティ上回った。本論文は、スパースLLMを効率的な訓練不要の方法で微調整する方法について新たな洞察を提供し、スパース性の大きな可能性をLLMに拡張する新たな場を開くものである。コードはhttps://github.com/zyxxmu/DSnoT。},
  file = {C:\Users\furuh\Zotero\storage\SNMID7A2\Zhang et al. - 2023 - Dynamic Sparse No Training Training-Free Fine-tuning for Sparse LLMs.pdf}
}

@misc{zhangEffectiveTensorCompletion2022,
  title = {Effective {{Tensor Completion}} via {{Element-wise Weighted Low-rank Tensor Train}} with {{Overlapping Ket Augmentation}}},
  author = {Zhang, Yang and Wang, Yao and Han, Zhi and Chen, Xi'ai and Tang, Yandong},
  year = {2022},
  month = jan,
  number = {arXiv:2109.05736},
  eprint = {2109.05736},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2109.05736},
  urldate = {2024-08-03},
  abstract = {In recent years, there have been an increasing number of applications of tensor completion based on the tensor train (TT) format because of its efficiency and effectiveness in dealing with higher-order tensor data. However, existing tensor completion methods using TT decomposition have two obvious drawbacks. One is that they only consider mode weights according to the degree of mode balance, even though some elements are recovered better in an unbalanced mode. The other is that serious blocking artifacts appear when the missing element rate is relatively large. To remedy such two issues, in this work, we propose a novel tensor completion approach via the element-wise weighted technique. Accordingly, a novel formulation for tensor completion and an effective optimization algorithm, called as tensor completion by parallel weighted matrix factorization via tensor train (TWMac-TT), is proposed. In addition, we specifically consider the recovery quality of edge elements from adjacent blocks. Different from traditional reshaping and ket augmentation, we utilize a new tensor augmentation technique called overlapping ket augmentation, which can further avoid blocking artifacts. We then conduct extensive performance evaluations on synthetic data and several real image data sets. Our experimental results demonstrate that the proposed algorithm TWMac-TT outperforms several other competing tensor completion methods.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computer Vision and Pattern Recognition},
  annotation = {abstractTranslation:  近年、テンソル列(TT)形式に基づくテンソル補完の応用が増加している。その理由は、高次のテンソルデータを扱う際の効率性と有効性にある。しかし、TT分解を用いた既存のテンソル補完法には2つの明らかな欠点がある。1つは、アンバランスなモードの方がよく復元される要素があるにもかかわらず、モードバランスの程度に応じたモード重みしか考慮していないことである。もう1つは、欠落要素率が比較的大きい場合に、深刻なブロッキングアーチファクトが現れることである。このような2つの問題を改善するために、本研究では、要素ごとの重み付け手法を用いた新しいテンソル補完アプローチを提案する。したがって、テンソル補完のための新しい定式化と、テンソル列を介した並列重み付き行列分解によるテンソル補完(TWMac-TT)と呼ばれる効果的な最適化アルゴリズムを提案する。さらに、隣接ブロックからのエッジ要素の復元品質を特に考慮する。従来のリシェーピングやケットオーギュメンテーションとは異なり、オーバーラッピングケットオーギュメンテーションと呼ばれる新しいテンソルオーギュメンテーション技術を利用することで、ブロッキングアーティファクトをさらに回避することができる。次に、合成データと複数の実画像データセットを用いて、広範な性能評価を行う。我々の実験結果は、提案アルゴリズムTWMac-TTが、他のいくつかの競合するテンソル補完手法を凌駕することを示している。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\B4W36I44\\Zhang et al. - 2022 - Effective Tensor Completion via Element-wise Weigh.pdf;C\:\\Users\\furuh\\Zotero\\storage\\CA26JYEV\\2109.html}
}

@article{zhangEfficientRecoveryLowRank2019,
  title = {Efficient {{Recovery}} of {{Low-Rank Matrix}} via {{Double Nonconvex Nonsmooth Rank Minimization}}},
  author = {Zhang, Hengmin and Gong, Chen and Qian, Jianjun and Zhang, Bob and Xu, Chunyan and Yang, Jian},
  year = {2019},
  month = oct,
  journal = {IEEE Transactions on Neural Networks and Learning Systems},
  volume = {30},
  number = {10},
  pages = {2916--2925},
  issn = {2162-237X, 2162-2388},
  doi = {10.1109/TNNLS.2019.2900572},
  urldate = {2023-12-03},
  abstract = {Recently, there is a rapidly increasing attraction for the efficient recovery of low-rank matrix in computer vision and machine learning. The popular convex solution of rank minimization is nuclear norm-based minimization (NNM), which usually leads to a biased solution since NNM tends to overshrink the rank components and treats each rank component equally. To address this issue, some nonconvex nonsmooth rank (NNR) relaxations have been exploited widely. Different from these convex and nonconvex rank substitutes, this paper first introduces a general and flexible rank relaxation function named weighted NNR relaxation function, which is actually derived from the initial double NNR (DNNR) relaxations, i.e., DNNR relaxation function acts on the nonconvex singular values function (SVF). An iteratively reweighted SVF optimization algorithm with continuation technology through computing the supergradient values to define the weighting vector is devised to solve the DNNR minimization problem, and the closed-form solution of the subproblem can be efficiently obtained by a general proximal operator, in which each element of the desired weighting vector usually satisfies the nondecreasing order. We next prove that the objective function values decrease monotonically, and any limit point of the generated subsequence is a critical point. Combining the Kurdyka--{\L}ojasiewicz property with some milder assumptions, we further give its global convergence guarantee. As an application in the matrix completion problem, experimental results on both synthetic data and real-world data can show that our methods are competitive with several state-of-the-art convex and nonconvex matrix completion methods.},
  file = {C:\Users\furuh\Zotero\storage\7JLIQA33\10.1109@TNNLS.2019.2900572.pdf.pdf}
}

@article{zhangEnhancedGroupSparse2022,
  title = {Enhanced {{Group Sparse Regularized Nonconvex Regression}} for {{Face Recognition}}},
  author = {Zhang, Chao and Li, Huaxiong and Chen, Chunlin and Qian, Yuhua and Zhou, Xianzhong},
  year = {2022},
  month = may,
  journal = {IEEE Transactions on Pattern Analysis and Machine Intelligence},
  volume = {44},
  number = {5},
  pages = {2438--2452},
  issn = {1939-3539},
  doi = {10.1109/TPAMI.2020.3033994},
  urldate = {2024-08-02},
  abstract = {Regression analysis based methods have shown strong robustness and achieved great success in face recognition. In these methods, convex l\_1l1-norm and nuclear norm are usually utilized to approximate the l\_0l0-norm and rank function. However, such convex relaxations may introduce a bias and lead to a suboptimal solution. In this paper, we propose a novel Enhanced Group Sparse regularized Nonconvex Regression (EGSNR) method for robust face recognition. An upper bounded nonconvex function is introduced to replace l\_1l1-norm for sparsity, which alleviates the bias problem and adverse effects caused by outliers. To capture the characteristics of complex errors, we propose a mixed model by combining {$\gamma\gamma$}-norm and matrix {$\gamma\gamma$}-norm induced from the nonconvex function. Furthermore, an l\textsubscript{2,{\textbackslash}gamma }l2,{$\gamma$}-norm based regularizer is designed to directly seek the interclass sparsity or group sparsity instead of traditional l\textsubscript{2,1}l2,1-norm. The locality of data, i.e., the distance between the query sample and multi-subspaces, is also taken into consideration. This enhanced group sparse regularizer enables EGSNR to learn more discriminative representation coefficients. Comprehensive experiments on several popular face datasets demonstrate that the proposed EGSNR outperforms the state-of-the-art regression based methods for robust face recognition.},
  keywords = {Encoding,enhanced group sparsity,face recognition,Face recognition,Low-rank structure,nonconvex relaxation,Nuclear magnetic resonance,Periodic structures,Robustness,Sparse matrices,sparse representation,Training},
  annotation = {abstractTranslation:  回帰分析に基づく手法は強いロバスト性を示し、顔認識において大きな成功を収めている。これらの手法では通常、l\_0l0ノルムとランク関数を近似するために、凸l\_1l1ノルムと核ノルムが利用される。しかし、このような凸緩和はバイアスを導入し、最適解を導かない可能性がある。本論文では、ロバストな顔認識のための新しい拡張群スパース正則化非凸回帰(EGSNR)法を提案する。スパース性のためにl\_1l1-normの代わりに上界非凸関数を導入し、バイアス問題と外れ値による悪影響を緩和する。複雑な誤差の特徴を捉えるために、非凸関数から誘導される{$\gamma$}ノルムと行列{$\gamma$}ノルムを組み合わせた混合モデルを提案する。さらに、従来のl\textsubscript{2,1}l2,1-normの代わりに、l\textsubscript{2,{$\gamma$}}gamma l2,{$\gamma$}-normに基づく正則化器を設計し、クラス間スパース性やグループスパース性を直接求める。データの局所性、すなわちクエリーサンプルと複数の部分空間との間の距離も考慮される。この強化されたグループスパース正則化により、EGSNRはより識別性の高い表現係数を学習することができる。いくつかの一般的な顔データセットを用いた包括的な実験により、提案するEGSNRが、ロバストな顔認識において、最新の回帰ベースの手法を凌駕することが実証された。}
}

@inproceedings{zhangEnhancedTensorLowRank2023,
  title = {Enhanced {{Tensor Low-Rank}} and {{Sparse Representation Recovery}} for {{Incomplete Multi-View Clustering}}},
  booktitle = {Proceedings of the {{AAAI Conference}} on {{Artificial Intelligence}}},
  author = {Zhang, Chao and Li, Huaxiong and Lv, Wei and Huang, Zizheng and Gao, Yang and Chen, Chunlin},
  year = {2023},
  month = jun,
  volume = {37},
  pages = {11174--11182},
  issn = {2374-3468, 2159-5399},
  doi = {10.1609/aaai.v37i9.26323},
  urldate = {2024-09-07},
  abstract = {Incomplete multi-view clustering (IMVC) has attracted remarkable attention due to the emergence of multi-view data with missing views in real applications. Recent methods attempt to recover the missing information to address the IMVC problem. However, they generally cannot fully explore the underlying properties and correlations of data similarities across views. This paper proposes a novel Enhanced Tensor Low-rank and Sparse Representation Recovery (ETLSRR) method, which reformulates the IMVC problem as a joint incomplete similarity graphs learning and complete tensor representation recovery problem. Specifically, ETLSRR learns the intra-view similarity graphs and constructs a 3-way tensor by stacking the graphs to explore the inter-view correlations. To alleviate the negative influence of missing views and data noise, ETLSRR decomposes the tensor into two parts: a sparse tensor and an intrinsic tensor, which models the noise and underlying true data similarities, respectively. Both global low-rank and local structured sparse characteristics of the intrinsic tensor are considered, which enhances the discrimination of similarity matrix. Moreover, instead of using the convex tensor nuclear norm, ETLSRR introduces a generalized non-convex tensor low-rank regularization to alleviate the biased approximation. Experiments on several datasets demonstrate the effectiveness of our method compared with the state-of-the-art methods.},
  langid = {english},
  annotation = {abstractTranslation: 不完全マルチビュークラスタリング(IMVC)は、実際のアプリケーションにおいて欠落したビューを持つマルチビューデータが出現するため、注目されている。最近の手法では、IMVC問題に対処するために欠損情報を回復することが試みられている。しかし、それらは一般に、ビュー間のデータの類似性の根本的な特性や相関関係を十分に探索することができない。本稿では、IMVC問題を不完全な類似グラフ学習と完全なテンソル表現回復の合同問題として再定義する、新しい拡張テンソル低ランク・疎な表現回復（ETLSRR）法を提案する。具体的には、ETLSRRはビュー内類似度グラフを学習し、ビュー間相関を探索するためにグラフを積み重ねることによって3元テンソルを構築する。欠落ビューとデータノイズの悪影響を緩和するために、ETLSRRはテンソルを2つの部分に分解する：スパーステンソルと固有テンソルであり、それぞれノイズと根本的な真のデータの類似性をモデル化する。固有テンソルの大域的な低ランクと局所的な構造化スパースの両方の特性を考慮することで、類似度行列の識別性を高める。さらに、凸テンソル核ノルムを用いる代わりに、ETLSRRは一般化された非凸テンソル低ランク正則化を導入し、偏った近似を緩和する。いくつかのデータセットを用いた実験により、本手法の有効性が最先端の手法と比較して実証された。},
  file = {C:\Users\furuh\Zotero\storage\NMPK8XKV\Zhang et al. - 2023 - Enhanced Tensor Low-Rank and Sparse Representation Recovery for Incomplete Multi-View Clustering.pdf}
}

@article{zhangExtensionSBLAlgorithms2012,
  title = {Extension of {{SBL Algorithms}} for the {{Recovery}} of {{Block Sparse Signals}} with {{Intra-Block Correlation}}},
  author = {Zhang, Zhilin and Rao, Bhaskar D.},
  year = {2012},
