@article{sakemiSparsefiringRegularizationMethods2023,
  title = {Sparse-Firing Regularization Methods for Spiking Neural Networks with Time-to-First-Spike Coding},
  author = {Sakemi, Yusuke and Yamamoto, Kakei and Hosomi, Takeo and Aihara, Kazuyuki},
  year = {2023},
  month = dec,
  journal = {Scientific Reports},
  volume = {13},
  number = {1},
  pages = {22897},
  publisher = {Nature Publishing Group},
  issn = {2045-2322},
  doi = {10.1038/s41598-023-50201-5},
  urldate = {2024-09-26},
  abstract = {The training of multilayer spiking neural networks (SNNs) using the error backpropagation algorithm has made significant progress in recent years. Among the various training schemes, the error backpropagation method that directly uses the firing time of neurons has attracted considerable attention because it can realize ideal temporal coding. This method uses time-to-first-spike (TTFS) coding, in which each neuron fires at most once, and this restriction on the number of firings enables information to be processed at a very low firing frequency. This low firing frequency increases the energy efficiency of information processing in SNNs. However, only an upper limit has been provided for TTFS-coded SNNs, and the information-processing capability of SNNs at lower firing frequencies has not been fully investigated. In this paper, we propose two spike-timing-based sparse-firing (SSR) regularization methods to further reduce the firing frequency of TTFS-coded SNNs. Both methods are characterized by the fact that they only require information about the firing timing and associated weights. The effects of these regularization methods were investigated on the MNIST, Fashion-MNIST, and CIFAR-10 datasets using multilayer perceptron networks and convolutional neural network structures.},
  copyright = {2023 The Author(s)},
  langid = {english},
  keywords = {Applied mathematics,Computer science},
  annotation = {abstractTranslation: 近年、誤差逆伝播アルゴリズムを用いた多層スパイキングニューラルネットワーク(SNN)の学習が大きく進展している。様々な学習方式の中でも、ニューロンの発火時刻を直接利用する誤差逆伝播法は、理想的な時間符号化を実現できることから注目を集めている。この方法は、各ニューロンが最大1回発火するTTFS（time-to-first-spike）符号化を用いており、この発火回数の制限により、非常に低い発火頻度で情報を処理することができる。この低い発火周波数は、SNNにおける情報処理のエネルギー効率を高める。しかし、TTFS符号化SNNについては上限値しか示されておらず、より低い発火頻度におけるSNNの情報処理能力については十分に調べられていない。本論文では、TTFS符号化SNNの発火周波数をさらに下げるために、スパイクタイミングに基づくスパース発火(SSR)正則化手法を2つ提案する。どちらの手法も、発火タイミングと関連する重みの情報のみを必要とするという特徴がある。これらの正則化手法の効果を、多層パーセプトロンネットワークと畳み込みニューラルネットワーク構造を用いて、MNIST、Fashion-MNIST、CIFAR-10データセットで調べた。},
  file = {C:\Users\furuh\Zotero\storage\ISA3JKIZ\Sakemi et al. - 2023 - Sparse-firing regularization methods for spiking neural networks with time-to-first-spike coding.pdf}
}

@article{salutOnlineTensorRobust2022,
  title = {Online {{Tensor Robust Principal Component Analysis}}},
  author = {Salut, Mohammad M. and Anderson, David V.},
  year = {2022},
  journal = {IEEE Access},
  volume = {10},
  pages = {69354--69363},
  issn = {2169-3536},
  doi = {10.1109/ACCESS.2022.3186364},
  urldate = {2024-12-31},
  abstract = {Online robust principal component analysis (RPCA) algorithms recursively decompose incoming data into low-rank and sparse components. However, they operate on data vectors and cannot directly be applied to higher-order data arrays (e.g. video frames). In this paper, we propose a new online robust PCA algorithm that preserves the multi-dimensional structure of data. Our algorithm is based on the recently proposed tensor singular value decomposition (T-SVD). We develop a convex optimization-based approach to recover the sparse component; and subsequently, update the low-rank component using incremental T-SVD. We propose an efficient tensor convolutional extension to the fast iterative shrinkage thresholding algorithm (FISTA) to produce a fast algorithm to solve this optimization problem. We demonstrate tensor-RPCA with the application of background foreground separation in a video stream. The foreground component is modeled as a sparse signal. The background component is modeled as a gradually changing low-rank subspace. Extensive experiments on real-world videos are presented and results demonstrate the effectiveness of our online tensor robust PCA.},
  langid = {english},
  keywords = {Convolutional codes,Heuristic algorithms,low-rank tensor model,Matrix decomposition,Multilinear subspace learning,Principal component analysis,Sparse matrices,Streaming media,tensor convolutional sparse coding,tensor singular value decomposition (T-SVD),Tensors},
  annotation = {abstractTranslation: オンラインの堅牢な主成分分析 (RPCA) アルゴリズムは、受信データを低ランクの疎成分に再帰的に分解します。ただし、これらはデータ ベクトルに対して動作するため、高次のデータ配列 (ビデオ フレームなど) に直接適用することはできません。この論文では、データの多次元構造を保存する新しいオンライン堅牢 PCA アルゴリズムを提案します。私たちのアルゴリズムは、最近提案されたテンソル特異値分解 (T-SVD) に基づいています。私たちは、スパース成分を回復するための凸最適化ベースのアプローチを開発します。その後、インクリメンタル T-SVD を使用して下位コンポーネントを更新します。我々は、この最適化問題を解決するための高速アルゴリズムを生成するために、高速反復収縮閾値アルゴリズム (FISTA) に対する効率的なテンソル畳み込み拡張を提案します。ビデオ ストリームにおける背景前景分離の適用による tensor-RPCA を実証します。フォアグラウンド コンポーネントはスパース信号としてモデル化されます。背景コンポーネントは、徐々に変化する低ランクの部分空間としてモデル化されます。現実世界のビデオに関する広範な実験が紹介され、結果はオンライン テンソル ロバスト PCA の有効性を示しています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\KWF73QIY\\Salut と Anderson - 2022 - Online Tensor Robust Principal Component Analysis.pdf;C\:\\Users\\furuh\\Zotero\\storage\\SAKV3Q3Y\\9807297.html}
}

@inproceedings{sanderFastDifferentiableSparse2023,
  title = {Fast, {{Differentiable}} and {{Sparse Top-k}}: A {{Convex Analysis Perspective}}},
  shorttitle = {Fast, {{Differentiable}} and {{Sparse Top-k}}},
  author = {Sander, Michael E. and Puigcerver, Joan and Djolonga, Josip and Peyr{\'e}, Gabriel and Blondel, Mathieu},
  year = {2023},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2302.01425},
  urldate = {2024-07-24},
  abstract = {The top-k operator returns a sparse vector, where the non-zero values correspond to the k largest values of the input. Unfortunately, because it is a discontinuous function, it is difficult to incorporate in neural networks trained end-to-end with backpropagation. Recent works have considered differentiable relaxations, based either on regularization or perturbation techniques. However, to date, no approach is fully differentiable and sparse. In this paper, we propose new differentiable and sparse top-k operators. We view the top-k operator as a linear program over the permutahedron, the convex hull of permutations. We then introduce a p-norm regularization term to smooth out the operator, and show that its computation can be reduced to isotonic optimization. Our framework is significantly more general than the existing one and allows for example to express top-k operators that select values in magnitude. On the algorithmic side, in addition to pool adjacent violator (PAV) algorithms, we propose a new GPU/TPU-friendly Dykstra algorithm to solve isotonic optimization problems. We successfully use our operators to prune weights in neural networks, to fine-tune vision transformers, and as a router in sparse mixture of experts.},
  copyright = {Creative Commons Attribution 4.0 International},
  langid = {american},
  keywords = {FOS: Computer and information sciences,Machine Learning (cs.LG),Machine Learning (stat.ML)},
  annotation = {abstractTranslation:  top-k演算子はスパースベクトルを返し、非ゼロ値は入力のk個の最大値に対応する。残念ながら、これは不連続関数であるため、バックプロパゲーションでend-to-end学習したニューラルネットワークに組み込むことは難しい。最近の研究では、正則化や摂動技術に基づく微分可能な緩和が検討されている。しかし、現在までのところ、完全に微分可能でスパースなアプローチはない。本稿では、微分可能でスパースな新しいtop-k演算子を提案する。我々はtop-k演算子を、順列の凸包であるpermutahedron上の線形プログラムとみなす。そして、この演算子を平滑化するためにp-norm正則化項を導入し、その計算が等張最適化に還元できることを示す。我々の枠組みは、既存の枠組みよりもかなり一般的であり、例えば、大きさで値を選択するtop-k演算子を表現することができる。アルゴリズム面では、プール隣接違反(PAV)アルゴリズムに加えて、等張最適化問題を解くためのGPU/TPUフレンドリーなDykstraアルゴリズムを提案する。我々は、ニューラルネットワークにおける重みの刈り込み、視覚変換器の微調整、および専門家のスパース混合におけるルータとして、我々の演算子を用いることに成功している。},
  file = {C:\Users\furuh\Zotero\storage\EDNWE884\Sander et al. - 2023 - Fast, Differentiable and Sparse Top-k a Convex An.pdf}
}

