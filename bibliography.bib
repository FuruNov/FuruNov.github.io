@incollection{saerensPrincipalComponentsAnalysis2004,
  title = {The {{Principal Components Analysis}} of a {{Graph}}, and {{Its Relationships}} to {{Spectral Clustering}}},
  booktitle = {Machine {{Learning}}: {{ECML}} 2004},
  author = {Saerens, Marco and Fouss, Francois and Yen, Luh and Dupont, Pierre},
  editor = {Hutchison, David and Kanade, Takeo and Kittler, Josef and Kleinberg, Jon M. and Mattern, Friedemann and Mitchell, John C. and Naor, Moni and Nierstrasz, Oscar and Pandu Rangan, C. and Steffen, Bernhard and Sudan, Madhu and Terzopoulos, Demetri and Tygar, Dough and Vardi, Moshe Y. and Weikum, Gerhard and Boulicaut, Jean-Fran{\c c}ois and Esposito, Floriana and Giannotti, Fosca and Pedreschi, Dino},
  year = {2004},
  volume = {3201},
  pages = {371--383},
  publisher = {Springer Berlin Heidelberg},
  address = {Berlin, Heidelberg},
  doi = {10.1007/978-3-540-30115-8_35},
  urldate = {2024-09-07},
  abstract = {This work presents a novel procedure for computing (1) distances between nodes of a weighted, undirected, graph, called the Euclidean Commute Time Distance (ECTD), and (2) a subspace projection of the nodes of the graph that preserves as much variance as possible, in terms of the ECTD -- a principal components analysis of the graph. It is based on a Markov-chain model of random walk through the graph. The model assigns transition probabilities to the links between nodes, so that a random walker can jump from node to node. A quantity, called the average commute time, computes the average time taken by a random walker for reaching node j when starting from node i, and coming back to node i. The square root of this quantity, the ECTD, is a distance measure between any two nodes, and has the nice property of decreasing when the number of paths connecting two nodes increases and when the ``length'' of any path decreases. The ECTD can be computed from the pseudoinverse of the Laplacian matrix of the graph, which is a kernel. We finally define the Principal Components Analysis (PCA) of a graph as the subspace projection that preserves as much variance as possible, in terms of the ECTD. This graph PCA has some interesting links with spectral graph theory, in particular spectral clustering.},
  isbn = {978-3-540-23105-9 978-3-540-30115-8},
  langid = {english},
  annotation = {abstractTranslation: 本研究では、(1)ユークリッド通勤時間距離(ECTD)と呼ばれる、重み付けされた無向グラフのノード間の距離と、(2)ECTDの観点から、可能な限り分散を保存するグラフのノードの部分空間射影、すなわちグラフの主成分分析を計算するための新しい手順を提示する。これは、グラフをランダムに歩くマルコフ連鎖モデルに基づいている。このモデルはノード間のリンクに遷移確率を割り当て、ランダム・ウォーカーがノードからノードへジャンプできるようにする。この量の平方根であるECTDは、任意の2つのノード間の距離尺度であり、2つのノードを接続するパスの数が増えると減少し、パスの "長さ "が減少すると減少するという素晴らしい性質を持っている。ECTDは、カーネルであるグラフのラプラシアン行列の擬似逆行列から計算できる。最後に、グラフの主成分分析（PCA）を、ECTDの観点から、できるだけ分散を保存する部分空間射影として定義する。このグラフPCAは、スペクトルグラフ理論、特にスペクトルクラスタリングと興味深い関係がある。},
  file = {C:\Users\furuh\Zotero\storage\3G89F9SB\Saerens et al. - 2004 - The Principal Components Analysis of a Graph, and Its Relationships to Spectral Clustering.pdf}
