  pages = {1746--1758},
  issn = {0278-0062, 1558-254X},
  doi = {10.1109/TMI.2019.2957097},
  urldate = {2024-09-06},
  abstract = {Recently, a hypergraph constructed from functional magnetic resonance imaging (fMRI) was utilized to explore brain functional connectivity networks (FCNs) for the classification of neurodegenerative diseases. Each edge of a hypergraph (called hyperedge) can connect any number of brain regions-of-interest (ROIs) instead of only two ROIs, and thus characterizes high-order relations among multiple ROIs that cannot be uncovered by a simple graph in the traditional graph based FCN construction methods. Unlike the existing hypergraph based methods where all hyperedges are assumed to have equal weights and only certain topological features are extracted from the hypergraphs, we propose a hypergraph learning based method for FCN construction in this paper. Specifically, we first generate hyperedges from fMRI time series based on sparse representation, then employ hypergraph learning to adaptively learn hyperedge weights, and finally define a hypergraph similarity matrix to represent the FCN. In our proposed method, weighting hyperedges results in better discriminative FCNs across subjects, and the defined hypergraph similarity matrix can better reveal the overall structure of brain network than using those hypergraph topological features. Moreover, we propose a multi-hypergraph learning based method by integrating multi-paradigm fMRI data, where the hyperedge weights associated with each fMRI paradigm are jointly learned and then a unified hypergraph similarity matrix is computed to represent the FCN. We validate the effectiveness of the proposed method on the Philadelphia Neurodevelopmental Cohort dataset for the classification of individuals' learning ability from three paradigms of fMRI data. Experimental results demonstrate that our proposed approach outperforms the traditional graph based methods (i.e., Pearson's correlation and partial correlation with the graphical Lasso) and the existing unweighted hypergraph based methods, which sheds light on how to optimize estimation of FCNs for cognitive and behavioral study.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {american},
  annotation = {abstractTranslation: 最近、機能的磁気共鳴画像（fMRI）から構築されたハイパーグラフが、神経変性疾患の分類のための脳機能的結合ネットワーク（FCN）の探索に利用された。ハイパーグラフの各エッジ（ハイパーエッジと呼ばれる）は、2つの脳関心領域（ROI）だけでなく、任意の数の脳関心領域（ROI）を接続することができるため、従来のグラフベースのFCN構築法では単純なグラフでは明らかにできなかった、複数のROI間の高次の関係を特徴付けることができる。全てのハイパーグラフの重みが等しいと仮定し、ハイパーグラフから特定のトポロジー的特徴のみを抽出する既存のハイパーグラフベースの手法とは異なり、本論文ではFCN構築のためのハイパーグラフ学習ベースの手法を提案する。具体的には、まずスパース表現に基づいてfMRI時系列からハイパーグラフを生成し、次にハイパーグラフ学習を採用してハイパーグラフの重みを適応的に学習し、最後にハイパーグラフ類似度行列を定義してFCNを表現する。提案手法では、ハイパーグラフに重み付けをすることで、被験者間でより識別性の高いFCNが得られ、定義されたハイパーグラフ類似度行列は、ハイパーグラフのトポロジー特徴を用いるよりも、脳ネットワークの全体構造をよりよく明らかにすることができる。さらに、マルチパラダイムfMRIデータを統合することで、各fMRIパラダイムに関連するハイパーグラフ重みを共同で学習し、FCNを表現するために統一されたハイパーグラフ類似度行列を計算する、マルチハイパーグラフ学習ベースの手法を提案する。我々は、fMRIデータの3つのパラダイムから個人の学習能力を分類するために、Philadelphia Neurodevelopmental Cohortデータセットを用いて提案手法の有効性を検証する。実験結果は、提案手法が従来のグラフに基づく手法（すなわち、ピアソンの相関や、グラフィカルラッソによる偏相関）や、既存の重み付けされていないハイパーグラフに基づく手法を凌駕することを示し、認知・行動研究のためのFCNの推定を最適化する方法に光を当てる。},
  file = {C:\Users\furuh\Zotero\storage\Q68WSV6G\Xiao et al. - 2020 - Multi-Hypergraph Learning-Based Brain Functional Connectivity Analysis in fMRI Data.pdf}
}

@article{xiaoRobustTensorLowRank2023,
  title = {Robust {{Tensor Low-Rank Sparse Representation With Saliency Prior}} for {{Hyperspectral Anomaly Detection}}},
  author = {Xiao, Qingjiang and Zhao, Liaoying and Chen, Shuhan and Li, Xiaorun},
  year = {2023},
  journal = {IEEE Transactions on Geoscience and Remote Sensing},
  volume = {61},
  pages = {1--20},
  issn = {1558-0644},
  doi = {10.1109/TGRS.2023.3329510},
  urldate = {2024-12-06},
  abstract = {Recently, hyperspectral anomaly detection (HAD) methods based on tensor low-rank representation (TLRR) have received widespread attention. However, most of them tend to emphasize the utilization of multiple types of prior knowledge to characterize background components, while the prior information about anomaly components is limited. In addition, the constructed background dictionary is also susceptible to noise and outliers. To address these challenges, this article focuses on both the background and abnormal components, proposing a robust tensor low-rank sparse representation with saliency prior (RTLSR-SP) method for HAD. Specifically, for the background component described by the dictionary tensor and the corresponding coefficient tensor, tensor nuclear norm (TNN) constraint and sparsity constraint are imposed on the coefficient tensor simultaneously to capture the global and local spatial--spectral structure information of the hyperspectral image (HSI), respectively. For the anomalous component, we design a sparse saliency prior weight tensor to enhance the saliency of anomalous targets. Meanwhile, the tensor {\textbackslash}ell \textsubscript{F,1} -norm is also integrated into the model to better separate abnormal targets from the background. Furthermore, combining tensor robust principal component analysis (TRPCA) and skinny tensor singular value decomposition (skinny t-SVD), a robust background dictionary is constructed. Finally, an efficient iterative algorithm based on the alternating direction method of multipliers (ADMM) is derived to optimize the RTLSR-SP model. Comprehensive experimental findings on one simulated dataset and six real hyperspectral datasets demonstrate the effectiveness and superiority of the proposed algorithm compared with eight state-of-the-art HAD algorithms.},
  langid = {american},
  keywords = {Anomaly detection,Dictionaries,Electron tubes,hyperspectral image (HSI),Hyperspectral imaging,Iterative methods,Principal component analysis,sparse saliency prior weight tensor,tensor low-rank sparse representation (SR),tensor robust principal component analysis (TRPCA),Tensors},
  annotation = {abstractTranslation: 近年、テンソル低ランク表現（TLRR）に基づくハイパースペクトル異常検出（HAD）手法が広く注目されている。しかし、その多くは、背景成分を特徴付けるために複数のタイプの事前知識を利用することを重視する傾向がある一方で、異常成分に関する事前情報は限られている。また、構築された背景辞書はノイズや異常値の影響を受けやすい。これらの課題に対処するため、本稿では背景成分と異常成分の両方に着目し、HADのための顕著性事前分布を用いた頑健なテンソル低ランクスパース表現（RTLSR-SP）法を提案する。具体的には、辞書テンソルと対応する係数テンソルによって記述される背景成分に対して、テンソル核ノルム（TNN）制約とスパース性制約を係数テンソルに同時に課し、ハイパースペクトル画像（HSI）の大域的および局所的な空間スペクトル構造情報をそれぞれ捕捉する。異常成分については、異常ターゲットの顕著性を高めるために、疎な顕著性事前重みテンソルを設計する。一方、異常なターゲットを背景からより良く分離するために、テンソルの\textsubscript{F,1} -normもモデルに統合する。さらに、テンソル頑健主成分分析(TRPCA)とスキニーテンソル特異値分解(skinny t-SVD)を組み合わせ、頑健な背景辞書を構築する。最後に、RTLSR-SPモデルを最適化するために、交互方向乗数法(ADMM)に基づく効率的な反復アルゴリズムを導出する。つの模擬データセットと6つの実際のハイパースペクトルデータセットを用いた包括的な実験結果は、8つの最先端のHADアルゴリズムと比較して、提案アルゴリズムの有効性と優位性を実証している。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\QEIHMDTC\\Xiao et al. - 2023 - Robust Tensor Low-Rank Sparse Representation With Saliency Prior for Hyperspectral Anomaly Detection.pdf;C\:\\Users\\furuh\\Zotero\\storage\\PFD745YE\\10305208.html}
}

