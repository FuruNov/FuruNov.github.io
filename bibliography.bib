@misc{dedieuErrorBoundLasso2020,
  title = {An Error Bound for {{Lasso}} and {{Group Lasso}} in High Dimensions},
  author = {Dedieu, Antoine},
  year = {2020},
  month = feb,
  number = {arXiv:1912.11398},
  eprint = {1912.11398},
  primaryclass = {stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1912.11398},
  urldate = {2025-05-30},
  abstract = {We leverage recent advances in high-dimensional statistics to derive new L2 estimation upper bounds for Lasso and Group Lasso in high-dimensions. For Lasso, our bounds scale as \$(k{\textasciicircum}*/n) {\textbackslash}log(p/k{\textasciicircum}*)\$---\$n{\textbackslash}times p\$ is the size of the design matrix and \$k{\textasciicircum}*\$ the dimension of the ground truth \${\textbackslash}boldsymbol\{{\textbackslash}beta\}{\textasciicircum}*\$---and match the optimal minimax rate. For Group Lasso, our bounds scale as \$(s{\textasciicircum}*/n) {\textbackslash}log{\textbackslash}left( G / s{\textasciicircum}* {\textbackslash}right) + m{\textasciicircum}* / n\$---\$G\$ is the total number of groups and \$m{\textasciicircum}*\$ the number of coefficients in the \$s{\textasciicircum}*\$ groups which contain \${\textbackslash}boldsymbol\{{\textbackslash}beta\}{\textasciicircum}*\$---and improve over existing results. We additionally show that when the signal is strongly group-sparse, Group Lasso is superior to Lasso.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Machine Learning,Mathematics - Statistics Theory,Now Reading,Statistics - Machine Learning,Statistics - Statistics Theory},
  annotation = {abstractTranslation: 我々は、高次元統計における最近の進展を活用し、高次元におけるLassoとGroup Lassoに対する新たなL2推定の上界を導出する。Lassoに対して、我々の上界は \$(k{\textasciicircum}*/n) {\textbackslash}log(p/k{\textasciicircum}*)\$ でスケールし（\$n{\textbackslash}times p\$ は計画行列のサイズ、\$k{\textasciicircum}*\$ は真のパラメータ \${\textbackslash}boldsymbol\{{\textbackslash}beta\}{\textasciicircum}*\$ の次元）、最適なミニマックスレートと一致する。Group Lassoに対して、我々の上界は \$(s{\textasciicircum}*/n) {\textbackslash}log{\textbackslash}left( G / s{\textasciicircum}* {\textbackslash}right) + m{\textasciicircum}* / n\$ でスケールし（\$G\$ はグループの総数、\$m{\textasciicircum}*\$ は \${\textbackslash}boldsymbol\{{\textbackslash}beta\}{\textasciicircum}*\$ を含む \$s{\textasciicircum}*\$ 個のグループにおける係数の数）、既存の結果を改善する。さらに、信号が強いグループスパース性を持つ場合、Group LassoがLassoよりも優れていることを示す。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\44A3ALEL\\Dedieu - 2020 - An error bound for Lasso and Group Lasso in high dimensions.pdf;C\:\\Users\\furuh\\Zotero\\storage\\MLGDYATP\\1912.html}
}

@misc{defazioLearningRateFreeLearningDAdaptation2023,
  title = {Learning-{{Rate-Free Learning}} by {{D-Adaptation}}},
  author = {Defazio, Aaron and Mishchenko, Konstantin},
  year = {2023},
  month = jul,
  number = {arXiv:2301.07733},
  eprint = {2301.07733},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2301.07733},
  urldate = {2024-12-09},
  abstract = {D-Adaptation is an approach to automatically setting the learning rate which asymptotically achieves the optimal rate of convergence for minimizing convex Lipschitz functions, with no back-tracking or line searches, and no additional function value or gradient evaluations per step. Our approach is the first hyper-parameter free method for this class without additional multiplicative log factors in the convergence rate. We present extensive experiments for SGD and Adam variants of our method, where the method automatically matches hand-tuned learning rates across more than a dozen diverse machine learning problems, including large-scale vision and language problems. An open-source implementation is available.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Machine Learning,Mathematics - Optimization and Control,Statistics - Machine Learning},
  annotation = {abstractTranslation: D-Adaptationは、凸リプシッツ関数を最小化するための最適な収束率を漸近的に達成する学習率を、バックトラッキングや直線探索を行わず、ステップ毎に関数値や勾配評価を追加することなく自動的に設定するアプローチである。我々のアプローチは、収束率に乗法的な対数因子を追加することなく、このクラスに対して初めて超パラメータを必要としない手法である。我々は、SGDと我々の手法のAdam変種に関する広範な実験を行い、大規模な視覚問題や言語問題を含む10以上の多様な機械学習問題において、この手法が手作業で調整された学習率と自動的に一致することを示す。オープンソースの実装が利用可能である。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\CXW9VXYW\\Defazio と Mishchenko - 2023 - Learning-Rate-Free Learning by D-Adaptation.pdf;C\:\\Users\\furuh\\Zotero\\storage\\X3D7CBU2\\2301.html}
}

@misc{defazioRoadLessScheduled2024,
  title = {The {{Road Less Scheduled}}},
  author = {Defazio, Aaron and Yang, Xingyu Alice and Mehta, Harsh and Mishchenko, Konstantin and Khaled, Ahmed and Cutkosky, Ashok},
  year = {2024},
  month = aug,
  number = {arXiv:2405.15682},
  eprint = {2405.15682},
  primaryclass = {cs, math, stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2405.15682},
  urldate = {2024-10-16},
  abstract = {Existing learning rate schedules that do not require specification of the optimization stopping step T are greatly out-performed by learning rate schedules that depend on T. We propose an approach that avoids the need for this stopping time by eschewing the use of schedules entirely, while exhibiting state-of-the-art performance compared to schedules across a wide family of problems ranging from convex problems to large-scale deep learning problems. Our Schedule-Free approach introduces no additional hyper-parameters over standard optimizers with momentum. Our method is a direct consequence of a new theory we develop that unifies scheduling and iterate averaging. An open source implementation of our method is available (https://github.com/facebookresearch/schedule\_free).},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Machine Learning,Mathematics - Optimization and Control,Statistics - Machine Learning},
  annotation = {abstractTranslation: 我々は、凸問題から大規模な深層学習問題までの幅広い問題群にわたって、スケジュールと比較して最先端の性能を示しながら、スケジュールの使用を完全に避けることによって、この停止時間の必要性を回避するアプローチを提案する。我々のスケジュールフリーのアプローチは、運動量を持つ標準的なオプティマイザに対して、追加のハイパーパラメータを導入しない。本手法は、スケジューリングと反復平均を統合する、我々が開発した新しい理論の直接的な結果である。我々の手法のオープンソース実装が利用可能である(https://github.com/facebookresearch/schedule\_free)。},
  file = {C:\Users\furuh\Zotero\storage\WPJ2LR8Z\Defazio et al. - 2024 - The Road Less Scheduled.pdf}
}

@misc{degrootBonsaiTreeRepresentations2025,
  title = {Bonsai : {{Tree}} Representations for Distortion-Free Visualization and Exploratory Analysis of Single-Cell Omics Data},
  shorttitle = {{\emph{Bonsai}}},
  author = {De Groot, Daan H. and Leonardo, Sarah X. Morillo and Pachkov, Mikhail and Van Nimwegen, Erik},
  year = {2025},
  month = may,
  publisher = {Bioinformatics},
  doi = {10.1101/2025.05.08.652944},
  urldate = {2025-05-16},
  abstract = {Abstract                        Single-cell omics methods promise to revolutionize our understanding of gene regulatory processes during cell differentiation, but analysis of such data continues to pose a major challenge. Apart from technical challenges such as the sparsity and heterogeneous noise properties of these data, the crucial problem is that we know little about the potentially very complex high-dimensional structures that the data represent. Consequently, there is an urgent need for exploratory analysis methods that allow rigorous representation and visualization of the structure in the data. However, currently popular methods such as UMAP and t-SNE are unsatisfactory because they are             ad hoc             , stochastic, uninterpretable, and known to severely distort the structure in the data.                                   Here we show that these challenges can be overcome by representing the data on tree structures and present             Bonsai             : a novel method that reconstructs the most likely tree relating any set of high-dimensional objects while rigorously accounting for heterogeneous measurement noise.                                   We show that, in contrast to other visualization methods, distances along the             Bonsai             trees accurately represent true distances between the objects in high-dimensional space across many types of datasets. Moreover,             Bonsai             automatically regularizes measurement noise, outperforming even methods specifically designed for that purpose on tasks such as nearest-neighbor identification.                                   By analyzing a blood cell dataset, we show that             Bonsai             trees not only capture known lineage relationships but also provide novel biological insights. For example,             Bonsai             uncovers that different subsets of NK cells derive from the myeloid and lymphoid lineage, and pinpoints genes that distinguish myeloid-NK from lymphoid-NK cells.                                   Bonsai             is free from tunable parameters and scales to datasets of hundreds of thousands of cells. The accompanying tool,             Bonsai-scout             , provides visualizations of the             Bonsai             trees and allows for interactive data exploration such as identifying subclades and their markers, visualizing features along the tree, changing the tree layout, and zooming in on substructures. Finally, application to a dataset of football statistics shows the generality of             Bonsai             in successfully capturing complex structures in high-dimensional data.},
  archiveprefix = {Bioinformatics},
  copyright = {http://creativecommons.org/licenses/by-nc/4.0/},
  langid = {english}
}

@article{dehandschutterDeepMatrixFactorizations2021,
  title = {Deep Matrix Factorizations},
  author = {De Handschutter, Pierre and Gillis, Nicolas and Siebert, Xavier},
  year = {2021},
