@article{zengFlexibleApproachBased2025,
  title = {A {{Flexible Approach Based}} on {{Hybrid Global Low-Rankness}} and {{Smoothness Regularization With Nonlocal Structure}} for {{Traffic Data Imputation}}},
  author = {Zeng, Zeyu and Feng, Jun and Huang, Zhang and Liu, Bin and Zhou, Bin},
  year = {2025},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  pages = {1--16},
  issn = {1558-0016},
  doi = {10.1109/TITS.2025.3541448},
  urldate = {2025-02-25},
  abstract = {Spatialtemporal traffic data are collected by a wide array of data collection devices deployed in intelligent transportation systems, which play crucial roles in data-driven intelligent transportation systems. However, hardware malfunctions or software system errors can lead to the inability to collect accurate data. Incomplete data in intelligent transportation systems can cause difficulties for subsequent applications, such as traffic flow anomaly detection and forecasting. Recently, low-rank tensor-based methods that characterize the global correlation of high-dimensional data have achieved superior performance. However, the majority of tensor-based approaches primarily account for the global correlation within the target traffic data, which is not sufficient to recover some challenging missing scenarios, such as fiber missing and slice missing that often occur in real situations. In this manuscript, we suggest a flexible method to explore the global correlation, local smoothness, and nonlocal self-similar redundancy in traffic data to improve recovery accuracy. Specifically, we utilize the multidimensional tensor nuclear norm to characterize the correlation structure, the multidimensional total variation to maintain smoothness detail, and the plug-and-play term to promote nonlocal self-similarity. The primary merits of this model lie in the fact that these priors characterize data features from different perspectives and complement each other. We develop an alternating direction method of multipliers to achieve efficient optimization for each variable. The proposed method is comprehensively evaluated through experiments across seven missing scenarios. Extensive experiments demonstrate that the suggested method with the aid of different priors outperforms many state-of-the-art approaches, especially structured missing scenarios.},
  langid = {english},
  keywords = {Accuracy,complex missing data scenarios,Correlation,Data models,Imputation,Laplace equations,Matrix decomposition,multidimensional tensor nuclear norm,nonlocal structure,smoothness regularization,Spatiotemporal phenomena,Spatiotemporal traffic data imputation,Tensors,Termination of employment,Transportation},
  annotation = {abstractTranslation: 空間的交通データは、データ駆動型のインテリジェント輸送システムで重要な役割を果たすインテリジェント輸送システムに展開された幅広いデータ収集デバイスによって収集されます。ただし、ハードウェアの誤動作またはソフトウェアシステムエラーは、正確なデータを収集できないことにつながる可能性があります。インテリジェントな輸送システムの不完全なデータは、トラフィックフローの異常検出や予測など、その後のアプリケーションの困難を引き起こす可能性があります。最近、高次元データのグローバルな相関を特徴付ける低ランクテンソルベースの方法は、優れたパフォーマンスを達成しました。ただし、テンソルベースのアプローチの大部分は、主にターゲットトラフィックデータ内のグローバルな相関関係を説明しています。これは、実際の状況で発生することが多いファイバーの欠落やスライスの欠落など、いくつかの挑戦的な欠落シナリオを回復するのに十分ではありません。この原稿では、回復の精度を向上させるために、トラフィックデータの世界的な相関、局所的な滑らかさ、および非ローカルな自己類似冗長性を調査するための柔軟な方法を提案します。具体的には、多次元テンソル核規範を利用して、相関構造、多次元の総変動を滑らかさの詳細を維持するための多次元の総変動、および非局所的な自己類似性を促進するプラグアンドプレイ用語を特徴付けます。このモデルの主なメリットは、これらのプライアーがさまざまな観点からデータ機能を特徴付け、互いに補完するという事実にあります。各変数の効率的な最適化を実現するために、乗数の交互方向方法を開発します。提案された方法は、7つの欠落したシナリオにわたる実験を通じて包括的に評価されます。広範な実験は、さまざまな事前層を使用した提案された方法が、多くの最先端のアプローチ、特に構造化された欠落シナリオよりも優れていることを示しています。}
}

@inproceedings{zengMedicalImageSegmentation2025,
  title = {Medical {{Image Segmentation}} via {{Sparse Coding Decoder}}},
  booktitle = {{{ICASSP}} 2025 - 2025 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {Zeng, Long and Zhu, Mingwei and Wu, Kaigui and Li, Zefang},
  year = {2025},
  month = apr,
  pages = {1--5},
  issn = {2379-190X},
  doi = {10.1109/ICASSP49660.2025.10889260},
  urldate = {2025-03-14},
  abstract = {Transformers have achieved significant success in medical image segmentation, owing to their capability to capture long-range dependencies. Previous studies have employed either pure Transformer or hybrid CNN-Transformer architectures in the encoder module to enhance their ability to extract more complex features. However, these models still exhibit limitations in fine-grained local feature extraction and effectively suppressing irrelevant information. To address this issue, a convolution sparse vector coding-based decoder is proposed, namely the CAScaded multi-layer Convolutional Sparse vector Coding DEcoder (CASCSCDE), which suppresses noise by refining the feature representation to be more sparse and accurate through sparse coding and localized convolution, effectively minimizing less important, noisy components. To demonstrate the effectiveness and versatility of our CASCSCDE, we incorporate our decoder into both pure Transformer and hybrid CNN-Transformer models, such as SwinUNet and TransUNet. Our experiments demonstrate that integrating CASCSCDE into the models significantly enhances segmentation performance. The CASCSCDE opens new ways for constructing decoders based on convolutional sparse vector coding.},
  langid = {english},
  keywords = {Biomedical imaging,Convolution,Convolutional codes,Decoding,Feature extraction,Image coding,Image segmentation,Medical image segmentation,Noise,Sparse Coding,Transformer,Transformers,Vectors},
  annotation = {abstractTranslation: 変圧器は、長距離の依存関係を捉える能力により、医療画像のセグメンテーションで大きな成功を収めています。以前の研究では、純粋なトランスまたはハイブリッドCNNトランスフォーカーアーキテクチャをエンコーダモジュールに採用しており、より複雑な機能を抽出する能力を高めています。ただし、これらのモデルは、きめ細かい局所的な特徴抽出において依然として制限を示し、無関係な情報を効果的に抑制します。この問題に対処するために、畳み込みスパースベクトルコーディングベースのデコーダー、すなわちカスケードされた多層畳み込みスパースベクターコーディングデコーダー（CASCSCDE）が提案されています。 CASCSCDEの有効性と汎用性を実証するために、SwinunetやTransunetなどの純粋な変圧器とハイブリッドのCNNトランスフォーマーモデルの両方にデコーダーを組み込みます。私たちの実験は、CASCSCDEをモデルに統合することでセグメンテーションのパフォーマンスが大幅に向上することを示しています。 The CASCSCDE opens new ways for constructing decoders based on convolutional sparse vector coding.},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\KJ875FHW\\Zeng et al. - 2025 - Medical Image Segmentation via Sparse Coding Decoder.pdf;C\:\\Users\\furuh\\Zotero\\storage\\C24FFYBL\\10889260.html}
