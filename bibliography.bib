@article{zhengVisibilityGraphBased2021,
  title = {Visibility Graph Based Temporal Community Detection with Applications in Biological Time Series},
  author = {Zheng, Minzhang and Domanskyi, Sergii and Piermarocchi, Carlo and Mias, George I.},
  year = {2021},
  month = mar,
  journal = {Scientific Reports},
  volume = {11},
  number = {1},
  pages = {5623},
  publisher = {Nature Publishing Group},
  issn = {2045-2322},
  doi = {10.1038/s41598-021-84838-x},
  urldate = {2024-07-19},
  abstract = {Temporal behavior is an essential aspect of all biological systems. Time series have been previously represented as networks. Such representations must address two fundamental problems on how to: (1) Create appropriate networks to reflect the characteristics of biological time series. (2) Detect characteristic dynamic patterns or events as network temporal communities. General community detection methods use metrics comparing the connectivity within a community to random models, or are based on the betweenness centrality of edges or nodes. However, such methods were not designed for network representations of time series. We introduce a visibility-graph-based method to build networks from time series and detect temporal communities within these networks. To characterize unevenly sampled time series (typical of biological experiments), and simultaneously capture events associated to peaks and troughs, we introduce the Weighted Dual-Perspective Visibility Graph (WDPVG). To detect temporal communities in individual signals, we first find the shortest path of the network between start and end nodes, identifying high intensity nodes as the main stem of our community detection algorithm that act as hubs for each community. Then, we aggregate nodes outside the shortest path to the closest nodes found on the main stem based on the closest path length, thereby assigning every node to a temporal community based on proximity to the stem nodes/hubs. We demonstrate the validity and effectiveness of our method through simulation and biological applications.},
  copyright = {2021 The Author(s)},
  langid = {english},
  keywords = {Computational biology and bioinformatics,Systems biology,Time series},
  annotation = {abstractTranslation: 時間的な振る舞いは、すべての生物学的システムにとって不可欠な側面である。時系列はこれまでネットワークとして表現されてきた。このような表現は、以下の2つの基本的な問題に対処しなければならない：(1) 生物学的時系列の特徴を反映する適切なネットワークを作成する。(2) 特徴的な動的パターンやイベントをネットワークの時間的コミュニティとして検出する。一般的なコミュニティ検出法は、コミュニティ内の接続性をランダムモデルと比較する指標を用いたり、エッジやノードの中心性（betweenness centrality）に基づいている。しかし、このような手法は時系列のネットワーク表現用に設計されていない。我々は、時系列からネットワークを構築し、これらのネットワーク内の時間的コミュニティを検出するための可視性グラフベースの手法を導入する。不均一にサンプリングされた時系列（生物学的実験に典型的）を特徴付け、ピークと谷に関連するイベントを同時に捕捉するために、重み付き二重視点可視性グラフ（WDPVG）を導入する。個々の信号の時間的コミュニティを検出するために、まず、開始ノードと終了ノード間のネットワークの最短パスを見つけ、各コミュニティのハブとして機能するコミュニティ検出アルゴリズムの主幹として高強度ノードを特定する。次に、最短パスの外側にあるノードを、最も近いパスの長さに基づいて、メインステム上で見つかった最も近いノードに集約し、それによって、ステムノード／ハブへの近接性に基づいて、すべてのノードを時間的コミュニティに割り当てる。シミュレーションと生物学的応用により、本手法の妥当性と有効性を示す。},
  file = {C:\Users\furuh\Zotero\storage\4BVTXS49\Zheng et al. - 2021 - Visibility graph based temporal community detectio.pdf}
}

