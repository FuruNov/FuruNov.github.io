  author = {Manojlovi{\'c}, Iva and Fonoberova, Maria and Mohr, Ryan and Andrej{\v c}uk, Aleksandr and Drma{\v c}, Zlatko and Kevrekidis, Yannis and Mezi{\'c}, Igor},
