@misc{unnikrishnanUnlabeledSensingRandom2015,
  title = {Unlabeled {{Sensing}} with {{Random Linear Measurements}}},
  author = {Unnikrishnan, Jayakrishnan and Haghighatshoar, Saeid and Vetterli, Martin},
  year = {2015},
  month = nov,
  number = {arXiv:1512.00115},
  eprint = {1512.00115},
  primaryclass = {cs, math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1512.00115},
  urldate = {2024-07-21},
  abstract = {We study the problem of solving a linear sensing system when the observations are unlabeled. Specifically we seek a solution to a linear system of equations y = Ax when the order of the observations in the vector y is unknown. Focusing on the setting in which A is a random matrix with i.i.d. entries, we show that if the sensing matrix A admits an oversampling ratio of 2 or higher, then with probability 1 it is possible to recover x exactly without the knowledge of the order of the observations in y. Furthermore, if x is of dimension K, then any 2K entries of y are sufficient to recover x. This result implies the existence of deterministic unlabeled sensing matrices with an oversampling factor of 2 that admit perfect reconstruction. The result is universal in that recovery is guaranteed for all possible choices of x. While the proof is constructive, it uses a combinatorial algorithm which is not practical, leaving the question of complexity open. We also analyze a noisy version of the problem and show that local stability is guaranteed by the solution. In particular, for every x, the recovery error tends to zero as the signal-to-noise-ratio tends to infinity. The question of universal stability is unclear. We also obtain a converse of the result in the noiseless case: If the number of observations in y is less than 2K, then with probability 1, universal recovery fails, i.e., with probability 1, there exists distinct choices of x which lead to the same unordered list of observations in y. In terms of applications, the unlabeled sensing problem is related to data association problems encountered in different domains including robotics where it is appears in a method called "simultaneous localization and mapping" (SLAM), multi-target tracking applications, and in sampling signals in the presence of jitter.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Information Theory,Mathematics - Probability},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\C3IC6AWE\\Unnikrishnan et al. - 2015 - Unlabeled Sensing with Random Linear Measurements.pdf;C\:\\Users\\furuh\\Zotero\\storage\\GLW6KD7H\\1512.html}
}

@inproceedings{upadhyayLessMoreParsimonious2023,
  title = {Less Is {{More}} -- {{Towards}} Parsimonious Multi-Task Models Using Structured Sparsity},
  booktitle = {Conference on {{Parsimony}} and {{Learning}} ({{Proceedings Track}})},
  author = {Upadhyay, Richa and Phlypo, Ronald and Saini, Rajkumar and Liwicki, Marcus},
  year = {2023},
  month = dec,
  urldate = {2025-05-30},
  abstract = {Model sparsification in deep learning promotes simpler, more interpretable models with fewer parameters. This not only reduces the model's memory footprint and computational needs but also shortens inference time. This work focuses on creating sparse models optimized for multiple tasks with fewer parameters. These parsimonious models also possess the potential to match or outperform dense models in terms of performance. In this work, we introduce channel-wise \$l\_1/l\_2\$ group sparsity in the shared convolutional layers parameters (or weights) of the multi-task learning model. This approach facilitates the removal of extraneous groups i.e., channels (due to \$l\_1\$ regularization) and also imposes a penalty on the weights, further enhancing the learning efficiency for all tasks (due to \$l\_2\$ regularization). We analyzed the results of group sparsity in both single-task and multi-task settings on two widely-used multi-task learning datasets: NYU-v2 and CelebAMask-HQ. On both datasets, which consist of three different computer vision tasks each, multi-task models with approximately 70{\textbackslash}\% sparsity outperform their dense equivalents. We also investigate how changing the degree of sparsification influences the model's performance, the overall sparsity percentage, the patterns of sparsity, and the inference time.},
  langid = {english},
  annotation = {abstractTranslation: 深層学習におけるモデルのスパース化は、より少ないパラメータで、よりシンプルで解釈可能性の高いモデルを促進する。これにより、モデルのメモリフットプリントと計算ニーズが削減されるだけでなく、推論時間も短縮される。本研究では、より少ないパラメータで複数のタスクに最適化されたスパースモデルの作成に焦点を当てる。これらの簡潔なモデルは、性能の点で密なモデルに匹敵するか、それを上回る可能性も秘めている。本研究では、マルチタスク学習モデルの共有畳み込み層のパラメータ（または重み）にチャネルワイズな \$l\_1/l\_2\$ グループスパース性を導入する。このアプローチは、（\$l\_1\$正則化により）余分なグループ、すなわちチャネルの除去を容易にし、（\$l\_2\$正則化により）重みにペナルティを課し、すべてのタスクの学習効率をさらに向上させる。グループスパース性の効果を、単一タスクおよびマルチタスクの両方の設定で、広く使用されている2つのマルチタスク学習データセット、NYU-v2とCelebAMask-HQを用いて分析した。各々3つの異なるコンピュータビジョンタスクから構成される両方のデータセットにおいて、約70\%のスパース性を持つマルチタスクモデルは、それらの密なモデルよりも優れた性能を示す。また、スパース化の度合いを変えることが、モデルの性能、全体的なスパース性の割合、スパース性のパターン、および推論時間にどのように影響するかについても調査する。},
  file = {C:\Users\furuh\Zotero\storage\L6T2TQD7\Upadhyay et al. - 2023 - Less is More – Towards parsimonious multi-task models using structured sparsity.pdf}
}

