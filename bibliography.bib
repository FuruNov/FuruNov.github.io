@inproceedings{haghighatshoarSignalRecoveryUnlabeled2017,
  title = {Signal Recovery from Unlabeled Samples},
  booktitle = {2017 {{IEEE International Symposium}} on {{Information Theory}} ({{ISIT}})},
  author = {Haghighatshoar, Saeid and Caire, Giuseppe},
