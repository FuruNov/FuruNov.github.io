  issn = {0893-6080},
  doi = {10.1016/j.neunet.2020.09.021},
  urldate = {2024-09-29},
  abstract = {Low Rank Regularization (LRR), in essence, involves introducing a low rank or approximately low rank assumption to target we aim to learn, which has achieved great success in many data analysis tasks. Over the last decade, much progress has been made in theories and applications. Nevertheless, the intersection between these two lines is rare. In order to construct a bridge between practical applications and theoretical studies, in this paper we provide a comprehensive survey for LRR. Specifically, we first review the recent advances in two issues that all LRR models are faced with: (1) rank-norm relaxation, which seeks to find a relaxation to replace the rank minimization problem; (2) model optimization, which seeks to use an efficient optimization algorithm to solve the relaxed LRR models. For the first issue, we provide a detailed summarization for various relaxation functions and conclude that the non-convex relaxations can alleviate the punishment bias problem compared with the convex relaxations. For the second issue, we summarize the representative optimization algorithms used in previous studies, and analyze their advantages and disadvantages. As the main goal of this paper is to promote the application of non-convex relaxations, we conduct extensive experiments to compare different relaxation functions. The experimental results demonstrate that the non-convex relaxations generally provide a large advantage over the convex relaxations. Such a result is inspiring for further improving the performance of existing LRR models.},
  langid = {english},
  keywords = {Favorite,Low rank,Optimization,Regularization},
  annotation = {abstractTranslation: 低ランク正則化(LRR)は、要するに、学習しようとするターゲットに低ランクまたはほぼ低ランクの仮定を導入するもので、多くのデータ解析タスクで大きな成功を収めている。過去10年間、理論と応用において多くの進歩があった。にもかかわらず、この2つの路線が交差することは稀である。実用的な応用と理論的な研究の橋渡しをするために、本稿ではLRRの包括的なサーベイを行う。具体的には、まずすべてのLRRモデルが直面する2つの問題について最近の進歩をレビューする：(1)ランク・ノルム緩和：ランク最小化問題に代わる緩和を求める問題、(2)モデル最適化：緩和されたLRRモデルを解くための効率的な最適化アルゴリズムを求める問題。(1)については、様々な弛緩関数の詳細な要約を行い、非凸弛緩関数は凸弛緩関数に比べ、罰の偏り問題を緩和できると結論付ける。第二の課題については、先行研究で用いられた代表的な最適化アルゴリズムを要約し、その長所と短所を分析する。本論文の主な目的は非凸緩和の適用を促進することであるため、異なる緩和関数を比較するために広範な実験を行った。その結果、非凸弛緩関数は凸弛緩関数よりも一般に大きな利点を持つことが示された。このような結果は、既存のLRRモデルの性能をさらに向上させるための刺激となる。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\FEEDMAUP\\Hu et al. - 2021 - Low Rank Regularization A review.pdf;C\:\\Users\\furuh\\Zotero\\storage\\NATCY8Z7\\S089360802030352X.html}
}

@article{humbertLearningLaplacianMatrix,
  title = {Learning {{Laplacian Matrix}} from {{Graph Signals}} with {{Sparse Spectral Representation}}},
  author = {Humbert, Pierre and Oudre, Laurent and Kalogeratos, Argyris and Vayatis, Nicolas},
  abstract = {In this paper, we consider the problem of learning a graph structure from multivariate signals, known as graph signals. Such signals are multivariate observations carrying measurements corresponding to the nodes of an unknown graph, which we desire to infer. They are assumed to enjoy a sparse representation in the graph spectral domain, a feature which is known to carry information related to the cluster structure of a graph. The signals are also assumed to behave smoothly with respect to the underlying graph structure. For the graph learning problem, we propose a new optimization program to learn the Laplacian of this graph and provide two algorithms to solve it, called IGL-3SR and FGL-3SR. Based on a 3-step alternating procedure, both algorithms rely on standard minimization methods --such as manifold gradient descent or linear programming-- and have lower complexity compared to state-of-the-art algorithms. While IGL-3SR ensures convergence, FGL-3SR acts as a relaxation and is significantly faster since its alternating process relies on multiple closed-form solutions. Both algorithms are evaluated on synthetic and real data. They are shown to perform as good or better than their competitors in terms of both numerical performance and scalability. Finally, we present a probabilistic interpretation of the proposed optimization program as a Factor Analysis Model.},
  langid = {english},
  keywords = {No DOI found},
  file = {C:\Users\furuh\Zotero\storage\TZ377WAR\Humbert et al. - Learning Laplacian Matrix from Graph Signals with Sparse Spectral Representation.pdf}
}

