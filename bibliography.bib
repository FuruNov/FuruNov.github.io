@inproceedings{sankaranIdentifyingGroupsStrongly2017,
  title = {Identifying {{Groups}} of {{Strongly Correlated Variables}} through {{Smoothed Ordered Weighted}} \${{L}}\_1\$-Norms},
  booktitle = {Proceedings of the 20th {{International Conference}} on {{Artificial Intelligence}} and {{Statistics}}},
  author = {Sankaran, Raman and Bach, Francis and Bhattacharya, Chiranjib},
  year = {2017},
  month = apr,
  pages = {1123--1131},
  publisher = {PMLR},
  issn = {2640-3498},
  urldate = {2024-08-22},
  abstract = {The failure of LASSO   to identify groups of correlated predictors in linear  regression  has sparked significant research interest. Recently,   various norms were proposed, which can be  best described as instances of ordered weighted \${\textbackslash}ell\_1\$ norms (OWL), as an alternative to \${\textbackslash}ell\_1\$ regularization used in LASSO. OWL can identify groups of correlated variables but  it forces the model to be constant within a group.  This artifact induces unnecessary bias in the model estimation.  In this paper we take a submodular perspective and show that  OWL can be posed as the Lov{\'a}sz extension of a suitably defined submodular function. The submodular perspective not only explains the group-wise constant behavior of OWL, but also suggests alternatives. The main contribution of this paper is smoothed OWL (SOWL), a new family of norms, which  not only identifies the groups but also allows the model to be flexible inside a group.   We establish several algorithmic and theoretical properties of SOWL including group identification and model consistency. We also provide algorithmic tools to compute the SOWL norm and its proximal operator, whose computational complexity  \$O(d{\textbackslash}log d)\$ is significantly better than that of general purpose solvers in \$O(d{\textasciicircum}2{\textbackslash}log d)\$. In our experiments, SOWL compares favorably with respect to OWL in the regimes of interest.},
  langid = {english},
  annotation = {abstractTranslation:  線形回帰において、LASSOが相関のある予測変数のグループを識別できないことが、大きな研究関心を呼んでいる。最近、LASSOで使用される\$ell\_1\$正則化に代わるものとして、順序付き重み付き\$ell\_1\$規範(OWL)のインスタンスとして説明できる様々な規範が提案された。OWLは、相関のある変数のグループを識別できるが、グループ内でモデルが一定であることを強制する。  このアーチファクトは、モデル推定に不必要なバイアスを引き起こす。  本論文ではサブモジュラーの視点を取り入れ、OWLが適切に定義されたサブモジュラー関数のLov{\'a}sz拡張として提起できることを示す。劣モジュラーの視点は、OWLの群間定数の振る舞いを説明するだけでなく、代替案も提案する。本論文の主な貢献は平滑化OWL(SOWL)であり、これは新しい規範のファミリーである。   SOWLのアルゴリズム的、理論的特性として、グループの同定、モデルの一貫性などがある。また、SOWLノルムとその近接演算子を計算するアルゴリズムツールを提供し、その計算複雑度\$O(dlog d)\$ は、汎用ソルバーの計算複雑度\$O(d{\textasciicircum}2log d)\$ を大幅に上回る。我々の実験では、SOWLはOWLと比較して、関心のある領域で良好な比較を行った。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\AWBKMH58\\Sankaran et al. - 2017 - Identifying Groups of Strongly Correlated Variable.pdf;C\:\\Users\\furuh\\Zotero\\storage\\DSBZITGZ\\Sankaran et al. - 2017 - Identifying Groups of Strongly Correlated Variable.pdf}
}

@article{santBlockSparseSignalRecovery2022,
  title = {Block-{{Sparse Signal Recovery}} via {{General Total Variation Regularized Sparse Bayesian Learning}}},
  author = {Sant, Aditya and Leinonen, Markus and Rao, Bhaskar D.},
  year = {2022},
  journal = {IEEE Transactions on Signal Processing},
  volume = {70},
  pages = {1056--1071},
  issn = {1053-587X, 1941-0476},
  doi = {10.1109/TSP.2022.3144948},
  urldate = {2023-07-24},
  abstract = {One of the main challenges in block-sparse signal recovery, as encountered in, e.g., multi-antenna mmWave channel models, is block-patterned estimation without knowledge of block sizes and boundaries. We propose a novel Sparse Bayesian Learning (SBL) method for block-sparse signal recovery under unknown block patterns. Contrary to conventional approaches that impose block-promoting regularization on the signal components, we apply two classes of hyperparameter regularizers for the SBL cost function, inspired by total variation (TV) denoising. The first class relies on a conventional TV difference unit and allows performing the SBL inference iteratively through a set of convex optimization problems, enabling a flexible choice of numerical solvers. The second class incorporates a region-aware TV penalty to penalize the signal and zero blocks in a dissimilar manner, enhancing the performance. We derive an alternating optimization algorithm based on expectation-maximization to perform the SBL inference through computationally efficient parallel updates for both the regularizer classes. The numerical results show that the proposed TV-regularized SBL algorithm is robust to the nature of the block structure and is capable of recovering signals with both block-patterned and isolated components, proving effective for various signal recovery systems. Index terms---Compressed Sensing, Block-sparsity, Sparse Bayesian Learning, Total Variation, Expectation-maximization, Majorization-minimization, Cyclic Optimization.},
  langid = {english},
  annotation = {abstractTranslation: たとえば、マルチアンテナmmwaveチャネルモデルで遭遇するように、ブロックスパース信号回復の主な課題の1つは、ブロックサイズと境界の知識なしにブロックパターンの推定です。未知のブロックパターンの下でのブロックスパルス信号回復のための新しいスパースベイジアン学習（SBL）方法を提案します。信号コンポーネントにブロック促進の正規化を課す従来のアプローチとは反対に、SBLコスト関数に2つのクラスのハイパーパラメーターの正統派を適用します。ファーストクラスは、従来のTV差ユニットに依存しており、一連の凸最適化問題を介してSBL推論を繰り返し実行でき、数値ソルバーの柔軟な選択を可能にします。 2番目のクラスには、地域を認識しているテレビペナルティが組み込まれており、信号とゼロブロックを異なる方法でペナルティし、パフォーマンスを向上させます。予想最大化アルゴリズムを導き出し、期待最大化に基づいて、両方の正規者クラスの計算効率的な並列更新を介してSBL推論を実行します。数値結果は、提案されたTV正規化されたSBLアルゴリズムがブロック構造の性質に堅牢であり、ブロックパターンと分離コンポーネントの両方で信号を回復できることを示しており、さまざまな信号回復システムに効果的であることが証明されています。インデックスの用語 - 構成されたセンシング、ブロックスプラシティ、スパースベイジアン学習、全体的な変動、期待最大化、多数化最小化、周期的最適化。},
  file = {C:\Users\furuh\Zotero\storage\AC75D8YZ\Sant et al. - 2022 - Block-Sparse Signal Recovery via General Total Var.pdf}
}

@misc{santGeneralTotalVariation2021,
  title = {General {{Total Variation Regularized Sparse Bayesian Learning}} for {{Robust Block-Sparse Signal Recovery}}},
  author = {Sant, Aditya and Leinonen, Markus and Rao, Bhaskar D.},
  year = {2021},
  month = feb,
  number = {arXiv:2102.06845},
  eprint = {2102.06845},
  primaryclass = {eess},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2102.06845},
  urldate = {2023-07-31},
  abstract = {Block-sparse signal recovery without knowledge of block sizes and boundaries, such as those encountered in multi-antenna mmWave channel models, is a hard problem for compressed sensing (CS) algorithms. We propose a novel Sparse Bayesian Learning (SBL) method for block-sparse recovery based on popular CS based regularizers with the function input variable related to total variation (TV). Contrary to conventional approaches that impose the regularization on the signal components, we regularize the SBL hyperparameters. This iterative TV-regularized SBL algorithm employs a majorization-minimization approach and reduces each iteration to a convex optimization problem, enabling a flexible choice of numerical solvers. The numerical results illustrate that the TV-regularized SBL algorithm is robust to the nature of the block structure and able to recover signals with both block-patterned and isolated components, proving useful for various signal recovery systems.},
  archiveprefix = {arXiv},
  keywords = {Electrical Engineering and Systems Science - Signal Processing},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\LFBD4ZJN\\Sant et al. - 2021 - General Total Variation Regularized Sparse Bayesia.pdf;C\:\\Users\\furuh\\Zotero\\storage\\EVCDIEBY\\2102.html}
}

