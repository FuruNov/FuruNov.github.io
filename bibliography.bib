@article{fengHyperspectralAnomalyDetection2023,
  title = {Hyperspectral {{Anomaly Detection Based}} on {{Tensor Ring Decomposition With Factors TV Regularization}}},
  author = {Feng, Maoyuan and Chen, Wendong and Yang, Yunxiu and Shu, Qin and Li, Hongxin and Huang, Yanqin},
  year = {2023},
  journal = {IEEE Transactions on Geoscience and Remote Sensing},
  volume = {61},
  pages = {1--14},
  issn = {1558-0644},
  doi = {10.1109/TGRS.2023.3274661},
  urldate = {2024-12-05},
  abstract = {Anomaly detection in the hyperspectral image (HSI) has gradually become a hot topic in remote sensing. Recently, some tensor-based methods have been proposed to improve detection performance by exploiting the characteristic of HSI data existing in the inherent multidimensional. However, the existing tensor-based methods may only partially use the prior properties in both spatial and spectral dimensions. In this article, we proposed a novel tensor ring (TR) decomposition with factors total variation (TV) regularization model for hyperspectral anomaly detection (TRDFTVAD). First, raw HSI data are decomposed into background and anomaly tensors. The TR decomposition is adopted to exploit the low-rank property of the background existing in both spatial and spectral dimensions. Then, the TV regularization is designed on the three dimensions of the background tensor to explore the piecewise smoothness of the background existing in both spatial and spectral dimensions. Further, this TV regularization is transferred to each factor tensor by exploiting the relationship between the background tensor and each factor tensor. Next, the l\textsubscript{2,1} norm regularization is designed on the anomaly tensor to exploit the group sparsity of anomaly pixels. Finally, the alternating direction method of multipliers (ADMM) scheme is adopted to update the involved variables. Experimental results validated on several real hyperspectral datasets demonstrate the effectiveness of the proposed algorithm.},
  langid = {american},
  keywords = {Anomaly detection,Convex functions,Hyperspectral anomaly detection,Hyperspectral imaging,low-rank tensor,Matrix decomposition,Sparse matrices,tensor ring (TR) decomposition,Tensors,total variation (TV) regularization,TV},
  annotation = {abstractTranslation: ハイパースペクトル画像(HSI)における異常検出はリモートセンシングにおいて徐々にホットなトピックとなってきている。近年、多次元に存在するHSIデータの特性を利用することで、検出性能を向上させるテンソルベースの手法がいくつか提案されている。しかし、既存のテンソルベース手法は、空間次元とスペクトル次元の両方の事前特性を部分的にしか利用していない可能性がある。本論文では、ハイパースペクトル異常検出のための、全変動（TV）正則化モデルを用いた新しいテンソルリング（TR）分解（TRDFTVAD）を提案する。まず、生のHSIデータを背景テンソルと異常テンソルに分解する。TR分解は、空間次元とスペクトル次元の両方に存在する背景の低ランク特性を利用するために採用される。次に、TV正則化を背景テンソルの3次元上で設計し、空間次元とスペクトル次元の両方に存在する背景の区分的平滑性を探索する。さらに、このTV正則化は、背景テンソルと各因子テンソルの間の関係を利用することにより、各因子テンソルに転送される。次に、l\textsubscript{2,1}ノルム正則化を異常テンソル上で設計し、異常ピクセルのグループスパース性を利用する。最後に、交互方向乗法(ADMM)スキームを採用し、関係する変数を更新する。いくつかの実際のハイパースペクトルデータセットを用いて検証した実験結果は、提案アルゴリズムの有効性を実証している。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\WH6ATPTV\\Feng et al. - 2023 - Hyperspectral Anomaly Detection Based on Tensor Ring Decomposition With Factors TV Regularization.pdf;C\:\\Users\\furuh\\Zotero\\storage\\GP85SPPK\\10122663.html}
}

@misc{fengHyperspectralUnmixingBased2022,
  title = {Hyperspectral {{Unmixing Based}} on {{Nonnegative Matrix Factorization}}: {{A Comprehensive Review}}},
  shorttitle = {Hyperspectral {{Unmixing Based}} on {{Nonnegative Matrix Factorization}}},
  author = {Feng, Xin-Ru and Li, Heng-Chao and Wang, Rui and Du, Qian and Jia, Xiuping and Plaza, Antonio},
  year = {2022},
  month = may,
  number = {arXiv:2205.09933},
  eprint = {2205.09933},
  primaryclass = {cs, eess},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2205.09933},
  urldate = {2024-08-29},
  abstract = {Hyperspectral unmixing has been an important technique that estimates a set of endmembers and their corresponding abundances from a hyperspectral image (HSI). Nonnegative matrix factorization (NMF) plays an increasingly significant role in solving this problem. In this article, we present a comprehensive survey of the NMF-based methods proposed for hyperspectral unmixing. Taking the NMF model as a baseline, we show how to improve NMF by utilizing the main properties of HSIs (e.g., spectral, spatial, and structural information). We categorize three important development directions including constrained NMF, structured NMF, and generalized NMF. Furthermore, several experiments are conducted to illustrate the effectiveness of associated algorithms. Finally, we conclude the article with possible future directions with the purposes of providing guidelines and inspiration to promote the development of hyperspectral unmixing.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Computer Vision and Pattern Recognition,Electrical Engineering and Systems Science - Image and Video Processing},
  annotation = {abstractTranslation: ハイパースペクトルアンミキシングは、ハイパースペクトル画像(HSI)からエンドメンバーの集合とそれに対応する存在量を推定する重要な技術である。非負行列分解（NMF）はこの問題を解決する上でますます重要な役割を果たしている。本稿では、ハイパースペクトルのアンミキシングのために提案されているNMFに基づく手法の包括的なサーベイを行う。NMFモデルをベースラインとして、HSIの主な特性（スペクトル、空間、構造情報など）を利用してNMFを改善する方法を示す。我々は、制約付きNMF、構造化NMF、一般化NMFを含む3つの重要な開発方向を分類する。さらに、関連アルゴリズムの有効性を示すために、いくつかの実験を行った。最後に、ハイパースペクトル・アンミキシングの開発を促進するためのガイドラインとインスピレーションを提供することを目的として、将来可能な方向性について本稿を締めくくる。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\NSBEZF94\\Feng et al. - 2022 - Hyperspectral Unmixing Based on Nonnegative Matrix Factorization A Comprehensive Review.pdf;C\:\\Users\\furuh\\Zotero\\storage\\DQGXGYNU\\2205.html}
}

@inproceedings{fengLatentFusedLasso2020,
  title = {Latent {{Fused Lasso}}},
  booktitle = {{{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}}},
  author = {Feng, Yining and Selesnick, Ivan},
  year = {2020},
  month = may,
  pages = {5969--5973},
