  urldate = {2025-03-13},
  abstract = {Tucker decomposition has shown advantages in simultaneously extracting group shared and individual features for studying brain function from multi-subject fMRI data. However, Tucker decomposition of complex-valued fMRI data is challenging, since the data are highly noisy, and imposing sparsity constraints on spatial maps, previously used for denoising magnitude-only fMRI data, may remove signal voxels with low amplitudes. Here we propose a new complex-valued low-rank Tucker decomposition (clrTKD) method to extract principal group and individual components from multi-subject fMRI data, and to denoise spatial components based on the small phase change property at a post-processing stage. We derive the update rules using the alternating direction method of multipliers. Simulated and experimental complex-valued fMRI data are used to evaluate the proposed clrTKD method. Results show that the proposed method can extract more contiguous and vital brain activations such as the anterior cingulate cortex region, compared to Tucker decomposition for magnitude-only fMRI data.},
  langid = {english},
  keywords = {complex-valued fMRI data,Data mining,Data models,Feature extraction,Functional magnetic resonance imaging,low-rank constraint,Mental disorders,Noise measurement,Noise reduction,phase denoising,Signal processing,Signal processing algorithms,Speech processing,Tucker decomposition},
  annotation = {abstractTranslation: タッカー分解は、マルチサブジェクトFMRIデータから脳機能を研究するためのグループの共有機能と個々の機能を同時に抽出することに利点を示しています。ただし、データは非常に騒がしく、以前はマグニチュードのみのfMRIデータを除去するために使用されていた空間マップにスパース性の制約を課すため、複雑なfMRIデータのタッカー分解は困難です。ここでは、マルチサブジェクトFMRIデータから主要なグループと個々のコンポーネントを抽出し、後処理段階での小さな相変化特性に基づく空間コンポーネントを除いて、新しい複雑な低ランクタッカー分解（CLRTKD）メソッドを提案します。乗数の交互方向方法を使用して、更新ルールを導き出します。シミュレートされた実験的な複雑な値のfMRIデータを使用して、提案されたCLRTKDメソッドを評価します。結果は、提案された方法が、マグニチュードのみのfMRIデータのタッカー分解と比較して、前帯状皮質領域などのより隣接する重要な脳の活性化を抽出できることを示しています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\T8TTJ5H9\\Zhao et al. - 2025 - Low-Rank Tucker Decomposition of Multi-Subject Complex-Valued fMRI Data.pdf;C\:\\Users\\furuh\\Zotero\\storage\\JSLGFYHT\\10890084.html}
}

