  journal = {IEEE Transactions on Neural Networks and Learning Systems},
  volume = {34},
  number = {10},
  pages = {7946--7955},
  issn = {2162-237X, 2162-2388},
  doi = {10.1109/TNNLS.2022.3147269},
  urldate = {2023-10-22},
  abstract = {Channel pruning has been long studied to compress convolutional neural networks (CNNs), which significantly reduces the overall computation. Prior works implement channel pruning in an unexplainable manner, which tends to reduce the final classification errors while failing to consider the internal influence of each channel. In this article, we conduct channel pruning in a white box. Through deep visualization of feature maps activated by different channels, we observe that different channels have a varying contribution to different categories in image classification. Inspired by this, we choose to preserve channels contributing to most categories. Specifically, to model the contribution of each channel to differentiating categories, we develop a class-wise mask for each channel, implemented in a dynamic training manner with respect to the input image's category. On the basis of the learned class-wise mask, we perform a global voting mechanism to remove channels with less category discrimination. Lastly, a fine-tuning process is conducted to recover the performance of the pruned model. To our best knowledge, it is the first time that CNN interpretability theory is considered to guide channel pruning. Extensive experiments on representative image classification tasks demonstrate the superiority of our White-Box over many state-of-the-arts (SOTAs). For instance, on CIFAR-10, it reduces 65.23\% floating point operations per seconds (FLOPs) with even 0.62\% accuracy improvement for ResNet-110. On ILSVRC-2012, White-Box achieves a 45.6\% FLOP reduction with only a small loss of 0.83\% in the top-1 accuracy for ResNet-50. Code is available at https://github.com/zyxxmu/White-Box.},
  file = {C:\Users\furuh\Zotero\storage\HKEXFZGR\Zhang et al. - 2023 - Carrying Out CNN Channel Pruning in a White Box.pdf}
}

@inproceedings{zhangCertifiedUnlearningDeep2024,
  title = {Towards Certified Unlearning for Deep Neural Networks},
  booktitle = {Proceedings of the 41st {{International Conference}} on {{Machine Learning}}},
  author = {Zhang, Binchi and Dong, Yushun and Wang, Tianhao and Li, Jundong},
  year = {2024},
  month = jul,
  series = {{{ICML}}'24},
  volume = {235},
  pages = {58800--58818},
  publisher = {JMLR.org},
  address = {Vienna, Austria},
  urldate = {2025-02-08},
  abstract = {In the field of machine unlearning, certified unlearning has been extensively studied in convex machine learning models due to its high efficiency and strong theoretical guarantees. However, its application to deep neural networks (DNNs), known for their highly nonconvex nature, still poses challenges. To bridge the gap between certified unlearning and DNNs, we propose several simple techniques to extend certified unlearning methods to nonconvex objectives. To reduce the time complexity, we develop an efficient computation method by inverse Hessian approximation without compromising certification guarantees. In addition, we extend our discussion of certification to nonconvergence training and sequential unlearning, considering that real-world users can send unlearning requests at different time points. Extensive experiments on three real-world datasets demonstrate the efficacy of our method and the advantages of certified unlearning in DNNs.},
  langid = {english},
  annotation = {abstractTranslation: マシンの学習の分野では、認定された非学習は、その高効率と強力な理論的保証のために、凸の機械学習モデルで広く研究されています。ただし、その高度に凸性の性質で知られる深いニューラルネットワーク（DNNS）への応用は、依然として課題をもたらします。認定された未学習とDNNSの間のギャップを埋めるために、認定された未学習の方法を非コンベックス目標に拡張するためのいくつかの簡単な手法を提案します。時間の複雑さを短縮するために、認証保証を損なうことなく、ヘシアン近似により効率的な計算方法を開発します。さらに、現実世界のユーザーが異なる時点で未学習のリクエストを送信できることを考慮して、認定の議論を非コンバージェンストレーニングと連続した順位の低い未学習に拡張します。 3つの現実世界のデータセットでの広範な実験は、DNNSでの認定された未学習の方法の有効性と利点を示しています。},
  file = {C:\Users\furuh\Zotero\storage\ZWIUIZSN\Zhang et al. - 2024 - Towards certified unlearning for deep neural networks.pdf}
}

