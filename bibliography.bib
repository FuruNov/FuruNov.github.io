@article{yangMultiviewClusteringSurvey2018,
  title = {Multi-View Clustering: {{A}} Survey},
  shorttitle = {Multi-View Clustering},
  author = {Yang, Yan and Wang, Hao},
  year = {2018},
  month = jun,
  journal = {Big Data Mining and Analytics},
  volume = {1},
  number = {2},
  pages = {83--107},
  issn = {2097-406X},
  doi = {10.26599/BDMA.2018.9020003},
  urldate = {2024-09-08},
  abstract = {In the big data era, the data are generated from different sources or observed from different views. These data are referred to as multi-view data. Unleashing the power of knowledge in multi-view data is very important in big data mining and analysis. This calls for advanced techniques that consider the diversity of different views, while fusing these data. Multi-view Clustering (MvC) has attracted increasing attention in recent years by aiming to exploit complementary and consensus information across multiple views. This paper summarizes a large number of multi-view clustering algorithms, provides a taxonomy according to the mechanisms and principles involved, and classifies these algorithms into five categories, namely, co-training style algorithms, multi-kernel learning, multi-view graph clustering, multi-view subspace clustering, and multi-task multi-view clustering. Therein, multi-view graph clustering is further categorized as graph-based, network-based, and spectral-based methods. Multi-view subspace clustering is further divided into subspace learning-based, and non-negative matrix factorization-based methods. This paper does not only introduce the mechanisms for each category of methods, but also gives a few examples for how these techniques are used. In addition, it lists some publically available multi-view datasets. Overall, this paper serves as an introductory text and survey for multi-view clustering.},
  langid = {english},
  keywords = {Big Data,Clustering algorithms,co-training,Data mining,Error analysis,graph clustering,Knowledge discovery,Mixture models,multi-kernel learning,multi-task learning,multi-view clustering,non-negative matrix factorization,subspace clustering,subspace learning,Task analysis},
  annotation = {abstractTranslation: ビッグデータ時代には、データは異なるソースから生成されたり、異なる視点から観察されたりする。これらのデータはマルチビューデータと呼ばれる。ビッグデータのマイニングと分析において、マルチビューデータの知識の力を引き出すことは非常に重要である。このため、これらのデータを融合させながら、異なるビューの多様性を考慮する高度な技術が必要となる。マルチビュークラスタリング(MvC)は、複数のビューにまたがる相補的でコンセンサスな情報を利用することを目的として、近年注目が高まっている。本論文では、多くのマルチビュークラスタリングアルゴリズムを要約し、そのメカニズムや原理による分類法を提供し、これらのアルゴリズムを5つのカテゴリ、すなわち、協調学習型アルゴリズム、マルチカーネル学習、マルチビューグラフクラスタリング、マルチビュー部分空間クラスタリング、マルチタスクマルチビュークラスタリングに分類する。その中で、マルチビューグラフクラスタリングは、さらにグラフベース、ネットワークベース、スペクトルベースの手法に分類される。マルチビュー部分空間クラスタリングは、さらに部分空間学習ベースの手法と非負行列分解ベースの手法に分類される。本稿では、各カテゴリの手法のメカニズムを紹介するだけでなく、これらの手法がどのように利用されているか、いくつかの例を示す。さらに、公開されているマルチビューデータセットのリストも示す。全体として、本稿はマルチビュークラスタリングの入門書であり、サーベイである。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\RBEHMQUF\\Yang と Wang - 2018 - Multi-view clustering A survey.pdf;C\:\\Users\\furuh\\Zotero\\storage\\CYYUR4H4\\8336846.html}
}

@article{yangOnlineLearningGroup,
  title = {Online {{Learning}} for {{Group Lasso}}},
  author = {Yang, Haiqin and Xu, Zenglin and King, Irwin and Lyu, Michael R},
  abstract = {We develop a novel online learning algorithm for the group lasso in order to efficiently find the important explanatory factors in a grouped manner. Different from traditional batch-mode group lasso algorithms, which suffer from the inefficiency and poor scalability, our proposed algorithm performs in an online mode and scales well: at each iteration one can update the weight vector according to a closed-form solution based on the average of previous subgradients. Therefore, the proposed online algorithm can be very efficient and scalable. This is guaranteed by its low worst-case time complexity and memory cost both in the order of O(d), where d is the number of dimensions. Moreover, in order to achieve more sparsity in both the group level and the individual feature level, we successively extend our online system to efficiently solve a number of variants of sparse group lasso models. We also show that the online system is applicable to other group lasso models, such as the group lasso with overlap and graph lasso. Finally, we demonstrate the merits of our algorithm by experimenting with both synthetic and real-world datasets.},
  langid = {english},
  keywords = {No DOI found},
  annotation = {abstractTranslation: 新規なオンライン学習アルゴリズムを開発し、グループ単位で重要な説明変数を効率的に発見するための群lassoを実装する。従来のバッチモード群lassoアルゴリズムは非効率性とスケーラビリティの低さに悩まされるのに対し、提案アルゴリズムはオンラインモードで動作し、高いスケーラビリティを持つ。各イテレーションにおいて、過去の劣勾配の平均に基づく閉形式解に従って重みベクトルを更新できる。したがって、提案されたオンラインアルゴリズムは非常に効率的かつスケーラブルである。これは、最悪の場合の時間計算量とメモリコストがともにO(d)（dは次元数）のオーダーであることによって保証される。さらに、グループレベルと個々の特徴量レベルの両方で、より高いスパース性を達成するために、オンラインシステムを拡張し、スパース群lassoモデルのいくつかのバリエーションを効率的に解決する。また、このオンラインシステムは、オーバーラップのある群lassoやグラフlassoなど、他の群lassoモデルにも適用可能であることを示す。最後に、合成データセットと実世界のデータセットの両方を用いた実験により、提案アルゴリズムの利点を実証する。},
  file = {C:\Users\furuh\Zotero\storage\JSMYE8TK\Yang et al. - Online Learning for Group Lasso.pdf}
}

@inproceedings{yangProvableDefenseGeometric2022,
