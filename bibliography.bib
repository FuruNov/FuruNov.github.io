}

@inproceedings{khanduriLinearlyConstrainedBilevel2023,
  title = {Linearly {{Constrained Bilevel Optimization}}: {{A Smoothed Implicit Gradient Approach}}},
  shorttitle = {Linearly {{Constrained Bilevel Optimization}}},
  booktitle = {Proceedings of the 40th {{International Conference}} on {{Machine Learning}}},
  author = {Khanduri, Prashant and Tsaknakis, Ioannis and Zhang, Yihua and Liu, Jia and Liu, Sijia and Zhang, Jiawei and Hong, Mingyi},
  year = {2023},
  month = jul,
  pages = {16291--16325},
  publisher = {PMLR},
  issn = {2640-3498},
  urldate = {2025-02-11},
  abstract = {This work develops analysis and algorithms for solving a class of bilevel optimization problems where the lower-level (LL) problems have linear constraints. Most of the existing approaches for constrained bilevel problems rely on value function-based approximate reformulations, which suffer from issues such as non-convex and non-differentiable constraints. In contrast, in this work, we develop an implicit gradient-based approach, which is easy to implement, and is suitable for machine learning applications. We first provide an in-depth understanding of the problem, by showing that the implicit objective for such problems is in general non-differentiable. However, if we add some small (linear) perturbation to the LL objective, the resulting implicit objective becomes differentiable almost surely. This key observation opens the door for developing (deterministic and stochastic) gradient-based algorithms similar to the state-of-the-art ones for unconstrained bi-level problems. We show that when the implicit function is assumed to be strongly-convex, convex, and weakly-convex, the resulting algorithms converge with guaranteed rate. Finally, we experimentally corroborate the theoretical findings and evaluate the performance of the proposed framework on numerical and adversarial learning problems.},
  langid = {english},
  annotation = {abstractTranslation: この作業は、低レベル（LL）の問題に線形制約があるバイレベル最適化問題のクラスを解くための分析とアルゴリズムを開発します。制約されたバイレベルの問題に対する既存のアプローチのほとんどは、価値関数ベースのおおよその再定式化に依存しており、これは非凸や非差性の制約などの問題に悩まされています。対照的に、この作業では、実装が簡単で、機械学習アプリケーションに適した暗黙の勾配ベースのアプローチを開発します。最初に、このような問題に対する暗黙の目的は一般に非差性であることを示すことにより、問題の詳細な理解を提供します。ただし、LL目的に小さな（線形）摂動を追加すると、結果として生じる暗黙的な目的はほぼ確実に微分可能になります。この重要な観察結果は、制約のないBIレベルの問題の最先端のアルゴリズムと同様の（決定論的および確率的）勾配ベースのアルゴリズムを開発するための扉を開きます。暗黙の関数が強く凸型、凸状で、弱く凸であると想定される場合、結果のアルゴリズムが保証された速度と収束することを示します。最後に、実験的に理論的発見を裏付け、数値学習および敵対的な学習問題に関する提案されたフレームワークのパフォーマンスを評価します。},
  file = {C:\Users\furuh\Zotero\storage\62375RE6\Khanduri et al. - 2023 - Linearly Constrained Bilevel Optimization A Smoothed Implicit Gradient Approach.pdf}
}

@inproceedings{khavariLowerUpperBounds2021,
  title = {Lower and {{Upper Bounds}} on the {{Pseudo-Dimension}} of {{Tensor Network Models}}},
  booktitle = {Neural {{Information Processing Systems}}},
  author = {Khavari, Behnoush and Rabusseau, Guillaume},
  year = {2021},
  urldate = {2023-11-24},
  abstract = {Tensor network (TN) methods have been a key ingredient of advances in condensed matter physics and have recently sparked interest in the machine learning community for their ability to compactly represent very high-dimensional objects. TN methods can for example be used to efficiently learn linear models in exponentially large feature spaces [56]. In this work, we derive upper and lower bounds on the VC-dimension and pseudo-dimension of a large class of TN models for classification, regression and completion. Our upper bounds hold for linear models parameterized by arbitrary TN structures, and we derive lower bounds for common tensor decomposition models (CP, Tensor Train, Tensor Ring and Tucker) showing the tightness of our general upper bound. These results are used to derive a generalization bound which can be applied to classification with low-rank matrices as well as linear classifiers based on any of the commonly used tensor decomposition models. As a corollary of our results, we obtain a bound on the VC-dimension of the matrix product state classifier introduced in [56] as a function of the so-called bond dimension (i.e. tensor train rank), which answers an open problem listed by Cirac, Garre-Rubio and P{\'e}rez-Garc{\'i}a in [13].},
  keywords = {No DOI found}
}

