  issn = {0196-5204},
  doi = {10.1137/0912058},
  urldate = {2025-01-28},
  abstract = {We extend the Golub--Kahan algorithm for computing the singular value decomposition of bidiagonal matrices to triangular matrices R. Our algorithm avoids the explicit formation of RTR or RRT.We derive a relation between left and right singular vectors of triangular matrices and use it to prove monotonic convergence of singular values and singular vectors. The convergence rate for singular values equals the square of the convergence rate for singular vectors. The convergence behaviour explains the occurrence of deflation in the interior of the matrix.We analyse the relationship between our algorithm and rank-revealing QR and URV decompositions. As a consequence, we obtain an algorithm for computing the URV decomposition, as well as a divide-and-conquer algorithm that computes singular values of dense matrices and may be beneficial on a parallel architecture. Our perturbation result for the smallest singular values of a triangular matrix is stronger than the traditional results because it guarantees high relative accuracy in the smallest singular values after an off -diagonal block of the matrix has been set to zero.},
  langid = {english},
  annotation = {abstractTranslation: golub -- kahanアルゴリズムを拡張して、双方のマトリックスの単数形分解を三角マトリックスRに計算するためにRTRまたはRRTの明示的な形成を回避します。三角マトリックスの左と右の特異ベクトル間の関係を導き出し、それを使用して使用します。特異値と特異ベクトルの単調な収束。特異値の収束率は、特異ベクターの収束速度の平方に等しくなります。収束の動作は、マトリックスの内部におけるデフレの発生を説明します。アルゴリズムとランクを生むQRとURV分解の関係を分析します。結果として、URV分解を計算するためのアルゴリズムと、密なマトリックスの特異な値を計算し、並列アーキテクチャで有益である可能性のある分割統合アルゴリズムを取得します。三角形マトリックスの最小の特異値に対する摂動結果は、マトリックスのオフ角ブロックがゼロに設定された後、最小の特異値で高い相対精度を保証するため、従来の結果よりも強いです。},
  file = {C:\Users\furuh\Zotero\storage\TRYJMNLK\Pan と Schreiber - 1991 - An Improved Newton Iteration for the Generalized Inverse of a Matrix, with Applications.pdf}
}

@article{panMovingForceIdentification2021,
  title = {Moving Force Identification Based on Sparse Regularization Combined with Moving Average Constraint},
  author = {Pan, Chudong and Huang, Zhenjie and You, Junda and Li, Yisha and Yang, Lihua},
  year = {2021},
  month = dec,
  journal = {Journal of Sound and Vibration},
  volume = {515},
  pages = {116496},
  issn = {0022460X},
  doi = {10.1016/j.jsv.2021.116496},
  urldate = {2024-12-09},
  abstract = {An accurate input-output mathematical model is the basis of moving force identification (MFI). However, an absolutely accurate mathematical model between moving forces and structural responses is difficult to be established due to some practical reasons, such as calibration error, modelling error, and so on. An inaccurate input-output relationship may lead to some unreasonable MFI results, for example, an obvious fluctuation of the trend lines in moving forces. To tackle this problem, a constrained sparse regularization-based method is proposed for MFI in this study. Wherein, structural responses obtained from sensors with calibration errors are taken as the inputs. A system matrix reflecting the input-output relationship is formulated in the consideration of unknown moving forces and initial conditions. Sparse regularization is adopted for ensuring that the identified forces are sparse and robust. The constrained condition is expressed as a non-negative function. This function is defined via a strategy named moving average and applied for reflecting the degree of fluctuation of the trend lines for the moving forces. The constrained problem is solved as a standard form of l1-norm regularization via relaxing the constrained condition appropriately. Numerical simulations and experimental studies are conducted for assessing the effectiveness and feasibility of the proposed method. Effects of different calibration errors of sensors are discussed in detail. Illustrated results show that the proposed method can reconstruct the moving forces with a good performance. Some related issues are discussed as well.},
  langid = {english},
  annotation = {abstractTranslation: 正確な入出力数理モデルは、ムービングフォース同定（MFI）の基礎である。しかし、校正誤差やモデル化誤差などの現実的な理由により、移動力と構造応答の間に絶対的に正確な数学モデルを確立することは困難です。不正確な入出力関係は、例えば、移動力の傾向線が明らかに変動するなど、MFIの結果に不合理な結果をもたらす可能性がある。この問題に対処するため、本研究では、MFIのための制約付きスパース正則化ベースの手法を提案する。ここで、校正誤差を持つセンサから得られる構造応答を入力とする。未知の移動力と初期条件を考慮して、入出力関係を反映するシステム行列を定式化する。同定された力がスパースでロバストであることを保証するために、スパース正則化が採用される。制約条件は非負関数として表現される。この関数は移動平均という戦略によって定義され、移動力の傾向線の揺らぎの程度を反映するために適用される。この制約条件はl1-norm正則化の標準的な形式として解かれる。提案手法の有効性と実現可能性を評価するために、数値シミュレーションと実験的研究を行った。センサーの異なる校正誤差の影響についても詳細に議論する。図解された結果は、提案手法が良好な性能で移動力を再構成できることを示している。いくつかの関連する問題についても議論する。},
  file = {C:\Users\furuh\Zotero\storage\J45NR6DD\Pan et al. - 2021 - Moving force identification based on sparse regularization combined with moving average constraint.pdf}
}

