  abstract = {We present Clifford-Steerable Convolutional Neural Networks (CS-CNNs), a novel class of \${\textbackslash}mathrm\{E\}(p, q)\$-equivariant CNNs. CS-CNNs process multivector fields on pseudo-Euclidean spaces \${\textbackslash}mathbb\{R\}{\textasciicircum}\{p,q\}\$. They cover, for instance, \${\textbackslash}mathrm\{E\}(3)\$-equivariance on \${\textbackslash}mathbb\{R\}{\textasciicircum}3\$ and Poincar{\textbackslash}'e-equivariance on Minkowski spacetime \${\textbackslash}mathbb\{R\}{\textasciicircum}\{1,3\}\$. Our approach is based on an implicit parametrization of \${\textbackslash}mathrm\{O\}(p,q)\$-steerable kernels via Clifford group equivariant neural networks. We significantly and consistently outperform baseline methods on fluid dynamics as well as relativistic electrodynamics forecasting tasks.},
