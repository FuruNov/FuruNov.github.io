@inproceedings{sahOnlineLearningNonconvex2025,
  title = {Online {{Learning With Non-convex Losses}}: {{New Condition To Achieve Small Dynamic Regret}}},
  shorttitle = {Online {{Learning With Non-convex Losses}}},
  booktitle = {{{ICASSP}} 2025 - 2025 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {Sah, Sumit and Bharath, B. N.},
  year = {2025},
  month = apr,
  pages = {1--5},
  issn = {2379-190X},
  doi = {10.1109/ICASSP49660.2025.10889663},
  urldate = {2025-03-15},
  abstract = {In this paper, we consider the challenging problem of online learning with non-convex time varying objectives/loss functions. We show that a simple Online gradient descent (OGD) algorithm achieves a dynamic regret comparable to the strongly convex setting provided a new condition that we propose is satisfied within a ball centered at the initialization and radius {$\rho$}. Our condition depends on gradients, loss functions, {$\rho$}, and the variation that measures the rate at which the function changes over time thereby capturing the online nature of the problem. Assuming that the condition is satisfied, we show that OGD achieves a dynamic regret that scales linearly with the variation. We corroborate our theoretical findings through experiments.},
  langid = {english},
  keywords = {Acoustics,Heuristic algorithms,Loss measurement,non-convex optimization,Online learning,Optimization,regret,Signal processing,Signal processing algorithms,Speech processing,Time measurement},
  annotation = {abstractTranslation: このホワイトペーパーでは、非凸の時間を変える目的/損失関数を持つオンライン学習の挑戦的な問題を検討します。単純なオンライン勾配降下（OGD）アルゴリズムが、初期化と半径{$\rho$}に焦点を合わせたボール内で満たされる新しい条件を提供する強力な凸状の設定に匹敵する動的な後悔を達成することを示します。私たちの状態は、勾配、損失関数、{$\rho$}、および関数が時間の経過とともに変化する速度を測定する変動に依存し、それによって問題のオンライン性を捉えています。条件が満たされていると仮定すると、OGDがバリエーションで直線的に拡大する動的な後悔を達成することを示します。実験を通じて理論的な発見を裏付けています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\85EQFQWS\\Sah と Bharath - 2025 - Online Learning With Non-convex Losses New Condition To Achieve Small Dynamic Regret.pdf;C\:\\Users\\furuh\\Zotero\\storage\\ZAF7BUU4\\10889663.html}
}

