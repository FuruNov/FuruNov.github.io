@article{wuHybridTensorDecomposition2020,
  title = {Hybrid {{Tensor Decomposition}} in {{Neural Network Compression}}},
  author = {Wu, Bijiao and Wang, Dingheng and Zhao, Guangshe and Deng, Lei and Li, Guoqi},
  year = {2020},
  month = dec,
  journal = {Neural Networks},
  volume = {132},
  eprint = {2006.15938},
  primaryclass = {cs},
  pages = {309--320},
  issn = {08936080},
  doi = {10.1016/j.neunet.2020.09.006},
  urldate = {2023-10-20},
  abstract = {Deep neural networks (DNNs) have enabled impressive breakthroughs in various artificial intelligence (AI) applications recently due to its capability of learning high-level features from big data. However, the current demand of DNNs for computational resources especially the storage consumption is growing due to that the increasing sizes of models are being required for more and more complicated applications. To address this problem, several tensor decomposition methods including tensor-train (TT) and tensor-ring (TR) have been applied to compress DNNs and shown considerable compression effectiveness. In this work, we introduce the hierarchical Tucker (HT), a classical but rarely-used tensor decomposition method, to investigate its capability in neural network compression. We convert the weight matrices and convolutional kernels to both HT and TT formats for comparative study, since the latter is the most widely used decomposition method and the variant of HT. We further theoretically and experimentally discover that the HT format has better performance on compressing weight matrices, while the TT format is more suited for compressing convolutional kernels. Based on this phenomenon we propose a strategy of hybrid tensor decomposition by combining TT and HT together to compress convolutional and fully connected parts separately and attain better accuracy than only using the TT or HT format on convolutional neural networks (CNNs). Our work illuminates the prospects of hybrid tensor decomposition for neural network compression.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computer Vision and Pattern Recognition},
  annotation = {abstractTranslation:  ディープニューラルネットワーク（DNN）は、ビッグデータから高レベルの特徴を学習する能力を持つため、近年さまざまな人工知能（AI）アプリケーションで目覚ましいブレークスルーを実現している。しかし、DNNの計算資源、特にストレージの消費に対する要求は、より複雑なアプリケーションのために必要とされるモデルのサイズが大きくなっていることに起因して増大している。この問題に対処するために、テンソル-トレイン（TT）やテンソル-リング（TR）を含むいくつかのテンソル分解法がDNNの圧縮に適用され、かなりの圧縮効果を示している。本研究では、古典的なテンソル分解法であるが、ほとんど利用されていない階層的タッカー（HT）を導入し、ニューラルネットワーク圧縮におけるその能力を調査する。後者は最も広く使われている分解手法であり、HTの変形であるため、比較研究のために重み行列と畳み込みカーネルをHTとTTの両方の形式に変換する。TT形式は畳み込みカーネルの圧縮に適している。この現象に基づき、畳み込み部分と完全連結部分を別々に圧縮し、畳み込みニューラルネットワーク（CNN）上でTT形式やHT形式のみを使用するよりも高い精度を達成するために、TT形式とHT形式を組み合わせるハイブリッドテンソル分解の戦略を提案する。我々の研究は、ニューラルネットワーク圧縮のためのハイブリッドテンソル分解の展望を明らかにする。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\WNZNWJWJ\\Wu et al. - 2020 - Hybrid Tensor Decomposition in Neural Network Comp.pdf;C\:\\Users\\furuh\\Zotero\\storage\\P8AHMNB9\\2006.html}
}

@article{wuHyperspectralImageDenoising2022,
  title = {Hyperspectral {{Image Denoising}} via {{Tensor Low-Rank Prior}} and {{Unsupervised Deep Spatial}}--{{Spectral Prior}}},
  author = {Wu, Wei-Hao and Huang, Ting-Zhu and Zhao, Xi-Le and Wang, Jian-Li and Zheng, Yu-Bang},
  year = {2022},
  journal = {IEEE Transactions on Geoscience and Remote Sensing},
  volume = {60},
  pages = {1--14},
  issn = {0196-2892, 1558-0644},
  doi = {10.1109/TGRS.2022.3228927},
  urldate = {2023-12-03},
  abstract = {Hyperspectral image (HSI) denoising is a fundamental task in remote sensing image processing, which is helpful for HSI subsequent applications, such as unmixing and classification. Thanks to the powerful representation ability of untrained deep neural networks (DNNs), deep image prior (DIP)-based methods achieve tremendous successes in image processing (e.g., denoising and inpainting). However, DIP-based methods neglect the tensor low-rank prior of the underlying HSI, which will be beneficial to capture the global structure of the underlying HSI. To address this issue, we propose a novel model for HSI denoising, which can simultaneously take respective advantages of the tensor low-rank prior and the deep spatial--spectral prior. The tensor low-rank prior leads to a better global structure, and the deep spatial--spectral prior is complementary to preserve better local details. On the one hand, we adopt low-rank tensor ring (TR) decomposition to characterize the tensor low-rank prior and capture the global structure of the underlying HSI. On the other hand, we employ untrained DNNs to flexibly represent the deep spatial--spectral prior and capture the local details of the underlying HSI. To solve the proposed model, we develop an efficient alternating minimization algorithm. Experimental results on simulated and real data validate the advantages of the proposed model in HSI denoising. Compared with state-of-the-art HSI denoising methods, the proposed method preserves better local details and the global structure of the underlying HSI.},
  langid = {american},
  annotation = {abstractTranslation: ハイパースペクトル画像（HSI）のノイズ除去は、リモートセンシング画像処理における基本的なタスクであり、アンミキシングや分類などのHSIの後続のアプリケーションに役立ちます。訓練されていない深層ニューラルネットワーク（DNN）の強力な表現能力のおかげで、Deep Image Prior（DIP）に基づく手法は、画像処理（例：ノイズ除去、インペインティング）において大きな成功を収めています。しかし、DIPに基づく手法は、基となるHSIのテンソル低ランク事前知識を無視しており、これは基となるHSIのグローバルな構造を捉えるのに有益です。この問題に対処するため、HSIノイズ除去のための新しいモデルを提案します。このモデルは、テンソル低ランク事前知識と深い空間-スペクトル事前知識のそれぞれの利点を同時に活用できます。テンソル低ランク事前知識は、より優れたグローバル構造につながり、深い空間-スペクトル事前知識は、より優れたローカルディテールを保持するために補完的です。一方では、低ランクテンソルリング（TR）分解を採用して、テンソル低ランク事前知識を特徴づけ、基となるHSIのグローバル構造を捉えます。他方では、訓練されていないDNNを使用して、深い空間-スペクトル事前知識を柔軟に表現し、基となるHSIのローカルディテールを捉えます。提案されたモデルを解くために、効率的な交互最小化アルゴリズムを開発します。シミュレーションデータと実データを用いた実験結果は、HSIノイズ除去における提案されたモデルの利点を検証しています。最先端のHSIノイズ除去手法と比較して、提案された手法は、より優れたローカルディテールと基となるHSIのグローバル構造を保持します。}
}

