  doi = {10.1016/j.acha.2022.05.003},
  urldate = {2025-06-03},
  abstract = {Convex {$\ell$}1 regularization using an infinite dictionary of neurons has been suggested for constructing neural networks with desired approximation guarantees, but can be affected by an arbitrary amount of over-parametrization. This can lead to a loss of sparsity and result in networks with too many active neurons for the given data, in particular if the number of data samples is large. As a remedy, in this paper, a nonconvex regularization method is investigated in the context of shallow ReLU networks: We prove that in contrast to the convex approach, any resulting (locally optimal) network is finite even in the presence of infinite data (i.e., if the data distribution is known and the limiting case of infinite samples is considered). Moreover, we show that approximation guarantees and existing bounds on the network size for finite data are maintained.},
  langid = {english},
  keywords = {Neural network,Non convex,Sparsity},
  annotation = {abstractTranslation: 凸l1正則化は、ニューロンの無限辞書を用いて所望の近似保証を持つニューラルネットワークを構築するために提案されてきたが、任意の過剰パラメータ化の影響を受ける可能性がある。これは、スパース性の喪失につながり、特にデータサンプル数が多い場合、与えられたデータに対してアクティブなニューロンが多すぎるネットワークをもたらす可能性がある。この問題を解決するために、本稿では、浅いReLUネットワークの文脈において、非凸正則化法を検討する。凸的なアプローチとは対照的に、得られる（局所最適）ネットワークは、無限データが存在する場合でも（すなわち、データ分布が既知であり、無限サンプルという極限的な場合を考慮した場合）、有限であることを証明する。さらに、近似保証と有限データに対するネットワークサイズの既存の限界が維持されることを示す。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\TUH8X8RM\\Pieper と Petrosyan - 2022 - Nonconvex regularization for sparse neural networks.pdf;C\:\\Users\\furuh\\Zotero\\storage\\E3KV6ZUX\\S1063520322000434.html}
}

@article{pilanciComplexityClarityAnalytical2024,
  title = {From {{Complexity}} to {{Clarity}}: {{Analytical Expressions}} of {{Deep Neural Network Weights}} via {{Clifford Algebra}} and {{Convexity}}},
  shorttitle = {From {{Complexity}} to {{Clarity}}},
