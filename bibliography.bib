@article{al-shabiliSharpeningSparseRegularizers2021,
  title = {Sharpening {{Sparse Regularizers}} via {{Smoothing}}},
  author = {{Al-Shabili}, Abdullah H. and Feng, Yining and Selesnick, Ivan},
  year = {2021},
  journal = {IEEE Open Journal of Signal Processing},
  volume = {2},
  pages = {396--409},
  issn = {2644-1322},
  doi = {10.1109/OJSP.2021.3104497},
  urldate = {2024-07-26},
  abstract = {Non-convex sparsity-inducing penalties outperform their convex counterparts, but generally sacrifice the cost function convexity. As a middle ground, we propose the sharpening sparse regularizers (SSR) framework to design non-separable non-convex penalties that induce sparsity more effectively than convex penalties such as l1 and nuclear norms, but without sacrificing the cost function convexity. The overall problem convexity is preserved by exploiting the data fidelity relative strong convexity. The framework constructs penalties as the difference of convex functions, namely the difference between convex sparsity-inducing penalties and their smoothed versions. We propose a generalized infimal convolution smoothing technique to obtain the smoothed versions. Furthermore, SSR recovers and generalizes several non-convex penalties in the literature as special cases. The SSR framework is applicable to any sparsity regularized least squares ill-posed linear inverse problem. Beyond regularized least squares, the SSR framework can be extended to accommodate Bregman divergence, and other sparsity structures such as low-rankness. The SSR optimization problem can be formulated as a saddle point problem, and solved by a scalable forward-backward splitting algorithm. The effectiveness of the SSR framework is demonstrated by numerical experiments in different applications.},
  langid = {english},
  keywords = {convex analysis,Convex functions,convex optimization,Convolution,Cost function,Kernel,low-rank,non-convexity,Signal processing algorithms,smoothing,Smoothing methods,Sparse matrices,Sparsity},
  annotation = {abstractTranslation: 非凸のスパースを誘発する罰則は、凸型の対応物よりも優れていますが、一般にコスト関数の凸性を犠牲にします。中間点として、L1や核規範などの凸型のペナルティよりもスパースをより効果的に誘導するが、コスト関数を犠牲にすることなく、恒星をより効果的に誘導する分離不可能な非凸ペナルティを設計するために、シャープニングスパース正規容器（SSR）フレームワークを提案します。全体的な問題の凸性は、データの忠実度が相対的な強い凸性を活用することにより保存されます。このフレームワークは、凸関数の違い、つまり凸のスパース誘発ペナルティとそのスムーズなバージョンの違いとしてペナルティを構築します。スムーズなバージョンを取得するために、一般化されたInfimal Convolution Smoothing手法を提案します。さらに、SSRは、文献のいくつかの非凸の罰則を特別なケースとして回復および一般化します。 SSRフレームワークは、スパースの正規化された最小二乗が不適切な線形逆問題に適用できます。正規化された最小二乗を超えて、SSRフレームワークを拡張して、ブレグマンの発散や低ランクネスなどの他のスパース構造に対応できます。 SSR最適化問題は、サドルポイントの問題として定式化でき、スケーラブルなフォワードバックワード分割アルゴリズムによって解決できます。 SSRフレームワークの有効性は、さまざまなアプリケーションでの数値実験によって実証されています。},
  file = {C:\Users\furuh\Zotero\storage\4LD88P9B\Al-Shabili et al. - 2021 - Sharpening Sparse Regularizers via Smoothing.pdf}
}

@article{alawodeLearningSpatialTemporalRegularized2023,
  title = {Learning {{Spatial-Temporal Regularized Tensor Sparse RPCA}} for {{Background Subtraction}}},
  author = {Alawode, Basit and Javed, Sajid},
  year = {2023},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2309.15576},
  urldate = {2024-08-04},
  abstract = {Video background subtraction is one of the fundamental problems in computer vision that aims to segment all moving objects. Robust principal component analysis has been identified as a promising unsupervised paradigm for background subtraction tasks in the last decade thanks to its competitive performance in a number of benchmark datasets. Tensor robust principal component analysis variations have improved background subtraction performance further. However, because moving object pixels in the sparse component are treated independently and do not have to adhere to spatial-temporal structured-sparsity constraints, performance is reduced for sequences with dynamic backgrounds, camouflaged, and camera jitter problems. In this work, we present a spatial-temporal regularized tensor sparse RPCA algorithm for precise background subtraction. Within the sparse component, we impose spatial-temporal regularizations in the form of normalized graph-Laplacian matrices. To do this, we build two graphs, one across the input tensor spatial locations and the other across its frontal slices in the time domain. While maximizing the objective function, we compel the tensor sparse component to serve as the spatiotemporal eigenvectors of the graph-Laplacian matrices. The disconnected moving object pixels in the sparse component are preserved by the proposed graph-based regularizations since they both comprise of spatiotemporal subspace-based structure. Additionally, we propose a unique objective function that employs batch and online-based optimization methods to jointly maximize the background-foreground and spatial-temporal regularization components. Experiments are performed on six publicly available background subtraction datasets that demonstrate the superior performance of the proposed algorithm compared to several existing methods. Our source code will be available very soon.},
  copyright = {Creative Commons Attribution 4.0 International},
  keywords = {Computer Vision and Pattern Recognition (cs.CV),FOS: Computer and information sciences},
  file = {C:\Users\furuh\Zotero\storage\MVYXTL8H\Alawode and Javed - 2023 - Learning Spatial-Temporal Regularized Tensor Spars.pdf}
}

@article{aliImplementationModifiedUNet2022,
