  month = dec,
  urldate = {2024-12-25},
  abstract = {We present Tensor-GaLore, a novel method for efficient training of neural networks with higher-order tensor weights. Many models, particularly those used in scientific computing and computer vision, employ tensor-parameterized layers to capture complex, high-dimensional relationships. However, these tensor structures lead to significant memory requirements during training. Our method addresses this memory challenge through low-rank subspace optimization using Tucker decomposition, overcoming limitations of previous approaches restricted to matrix-parameterized weights, including those operating on complex-valued data. We showcase its effectiveness on Fourier Neural Operators (FNOs), a class of models crucial for solving partial differential equations. Across various PDE tasks, we achieved performance gains ranging from 11{\textbackslash}\% to 50{\textbackslash}\% better generalization while reducing optimizer memory usage by up to 76{\textbackslash}\%. These consistent improvements, coupled with substantial memory savings across AI for science, demonstrate Tensor-GaLore's potential.},
  langid = {english},
  annotation = {我々は、高次のテンソル重みを持つニューラルネットワークの効率的な学習のための新しい手法であるTensor-GaLoreを発表する。多くのモデル、特に科学計算やコンピュータビジョンで使われるモデルは、複雑で高次元の関係を捉えるためにテンソルパラメータ化された層を採用している。しかし、このようなテンソル構造は、学習時に大きなメモリを必要とする。本手法は、タッカー分解を用いた低ランク部分空間最適化により、このメモリ問題を解決し、行列パラメータ化された重みに限定された従来のアプローチの限界を克服する。偏微分方程式を解くのに重要なモデルのクラスであるFourier Neural Operators (FNOs)での有効性を示す。様々なPDEタスクにおいて、オプティマイザのメモリ使用量を最大76\%削減しながら、11\%から50\%の汎化率向上という性能向上を達成した。このような一貫した改善は、科学のためのAI全体での大幅なメモリ節約と相まって、TensorGaLoreの可能性を示しています。},
  file = {C:\Users\furuh\Zotero\storage\2VFFQ97Z\George et al. - 2024 - Tensor-GaLore Memory-Efficient Training via Gradient Tensor Decomposition.pdf}
}

