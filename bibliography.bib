@inproceedings{schneiderWhatShouldNeuron2024,
  title = {What Should a Neuron Aim for? {{Designing}} Local Objective Functions Based on Information Theory},
  shorttitle = {What Should a Neuron Aim For?},
  booktitle = {The {{Thirteenth International Conference}} on {{Learning Representations}}},
  author = {Schneider, Andreas Christian and Neuhaus, Valentin and Ehrlich, David Alexander and Makkeh, Abdullah and Ecker, Alexander S. and Priesemann, Viola and Wibral, Michael},
  year = {2024},
  month = oct,
  urldate = {2025-04-26},
  abstract = {In modern deep neural networks, the learning dynamics of individual neurons are often obscure, as the networks are trained via global optimization. Conversely, biological systems build on self-organized, local learning, achieving robustness and efficiency with limited global information. Here, we show how self-organization between individual artificial neurons can be achieved by designing abstract bio-inspired local learning goals. These goals are parameterized using a recent extension of information theory, Partial Information Decomposition (PID), which decomposes the information that a set of information sources holds about an outcome into unique, redundant and synergistic contributions. Our framework enables neurons to locally shape the integration of information from various input classes, i.e., feedforward, feedback, and lateral, by selecting which of the three inputs should contribute uniquely, redundantly or synergistically to the output. This selection is expressed as a weighted sum of PID terms, which, for a given problem, can be directly derived from intuitive reasoning or via numerical optimization, offering a window into understanding task-relevant local information processing. Achieving neuron-level interpretability while enabling strong performance using local learning, our work advances a principled information-theoretic foundation for local learning strategies.},
  langid = {english},
  annotation = {abstractTranslation: 現代の深層ニューラルネットワークでは、ネットワークがグローバルな最適化によって学習されるため、個々のニューロンの学習ダイナミクスはしばしば不明瞭である。対照的に、生物学的システムは自己組織化された局所学習に基づいて構築されており、限られたグローバル情報でロバスト性と効率性を実現している。本研究では、抽象的な生物学的インスピレーションに基づいた局所学習目標を設計することで、個々の人工ニューロン間の自己組織化がどのように実現できるかを示す。これらの目標は、情報理論の最近の拡張であるPartial Information Decomposition（PID）を用いてパラメータ化されており、PIDは、情報源の集合がある結果について保持する情報を、固有、冗長、相乗的な寄与に分解する。我々のフレームワークは、ニューロンが、3つの入力のうちどれが固有、冗長、または相乗的に出力に寄与すべきかを選択することで、様々な入力クラス（すなわち、フィードフォワード、フィードバック、および側方）からの情報の統合を局所的に形成することを可能にする。この選択は、PID項の加重和として表現され、特定の課題に対して、直感的な推論または数値最適化によって直接導出することができ、タスクに関連する局所的な情報処理を理解するための窓を提供する。局所学習を用いて強力なパフォーマンスを可能にしながら、ニューロンレベルの解釈可能性を実現することで、我々の研究は、局所学習戦略のための原理的な情報理論的基盤を前進させる。},
  file = {C:\Users\furuh\Zotero\storage\D4JRVG97\Schneider et al. - 2024 - What should a neuron aim for Designing local objective functions based on information theory.pdf}
}

@inproceedings{schugAttentionHypernetwork2024,
  title = {Attention as a {{Hypernetwork}}},
  booktitle = {The {{Thirteenth International Conference}} on {{Learning Representations}}},
  author = {Schug, Simon and Kobayashi, Seijin and Akram, Yassir and Sacramento, Joao and Pascanu, Razvan},
  year = {2024},
  month = oct,
  urldate = {2025-04-26},
  abstract = {Transformers can under some circumstances generalize to novel problem instances whose constituent parts might have been encountered during training, but whose compositions have not. What mechanisms underlie this ability for compositional generalization? By reformulating multi-head attention as a hypernetwork, we reveal that a composable, low-dimensional latent code specifies key-query specific operations. We find empirically that this latent code is predictive of the subtasks the network performs on unseen task compositions, revealing that latent codes acquired during training are reused to solve unseen problem instances. To further examine the hypothesis that the intrinsic hypernetwork of multi-head attention supports compositional generalization, we ablate whether making the hypernetwork-generated linear value network nonlinear strengthens compositionality. We find that this modification improves compositional generalization on abstract reasoning tasks. In particular, we introduce a symbolic version of the Raven's Progressive Matrices human intelligence test, which gives us precise control over the problem compositions encountered during training and evaluation. We demonstrate on this task how scaling model size and data enables compositional generalization in transformers and gives rise to a functionally structured latent space.},
  langid = {english},
  annotation = {abstractTranslation: Transformerは、ある状況下において、訓練中に構成要素が遭遇した可能性はあるものの、その組み合わせが未遭遇である新しい問題事例に対して汎化できる。この構成的汎化能力の根底にあるメカニズムは何なのか？Multi-Head Attentionをハイパーネットワークとして再構成することで、構成可能で低次元の潜在コードが、Key-Queryに特化した演算を指定することを明らかにする。この潜在コードが、ネットワークが未見のタスク構成に対して実行するサブタスクを予測できることを経験的に見出し、訓練中に獲得された潜在コードが、未見の問題事例を解決するために再利用されることを示す。Multi-Head Attentionの固有のハイパーネットワークが構成的汎化をサポートするという仮説をさらに検証するために、ハイパーネットワークによって生成される線形Valueネットワークを非線形化することが、構成性を強化するかどうかを検証する。この変更が抽象的推論タスクにおける構成的汎化を改善することを見出す。特に、Raven's Progressive Matrices（人間の知能テスト）の記号版を導入し、訓練と評価中に遭遇する問題構成を正確に制御できるようにする。このタスクにおいて、モデルサイズとデータのスケーリングが、Transformerにおける構成的汎化を可能にし、機能的に構造化された潜在空間を生み出すことを実証する。},
  file = {C:\Users\furuh\Zotero\storage\NPWXB58N\Schug et al. - 2024 - Attention as a Hypernetwork.pdf}
}

@article{schuurmansHowInformativeApproximation2023,
  title = {How {{Informative}} Is the {{Approximation Error}} from {{Tensor Decomposition}} for {{Neural Network Compression}}?},
  author = {Schuurmans, Jetze T. and Batselier, Kim and Kooij, Julian F. P.},
  year = {2023},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2305.05318},
  urldate = {2023-11-13},
  abstract = {Tensor decompositions have been successfully applied to compress neural networks. The compression algorithms using tensor decompositions commonly minimize the approximation error on the weights. Recent work assumes the approximation error on the weights is a proxy for the performance of the model to compress multiple layers and fine-tune the compressed model. Surprisingly, little research has systematically evaluated which approximation errors can be used to make choices regarding the layer, tensor decomposition method, and level of compression. To close this gap, we perform an experimental study to test if this assumption holds across different layers and types of decompositions, and what the effect of fine-tuning is. We include the approximation error on the features resulting from a compressed layer in our analysis to test if this provides a better proxy, as it explicitly takes the data into account. We find the approximation error on the weights has a positive correlation with the performance error, before as well as after fine-tuning. Basing the approximation error on the features does not improve the correlation significantly. While scaling the approximation error commonly is used to account for the different sizes of layers, the average correlation across layers is smaller than across all choices (i.e. layers, decompositions, and level of compression) before fine-tuning. When calculating the correlation across the different decompositions, the average rank correlation is larger than across all choices. This means multiple decompositions can be considered for compression and the approximation error can be used to choose between them.},
  copyright = {Creative Commons Attribution 4.0 International},
  langid = {american},
  keywords = {FOS: Computer and information sciences,Machine Learning (cs.LG)},
  annotation = {abstractTranslation: テンソル分解は、ニューラルネットワークの圧縮に {\cyrchar\cyru}{\cyrchar\cyrs}{\cyrchar\cyrp}{\cyrchar\cyre}{\cyrchar\cyrsh}{\cyrchar\cyrn}{\cyrchar\cyro}適用されてきた。テンソル分解を用いた圧縮アルゴリズムは、通常、重みに関する近似誤差を最小化する。近年、重みに関する近似誤差が、複数層を圧縮し、圧縮されたモデルを微調整するためのモデル性能の代替指標になると仮定されている。驚くべきことに、どの近似誤差が層、テンソル分解法、および圧縮レベルに関する選択を行うために使用できるかを体系的に評価した研究はほとんどない。このギャップを埋めるために、本研究では、この仮定が異なる層や分解の種類にわたって成り立つかどうか、そして微調整の効果がどうであるかを実験的に検証する。データ明示的に考慮するため、圧縮された層から得られる特徴に関する近似誤差を分析に含め、より優れた代替指標となるかどうかを検証する。重みに関する近似誤差は、微調整の前後を問わず、性能誤差と正の相関があることがわかった。特徴に基づく近似誤差では、相関は大幅に改善されない。近似誤差のスケーリングは、通常、層のサイズの違いを考慮するために使用されるが、層間の平均相関は、微調整前のすべての選択肢（すなわち、層、分解、および圧縮レベル）間の相関よりも小さい。異なる分解間の相関を計算すると、平均ランク相関はすべての選択肢間よりも大きくなる。これは、複数の分解を圧縮の対象として検討でき、近似誤差を用いてそれらを選択できることを意味する。},
  file = {C:\Users\furuh\Zotero\storage\JUPLLLV9\Schuurmans et al. - 2023 - How Informative is the Approximation Error from Te.pdf}
}

@inproceedings{schwarzPowerpropagationSparsityInducing2021,
  title = {Powerpropagation: {{A}} Sparsity Inducing Weight Reparameterisation},
  shorttitle = {Powerpropagation},
  booktitle = {Neural {{Information Processing Systems}}},
  author = {Schwarz, Jonathan and Jayakumar, Siddhant M. and Pascanu, Razvan and Latham, P. and Teh, Y.},
  year = {2021},
  month = oct,
  urldate = {2024-10-13},
  abstract = {The training of sparse neural networks is becoming an increasingly important tool for reducing the computational footprint of models at training and evaluation, as well enabling the effective scaling up of models. Whereas much work over the years has been dedicated to specialised pruning techniques, little attention has been paid to the inherent effect of gradient based training on model sparsity. In this work, we introduce Powerpropagation, a new weight-parameterisation for neural networks that leads to inherently sparse models. Exploiting the behaviour of gradient descent, our method gives rise to weight updates exhibiting a"rich get richer"dynamic, leaving low-magnitude parameters largely unaffected by learning. Models trained in this manner exhibit similar performance, but have a distribution with markedly higher density at zero, allowing more parameters to be pruned safely. Powerpropagation is general, intuitive, cheap and straight-forward to implement and can readily be combined with various other techniques. To highlight its versatility, we explore it in two very different settings: Firstly, following a recent line of work, we investigate its effect on sparse training for resource-constrained settings. Here, we combine Powerpropagation with a traditional weight-pruning technique as well as recent state-of-the-art sparse-to-sparse algorithms, showing superior performance on the ImageNet benchmark. Secondly, we advocate the use of sparsity in overcoming catastrophic forgetting, where compressed representations allow accommodating a large number of tasks at fixed model capacity. In all cases our reparameterisation considerably increases the efficacy of the off-the-shelf methods.},
  langid = {american},
  annotation = {abstractTranslation: スパースニューラルネットワークの学習は、学習と評価におけるモデルの計算量を削減し、モデルの効果的なスケールアップを可能にするために、ますます重要なツールになってきている。長年にわたり、多くの研究が特殊な刈り込み技術に費やされてきたが、勾配ベースの学習がモデルのスパース性に与える固有の影響については、ほとんど注目されてこなかった。本研究では、本質的にスパースなモデルを導くニューラルネットワークの新しい重みパラメータ化であるPowerpropagationを導入する。勾配降下の振る舞いを利用することで、我々の手法は「金持ちほど金持ちになる」ダイナミックを示す重み更新をもたらし、低倍率のパラメータは学習の影響をほとんど受けない。この方法で学習されたモデルは同様の性能を示すが、ゼロの密度が著しく高い分布を持つため、より多くのパラメータを安全に刈り込むことができる。Powerpropagationは一般的で直感的、安価で実装が簡単であり、他の様々な手法と容易に組み合わせることができる。その汎用性を強調するために、2つの異なる設定でパワー・プロパゲーションを検証する：1つ目は、最近の研究成果に従って、リソースに制約のある設定におけるスパース学習への効果を調べる。ここでは、Powerpropagationを伝統的なウェイト刈り込み手法や最新のスパース間アルゴリズムと組み合わせ、ImageNetベンチマークで優れた性能を示した。第二に、圧縮された表現が一定のモデル容量で多数のタスクに対応することを可能にする、壊滅的な忘却を克服するためのスパース性の利用を提唱する。全ての場合において、我々の再パラメータ化は、既成の手法の有効性を大幅に向上させる。},
  file = {C:\Users\furuh\Zotero\storage\AM5PCCH7\Schwarz et al. - 2021 - Powerpropagation A sparsity inducing weight reparameterisation.pdf}
}

@misc{schwettmannFINDFunctionDescription2023,
  title = {{{FIND}}: {{A Function Description Benchmark}} for {{Evaluating Interpretability Methods}}},
  shorttitle = {{{FIND}}},
  author = {Schwettmann, Sarah and Shaham, Tamar Rott and Materzynska, Joanna and Chowdhury, Neil and Li, Shuang and Andreas, Jacob and Bau, David and Torralba, Antonio},
  year = {2023},
  month = dec,
  number = {arXiv:2309.03886},
  eprint = {2309.03886},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2309.03886},
  urldate = {2024-02-11},
  abstract = {Labeling neural network submodules with human-legible descriptions is useful for many downstream tasks: such descriptions can surface failures, guide interventions, and perhaps even explain important model behaviors. To date, most mechanistic descriptions of trained networks have involved small models, narrowly delimited phenomena, and large amounts of human labor. Labeling all human-interpretable sub-computations in models of increasing size and complexity will almost certainly require tools that can generate and validate descriptions automatically. Recently, techniques that use learned models in-the-loop for labeling have begun to gain traction, but methods for evaluating their efficacy are limited and ad-hoc. How should we validate and compare open-ended labeling tools? This paper introduces FIND (Function INterpretation and Description), a benchmark suite for evaluating the building blocks of automated interpretability methods. FIND contains functions that resemble components of trained neural networks, and accompanying descriptions of the kind we seek to generate. The functions span textual and numeric domains, and involve a range of real-world complexities. We evaluate methods that use pretrained language models (LMs) to produce descriptions of function behavior in natural language and code. Additionally, we introduce a new interactive method in which an Automated Interpretability Agent (AIA) generates function descriptions. We find that an AIA, built from an LM with black-box access to functions, can infer function structure, acting as a scientist by forming hypotheses, proposing experiments, and updating descriptions in light of new data. However, AIA descriptions tend to capture global function behavior and miss local details. These results suggest that FIND will be useful for evaluating more sophisticated interpretability methods before they are applied to real-world models.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computation and Language,Computer Science - Machine Learning}
}

@misc{scienceandtechnology.jpRiziekutohenoNuriLuoDanLunWenwoChusuLi2017,
  title = {リジェクトへの怒り・落胆【論文を出す力】},
  author = {{scienceandtechnology.jp}},
  year = {2017},
  month = feb,
  journal = {日本の科学と技術},
  urldate = {2024-12-08},
  abstract = {論文執筆応援されたんで頑張ります。 pic.twitter.com/6iBnUORmkc --- ひゅうひゅう＠耐性試験株 (@sciencehyuhyu) November 5, 2023 研究者には論文を書く能力が必要ですが、それだけでなく、論文を世に出す(＝アクセプトに漕ぎ着ける）力も必要です。両者は重なる部分もありますが、質的に全く異なります。論文を書くうえで重要なのは知性ですが、論文を出すときに重要なのはリジェクトされたときの落胆、怒り、失望、疑念などの感情をコントロールする力、揺るぎない信念、状況を見極める客観性や判断力です。 リジェクトに対する心構えが出来ているだけで、受けるダメージ及び回復力が変わってくると思いますので、これから論文を出す人の参考になりそうな記事を紹介しようと思い立ちました。また、結果だけを見ると、みんな順調に論文を通しているように思えるかもしれませんが、実際には、他人には想像がつかないような苦労の末になんとかアクセプトまで漕ぎ着けたという場合がほとんどです。そんな論文出版の苦労を分かち合える記事を、以下に紹介します。 目次1 折れない心2 批判を受け止める力3 リジェクトされた時にやるべきこと4 リジェクトという名の授業料5 15回リジェクトされた論文6 リジェクト：苦難の始まり7 アクセプトまでの苦難の道のり8 2年にわたるNatureとの戦い9 論文投稿の苦しみ10 努力と結果11 Shooting for the moon12 味方を得てアクセプト13 自身を客観的に見る14 私はリジェクトが好きだ15 リジェクトするときに使える英語表現16 リジェクトの味17 参考18 同じカテゴリーの記事一覧 折れない心 何年もかけてやってきたプロジェクトの成果が、辛辣なコメントともにリジェクトとなった場合は、自分の研究者としての能力を否定された気分になり、相当なダメージを受けるが、折れないタフな心をもってアクセプトになるまで戦い続けるしかない。　{\dots} 散々追加実験を頑張った上での再投稿にも関わらず、やはりリジェクトとなった場合は時間的にも精神的にも相当ダメージは大きく、また半年〜1年前にもどって別のジャーナルにいちから投稿し直しとなる、、、　(有名ジャーナルに論文が掲載される意義　IMAYOSHI LAB　2013年11月22日) 最近、友人の一人の論文が、Natureにacceptされたのですが、それが実にすさまじい闘いだったのです。彼が最初の論文を書き上げたのが、3年ほど前。まず、Natureに送りました。Editorial kickにはならず、レビューに回りましたが（トップジャーナルでは、レビューに回るだけでも凄いのです）、rejectされました。レビューアーからのコメントがあったため、追加実験を行って全てのコメントに答えた上で再投稿した。しかし、結果はやはりreject。そこで、彼はScienceに投稿しました。Scienceでもレビューに回りましたがreject。これだけでも凄すぎるのに、これからが彼の凄いところでした。Scienceで得たコメントで指摘された点を改善し、なんと再びNatureへ投稿。再びレビューに回るも、reject。再実験を重ねた上、レビューアーのコメントに答えて、Editorへ抗議。その後、結局、acceptされたのです。（Never give up! Alltid Leende April 22nd, 2013） まず青い方からこの表をみる。サイエンスの689というのは、最初の投稿先がサイエンスでそのままサイエンスに採用された論文が689報あるということである。サイエンスに蹴られてnatureに採用されたのが82報あるということ。しかしcell誌にはサイエンスリジェクト論文は一つも載らなかった（natureリジェクト論文も載っていない）。（サイエンスに蹴られた論文がネイチャーに載る・・・ がんの分子腫瘍学・遺伝学 2012年10月22日) ~ 批判を受け止める力 Coping with publication rejection is [{\dots}]},
  langid = {american},
  file = {C:\Users\furuh\Zotero\storage\RN64695H\12354.html}
}

@inproceedings{sculleyHiddenTechnicalDebt2015,
  title = {Hidden {{Technical Debt}} in {{Machine Learning Systems}}},
  booktitle = {Neural {{Information Processing Systems}}},
  author = {Sculley, D. and Holt, Gary and Golovin, D. and Davydov, Eugene and Phillips, Todd and Ebner, D. and Chaudhary, Vinay and Young, Michael and Crespo, Jean-Fran{\c c}ois and Dennison, Dan},
  year = {2015},
  month = dec,
  urldate = {2023-10-12},
  abstract = {Machine learning offers a fantastically powerful toolkit for building useful complex prediction systems quickly. This paper argues it is dangerous to think of these quick wins as coming for free. Using the software engineering framework of technical debt, we find it is common to incur massive ongoing maintenance costs in real-world ML systems. We explore several ML-specific risk factors to account for in system design. These include boundary erosion, entanglement, hidden feedback loops, undeclared consumers, data dependencies, configuration issues, changes in the external world, and a variety of system-level anti-patterns.}
}

@article{seghouaneRBDLRobustBlockStructured2023,
  title = {{{RBDL}}: {{Robust}} Block-{{Structured}} Dictionary Learning for Block Sparse Representation},
  shorttitle = {{{RBDL}}},
  author = {Seghouane, Abd-Krim and Iqbal, Asif and Miri Rekavandi, Aref},
  year = {2023},
  month = aug,
  journal = {Pattern Recognition Letters},
  volume = {172},
  pages = {89--96},
  issn = {0167-8655},
  doi = {10.1016/j.patrec.2023.06.009},
  urldate = {2025-02-09},
  abstract = {Dictionary learning methods have been extensively used in different types of image and signal processing tasks. In a number of applications, the collected data/signal may have a multi-subspace structure and be perturbed with outliers. These motivate the use of robust and block-sparse signal representations. In this paper, a new algorithm for learning a block-structured dictionary in the presence of outliers is proposed. It is based on {$\alpha-$}divergence and has the advantage of tolerating the presence of outliers. A block coordinate descent approach is adopted to obtain simple closed-form solutions for both the sparse coding and dictionary update stages. Finally, experimental results illustrating the superiority of the proposed method over some state-of-the-art dictionary learning methods, are provided.},
