@misc{hashimotoUnificationSymmetriesNeural2024,
  title = {Unification of {{Symmetries Inside Neural Networks}}: {{Transformer}}, {{Feedforward}} and {{Neural ODE}}},
  shorttitle = {Unification of {{Symmetries Inside Neural Networks}}},
  author = {Hashimoto, Koji and Hirono, Yuji and Sannai, Akiyoshi},
  year = {2024},
