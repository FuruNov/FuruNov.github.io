@misc{chandraGradientDescentUltimate2022,
  title = {Gradient {{Descent}}: {{The Ultimate Optimizer}}},
  shorttitle = {Gradient {{Descent}}},
  author = {Chandra, Kartik and Xie, Audrey and {Ragan-Kelley}, Jonathan and Meijer, Erik},
