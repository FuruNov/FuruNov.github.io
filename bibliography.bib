@article{chenScatterbrainUnifyingSparse2021,
  title = {Scatterbrain: {{Unifying Sparse}} and {{Low-rank Attention Approximation}}},
  shorttitle = {Scatterbrain},
  author = {Chen, Beidi and Dao, Tri and Winsor, Eric and Song, Zhao and Rudra, A. and R{\'e}, C.},
  year = {2021},
  month = oct,
  journal = {ArXiv},
  doi = {10.48550/arxiv.2110.15343},
  urldate = {2024-08-03},
  abstract = {Recent advances in efficient Transformers have exploited either the sparsity or low-rank properties of attention matrices to reduce the computational and memory bottlenecks of modeling long sequences. However, it is still challenging to balance the trade-off between model quality and efficiency to perform a one-size-fits-all approximation for different tasks. To better understand this trade-off, we observe that sparse and low-rank approximations excel in different regimes, determined by the softmax temperature in attention, and sparse + low-rank can outperform each individually. Inspired by the classical robust-PCA algorithm for sparse and low-rank decomposition, we propose Scatterbrain, a novel way to unify sparse (via locality sensitive hashing) and low-rank (via kernel feature map) attention for accurate and efficient approximation. The estimation is unbiased with provably low error. We empirically show that Scatterbrain can achieve 2.1x lower error than baselines when serving as a drop-in replacement in BigGAN image generation and pre-trained T2T-ViT. On a pre-trained T2T Vision transformer, even without fine-tuning, Scatterbrain can reduce 98\% of attention memory at the cost of only 1\% drop in accuracy. We demonstrate Scatterbrain for end-to-end training with up to 4 points better perplexity and 5 points better average accuracy than sparse or low-rank efficient transformers on language modeling and long-range-arena tasks.},
  langid = {american},
  annotation = {abstractTranslation: 効率的な変換器における最近の進歩は、注意行列のスパース性または低ランク特性のいずれかを利用し、長いシーケンスをモデル化する際の計算およびメモリのボトルネックを削減している。しかし、様々なタスクに対して一律に近似を行うために、モデルの品質と効率の間のトレードオフのバランスをとることはまだ困難である。このトレードオフをよりよく理解するために、我々は、スパースと低ランクの近似が、注意のソフトマックス温度によって決定される異なる領域で優れており、スパース＋低ランクがそれぞれを上回ることができることを観察する。スパースと低ランクの分解のための古典的なロバストPCAアルゴリズムに触発されて、我々は、正確で効率的な近似のために、スパース（局所性に敏感なハッシュを介して）と低ランク（カーネル特徴マップを介して）注意を統合する新しい方法であるScatterbrainを提案する。推定は不偏であり、証明可能な低誤差である。BigGAN画像生成と事前訓練済みT2T-ViTにおいて、Scatterbrainがドロップイン置き換えとして機能する場合、ベースラインよりも2.1倍低い誤差を達成できることを実証的に示す。事前訓練されたT2T Vision変換器では、微調整なしでも、Scatterbrainは精度を1\%低下させるだけで、アテンションメモリの98\%を削減できる。Scatterbrainは、言語モデリングと長距離アリーナタスクにおいて、スパースまたは低ランクの効率的な変換器と比較して、最大4ポイント優れた当惑度と5ポイント優れた平均精度を持つエンド・ツー・エンド・トレーニングを実証する。},
  file = {C:\Users\furuh\Zotero\storage\4TKTH342\Chen et al. - 2021 - Scatterbrain Unifying Sparse and Low-rank Attenti.pdf}
}

@inproceedings{chenSharingResidualUnits2018,
  title = {Sharing {{Residual Units Through Collective Tensor Factorization To Improve Deep Neural Networks}}},
  booktitle = {Proceedings of the {{Twenty-Seventh International Joint Conference}} on {{Artificial Intelligence}}},
  author = {Chen, Yunpeng and Jin, Xiaojie and Kang, Bingyi and Feng, Jiashi and Yan, Shuicheng},
  year = {2018},
  month = jul,
  pages = {635--641},
  publisher = {International Joint Conferences on Artificial Intelligence Organization},
  address = {Stockholm, Sweden},
  doi = {10.24963/ijcai.2018/88},
  urldate = {2023-10-19},
  abstract = {The residual unit and its variations are wildly used in building very deep neural networks for alleviating optimization difficulty. In this work, we revisit the standard residual function as well as its several successful variants and propose a unified framework based on tensor Block Term Decomposition (BTD) to explain these apparently different residual functions from the tensor decomposition view. With the BTD framework, we further propose a novel basic network architecture, named the Collective Residual Unit (CRU). CRU further enhances parameter efficiency of deep residual neural networks by sharing core factors derived from collective tensor factorization over the involved residual units. It enables efficient knowledge sharing across multiple residual units, reduces the number of model parameters, lowers the risk of over-fitting, and provides better generalization ability. Extensive experimental results show that our proposed CRU network brings outstanding parameter efficiency -- it achieves comparable classification performance with ResNet-200 while using a model size as small as ResNet-50 on the ImageNet-1k and Places365-Standard benchmark datasets.},
  isbn = {978-0-9992411-2-7},
  langid = {english}
}

