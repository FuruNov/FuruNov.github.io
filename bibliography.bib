@inproceedings{hillIllustratedGuideAutomatic2025,
  title = {An {{Illustrated Guide}} to {{Automatic Sparse Differentiation}}},
  booktitle = {The {{Fourth Blogpost Track}} at {{ICLR}} 2025},
  author = {Hill, Adrian and Dalle, Guillaume and Montoison, Alexis},
  year = {2025},
  month = feb,
  urldate = {2025-04-26},
  abstract = {In numerous applications of machine learning, Hessians and Jacobians exhibit sparsity, a property that can be leveraged to vastly accelerate their computation. While the usage of automatic differentiation in machine learning is ubiquitous, automatic sparse differentiation (ASD) remains largely unknown. This post introduces ASD, explaining its key components and their roles in the computation of both sparse Jacobians and Hessians. We conclude with a practical demonstration showcasing the performance benefits of ASD. \_\_\_ First-order optimization is ubiquitous in machine learning (ML) but second-order optimization is much less common. The intuitive reason is that high-dimensional vectors (gradients) are cheap, whereas high-dimensional matrices (Hessians) are expensive. Luckily, in numerous applications of ML to science or engineering, Hessians and Jacobians exhibit sparsity: most of their coefficients are known to be zero. Leveraging this sparsity can vastly accelerate automatic differentiation (AD) for Hessians and Jacobians, while decreasing its memory requirements. Yet, while traditional AD is available in many high-level programming languages like Python and Julia, automatic sparse differentiation (ASD) is not as widely used. One reason is that the underlying theory was developed outside of the ML research ecosystem, by people more familiar with low-level programming languages. With this blog post, we aim to shed light on the inner workings of ASD, bridging the gap between the ML and AD communities by presenting well established techniques from the latter field. We start out with a short introduction to traditional AD, covering the computation of Jacobians in both forward and reverse mode. We then dive into the two primary components of ASD: sparsity pattern detection and matrix coloring. Having described the computation of sparse Jacobians, we move on to sparse Hessians. We conclude with a practical demonstration of ASD, providing performance benchmarks and guidance on when to use ASD over AD.},
  langid = {english},
  annotation = {abstractTranslation: 機械学習の多くの応用において、ヘッセ行列とヤコビ行列は疎性を示し、この性質を活用することで、計算を大幅に高速化できます。機械学習における自動微分 (AD) の利用は遍在していますが、自動疎微分 (ASD) はほとんど知られていません。この記事では ASD を紹介し、その主要な構成要素と、疎なヤコビ行列とヘッセ行列の両方の計算におけるそれらの役割について説明します。最後に、ASD のパフォーマンス上の利点を示す実践的なデモンストレーションを行います。\\
\\
\_\_\_\\
\\
一次の最適化は機械学習 (ML) で遍在していますが、二次の最適化はそれほど一般的ではありません。直感的な理由は、高次元ベクトル (勾配) は安価であるのに対し、高次元行列 (ヘッセ行列) は高価であるためです。幸いなことに、科学または工学への ML の多くの応用において、ヘッセ行列とヤコビ行列は疎性を示します。係数のほとんどがゼロであることがわかっています。この疎性を活用することで、ヘッセ行列とヤコビ行列の自動微分 (AD) を大幅に高速化し、メモリ要件を削減できます。しかし、従来の AD は Python や Julia などの多くの高水準プログラミング言語で利用できますが、自動疎微分 (ASD) はそれほど広く使用されていません。その理由の 1 つは、根底にある理論が、ローレベルのプログラミング言語に精通した人々によって、ML 研究エコシステムの外部で開発されたことです。このブログ記事では、ASD の内部動作に光を当て、後者の分野からの確立された手法を紹介することにより、ML コミュニティと AD コミュニティの間のギャップを埋めることを目指しています。まず、従来の AD の簡単な紹介から始め、順方向モードと逆方向モードの両方でのヤコビ行列の計算について説明します。次に、ASD の 2 つの主要な構成要素である、スパースパターンの検出と行列彩色について掘り下げます。疎なヤコビ行列の計算について説明した後、疎なヘッセ行列に進みます。最後に、ASD の実践的なデモンストレーションを行い、パフォーマンスベンチマークと、AD よりも ASD を使用するタイミングに関するガイダンスを提供します。},
  file = {C:\Users\furuh\Zotero\storage\IGYNCRCS\forum.html}
}

