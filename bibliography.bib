@article{hazimehGroupedVariableSelection2023,
  title = {Grouped Variable Selection with Discrete Optimization: {{Computational}} and Statistical Perspectives},
  shorttitle = {Grouped Variable Selection with Discrete Optimization},
  author = {Hazimeh, Hussein and Mazumder, Rahul and Radchenko, Peter},
  year = {2023},
  month = feb,
  journal = {The Annals of Statistics},
  volume = {51},
  number = {1},
  pages = {1--32},
  publisher = {Institute of Mathematical Statistics},
  issn = {0090-5364, 2168-8966},
  doi = {10.1214/21-AOS2155},
  urldate = {2025-02-04},
  abstract = {We present a new algorithmic framework for grouped variable selection that is based on discrete mathematical optimization. While there exist several appealing approaches based on convex relaxations and nonconvex heuristics, we focus on optimal solutions for the {$\ell$}0-regularized formulation, a problem that is relatively unexplored due to computational challenges. Our methodology covers both high-dimensional linear regression and nonparametric sparse additive modeling with smooth components. Our algorithmic framework consists of approximate and exact algorithms. The approximate algorithms are based on coordinate descent and local search, with runtimes comparable to popular sparse learning algorithms. Our exact algorithm is based on a standalone branch-and-bound (BnB) framework, which can solve the associated mixed integer programming (MIP) problem to certified optimality. By exploiting the problem structure, our custom BnB algorithm can solve to optimality problem instances with 5{\texttimes}106 features and 103 observations in minutes to hours---over 1000 times larger than what is currently possible using state-of-the-art commercial MIP solvers. We also explore statistical properties of the {$\ell$}0-based estimators. We demonstrate, theoretically and empirically, that our proposed estimators have an edge over popular group-sparse estimators in terms of statistical performance in various regimes. We provide an open source implementation of our proposed framework.},
  langid = {english},
  keywords = {0 regularization,62G05,62Jxx,90C06,90C11,branch and bound algorithms,group variable selection,mixed integer programming,nonparametric additive models,Sparsity},
  annotation = {abstractTranslation: 個別の数学的最適化に基づいたグループ化された変数選択のための新しいアルゴリズムフレームワークを提示します。凸型弛緩と非凸性ヒューリスティックに基づいたいくつかの魅力的なアプローチが存在しますが、L0正規化された製剤の最適なソリューションに焦点を当てています。これは、計算上の課題のために比較的未開拓の問題です。私たちの方法論は、高次元線形回帰とスムーズなコンポーネントを使用したノンパラメトリックスパース添加モデリングの両方をカバーしています。アルゴリズムフレームワークは、おおよその正確なアルゴリズムで構成されています。近似アルゴリズムは、座標降下とローカル検索に基づいており、人気のあるスパース学習アルゴリズムに匹敵するランタイムがあります。当社の正確なアルゴリズムは、関連する混合整数プログラミング（MIP）の問題を認定された最適性を解決できるスタンドアロンの分岐とバウンド（BNB）フレームワークに基づいています。問題構造を活用することにより、当社のカスタムBNBアルゴリズムは、最先端の商用MIPソルバーを使用して現在可能なものよりも1000倍以上の5{\texttimes}106の機能と103の観測値を使用して、最適性の問題インスタンスに解くことができます。また、L0ベースの推定器の統計的特性を調査します。理論的および経験的に、提案された推定量は、さまざまな体制における統計的パフォーマンスの観点から、一般的なグループスパース推定器よりも優位性があることを実証します。提案されたフレームワークのオープンソースの実装を提供します。},
  file = {C:\Users\furuh\Zotero\storage\8Q3GFHDJ\Hazimeh et al. - 2023 - Grouped variable selection with discrete optimization Computational and statistical perspectives.pdf}
}

