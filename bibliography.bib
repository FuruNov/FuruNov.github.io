@misc{chenTopologicalRegularizerClassifiers2018,
  title = {A {{Topological Regularizer}} for {{Classifiers}} via {{Persistent Homology}}},
  author = {Chen, Chao and Ni, Xiuyan and Bai, Qinxun and Wang, Yusu},
