@article{soubiesUnifiedViewExact2017,
  title = {A {{Unified View}} of {{Exact Continuous Penalties}} for \${\textbackslash}ell\_2\$-\${\textbackslash}ell\_0\$ {{Minimization}}},
  author = {Soubies, Emmanuel and {Blanc-F{\'e}raud}, Laure and Aubert, Gilles},
  year = {2017},
  month = jan,
  journal = {SIAM Journal on Optimization},
  volume = {27},
  number = {3},
  pages = {2034--2060},
  publisher = {{Society for Industrial and Applied Mathematics}},
  issn = {1052-6234},
  doi = {10.1137/16M1059333},
  urldate = {2025-03-12},
  abstract = {Within the framework of the \${\textbackslash}ell\_0\$ regularized least squares problem, we focus, in this paper, on nonconvex continuous penalties approximating the \${\textbackslash}ell\_0\$-norm. Such penalties are known to better promote sparsity than the \${\textbackslash}ell\_1\$ convex relaxation. Based on some results in one dimension and in  the case of orthogonal matrices, we propose the continuous exact \${\textbackslash}ell\_0\$  penalty (CEL0) leading to a tight continuous relaxation of the \${\textbackslash}ell\_2-{\textbackslash}ell\_0\$ problem. The global minimizers of the CEL0 functional contain the global minimizers of \${\textbackslash}ell\_2 - {\textbackslash}ell\_0\$, and from each global minimizer of CEL0 one can easily identify a global minimizer of \${\textbackslash}ell\_2 - {\textbackslash}ell\_0\$. We also demonstrate that from each local minimizer of the CEL0 functional, a local minimizer of \${\textbackslash}ell\_2 - {\textbackslash}ell\_0\$ is easy to obtain. Moreover, some strict local minimizers of the initial functional are eliminated with the proposed tight relaxation. Then solving the initial \${\textbackslash}ell\_2 - {\textbackslash}ell\_0\$ problem is equivalent, in a sense, to solving it by replacing the \${\textbackslash}ell\_0\$-norm with the CEL0  which provides better properties for the objective function in terms of minimization, such as the continuity and the convexity with respect to each direction of the standard \${\textbackslash}mathbb\{R\}{\textasciicircum}N\$ basis, although the problem remains nonconvex. Finally, recent nonsmooth nonconvex algorithms are used to address this relaxed problem within a macro algorithm ensuring the convergence to a critical point of the relaxed functional which is also a (local) optimum of the initial problem.},
  langid = {english},
  annotation = {abstractTranslation: \$ {\textbackslash} ell\_0 \$の正規化された最小二乗問題のフレームワーク内で、このホワイトペーパーでは、\$ {\textbackslash} ell\_0 \$ -normに近い非凸の連続ペナルティに焦点を当てます。このような罰則は、\$ {\textbackslash} ell\_1 \$ convex緩和よりもスパースをよりよく促進することが知られています。 1つの次元のいくつかの結果に基づいて、直交行列の場合、\$ {\textbackslash} ell\_2- {\textbackslash} ell\_0 \$の問題の緊密な緩和につながる連続正確な\$ {\textbackslash} ell\_0 \$ペナルティ（CEL0）を提案します。 CEL0機能のグローバルミニマイザーには、\$ {\textbackslash} ell\_2  -  {\textbackslash} ell\_0 \$のグローバルミニマイザーが含まれており、CEL0の各グローバルミニマイザーから、\$ {\textbackslash} ell\_2- {\textbackslash} ell\_0 \$のグローバルミニマライザーを簡単に識別できます。また、CEL0機能の各ローカルミニマイザーから、\$ {\textbackslash} ell\_2  -  {\textbackslash} ell\_0 \$のローカルミニマイザーが簡単に入手できることを実証します。さらに、最初の機能のいくつかの厳格な局所ミニマイザーは、提案された緊密なリラクゼーションで排除されます。次に、最初の\$ {\textbackslash} elel\_2- {\textbackslash} ell\_0 \$の問題を解くことは、ある意味では、\$ {\textbackslash} ell\_0 \$ -NormをCEL0に置き換えることでそれを解くことに相当します。最後に、最近の非滑らかな非凸アルゴリズムを使用して、マクロアルゴリズム内のこのリラックスした問題に対処し、最初の問題の（ローカル）最適であるリラックスした機能の重要なポイントへの収束を保証します。},
  file = {C:\Users\furuh\Zotero\storage\DB9PHJFJ\Soubies et al. - 2017 - A Unified View of Exact Continuous Penalties for $ell_2$-$ell_0$ Minimization.pdf}
}

@article{spornsGraphTheoryMethods2018,
  title = {Graph Theory Methods: Applications in Brain Networks},
  shorttitle = {Graph Theory Methods},
  author = {Sporns, Olaf},
  year = {2018},
  month = jun,
  journal = {Dialogues in Clinical Neuroscience},
  volume = {20},
  number = {2},
  pages = {111--121},
  issn = {1294-8322},
  urldate = {2024-09-06},
  abstract = {Network neuroscience is a thriving and rapidly expanding field. Empirical data on brain networks, from molecular to behavioral scales, are ever increasing in size and complexity. These developments lead to a strong demand for appropriate tools and methods that model and analyze brain network data, such as those provided by graph theory. This brief review surveys some of the most commonly used and neurobiologically insightful graph measures and techniques. Among these, the detection of network communities or modules, and the identification of central network elements that facilitate communication and signal transfer, are particularly salient. A number of emerging trends are the growing use of generative models, dynamic (time-varying) and multilayer networks, as well as the application of algebraic topology. Overall, graph theory methods are centrally important to understanding the architecture, development, and evolution of brain networks.},
  langid = {american},
  pmcid = {PMC6136126},
  pmid = {30250388},
  annotation = {abstractTranslation: ネットワーク神経科学は、繁栄し、急速に拡大している分野である。分子スケールから行動スケールに至るまで、脳ネットワークに関する実証的データは、その規模と複雑さを増し続けている。このような発展は、グラフ理論が提供するような、脳ネットワークデータをモデル化し解析する適切なツールや手法に対する強い要求につながる。この簡単な総説では、最も一般的に使用され、神経生物学的に洞察に満ちたグラフの尺度や手法のいくつかを調査する。その中でも、ネットワーク・コミュニティやモジュールの検出、コミュニケーションや信号伝達を促進する中心的なネットワーク要素の同定は、特に重要である。新たな傾向として、生成モデル、動的（時変）ネットワーク、多層ネットワーク、代数的トポロジーの応用が増加している。全体として、グラフ理論の手法は、脳ネットワークの構造、発達、進化を理解する上で中心的に重要である。},
  file = {C:\Users\furuh\Zotero\storage\5WM5XQ7S\Sporns - 2018 - Graph theory methods applications in brain networks.pdf}
}

