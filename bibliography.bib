  file = {C:\Users\furuh\Zotero\storage\HISMRCYK\Farias et al. - 2025 - MixFunn A Neural Network for Differential Equations with Improved Generalization and Interpretability.pdf}
}

@article{faustineAdaptiveWeightedRecurrence2021,
