  issn = {2835-8856},
  urldate = {2025-04-26},
  abstract = {In this paper, we introduce a novel analysis of neural networks based on geometric (Clifford) algebra and convex optimization. We show that optimal weights of deep ReLU neural networks are given by the wedge product of training samples when trained with standard regularized loss. Furthermore, the training problem reduces to convex optimization over wedge product features, which encode the geometric structure of the training dataset. This structure is given in terms of signed volumes of triangles and parallelotopes generated by data vectors. The convex problem finds a small subset of samples via \${\textbackslash}ell\_1\$ regularization to discover only relevant wedge product features. Our analysis provides a novel perspective on the inner workings of deep neural networks and sheds light on the role of the hidden layers.},
  langid = {english},
  keywords = {No DOI found},
  annotation = {abstractTranslation: 本稿では、幾何代数（クリフォード代数）と凸最適化に基づくニューラルネットワークの新しい解析手法を提案する。標準的な正則化損失を用いて学習させた場合、深いReLUニューラルネットワークの最適重みは、訓練サンプルのウェッジ積によって与えられることを示す。さらに、訓練問題は、訓練データセットの幾何学的構造を符号化するウェッジ積特徴量に対する凸最適化に帰着する。この構造は、データベクトルによって生成される三角形と平行多面体の符号付き体積として与えられる。凸問題は、関連するウェッジ積特徴量のみを発見するために、\${\textbackslash}ell\_1\$正則化を通じてサンプルの小さなサブセットを見つける。本解析は、深いニューラルネットワークの内部動作に関する新しい視点を提供し、隠れ層の役割を明らかにする。},
  file = {C:\Users\furuh\Zotero\storage\CT99Z4R9\Pilanci - 2024 - From Complexity to Clarity Analytical Expressions of Deep Neural Network Weights via Clifford Algeb.pdf}
}

@article{pilanciNeuralNetworksAre2020,
