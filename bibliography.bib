  number = {1},
  pages = {91--108},
  issn = {1369-7412, 1467-9868},
  doi = {10.1111/j.1467-9868.2005.00490.x},
  urldate = {2024-11-11},
  abstract = {The lasso penalizes a least squares regression by the sum of the absolute values (L1-norm) of the coefficients. The form of this penalty encourages sparse solutions (with many coefficients equal to 0). We propose the `fused lasso', a generalization that is designed for problems with features that can be ordered in some meaningful way. The fused lasso penalizes the L1-norm of both the coefficients and their successive differences. Thus it encourages sparsity of the coefficients and also sparsity of their differences---i.e. local constancy of the coefficient profile. The fused lasso is especially useful when the number of features p is much greater than N, the sample size. The technique is also extended to the `hinge' loss function that underlies the support vector classifier.We illustrate the methods on examples from protein mass spectroscopy and gene expression data.},
  copyright = {https://academic.oup.com/journals/pages/open\_access/funder\_policies/chorus/standard\_publication\_model},
  langid = {english},
  annotation = {abstractTranslation: lassoは、係数の絶対値の合計（L1-norm）によって最小2乗回帰にペナルティを与えます。このペナルティの形式は、スパース解（多くの係数が0に等しい）を奨励します。我々は「フューズド・ラッソ（fused lasso）」を提案する。これは、何らかの意味のある順序付けが可能な特徴を持つ問題のために設計された一般化である。fused lassoは係数とその連続差分のL1-normにペナルティを与えます。従って、係数のスパース性とその差のスパース性、つまり係数プロファイルの局所的不変性を促進します。フューズド・ラッソは、特徴数pがサンプルサイズNよりはるかに大きい場合に特に有効です。この手法は、サポートベクトル分類器の基礎となる「ヒンジ」損失関数にも拡張されている。},
  file = {C:\Users\furuh\Zotero\storage\CFAGRJ7F\Tibshirani et al. - 2005 - Sparsity and Smoothness Via the Fused Lasso.pdf}
}

@misc{timorImplicitRegularizationRank2022,
  title = {Implicit {{Regularization Towards Rank Minimization}} in {{ReLU Networks}}},
  author = {Timor, Nadav and Vardi, Gal and Shamir, Ohad},
  year = {2022},
