  urldate = {2023-10-20},
  abstract = {Attention mechanisms have recently boosted performance on a range of NLP tasks. Because attention layers explicitly weight input components' representations, it is also often assumed that attention can be used to identify information that models found important (e.g., specific contextualized word tokens). We test whether that assumption holds by manipulating attention weights in already-trained text classification models and analyzing the resulting differences in their predictions. While we observe some ways in which higher attention weights correlate with greater impact on model predictions, we also find many ways in which this does not hold, i.e., where gradient-based rankings of attention weights better predict their effects than their magnitudes. We conclude that while attention noisily predicts input components' overall importance to a model, it is by no means a fail-safe indicator.1},
  langid = {english},
  annotation = {abstractTranslation:  最近、注意のメカニズムが、さまざまな自然言語処理タスクのパフォーマンスを向上させている。注意層は入力成分の表現に明示的に重み付けを行うため、注意はモデルが重要だと判断した情報（例えば、文脈に応じた特定の単語トークン）を識別するために利用できると仮定されることも多い。我々は、既に訓練されたテキスト分類モデルで注意の重みを操作し、その結果生じる予測値の違いを分析することで、この仮定が成り立つかどうかを検証する。アテンションウェイトが高いほどモデル予測に大きな影響を与えるという相関が観測された一方で、アテンションウェイトの大きさよりも勾配に基づくランキングの方がアテンションウェイトの影響を予測しやすいという、アテンションウェイトが成立しないケースも多く観測された。我々は、注意は入力成分のモデルに対する全体的な重要性を騒々しく予測するが、決して安全な指標ではない、と結論づける1。},
  file = {C:\Users\furuh\Zotero\storage\DK4AJGB8\Serrano and Smith - 2019 - Is Attention Interpretable.pdf}
}

@misc{seviHarmonicAnalysisDirected2021,
