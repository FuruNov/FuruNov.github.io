  urldate = {2025-05-19},
  abstract = {In this paper, we show that, under the assumption that {\textbardbl}e{\textbardbl}2{$\leq\epsilon$}, every k-sparse signal x{$\in$}Rn can be stably ({$\epsilon\neq$}0) or exactly recovered ({$\epsilon$}=0) from y=Ax+e via lp-minimization with p{$\in$}(0,p{\textasciimacron}], wherep{\textasciimacron}=\{5031(1-{$\delta$}2k),{$\delta$}2k{$\in$}[22,0.7183)0.4541,{$\delta$}2k{$\in$}[0.7183,0.7729)2(1-{$\delta$}2k),{$\delta$}2k{$\in$}[0.7729,1), even if the restricted isometry constant of A satisfies {$\delta$}2k{$\in$}[22,1). Furthermore, under the assumption that n{$\leq$}4k, we show that the range of p can be further improved to p{$\in$}(0,3+222(1-{$\delta$}2k)]. This not only extends some discussions of only the noiseless recovery (Lai et al. (2011) [16] and Wu et al. (2013) [17]) to the noise recovery, but also greatly improves the best existing results where p{$\in$}(0,min⁡\{1,1.0873(1-{$\delta$}2k)\}) (Wu et al. (2013) [17]).\vphantom\}},
