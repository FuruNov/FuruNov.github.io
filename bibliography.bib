  shorttitle = {Learning to {{Drop}}},
  booktitle = {Proceedings of the 14th {{ACM International Conference}} on {{Web Search}} and {{Data Mining}}},
  author = {Luo, Dongsheng and Cheng, Wei and Yu, Wenchao and Zong, Bo and Ni, Jingchao and Chen, Haifeng and Zhang, Xiang},
  year = {2021},
  month = mar,
  series = {{{WSDM}} '21},
  pages = {779--787},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3437963.3441734},
  urldate = {2025-02-01},
  abstract = {Graph Neural Networks (GNNs) have shown to be powerful tools for graph analytics. The key idea is to recursively propagate and aggregate information along the edges of the given graph. Despite their success, however, the existing GNNs are usually sensitive to the quality of the input graph. Real-world graphs are often noisy and contain task-irrelevant edges, which may lead to suboptimal generalization performance in the learned GNN models. In this paper, we propose PTDNet, a parameterized topological denoising network, to improve the robustness and generalization performance of GNNs by learning to drop task-irrelevant edges. PTDNet prunes task-irrelevant edges by penalizing the number of edges in the sparsified graph with parameterized networks. To take into consideration the topology of the entire graph, the nuclear norm regularization is applied to impose the low-rank constraint on the resulting sparsified graph for better generalization. PTDNet can be used as a key component in GNN models to improve their performances on various tasks, such as node classification and link prediction. Experimental studies on both synthetic and benchmark datasets show that PTDNet can improve the performance of GNNs significantly and the performance gain becomes larger for more noisy datasets.},
  isbn = {978-1-4503-8297-7},
  langid = {english},
  annotation = {abstractTranslation: グラフニューラルネットワーク（GNNS）は、グラフ分析の強力なツールであることが示されています。重要なアイデアは、指定されたグラフの端に沿って情報を再帰的に伝播して集約することです。しかし、彼らの成功にもかかわらず、既存のGNNは通常、入力グラフの品質に敏感です。実際のグラフはしばしばノイズが多く、タスクに関係のあるエッジが含まれており、学習したGNNモデルで最適ではない一般化パフォーマンスにつながる可能性があります。このホワイトペーパーでは、パラメーター化されたトポロジ除去ネットワークであるPTDNETを提案し、タスクに関係のないエッジをドロップすることを学習することにより、GNNの堅牢性と一般化パフォーマンスを改善します。 PTDNETプルネは、パラメーター化されたネットワークを備えたSparSified Graphのエッジの数をペナルティにすることにより、タスクに関係のあるエッジを使用します。グラフ全体のトポロジーを考慮するために、原子力規範の正規化が適用され、結果として生じるスパースグラフに低いランク制約を課して、より良い一般化を課します。 PTDNETは、GNNモデルの重要なコンポーネントとして使用して、ノード分類やリンク予測など、さまざまなタスクでのパフォーマンスを改善できます。合成データセットとベンチマークデータセットの両方での実験的研究は、PTDNETがGNNのパフォーマンスを大幅に改善し、よりノイズの多いデータセットでパフォーマンスゲインが大きくなることを示しています。},
  file = {C:\Users\furuh\Zotero\storage\AXICWPAC\Luo et al. - 2021 - Learning to Drop Robust Graph Neural Network via Topological Denoising.pdf}
}

@article{luoLowrankTensorEstimation,
  title = {Low-Rank {{Tensor Estimation}} via {{Riemannian Gauss-Newton}}: {{Statistical Optimality}} and {{Second-Order Convergence}}},
  author = {Luo, Yuetian and Zhang, Anru R},
  abstract = {In this paper, we consider the estimation of a low Tucker rank tensor from a number of noisy linear measurements. The general problem covers many specific examples arising from applications, including tensor regression, tensor completion, and tensor PCA/SVD. We consider an efficient Riemannian Gauss-Newton (RGN) method for low Tucker rank tensor estimation. Different from the generic (super)linear convergence guarantee of RGN in the literature, we prove the first local quadratic convergence guarantee of RGN for lowrank tensor estimation in the noisy setting under some regularity conditions and provide the corresponding estimation error upper bounds. A deterministic estimation error lower bound, which matches the upper bound, is provided that demonstrates the statistical optimality of RGN. The merit of RGN is illustrated through two machine learning applications: tensor regression and tensor SVD. Finally, we provide the simulation results to corroborate our theoretical findings.},
