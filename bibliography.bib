@article{zhangSurveySparseRepresentation2015,
  title = {A {{Survey}} of {{Sparse Representation}}: {{Algorithms}} and {{Applications}}},
  shorttitle = {A {{Survey}} of {{Sparse Representation}}},
  author = {Zhang, Zheng and Xu, Yong and Yang, Jian and Li, Xuelong and Zhang, David},
  year = {2015},
  journal = {IEEE Access},
  volume = {3},
  pages = {490--530},
  issn = {2169-3536},
  doi = {10.1109/ACCESS.2015.2430359},
  urldate = {2023-12-29},
  abstract = {Sparse representation has attracted much attention from researchers in fields of signal processing, image processing, computer vision, and pattern recognition. Sparse representation also has a good reputation in both theoretical research and practical applications. Many different algorithms have been proposed for sparse representation. The main purpose of this paper is to provide a comprehensive study and an updated review on sparse representation and to supply guidance for researchers. The taxonomy of sparse representation methods can be studied from various viewpoints. For example, in terms of different norm minimizations used in sparsity constraints, the methods can be roughly categorized into five groups: 1) sparse representation with l0-norm minimization; 2) sparse representation with lp-norm (0 \&lt;; p \&lt;; 1) minimization; 3) sparse representation with l1-norm minimization; 4) sparse representation with l2,1-norm minimization; and 5) sparse representation with l2-norm minimization. In this paper, a comprehensive overview of sparse representation is provided. The available sparse representation algorithms can also be empirically categorized into four groups: 1) greedy strategy approximation; 2) constrained optimization; 3) proximity algorithm-based optimization; and 4) homotopy algorithm-based sparse representation. The rationales of different algorithms in each category are analyzed and a wide range of sparse representation applications are summarized, which could sufficiently reveal the potential nature of the sparse representation theory. In particular, an experimentally comparative study of these sparse representation algorithms was presented.},
  langid = {english},
  keywords = {Favorite},
  annotation = {abstractTranslation: スパース表現は、信号処理、画像処理、コンピュータビジョン、パターン認識の各分野の研究者から注目を集めている。また、スパース表現は理論研究と実用的応用の両方において高い評価を得ている。スパース表現には多くの異なるアルゴリズムが提案されている。本稿の主な目的は、スパース表現に関する包括的な研究と最新のレビューを提供し、研究者に指針を提供することである。スパース表現法の分類法は様々な観点から研究することができる。例えば、スパース制約に用いられるノルム最小化の違いから、その手法は大きく5つのグループに分類される：1) l0-ノルム最小化によるスパース表現、2) lp-ノルム(0 \&lt;; p \&lt;; 1)最小化によるスパース表現、3) l1-ノルム最小化によるスパース表現、4) l2,1-ノルム最小化によるスパース表現、5) l2-ノルム最小化によるスパース表現。本論文では、スパース表現の包括的な概観を提供する。また、利用可能なスパース表現アルゴリズムは、経験的に次の4つのグループに分類することができる：1)貪欲な戦略近似、2)制約付き最適化、3)近接アルゴリズムに基づく最適化、4)ホモトピーアルゴリズムに基づくスパース表現。各カテゴリーの異なるアルゴリズムの根拠を分析し、スパース表現理論の潜在的な性質を十分に明らかにすることができる、幅広いスパース表現アプリケーションを要約する。特に、これらのスパース表現アルゴリズムの実験的比較研究が示された。},
  file = {C:\Users\furuh\Zotero\storage\ZWWS9UI2\Zhang et al. - 2015 - A Survey of Sparse Representation Algorithms and .pdf}
}

@misc{zhangSymmetryGeometryTractable2022,
  title = {From {{Symmetry}} to {{Geometry}}: {{Tractable Nonconvex Problems}}},
  shorttitle = {From {{Symmetry}} to {{Geometry}}},
  author = {Zhang, Yuqian and Qu, Qing and Wright, John},
  year = {2022},
  month = jul,
  number = {arXiv:2007.06753},
  eprint = {2007.06753},
  primaryclass = {cs, math, stat},
  doi = {10.48550/arXiv.2007.06753},
  urldate = {2023-03-05},
  abstract = {As science and engineering have become increasingly data-driven, the role of optimization has expanded to touch almost every stage of the data analysis pipeline, from signal and data acquisition to modeling and prediction. The optimization problems encountered in practice are often nonconvex. While challenges vary from problem to problem, one common source of nonconvexity is nonlinearity in the data or measurement model. Nonlinear models often exhibit symmetries, creating complicated, nonconvex objective landscapes, with multiple equivalent solutions. Nevertheless, simple methods (e.g., gradient descent) often perform surprisingly well in practice. The goal of this survey is to highlight a class of tractable nonconvex problems, which can be understood through the lens of symmetries. These problems exhibit a characteristic geometric structure: local minimizers are symmetric copies of a single "ground truth" solution, while other critical points occur at balanced superpositions of symmetric copies of the ground truth, and exhibit negative curvature in directions that break the symmetry. This structure enables efficient methods to obtain global minimizers. We discuss examples of this phenomenon arising from a wide range of problems in imaging, signal processing, and data analysis. We highlight the key role of symmetry in shaping the objective landscape and discuss the different roles of rotational and discrete symmetries. This area is rich with observed phenomena and open problems; we close by highlighting directions for future research.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computer Vision and Pattern Recognition,Computer Science - Information Theory,Computer Science - Machine Learning,Mathematics - Optimization and Control,Statistics - Machine Learning},
  file = {C:\Users\furuh\Zotero\storage\L5ZMF42Y\Zhang et al. - 2022 - From Symmetry to Geometry Tractable Nonconvex Problems.pdf}
}

@article{zhangTDSFNetTensorDecompositionBased2025,
  title = {{{TDSF-Net}}: {{Tensor Decomposition-Based Subspace Fusion Network}} for {{Multimodal Medical Image Classification}}},
  shorttitle = {{{TDSF-Net}}},
  author = {Zhang, Yi and Xu, Guoxia and Zhao, Meng and Wang, Hao and Shi, Fan and Chen, Shengyong},
