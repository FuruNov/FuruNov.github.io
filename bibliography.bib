@misc{gaviliShiftOperatorGraph2017,
  title = {On the {{Shift Operator}}, {{Graph Frequency}} and {{Optimal Filtering}} in {{Graph Signal Processing}}},
  author = {Gavili, Adnan and Zhang, Xiao-Ping},
