  number = {arXiv:2108.00192},
  eprint = {2108.00192},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2108.00192},
  urldate = {2024-12-08},
  abstract = {Learning with noisy labels is an important and challenging task for training accurate deep neural networks. Some commonly-used loss functions, such as Cross Entropy (CE), suffer from severe overfitting to noisy labels. Robust loss functions that satisfy the symmetric condition were tailored to remedy this problem, which however encounter the underfitting effect. In this paper, we theoretically prove that {\textbackslash}textbf\{any loss can be made robust to noisy labels\} by restricting the network output to the set of permutations over a fixed vector. When the fixed vector is one-hot, we only need to constrain the output to be one-hot, which however produces zero gradients almost everywhere and thus makes gradient-based optimization difficult. In this work, we introduce the sparse regularization strategy to approximate the one-hot constraint, which is composed of network output sharpening operation that enforces the output distribution of a network to be sharp and the \${\textbackslash}ell\_p\$-norm (\$p{\textbackslash}le 1\$) regularization that promotes the network output to be sparse. This simple approach guarantees the robustness of arbitrary loss functions while not hindering the fitting ability. Experimental results demonstrate that our method can significantly improve the performance of commonly-used loss functions in the presence of noisy labels and class imbalance, and outperform the state-of-the-art methods. The code is available at https://github.com/hitcszx/lnl\_sr.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Computer Vision and Pattern Recognition,Computer Science - Machine Learning,Statistics - Machine Learning},
  annotation = {abstractTranslation: ノイズの多いラベルでの学習は、正確なディープニューラルネットワークを学習する上で重要かつ困難な課題である。クロスエントロピー（CE）のような一般的に使用されている損失関数は、ノイズの多いラベルに対して深刻なオーバーフィッティングに苦しんでいる。この問題を改善するために、対称条件を満たすロバストな損失関数が調整されたが、これはアンダーフィット効果に遭遇する。本論文では、ネットワーク出力を固定ベクトル上の順列集合に制限することで、ノイズの多いラベルに対してロバストになることを理論的に証明する。固定ベクトルがone-hotである場合、出力をone-hotに制限するだけでよいが、これはほぼ全ての場所でゼロ勾配を生成するため、勾配に基づく最適化を困難にする。これは、ネットワークの出力分布がシャープであることを強制するネットワーク出力シャープ化操作と、ネットワーク出力がスパースになることを促進する\$pell\_p\$-norm (\$pelle 1\$)正則化で構成される。この単純なアプローチは、フィッティング能力を妨げない一方で、任意の損失関数のロバスト性を保証する。実験結果は、我々の手法が、ノイズの多いラベルやクラス不均衡の存在下で、一般的に使用される損失関数の性能を大幅に改善し、最先端の手法を凌駕することを実証している。コードはhttps://github.com/hitcszx/lnl\_sr。},
