@article{8319524,
  title = {Alternative to Extended Block Sparse Bayesian Learning and Its Relation to Pattern-Coupled Sparse Bayesian Learning},
  author = {Wang, Lu and Zhao, Lifan and Rahardja, Susanto and Bi, Guoan},
  year = {2018},
  month = may,
  journal = {IEEE Transactions on Signal Processing},
  volume = {66},
  number = {10},
  pages = {2759--2771},
  issn = {1941-0476},
  doi = {10.1109/TSP.2018.2816574},
  abstract = {We consider the problem of recovering block sparse signals with unknown block partition and propose a better alternative to the extended block sparse Bayesian learning (EBSBL). The underlying relationship between the proposed method EBSBL and pattern-coupled sparse Bayesian learning (PC-SBL) is explicitly revealed. The proposed method adopts a cluster-structured prior for sparse coefficients, which encourages dependencies among neighboring coefficients by properly manipulating the hyperparameters of the neighborhood. Due to entanglement of the hyperparameters, a joint sparsity assumption is made to yield a suboptimal analytic solution. The alternative algorithm avoids high dictionary coherence in EBSBL, reduces the unknowns of EBSBL, and explains the effectiveness of EBSBL. The proposed algorithm also avoids the vulnerability of parameter choice in PC-SBL. Results of comprehensive simulations demonstrate that the proposed algorithm achieves performance that is close to the best performance of PC-SBL. In addition, it outperforms EBSBL and other recently reported algorithms particularly under noisy and low sampling scenarios.},
  langid = {american},
  annotation = {abstractTranslation: 未知のブロック分割を持つブロックスパース信号を復元する問題を考察し、拡張ブロックスパースベイズ学習(EBSBL)に代わるより良い方法を提案する。提案手法EBSBLとパターン結合スパースベイズ学習(PC-SBL)の基本的な関係を明示的に明らかにする。提案手法は、スパース係数に対してクラスタ構造化事前分布を採用し、近傍のハイパーパラメータを適切に操作することで、近傍係数間の依存性を促す。ハイパーパラメータのもつれにより、共同スパース性が仮定され、最適な解析解が得られない。代替アルゴリズムはEBSBLにおける高い辞書コヒーレンスを回避し、EBSBLの未知数を減らし、EBSBLの有効性を説明する。また、提案アルゴリズムはPC-SBLにおけるパラメータ選択の脆弱性を回避する。包括的なシミュレーションの結果、提案アルゴリズムはPC-SBLの最高性能に近い性能を達成することが実証された。さらに、特にノイズの多い低サンプリングシナリオにおいて、EBSBLや最近報告された他のアルゴリズムを凌駕する。}
}

