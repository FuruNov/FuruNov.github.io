  abstract = {Abstract             Recently, tensor ring networks (TRNs) have been applied in deep networks, achieving remarkable successes in compression ratio and accuracy. Although highly related to the performance of TRNs, rank selection is seldom studied in previous works and usually set to equal in experiments. Meanwhile, there is not any heuristic method to choose the rank, and an enumerating way to find appropriate rank is extremely time-consuming. Interestingly, we discover that part of the rank elements is sensitive and usually aggregate in a narrow region, namely an interest region. Therefore, based on the above phenomenon, we propose a novel progressive genetic algorithm named progressively searching tensor ring network search (PSTRN), which has the ability to find optimal rank precisely and efficiently. Through the evolutionary phase and progressive phase, PSTRN can converge to the interest region quickly and harvest good performance. Experimental results show that PSTRN can significantly reduce the complexity of seeking rank, compared with the enumerating method. Furthermore, our method is validated on public benchmarks like MNIST, CIFAR10/100, UCF11 and HMDB51, achieving the state-of-the-art performance.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\EIXDGZNM\Li et al. - 2022 - Heuristic rank selection with progressively search.pdf}
}

@article{liHypernetworkConstructionFeature2020,
  title = {Hypernetwork {{Construction}} and {{Feature Fusion Analysis Based}} on {{Sparse Group Lasso Method}} on {{fMRI Dataset}}},
  author = {Li, Yao and Sun, Chao and Li, Pengzu and Zhao, Yunpeng and Mensah, Godfred Kim and Xu, Yong and Guo, Hao and Chen, Junjie},
  year = {2020},
  journal = {Frontiers in Neuroscience},
  volume = {14},
  publisher = {Frontiers Media SA},
  doi = {10.3389/fnins.2020.00060},
  urldate = {2024-09-04},
  abstract = {Recent works have shown that the resting-state brain functional connectivity hypernetwork, where multiple nodes can be connected, are an effective technique for brain disease diagnosis and classification research. The lasso method was used to construct hypernetworks by solving sparse linear regression models in previous research. But, constructing a hypernetwork based on the lasso method simply selects a single variable, in that it lacks the ability to interpret the grouping effect. Considering the group structure problem, the previous study proposed to create a hypernetwork based on the elastic net and the group lasso methods, and the results showed that the former method had the best classification performance. However, the highly correlated variables selected by the elastic net method were not necessarily in the active set in the group. Therefore, we extended our research to address this issue. Herein, we propose a new method that introduces the sparse group lasso method to improve the construction of the hypernetwork by solving the group structure problem of the brain regions. We used the traditional lasso, group lasso method, and sparse group lasso method to construct a hypernetwork in patients with depression and normal subjects. Meanwhile, other clustering coefficients (clustering coefficients based on pairs of nodes) were also introduced to extract features with traditional clustering coefficients. Two types of features with significant differences obtained after feature selection were subjected to multi-kernel learning for feature fusion and classification using each method, respectively. The network topology results revealed differences among the three networks, where hypernetwork using the lasso method was the strictest; the group lasso, most lenient; and the sgLasso method, moderate. The network topology of the sparse group lasso method was similar to that of the group lasso method but different from the lasso method. The classification results show that the sparse group lasso method achieves the best classification accuracy by using multi-kernel learning, which indicates that better classification performance can be achieved when the group structure exists and is properly extended.},
  langid = {english},
  pmid = {32116508},
  annotation = {abstractTranslation: 近年の研究により、複数のノードが接続可能な安静時脳機能接続ハイパーネットワークが、脳疾患の診断や分類研究に有効な手法であることが示されている。これまでの研究では、スパース線形回帰モデルを解くことによりハイパーネットワークを構築するために、lasso法が用いられてきた。しかし、投げ縄法に基づくハイパーネットワークの構築は、単に単一の変数を選択するだけであり、グループ化効果を解釈する能力に欠ける。グループ構造の問題を考慮し、先行研究ではエラスティック・ネット法とグループ・ラッソ法に基づくハイパーネットワークの作成を提案し、その結果、前者の方法が最も優れた分類性能を持つことが示された。しかし、エラスティック・ネット法で選択された相関の高い変数は、必ずしもグループ内のアクティブセットに含まれているわけではなかった。そこで、この問題を解決するために研究を拡張した。ここでは、脳領域のグループ構造問題を解決することにより、ハイパーネットワークの構築を改善するために、スパースグループラッソ法を導入した新しい手法を提案する。うつ病患者と健常者を対象に、従来の投げ縄法、グループ投げ縄法、スパースグループ投げ縄法を用いてハイパーネットワークを構築した。一方、他のクラスタリング係数（ノードのペアに基づくクラスタリング係数）も導入し、従来のクラスタリング係数による特徴量を抽出した。特徴選択後に得られた有意差のある2種類の特徴について、それぞれマルチカーネル学習を行い、特徴融合と各手法による分類を行った。ネットワークトポロジーの結果、ラッソ法を用いたハイパーネットワークが最も厳しく、グループラッソ法が最も甘く、sgLasso法が中程度であった。スパース・グループ・ラッソ法のネットワーク・トポロジーは、グループ・ラッソ法と類似していたが、ラッソ法とは異なっていた。分類結果は、スパース・グループ・ラッソ法がマルチカーネル学習により最高の分類精度を達成したことを示しており、これは、グループ構造が存在し、適切に拡張された場合に、より良い分類性能が達成できることを示している。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\6328DJIJ\\Li et al. - 2020 - Hypernetwork Construction and Feature Fusion Analysis Based on Sparse Group Lasso Method on fMRI Dat.pdf;C\:\\Users\\furuh\\Zotero\\storage\\5N9N9TTJ\\PMC7029661.html}
}

@misc{liImplicitRegularizationBregman2023,
  title = {Implicit {{Regularization}} of {{Bregman Proximal Point Algorithm}} and {{Mirror Descent}} on {{Separable Data}}},
  author = {Li, Yan and Ju, Caleb and Fang, Ethan X. and Zhao, Tuo},
  year = {2023},
  month = aug,
  number = {arXiv:2108.06808},
  eprint = {2108.06808},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2108.06808},
  urldate = {2023-09-09},
  abstract = {Bregman proximal point algorithm (BPPA) has witnessed emerging machine learning applications, yet its theoretical understanding has been largely unexplored. We study the computational properties of BPPA through learning linear classifiers with separable data, and demonstrate provable algorithmic regularization of BPPA. For any BPPA instantiated with a fixed Bregman divergence, we provide a lower bound of the margin obtained by BPPA with respect to an arbitrarily chosen norm. The obtained margin lower bound differs from the maximal margin by a multiplicative factor, which inversely depends on the condition number of the distance-generating function measured in the dual norm. We show that the dependence on the condition number is tight, thus demonstrating the importance of divergence in affecting the quality of the learned classifiers. We then extend our findings to mirror descent, for which we establish similar connections between the margin and Bregman divergence, together with a non-asymptotic analysis. Numerical experiments on both synthetic and real-world datasets are provided to support our theoretical findings. To the best of our knowledge, the aforementioned findings appear to be new in the literature of algorithmic regularization.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning}
}

@misc{liImplicitRegularizationGroup2023,
  title = {Implicit {{Regularization}} for {{Group Sparsity}}},
  author = {Li, Jiangyuan and Nguyen, Thanh V. and Hegde, Chinmay and Wong, Raymond K. W.},
  year = {2023},
  month = jan,
  number = {arXiv:2301.12540},
  eprint = {2301.12540},
  primaryclass = {cs, stat},
  urldate = {2023-02-21},
  abstract = {We study the implicit regularization of gradient descent towards structured sparsity via a novel neural reparameterization, which we call a diagonally grouped linear neural network. We show the following intriguing property of our reparameterization: gradient descent over the squared regression loss, without any explicit regularization, biases towards solutions with a group sparsity structure. In contrast to many existing works in understanding implicit regularization, we prove that our training trajectory cannot be simulated by mirror descent. We analyze the gradient dynamics of the corresponding regression problem in the general noise setting and obtain minimax-optimal error rates. Compared to existing bounds for implicit sparse regularization using diagonal linear networks, our analysis with the new reparameterization shows improved sample complexity. In the degenerate case of size-one groups, our approach gives rise to a new algorithm for sparse linear regression. Finally, we demonstrate the efficacy of our approach with several numerical experiments.},
  archiveprefix = {arXiv},
  langid = {english},
  annotation = {abstractTranslation: 我々は、対角的にグループ化された線形ニューラルネットワークと呼ぶ新しいニューラル再パラメータ化によって、構造化されたスパース性に向かう勾配降下の暗黙の正則化を研究する。明示的な正則化なしに、回帰損失の2乗に対する勾配降下は、群スパース構造を持つ解に偏る。暗黙的な正則化を理解する多くの既存の研究とは対照的に、我々は、我々の学習軌跡はミラー降下ではシミュレートできないことを証明する。一般的なノイズ設定における対応する回帰問題の勾配ダイナミクスを解析し、最小最適誤差率を求める。対角線形ネットワークを用いた暗黙的スパース正則化の既存の境界と比較して、新しい再パラメータ化を用いた我々の解析は、サンプルの複雑さが改善されていることを示す。サイズ1群の退化的な場合において、我々のアプローチはスパース線形回帰の新しいアルゴリズムを生み出す。最後に、いくつかの数値実験により、我々のアプローチの有効性を示す。},
  file = {C:\Users\furuh\Zotero\storage\LSZ28DEU\Li et al_2023_Implicit Regularization for Group Sparsity.pdf}
}

@misc{liImplicitSparseRegularization2021,
  title = {Implicit {{Sparse Regularization}}: {{The Impact}} of {{Depth}} and {{Early Stopping}}},
  shorttitle = {Implicit {{Sparse Regularization}}},
  author = {Li, Jiangyuan and Nguyen, Thanh V. and Hegde, Chinmay and Wong, Raymond K. W.},
  year = {2021},
  month = oct,
  number = {arXiv:2108.05574},
  eprint = {2108.05574},
  primaryclass = {cs, stat},
  urldate = {2023-02-20},
  abstract = {In this paper, we study the implicit bias of gradient descent for sparse regression. We extend results on regression with quadratic parametrization, which amounts to depth-2 diagonal linear networks, to more general depth-N networks, under more realistic settings of noise and correlated designs. We show that early stopping is crucial for gradient descent to converge to a sparse model, a phenomenon that we call implicit sparse regularization. This result is in sharp contrast to known results for noiseless and uncorrelated-design cases. We characterize the impact of depth and early stopping and show that for a general depth parameter N, gradient descent with early stopping achieves minimax optimal sparse recovery with sufficiently small initialization and step size. In particular, we show that increasing depth enlarges the scale of working initialization and the early-stopping window so that this implicit sparse regularization effect is more likely to take place.},
  archiveprefix = {arXiv},
  file = {C:\Users\furuh\Zotero\storage\C3EEAY6N\Li et al_2021_Implicit Sparse Regularization.pdf}
}

@inproceedings{liLoftQLoRAFineTuningawareQuantization2023,
  title = {{{LoftQ}}: {{LoRA-Fine-Tuning-aware Quantization}} for {{Large Language Models}}},
