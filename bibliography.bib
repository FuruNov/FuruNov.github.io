@incollection{lanzaConvexNonconvexVariational2021,
  title = {Convex {{Non-convex Variational Models}}},
  booktitle = {Handbook of {{Mathematical Models}} and {{Algorithms}} in {{Computer Vision}} and {{Imaging}}: {{Mathematical Imaging}} and {{Vision}}},
  author = {Lanza, Alessandro and Morigi, Serena and Selesnick, Ivan W. and Sgallari, Fiorella},
  editor = {Chen, Ke and Sch{\"o}nlieb, Carola-Bibiane and Tai, Xue-Cheng and Younces, Laurent},
  year = {2021},
