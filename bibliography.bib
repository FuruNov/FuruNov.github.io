  author = {Huang, Zihao and Min, Qiyang and Huang, Hongzhi and Zeng, Yutao and Zhu, Defa and Guo, Ran and Xun, Zhou},
  year = {2024},
  month = oct,
  urldate = {2025-04-26},
  abstract = {It is widely acknowledged that the performance of Transformer models is logarithmically related to their number of parameters and computational complexity. While approaches like Mixture of Experts (MoE) decouple parameter count from computational complexity, they still face challenges in inference due to high memory access costs. This work introduces UltraMem, incorporating large-scale, ultra-sparse memory layer to address these limitations. Our approach significantly reduces inference latency while maintaining model performance. We also investigate the scaling laws of this new architecture, demonstrating that it not only exhibits favorable scaling properties but outperforms MoE. In experiments, the largest UltraMem we train has {\textbackslash}textbf\{20 million\} memory slots. The results show that our method achieves state-of-the-art inference speed and model performance within a given computational budget, paving the way for billions of slots or experts.},
  langid = {english},
  annotation = {abstractTranslation: Transformerモデルの性能が、そのパラメータ数と計算複雑性に対して対数的に関連していることは広く認識されています。Mixture of Experts（MoE）のような手法は、パラメータ数と計算複雑性を分離しますが、それでもなお、高いメモリアクセスコストのために推論において課題に直面します。本研究では、これらの制限に対処するために、大規模かつ超疎なメモリ層を組み込んだUltraMemを提案します。我々のアプローチは、モデル性能を維持しながら、推論レイテンシを大幅に削減します。また、この新しいアーキテクチャのスケーリング則を調査し、良好なスケーリング特性を示すだけでなく、MoEを上回ることを実証します。実験では、我々が訓練した最大のUltraMemは{\textbackslash}textbf\{2000万\}のメモリスロットを持っています。結果は、我々の手法が、特定の計算予算内で最先端の推論速度とモデル性能を達成し、数十億のスロットまたは専門家への道を開くことを示しています。},
