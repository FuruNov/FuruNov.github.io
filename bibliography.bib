  doi = {10.48550/arXiv.2011.10187},
  urldate = {2024-11-01},
  abstract = {Location-based Social Networks (LBSNs) enable users to socialize with friends and acquaintances by sharing their check-ins, opinions, photos, and reviews. Huge volume of data generated from LBSNs opens up a new avenue of research that gives birth to a new sub-field of recommendation systems, known as Point-of-Interest (POI) recommendation. A POI recommendation technique essentially exploits users' historical check-ins and other multi-modal information such as POI attributes and friendship network, to recommend the next set of POIs suitable for a user. A plethora of earlier works focused on traditional machine learning techniques by using hand-crafted features from the dataset. With the recent surge of deep learning research, we have witnessed a large variety of POI recommendation works utilizing different deep learning paradigms. These techniques largely vary in problem formulations, proposed techniques, used datasets, and features, etc. To the best of our knowledge, this work is the first comprehensive survey of all major deep learning-based POI recommendation works. Our work categorizes and critically analyzes the recent POI recommendation works based on different deep learning paradigms and other relevant features. This review can be considered a cookbook for researchers or practitioners working in the area of POI recommendation.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Information Retrieval,Computer Science - Machine Learning},
  annotation = {abstractTranslation: ロケーションベース・ソーシャルネットワーク（LBSN）は、ユーザーがチェックイン、意見、写真、レビューを共有することで、友人や知人と交流することを可能にする。LBSNから生成される膨大なデータは、POI（Point-of-Interest）推薦として知られる推薦システムの新しいサブフィールドを誕生させる研究の新しい道を開く。POI推薦技術は、基本的にユーザーの過去のチェックイン履歴や、POIの属性や友好ネットワークのような他のマルチモーダルな情報を利用して、ユーザーに適した次のPOIセットを推薦する。以前の多くの研究は、データセットから手作業で作成された特徴を使用することにより、伝統的な機械学習技術に焦点を当てていた。近年のディープラーニング研究の急増に伴い、我々は様々なディープラーニングパラダイムを利用した多種多様なPOI推薦技術を目の当たりにしてきた。これらの技術は、問題の定式化、提案された技術、使用されたデータセット、特徴などにおいて大きく異なる。我々の知る限り、この研究は、すべての主要な深層学習ベースのPOI推薦作品の最初の包括的な調査である。我々の研究は、異なるディープラーニングパラダイムと他の関連する特徴に基づく最近のPOI推薦作品を分類し、批判的に分析する。このレビューは、POI推薦の分野で働く研究者や実務家のためのクックブックとみなすことができる。},
