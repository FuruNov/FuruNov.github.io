@article{taniguchiADOPTModifiedAdam2023,
  title = {{{ADOPT}}: {{Modified Adam Can Converge}} with the {{Optimal Rate}} with {{Any Hyperparameters}}},
  shorttitle = {{{ADOPT}}},
  author = {Taniguchi, Shohei and Harada, Keno and Gouki, Minegishi and Oshima, Yuta and Jeong, Seong Cheol and Nagahara, Go and Iiyama, Tomoshi and Suzuki, Masahiro and Iwasawa, Yusuke and Matsuo, Yutaka},
  year = {2023},
  month = oct,
  urldate = {2024-10-17},
  abstract = {Adaptive gradient methods based on exponential moving averages, such as Adam and RMSprop, are widely used for deep learning. However, it is known that they do not converge unless choosing hyperparameters in a problem-dependent manner. There have been many attempts to fix their convergence (e.g., AMSGrad), but they require an impractical assumption that the stochastic gradient is uniformly bounded. In this paper, we propose a new adaptive gradient method named ADOPT, which achieves the optimal convergence rate of \${\textbackslash}mathcal\{O\} ( 1 / {\textbackslash}sqrt\{T\} )\$ with any hyperparameter choice without the bounded stochastic gradient assumption. ADOPT addresses the non-convergence issue of Adam by removing the current gradient from the second moment estimate and changing the order of the momentum calculation and the scaling operation by the second moment estimate. We also conduct intensive numerical experiments, and verify that our ADOPT achieves competitive or even better results compared to Adam and its variants across a wide range of tasks, including image classification, generative modeling, natural language processing, and deep reinforcement learning.},
  langid = {english},
  keywords = {No DOI found},
  file = {C:\Users\furuh\Zotero\storage\8ZL7M66C\Taniguchi et al. - 2023 - ADOPT Modified Adam Can Converge with the Optimal Rate with Any Hyperparameters.pdf}
