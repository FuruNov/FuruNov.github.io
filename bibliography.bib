@inproceedings{yuAutoencoderNonnegativeMatrixCoFactorization2024,
  title = {An {{Autoencoder-Like Nonnegative Matrix Co-Factorization}} for {{Improved Student Cognitive Modeling}}},
  booktitle = {The {{Thirty-eighth Annual Conference}} on {{Neural Information Processing Systems}}},
  author = {Yu, Shenbao and Pan, Yinghui and Zeng, Yifeng and Doshi, Prashant and Liu, Guoquan and Poh, Kim-Leng and Lin, Mingwei},
  year = {2024},
  month = nov,
  urldate = {2024-11-24},
  abstract = {Student cognitive modeling (SCM) is a fundamental task in intelligent education, with applications ranging from personalized learning to educational resource allocation. By exploiting students' response logs, SCM aims to predict their exercise performance as well as estimate knowledge proficiency in a subject. Data mining approaches such as matrix factorization can obtain high accuracy in predicting student performance on exercises, but the knowledge proficiency is unknown or poorly estimated. The situation is further exacerbated if only sparse interactions exist between exercises and students (or knowledge concepts). To solve this dilemma, we root monotonicity (a fundamental psychometric theory on educational assessments) in a co-factorization framework and present an autoencoder-like nonnegative matrix co-factorization (AE-NMCF), which improves the accuracy of estimating the student's knowledge proficiency via an encoder-decoder learning pipeline. The resulting estimation problem is nonconvex with nonnegative constraints. We introduce a projected gradient method based on block coordinate descent with Lipschitz constants and guarantee the method's theoretical convergence. Experiments on several real-world data sets demonstrate the efficacy of our approach in terms of both performance prediction accuracy and knowledge estimation ability, when compared with existing student cognitive models.},
  langid = {english}
}

@inproceedings{yuBayesianCompressiveSensing2011,
  title = {Bayesian {{Compressive Sensing}} for Clustered Sparse Signals},
  booktitle = {Proceedings of {{International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {Yu, Lei and Sun, Hong and Barbot, Jean Pierre and Zheng, Gang},
  year = {2011},
  month = may,
  pages = {3948--3951},
  issn = {2379-190X},
  doi = {10.1109/ICASSP.2011.5947216},
  abstract = {In traditional framework of Compressive Sensing (CS), only sparse prior on the property of signals in time or frequency domain is adopted to guarantee the exact inverse recovery. Besides sparse prior, cluster prior is introduced in this paper in order to investigate a class of structural sparse signals, called clustered sparse signals. A hierarchical statistical model is employed via Bayesian approach to model both the sparse prior and cluster prior and Markov Chain Monte Carlo (MCMC) sampling is implemented for the inference. Unlike the state-of-the-art algorithms based on the cluster prior, the proposed algorithm solves the inverse problem without any prior knowledge of the cluster parameters, even without the knowledge of the sparsity. The experimental results show that the proposed algorithm outperforms many state-of-the-art algorithms.},
  langid = {american},
  keywords = {Bayesian,Bayesian methods,Clustered Sparse Signals,Clustering algorithms,Compressed sensing,Compressive Sensing,Estimation,Inference algorithms,MCMC,Sensors,Signal processing algorithms},
  annotation = {abstractTranslation: 従来の圧縮センシング(CS)の枠組みでは、厳密な逆回復を保証するために、時間領域または周波数領域における信号の特性に関するスパース事前分布のみが採用されている。本論文では、クラスター化されたスパース信号と呼ばれる構造的なスパース信号のクラスを調査するために、スパース事前分布に加えてクラスター事前分布を導入する。スパース事前分布とクラスタ事前分布の両方をモデル化するために、ベイズアプローチによる階層的統計モデルを採用し、推論のためにマルコフ連鎖モンテカルロ（MCMC）サンプリングを実装する。クラスタ事前分布に基づく最新のアルゴリズムとは異なり、提案アルゴリズムは、クラスタパラメータに関する事前知識が無くても、スパース性の知識が無くても、逆問題を解く。実験結果は、提案アルゴリズムが多くの最新アルゴリズムを凌駕することを示している。},
  file = {C:\Users\furuh\Zotero\storage\ESQ2YC5V\5947216.html}
}

@inproceedings{yuCauchySchwarzDivergenceInformation2023,
  title = {Cauchy-{{Schwarz Divergence Information Bottleneck}} for {{Regression}}},
  booktitle = {The {{Twelfth International Conference}} on {{Learning Representations}}},
  author = {Yu, Shujian and Yu, Xi and L{\o}kse, Sigurd and Jenssen, Robert and Principe, Jose C.},
  year = {2023},
  month = oct,
  urldate = {2024-06-17},
  abstract = {The information bottleneck (IB) approach is popular to improve the generalization, robustness and explainability of deep neural networks. Essentially, it aims to find a minimum sufficient representation \${\textbackslash}mathbf\{t\}\$ by striking a trade-off between a compression term \$I({\textbackslash}mathbf\{x\};{\textbackslash}mathbf\{t\})\$ and a prediction term \$I(y;{\textbackslash}mathbf\{t\})\$, where \$I({\textbackslash}cdot;{\textbackslash}cdot)\$ refers to the mutual information (MI). MI is for the IB for the most part expressed in terms of the Kullback-Leibler (KL) divergence, which in the regression case corresponds to prediction based on mean squared error (MSE) loss with Gaussian assumption and compression approximated by variational inference. In this paper, we study the IB principle for the regression problem and develop a new way to parameterize the IB with deep neural networks by exploiting favorable properties of the Cauchy-Schwarz (CS) divergence. By doing so, we move away from MSE-based regression and ease estimation by avoiding variational approximations or distributional assumptions. We investigate the improved generalization ability of our proposed CS-IB and demonstrate strong adversarial robustness guarantees. We demonstrate its superior performance on six real-world regression tasks over other popular deep IB approaches. We additionally observe that the solutions discovered by CS-IB always achieve the best trade-off between prediction accuracy and compression ratio in the information plane. The code is available at {\textbackslash}url\{https://github.com/SJYuCNEL/Cauchy-Schwarz-Information-Bottleneck\}.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\Z9LDD8GG\Yu et al. - 2023 - Cauchy-Schwarz Divergence Information Bottleneck f.pdf}
}

@article{yuCompressingDeepModels2017,
  title = {On {{Compressing Deep Models}} by {{Low Rank}} and {{Sparse Decomposition}}},
  author = {Yu, Xiyu and Liu, Tongliang and Wang, Xinchao and Tao, Dacheng},
  year = {2017},
  month = jul,
  journal = {2017 IEEE Conference on Computer Vision and Pattern Recognition (CVPR)},
  pages = {67--76},
  publisher = {IEEE},
  address = {Honolulu, HI},
  doi = {10.1109/CVPR.2017.15},
  urldate = {2023-11-29},
  abstract = {Deep compression refers to removing the redundancy of parameters and feature maps for deep learning models. Low-rank approximation and pruning for sparse structures play a vital role in many compression works. However, weight filters tend to be both low-rank and sparse. Neglecting either part of these structure information in previous methods results in iteratively retraining, compromising accuracy, and low compression rates. Here we propose a unified framework integrating the low-rank and sparse decomposition of weight matrices with the feature map reconstructions. Our model includes methods like pruning connections as special cases, and is optimized by a fast SVD-free algorithm. It has been theoretically proven that, with a small sample, due to its generalizability, our model can well reconstruct the feature maps on both training and test data, which results in less compromising accuracy prior to the subsequent retraining. With such a warm start to retrain, the compression method always possesses several merits: (a) higher compression rates, (b) little loss of accuracy, and (c) fewer rounds to compress deep models. The experimental results on several popular models such as AlexNet, VGG-16, and GoogLeNet show that our model can significantly reduce the parameters for both convolutional and fully-connected layers. As a result, our model reduces the size of VGG-16 by 15\&\#xd7;, better than other recent compression methods that use a single strategy.},
  isbn = {9781538604571}
}

@inproceedings{yuDropoutEnhancedBilevel2023,
  title = {Dropout {{Enhanced Bilevel Training}}},
  booktitle = {The {{Twelfth International Conference}} on {{Learning Representations}}},
  author = {Yu, Peiran and Li, Junyi and Huang, Heng},
  year = {2023},
  month = oct,
  urldate = {2024-06-17},
  abstract = {Bilevel optimization problems appear in many widely used machine learning tasks. Bilevel optimization models are sensitive to small changes, and bilevel training tasks typically involve limited datasets. Therefore, overfitting is a common challenge in bilevel training tasks. This paper considers the use of dropout to address this problem. We propose a bilevel optimization model that depends on the distribution of dropout masks. We investigate how the dropout rate affects the hypergradient of this model. We propose a dropout bilevel method to solve the dropout bilevel optimization model. Subsequently, we analyze the resulting dropout bilevel method from an optimization perspective. Analyzing the optimization properties of methods with dropout is essential because it provides convergence guarantees for methods using dropout. However, there has been limited investigation in this research direction. We provide the complexity of the resulting dropout bilevel method in terms of reaching an \${\textbackslash}epsilon\$ stationary point of the proposed stochastic bilevel model. Empirically, we demonstrate that overfitting occurs in data cleaning problems, and the method proposed in this work mitigates this issue.},
  langid = {english},
  annotation = {abstractTranslation: 二重レベル最適化問題は、多くの広く使用されている機械学習タスクに現れます。二重レベル最適化モデルは、わずかな変化に敏感であり、二重レベル学習タスクは通常、限られたデータセットを伴います。したがって、過学習は二重レベル学習タスクにおける一般的な課題です。本論文では、この問題に対処するためにドロップアウトの使用を検討します。我々は、ドロップアウトマスクの分布に依存する二重レベル最適化モデルを提案します。このモデルのハイパー勾配にドロップアウト率がどのように影響するかを調査します。ドロップアウト二重レベル最適化モデルを解くために、ドロップアウト二重レベル法を提案します。続いて、最適化の観点から、結果として得られるドロップアウト二重レベル法を分析します。ドロップアウトを使用する方法の最適化特性を分析することは、ドロップアウトを使用する方法の収束保証を提供する上で不可欠です。しかし、この研究方向における調査は限られています。提案された確率的二重レベルモデルの\${\textbackslash}epsilon\$定常点に到達するという点で、結果として得られるドロップアウト二重レベル法の複雑性を提供します。実験的に、過学習がデータクリーニングの問題で発生すること、および本研究で提案された方法がこの問題を軽減することを実証します。},
  file = {C:\Users\furuh\Zotero\storage\5JNSJT8Z\Yu et al. - 2023 - Dropout Enhanced Bilevel Training.pdf}
}

@inproceedings{yuExtractingSparseSpecialist2025,
  title = {Extracting {{Sparse Specialist Models}} from {{Generalist Models}}},
  booktitle = {{{ICASSP}} 2025 - 2025 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {Yu, Tao and Zhao, Xu and An, Yongqi and Zhu, Guibo and Tang, Ming and Wang, Jinqiao},
  year = {2025},
  month = apr,
  pages = {1--5},
  issn = {2379-190X},
  doi = {10.1109/ICASSP49660.2025.10887911},
  urldate = {2025-03-14},
  abstract = {Recently, several generalist models such as Contrastive Language Image Pre-training (CLIP) have demonstrated their capabilities of performing diverse downstream tasks through zero-shot or few-shot guidance. When these generalist models are used for the specific downstream task where only a fraction of features is relevant, they would suffer from a significant redundancy of parameters. While existing methods aim to achieve sparsity and specialization, they often require additional training and large datasets. In this paper, we propose a novel framework to extract a sparse specialist model from a generalist model using only few-shot samples, without any training. Our task-specific pruning framework defines task relevance metrics and employs weighted layer-wise pruning, preserving relevant features while removing redundancies. Experiments show that our method maintains nearly identical zero-shot accuracy compared to the original generalist models at 30\% sparsity, with only minimal decline at 50\%.},
  langid = {english},
  keywords = {Accuracy,Acoustics,Feature extraction,Image restoration,Measurement,Network Compression,Network Pruning,Numerical models,Signal processing,Speech processing,Termination of employment,Training,Vision-Language Models},
  annotation = {abstractTranslation: 最近、Contrastive Language Image Pre-Training（CLIP）などのいくつかのジェネラリストモデルは、ゼロショットまたは少数のショットガイダンスを通じて、多様なダウンストリームタスクを実行する能力を実証しています。これらのジェネラリストモデルが、機能のほんの一部のみが関連する特定のダウンストリームタスクに使用される場合、パラメーターの重大な冗長性に苦しむでしょう。既存の方法は、スパースと専門化を実現することを目的としていますが、多くの場合、追加のトレーニングと大規模なデータセットが必要です。この論文では、トレーニングなしで、少数のショットサンプルのみを使用して、ジェネラリストモデルからまばらな専門モデルを抽出する新しいフレームワークを提案します。 Our task-specific pruning framework defines task relevance metrics and employs weighted layer-wise pruning, preserving relevant features while removing redundancies.実験では、私たちの方法は、30％のスパースでの元のジェネラリストモデルと比較してほぼ同一のゼロショット精度を維持し、50％で最小限の低下しか維持されていません。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\DIXG3I3P\\Yu et al. - 2025 - Extracting Sparse Specialist Models from Generalist Models.pdf;C\:\\Users\\furuh\\Zotero\\storage\\8DWP69NB\\10887911.html}
}

@misc{yuKANMLPFairer2024,
  title = {{{KAN}} or {{MLP}}: {{A Fairer Comparison}}},
  shorttitle = {{{KAN}} or {{MLP}}},
  author = {Yu, Runpeng and Yu, Weihao and Wang, Xinchao},
  year = {2024},
  month = jul,
  number = {arXiv:2407.16674},
  eprint = {2407.16674},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2407.16674},
  urldate = {2024-07-28},
  abstract = {This paper does not introduce a novel method. Instead, it offers a fairer and more comprehensive comparison of KAN and MLP models across various tasks, including machine learning, computer vision, audio processing, natural language processing, and symbolic formula representation. Specifically, we control the number of parameters and FLOPs to compare the performance of KAN and MLP. Our main observation is that, except for symbolic formula representation tasks, MLP generally outperforms KAN. We also conduct ablation studies on KAN and find that its advantage in symbolic formula representation mainly stems from its B-spline activation function. When B-spline is applied to MLP, performance in symbolic formula representation significantly improves, surpassing or matching that of KAN. However, in other tasks where MLP already excels over KAN, B-spline does not substantially enhance MLP's performance. Furthermore, we find that KAN's forgetting issue is more severe than that of MLP in a standard class-incremental continual learning setting, which differs from the findings reported in the KAN paper. We hope these results provide insights for future research on KAN and other MLP alternatives. Project link: https://github.com/yu-rp/KANbeFair},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Machine Learning}
}

@misc{yukawaContinuousRelaxationDiscontinuous2024,
  title = {Continuous {{Relaxation}} of {{Discontinuous Shrinkage Operator}}: {{Proximal Inclusion}} and {{Conversion}}},
  shorttitle = {Continuous {{Relaxation}} of {{Discontinuous Shrinkage Operator}}},
  author = {Yukawa, Masahiro},
  year = {2024},
  month = sep,
  number = {arXiv:2409.05316},
  eprint = {2409.05316},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2409.05316},
  urldate = {2025-01-14},
  abstract = {We present a principled way of deriving a continuous relaxation of a given discontinuous shrinkage operator, which is based on a couple of fundamental results. First, the image of a point with respect to the ``set-valued'' proximity operator of a nonconvex function is included by that for its lower semicontinuous (l.s.c.) 1-weakly-convex envelope. Second, the ``set-valued'' proximity operator of a proper l.s.c. 1-weakly-convex function is converted, via double inversion, to a ``single-valued'' proximity operator which is Lipschitz continuous. As a specific example, we derive a continuous relaxation of the discontinuous shrinkage operator associated with the reversely ordered weighted \${\textbackslash}ell\_1\$ (ROWL) penalty. Numerical examples demonstrate potential advantages of the continuous relaxation.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Mathematics - Optimization and Control},
  annotation = {abstractTranslation: 我々は、いくつかの基本的な結果に基づいて、特定の不連続収縮演算子の連続緩和を導出する原理的な方法を提示します。まず、非凸関数の「設定値」近接演算子に関する点のイメージが、その下部の半連続 (l.s.c.) 1 弱凸エンベロープのイメージに含まれます。 2 番目に、適切な l.s.c. の「設定値」近接演算子。 1 弱凸関数は、二重反転を介して、リプシッツ連続である「単一値」近接演算子に変換されます。特定の例として、逆順序の重み付き \${\textbackslash}ell\_1\$ (ROWL) ペナルティに関連付けられた不連続収縮演算子の連続緩和を導出します。数値例は、連続緩和の潜在的な利点を示しています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\SBQBG4DH\\Yukawa - 2024 - Continuous Relaxation of Discontinuous Shrinkage Operator Proximal Inclusion and Conversion.pdf;C\:\\Users\\furuh\\Zotero\\storage\\NMU5EMEN\\2409.html}
}

@misc{yukawaMonotoneLipschitzGradientDenoiser2025,
  title = {Monotone {{Lipschitz-Gradient Denoiser}}: {{Explainability}} of {{Operator Regularization Approaches Free From Lipschitz Constant Control}}},
  shorttitle = {Monotone {{Lipschitz-Gradient Denoiser}}},
  author = {Yukawa, Masahiro and Yamada, Isao},
  year = {2025},
  month = jan,
  number = {arXiv:2406.04676},
  eprint = {2406.04676},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2406.04676},
  urldate = {2025-01-21},
  abstract = {This paper addresses explainability of the operator-regularization approach under the use of monotone Lipschitz-gradient (MoL-Grad) denoiser -- an operator that can be expressed as the Lipschitz continuous gradient of a differentiable convex function. We prove that an operator is a MoL-Grad denoiser if and only if it is the ``single-valued'' proximity operator of a weakly convex function. An extension of Moreau's decomposition is also shown with respect to a weakly convex function and the conjugate of its convexified function. Under these arguments, two specific algorithms, the forward-backward splitting algorithm and the primal-dual splitting algorithm, are considered, both employing MoL-Grad denoisers. These algorithms generate a sequence of vectors converging weakly, under conditions, to a minimizer of a certain cost function which involves an ``implicit regularizer'' induced by the denoiser. Unlike the previous studies of operator regularization, our framework requires no control of the Lipschitz constant in learning the denoiser. The theoretical findings are supported by simulations.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Electrical Engineering and Systems Science - Signal Processing,Mathematics - Optimization and Control},
  annotation = {abstractTranslation: この論文では、単調リプシッツ勾配 (MoL-Grad) デノイザー (微分可能な凸関数のリプシッツ連続勾配として表現できる演算子) を使用した演算子正則化アプローチの説明可能性について取り上げます。演算子が弱凸関数の「単一値」近接演算子である場合に限り、その演算子が MoL-Grad デノイザーであることを証明します。モローの分解の拡張は、弱凸関数とその凸関数の共役に関しても示されています。これらの議論の下で、前方後方分割アルゴリズムと主双対分割アルゴリズムという 2 つの特定のアルゴリズムが考慮されます。どちらも MoL-Grad デノイザーを使用します。これらのアルゴリズムは、条件下で、デノイザーによって誘発される「暗黙の正則化器」を含む特定のコスト関数の最小化関数に弱く収束する一連のベクトルを生成します。演算子正則化に関するこれまでの研究とは異なり、私たちのフレームワークでは、デノイザーの学習においてリプシッツ定数の制御は必要ありません。理論的発見はシミュレーションによって裏付けられています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\9K8UPW9H\\Yukawa と Yamada - 2025 - Monotone Lipschitz-Gradient Denoiser Explainability of Operator Regularization Approaches Free From.pdf;C\:\\Users\\furuh\\Zotero\\storage\\3NHG8IVT\\molgrad.html;C\:\\Users\\furuh\\Zotero\\storage\\4Z7DT2BQ\\2406.html}
}

