  year = {2024},
  month = oct,
  urldate = {2025-04-25},
  abstract = {Sparse regularization techniques are well-established in machine learning, yet their application in neural networks remains challenging due to the non-differentiability of penalties like the \$L\_1\$ norm, which is incompatible with stochastic gradient descent. A promising alternative is shallow weight factorization, where weights are decomposed into two factors, allowing for smooth optimization of \$L\_1\$-penalized neural networks by adding differentiable \$L\_2\$ regularization to the factors. In this work, we introduce deep weight factorization, extending previous shallow approaches to more than two factors. We theoretically establish equivalence of our deep factorization with non-convex sparse regularization and analyze its impact on training dynamics and optimization. Due to the limitations posed by standard training practices, we propose a tailored initialization scheme and identify important learning rate requirements necessary for training factorized networks. We demonstrate the effectiveness of our deep weight factorization through experiments on various architectures and datasets, consistently outperforming its shallow counterpart and widely used pruning methods.},
  langid = {english},
  keywords = {Favorite},
  annotation = {abstractTranslation: スパース正則化手法は機械学習において確立されているが、ニューラルネットワークへの適用は、\$L\_1\$ノルムのようなペナルティの非微分性により、確率的勾配降下法と相容れないため、依然として課題が残る。有望な代替策はshallow weight factorizationであり、重みを2つの因子に分解し、因子に微分可能な\$L\_2\$正則化を加えることで、\$L\_1\$ペナルティ付きニューラルネットワークの滑らかな最適化を可能にする。本研究では、従来のshallowアプローチを拡張し、3つ以上の因子を用いるdeep weight factorizationを提案する。deep factorizationと非凸スパース正則化との等価性を理論的に確立し、学習ダイナミクスと最適化への影響を分析する。標準的な学習方法による制約のため、調整された初期化スキームを提案し、因子分解されたネットワークの学習に必要な重要な学習率要件を特定する。様々なアーキテクチャとデータセットを用いた実験を通して、提案するdeep weight factorizationの有効性を示し、shallowな手法や広く用いられている枝刈り手法を一貫して凌駕することを示す。},
  file = {C:\Users\furuh\Zotero\storage\FKZ4YM9J\Kolb et al. - 2024 - Deep Weight Factorization Sparse Learning Through the Lens of Artificial Symmetries.pdf}
}

@article{kolbeinssonTensorDropoutRobust2021,
