@misc{einkemmerLowrankProjectorsplittingIntegrator2018,
  title = {A Low-Rank Projector-Splitting Integrator for the {{Vlasov--Poisson}} Equation},
  author = {Einkemmer, Lukas and Lubich, Christian},
  year = {2018},
  month = jun,
  number = {arXiv:1801.01103},
  eprint = {1801.01103},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1801.01103},
  urldate = {2024-12-21},
  abstract = {Many problems encountered in plasma physics require a description by kinetic equations, which are posed in an up to six-dimensional phase space. A direct discretization of this phase space, often called the Eulerian approach, has many advantages but is extremely expensive from a computational point of view. In the present paper we propose a dynamical low-rank approximation to the Vlasov--Poisson equation, with time integration by a particular splitting method. This approximation is derived by constraining the dynamics to a manifold of low-rank functions via a tangent space projection and by splitting this projection into the subprojections from which it is built. This reduces a time step for the six- (or four-) dimensional Vlasov--Poisson equation to solving two systems of three- (or two-) dimensional advection equations over the time step, once in the position variables and once in the velocity variables, where the size of each system of advection equations is equal to the chosen rank. By a hierarchical dynamical low-rank approximation, a time step for the Vlasov--Poisson equation can be further reduced to a set of six (or four) systems of one-dimensional advection equations, where the size of each system of advection equations is still equal to the rank. The resulting systems of advection equations can then be solved by standard techniques such as semi-Lagrangian or spectral methods. Numerical simulations in two and four dimensions for linear Landau damping, for a two-stream instability and for a plasma echo problem highlight the favorable behavior of this numerical method and show that the proposed algorithm is able to drastically reduce the required computational effort.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Numerical Analysis,Physics - Computational Physics},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\WCRUAWXF\\Einkemmer と Lubich - 2018 - A low-rank projector-splitting integrator for the Vlasov--Poisson equation.pdf;C\:\\Users\\furuh\\Zotero\\storage\\FFH9CPNK\\1801.html}
}

@misc{einkemmerReviewLowrankMethods2024,
  title = {A Review of Low-Rank Methods for Time-Dependent Kinetic Simulations},
  author = {Einkemmer, Lukas and Kormann, Katharina and Kusch, Jonas and McClarren, Ryan G. and Qiu, Jing-Mei},
  year = {2024},
  month = dec,
  number = {arXiv:2412.05912},
  eprint = {2412.05912},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2412.05912},
  urldate = {2024-12-13},
  abstract = {Time-dependent kinetic models are ubiquitous in computational science and engineering. The underlying integro-differential equations in these models are high-dimensional, comprised of a six--dimensional phase space, making simulations of such phenomena extremely expensive. In this article we demonstrate that in many situations, the solution to kinetics problems lives on a low dimensional manifold that can be described by a low-rank matrix or tensor approximation. We then review the recent development of so-called low-rank methods that evolve the solution on this manifold. The two classes of methods we review are the dynamical low-rank (DLR) method, which derives differential equations for the low-rank factors, and a Step-and-Truncate (SAT) approach, which projects the solution onto the low-rank representation after each time step. Thorough discussions of time integrators, tensor decompositions, and method properties such as structure preservation and computational efficiency are included. We further show examples of low-rank methods as applied to particle transport and plasma dynamics.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Numerical Analysis,Mathematics - Numerical Analysis,Physics - Computational Physics,Physics - Plasma Physics},
  annotation = {時間依存の動力学モデルは、計算科学や工学の分野ではどこにでもある。これらのモデルの基礎となる積分微分方程式は6次元の位相空間からなる高次元であり、このような現象のシミュレーションを非常に高価なものにしている。この論文では、多くの状況において、動力学問題の解は、低ランクの行列またはテンソル近似によって記述できる低次元の多様体上に存在することを示す。次に、この多様体上の解を進化させる、いわゆる低ランク法の最近の発展についてレビューする。低ランク因子の微分方程式を導く動的低ランク（DLR）法と、各時間ステップの後に解を低ランク表現に投影するステップ・アンド・トランケート（SAT）法である。時間積分器、テンソル分解、および構造保存や計算効率などの手法の特性についての徹底的な議論も含まれる。さらに、低ランク法を粒子輸送やプラズマダイナミクスに適用した例を示す。},
  file = {C:\Users\furuh\Zotero\storage\DI5EPXUV\Einkemmer et al. - 2024 - A review of low-rank methods for time-dependent kinetic simulations.pdf}
}

