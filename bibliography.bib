  issn = {2379-190X},
  doi = {10.1109/ICASSP49660.2025.10888203},
  urldate = {2025-03-14},
  abstract = {In this paper, we study the sparse principal component analysis (PCA) problem in high-dimensional settings. We propose a novel row-sparse principal subspace estimator, which estimates the subspace spanned by multiple eigenvectors based on the variance maximization problem with a nonconvex sparsity regularizer. To tackle the nonconvex estimation problem, we introduce a minorization-maximization (MM) algorithm to decompose it into a sequence of convex subproblems. Each subproblem is solved based on the alternating direction method of multipliers. Theoretically, we provide a comprehensive analysis of both the computational and statistical properties of the iterates from the MM algorithm. We demonstrate that the proposed sparse PCA estimator can achieve the same statistical rate as the oracle estimator. Simulation results corroborate the theoretical findings and highlight the superiority of the proposed sparse PCA estimator.},
  langid = {english},
  keywords = {Acoustics,Estimation,minorization-maximization,nonconvex statistical optimization,Principal component analysis,principal subspace estimation,Signal processing,Signal processing algorithms,Simulation,sparsity,Speech processing},
  annotation = {abstractTranslation: この論文では、高次元設定でスパース主成分分析（PCA）問題を研究します。非コンベックススパースリガイザーの分散最大化問題に基づいて、複数の固有ベクトルが及ぶサブスペースを推定する新しいRow-Sparse主要な部分空間推定器を提案します。非コンベックスの推定問題に取り組むために、マイナー化最大化（MM）アルゴリズムを導入して、凸面サブ問題のシーケンスに分解します。各サブ問題は、乗数の交互方向方法に基づいて解決されます。理論的には、MMアルゴリズムからの反復の計算特性と統計的特性の両方の包括的な分析を提供します。提案されているスパースPCA推定器がOracle推定器と同じ統計レートを達成できることを実証します。シミュレーション結果は、理論的な調査結果を裏付け、提案されたまばらなPCA推定器の優位性を強調します。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\XGJ42B69\\Zhong と Zhao - 2025 - Sparse PCA with Oracle Rate in High Dimensions.pdf;C\:\\Users\\furuh\\Zotero\\storage\\B2A9WY9T\\10888203.html}
