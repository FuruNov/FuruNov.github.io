@inproceedings{croceSparseImperceivableAdversarial2019,
  title = {Sparse and {{Imperceivable Adversarial Attacks}}},
  booktitle = {2019 {{IEEE}}/{{CVF International Conference}} on {{Computer Vision}} ({{ICCV}})},
  author = {Croce, Francesco and Hein, Matthias},
  year = {2019},
  month = oct,
  pages = {4723--4731},
  publisher = {IEEE},
  address = {Seoul, Korea (South)},
  doi = {10.1109/ICCV.2019.00482},
  urldate = {2024-11-18},
  abstract = {Neural networks have been proven to be vulnerable to a variety of adversarial attacks. From a safety perspective, highly sparse adversarial attacks are particularly dangerous. On the other hand the pixelwise perturbations of sparse attacks are typically large and thus can be potentially detected. We propose a new black-box technique to craft adversarial examples aiming at minimizing l0distance to the original image. Extensive experiments show that our attack is better or competitive to the state of the art. Moreover, we can integrate additional bounds on the componentwise perturbation. Allowing pixels to change only in region of high variation and avoiding changes along axisaligned edges makes our adversarial examples almost nonperceivable. Moreover, we adapt the Projected Gradient Descent attack to the l0-norm integrating componentwise constraints. This allows us to do adversarial training to enhance the robustness of classifiers against sparse and imperceivable adversarial manipulations.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  isbn = {978-1-7281-4803-8},
  langid = {english},
  annotation = {abstractTranslation: ニューラルネットワークは様々な敵対的攻撃に対して脆弱であることが証明されている。安全性の観点からは、非常にスパースな敵対的攻撃は特に危険である。一方、スパース攻撃のピクセル単位の摂動は一般的に大きいため、検出できる可能性がある。我々は、原画像とのl0距離を最小化することを目的とした、敵対的な例を作成する新しいブラックボックス技術を提案する。広範な実験により、我々の攻撃は最新の技術よりも優れている、あるいは拮抗していることを示す。さらに、構成要素ごとの摂動に関する追加的な境界を統合することができる。変動が大きい領域でのみピクセルの変化を許容し、軸に沿ったエッジでの変化を避けることで、我々の敵対的な例はほとんど知覚不可能になる。さらに、Projected Gradient Descent 攻撃を、成分的制約を積分したl0-normに適応させる。これにより、敵対的な学習が可能となり、疎な敵対的な操作に対する分類器の頑健性が向上する。},
  file = {C:\Users\furuh\Zotero\storage\XDQAC989\Croce と Hein - 2019 - Sparse and Imperceivable Adversarial Attacks.pdf}
}

@book{crockettBilevelMethodsImage2022,
  title = {Bilevel {{Methods}} for {{Image Reconstruction}}},
  author = {Crockett, Caroline and Fessler, Jeffrey A.},
  year = {2022},
  publisher = {NOW PUBLISHERS},
  address = {S.l.},
  abstract = {This review discusses methods for learning parameters for image reconstruction problems using bilevel formulations. Image reconstruction typically involves optimizing a cost function to recover a vector of unknown variables that agrees with collected measurements and prior assumptions. State-of-the-art image reconstruction methods learn these prior assumptions from training data using various machine learning techniques, such as bilevel methods. One can view the bilevel problem as formalizing hyperparameter optimization, as bridging machine learning and cost function based optimization methods, or as a method to learn variables best suited to a specific task. More formally, bilevel problems attempt to minimize an upper-level loss function, where variables in the upper-level loss function are themselves minimizers of a lower-level cost function. This review contains a running example problem of learning tuning parameters and the coefficients for sparsifying filters used in a regularizer. Such filters generalize the popular total variation regularization method, and learned filters are closely related to convolutional neural networks approaches that are rapidly gaining in popularity. Here, the lower-level problem is to reconstruct an image using a regularizer with learned sparsifying filters; the corresponding upper-level optimization problem involves a measure of reconstructed image quality based on training data. This review discusses multiple perspectives to motivate the use of bilevel methods and to make them more easily accessible to different audiences. We then turn to ways to optimize the bilevel problem, providing pros and cons of the variety of proposed approaches. Finally we overview bilevel applications in image reconstruction.},
  isbn = {978-1-63828-002-6},
  langid = {english},
  annotation = {OCLC: 1325664494\\
abstractTranslation: このレビューでは、バイレベル定式化を使用した画像再構成の問題のパラメーターを学習する方法について説明します。画像の再構築には、通常、コスト関数を最適化して、収集された測定値と以前の仮定と一致する未知の変数のベクトルを回復します。最先端の画像再構成方法は、Bilevel Methodなどのさまざまな機械学習技術を使用して、トレーニングデータからこれらの以前の仮定を学びます。橋渡しの問題は、機械学習およびコスト関数ベースの最適化方法として、または特定のタスクに最適な変数を学習する方法として、ハイパーパラメーターの最適化を正式化するものとして見ることができます。より正式には、バイレベルの問題は、上位レベルの損失関数の変数自体が低レベルのコスト関数のミニマイズである上位レベルの損失関数を最小限に抑えようとします。このレビューには、学習チューニングパラメーターの学習の問題と、正規者で使用されるフィルターをSparsifingする係数が含まれています。このようなフィルターは、一般的なバリエーションの正規化方法を一般化し、学習したフィルターは、人気が急速に獲得されている畳み込みニューラルネットワークアプローチと密接に関連しています。ここでは、下位レベルの問題は、学習したスパースフィルターを使用して正規者を使用して画像を再構築することです。対応する上位レベルの最適化問題には、トレーニングデータに基づいて再構築された画質の尺度が含まれます。このレビューでは、複数の視点について説明し、バイレベル法の使用を動機付け、さまざまな視聴者が簡単にアクセスできるようにします。次に、バイレベルの問題を最適化する方法に目を向け、提案されているさまざまなアプローチの長所と短所を提供します。最後に、画像再構成のBilevelアプリケーションを概要します。},
  file = {C:\Users\furuh\Zotero\storage\Y36A5DA8\CROCKETT - 2022 - BILEVEL METHODS FOR IMAGE RECONSTRUCTION.pdf}
}

