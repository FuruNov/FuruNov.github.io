  urldate = {2025-05-10},
  abstract = {Selecting an appropriate optimization method to promote sparsity is of great significance for sparse recovery. In this paper, a novel scale-invariant Lp/Lq minimization method which employs the ratio of {\textbackslash}ell\_p {\textbackslash},(p {\i}n (0,1]) and {\textbackslash}ell\_q {\textbackslash},(q {\textbackslash}gt p) (quasi-) norms is proposed. Based on the prior block support information, mild condition in the frame of block restricted isometry property is established to ensure the stable and robust recovery of approximately block k-sparse signals in different noise settings. Numerical studies support the recoverability of the proposed method and suggest that the new method yields better performance of block-sparse signal recovery compared with the existing results.},
  langid = {english},
  keywords = {approximate block-sparsity,block restricted isometry property (block-RIP),Compressed sensing,DNA,Indexes,L p /L q nonconvex minimization,Linear programming,Minimization methods,Noise,Noise measurement,Radio frequency,sparse representation,sparse signal recovery,Training,Vectors},
  annotation = {abstractTranslation: 適切なスパース性促進のための最適化手法の選択は、スパース復元において非常に重要である。本稿では、{\textbackslash}ell\_p {\textbackslash},(p {\textbackslash}in (0,1])と{\textbackslash}ell\_q {\textbackslash},(q {$>$} p)（準）ノルムの比を用いる、新たなスケール不変なLp/Lq最小化法を提案する。ブロック事前サポート情報に基づき、ブロック制限等長性条件の枠組みにおいて、近似的なブロックk-スパース信号の安定かつロバストな復元を保証するための緩やかな条件を、異なるノイズ設定下で確立する。数値実験により、提案手法の復元可能性が支持され、既存の結果と比較して、本手法がブロック-スパース信号復元においてより優れた性能を示すことが示唆される。},
  file = {C:\Users\furuh\Zotero\storage\TXZXAZBF\authors.html}
}

@article{zhaNonconvexStructuralSparsity2022,
  title = {Nonconvex {{Structural Sparsity Residual Constraint}} for {{Image Restoration}}},
  author = {Zha, Zhiyuan and Yuan, Xin and Wen, Bihan and Zhang, Jiachao and Zhu, Ce},
  year = {2022},
  month = nov,
  journal = {IEEE Transactions on Cybernetics},
  volume = {52},
  number = {11},
  pages = {12440--12453},
  issn = {2168-2267, 2168-2275},
  doi = {10.1109/TCYB.2021.3084931},
  urldate = {2023-12-03},
  abstract = {This article proposes a novel nonconvex structural sparsity residual constraint (NSSRC) model for image restoration, which integrates structural sparse representation (SSR) with nonconvex sparsity residual constraint (NC-SRC). Although SSR itself is powerful for image restoration by combining the local sparsity and nonlocal self-similarity in natural images, in this work, we explicitly incorporate the novel NC-SRC prior into SSR. Our proposed approach provides more effective sparse modeling for natural images by applying a more flexible sparse representation scheme, leading to high-quality restored images. Moreover, an alternating minimizing framework is developed to solve the proposed NSSRC-based image restoration problems. Extensive experimental results on image denoising and image deblocking validate that the proposed NSSRC achieves better results than many popular or state-of-the-art methods over several publicly available datasets.}
}

@article{zhaNonlocalStructuredSparsity2023,
  title = {Nonlocal {{Structured Sparsity Regularization Modeling}} for {{Hyperspectral Image Denoising}}},
  author = {Zha, Zhiyuan and Wen, Bihan and Yuan, Xin and Zhang, Jiachao and Zhou, Jiantao and Lu, Yilong and Zhu, Ce},
  year = {2023},
  journal = {IEEE Transactions on Geoscience and Remote Sensing},
  volume = {61},
  pages = {1--16},
  issn = {1558-0644},
  doi = {10.1109/TGRS.2023.3269224},
  urldate = {2024-07-17},
  abstract = {The nonlocal-based model for hyperspectral image (HSI) denoising first uses nonlocal self-similarity (NSS) prior to group similar full-band patches into 3-D nonlocal full-band groups (tensors) using a block matching (BM) operation, and then a low-rank (LR) penalty is typically applied to each nonlocal full-band group to reduce noise. While nonlocal-based methods have shown promising performance in HSI denoising, most existing methods have only considered the LR property of the nonlocal full-band group while ignoring the strong correlation between sparse coefficients. Moreover, such methods often result in unsatisfactory visual artifacts due to the noise sensitivity of BM operations, while requiring expensive computations. To address these limitations, this article proposes a novel nonlocal structured sparsity regularization (NLSSR) approach for HSI denoising. First, to mitigate the noise sensitivity of the BM operation, we propose a graph-based domain distance scheme to index similar full-band patches to form the nonlocal full-band group. Second, we design an adaptive unidirectional LR dictionary with low complexity that takes into account the differences in intrinsic structure correlation among different modes of the nonlocal full-band tensor. Third, we utilize a global spectral LR prior to reduce spectral redundancy. Fourth, we develop a generalized soft-thresholding (GST) algorithm based on the alternating minimization framework to solve the NLSSR-based HSI denoising problem. We perform extensive experiments on both simulated and real data to show that the proposed NLSSR algorithm outperforms many popular or state-of-the-art HSI denoising methods in both quantitative and visual evaluations.},
  langid = {american},
  keywords = {Alternating minimization algorithm,Correlation,generalized soft-thresholding (GST),graph-based block matching (BM),hyperspectral image (HSI) denoising,Image denoising,low-rank (LR),Noise measurement,Noise reduction,nonlocal self-similarity (NSS),Sensitivity,structured sparsity,Tensors,Visualization},
  annotation = {abstractTranslation: ハイパースペクトル画像（HSI）ノイズ除去のための非局所ベースモデルは、まず非局所自己相似性（NSS）を用いて、類似したフルバンドパッチをブロックマッチング（BM）演算を用いて3次元の非局所フルバンドグループ（テンソル）にグループ化し、次に低ランク（LR）ペナルティを各非局所フルバンドグループに適用してノイズを低減するのが一般的である。非局所ベースの手法はHSIノイズ除去において有望な性能を示しているが、既存の手法の多くは、非局所フルバンドグループのLR特性のみを考慮し、スパース係数間の強い相関を無視している。さらに、このような手法は、BM演算のノイズ感度のために、しばしば満足のいかない視覚的アーチファクトを生じ、同時に高価な計算を必要とする。これらの限界に対処するため、本稿ではHSIノイズ除去のための新しい非局所構造化スパース正則化（NLSSR）アプローチを提案する。第一に、BM演算のノイズ感度を緩和するために、非局所フルバンドグループを形成する類似フルバンドパッチにインデックスを付けるグラフベースのドメイン距離スキームを提案する。第二に、非局所フルバンドテンソルの異なるモード間の固有構造相関の違いを考慮した、複雑度の低い適応的な一方向LR辞書を設計する。第3に、スペクトルの冗長性を低減するために、大域的なスペクトルLR事前分布を利用する。第四に、NLSSRに基づくHSIノイズ除去問題を解くために、交互最小化フレームワークに基づく一般化ソフト閾値(GST)アルゴリズムを開発する。シミュレーションデータと実データの両方で広範な実験を行い、提案するNLSSRアルゴリズムが、定量的評価と視覚的評価の両方において、多くの一般的な、あるいは最先端のHSIノイズ除去法を凌駕することを示す。},
  file = {C:\Users\furuh\Zotero\storage\8QF48UBG\Zha et al. - 2023 - Nonlocal Structured Sparsity Regularization Modeli.pdf}
}

@article{zhanSparseRepresentationLp2025,
  title = {Sparse Representation for {$\ell$}p - {$A\ell$}q Minimization and Uniform Condition for the Recovery of Approximately k-Sparse Signals with Prior Support Information},
  author = {Zhan, Kunsheng and Wan, Anhua},
  year = {2025},
  month = oct,
  journal = {Signal Processing},
  volume = {235},
  pages = {110019},
  issn = {0165-1684},
  doi = {10.1016/j.sigpro.2025.110019},
  urldate = {2025-05-10},
  abstract = {In the frame of {$\ell$}p-{$\alpha\ell$}q metric, a novel lemma of sparse representation is developed. Uniform sufficient conditions for the stable recovery of approximately k-sparse signals with partial support information are derived in different noise settings via weighted {$\ell$}p-{$\alpha\ell$}q minimization method, and moreover, the reconstruction error bounds are precisely characterized. Specifying different values of the parameters p{$\in$}(0,1],q{$\in$}[p,+{$\infty$}] and {$\alpha\in$}[0,1] in the new results leads to some important special cases, including the optimal results in terms of {$\ell$}1 convex minimization, {$\ell$}p nonconvex minimization, {$\ell$}1-{$\ell$}2 minimization, {$\ell$}1-{$\alpha\ell$}q minimization and {$\ell$}p-{$\alpha\ell$}1 minimization in the literature. A series of numerical experiments demonstrate the advantage of the new method for sparse recovery.},
  keywords = {Compressed sensing,nonconvex minimization,Restricted isometry property,Sparse representation,Sparse signal recovery}
}

@article{zhaoAdaptiveWeightingFunction2024,
  title = {Adaptive Weighting Function for Weighted Nuclear Norm Based Matrix/Tensor Completion},
  author = {Zhao, Qian and Lin, Yuji and Wang, Fengxingyu and Meng, Deyu},
  year = {2024},
  month = feb,
  journal = {International Journal of Machine Learning and Cybernetics},
  volume = {15},
  number = {2},
  pages = {697--718},
  issn = {1868-808X},
  doi = {10.1007/s13042-023-01935-1},
  urldate = {2024-08-22},
  abstract = {Weighted nuclear norm provides a simple yet powerful tool to characterize the intrinsic low-rank structure of a matrix, and has been successfully applied to the matrix completion problem. However, in previous studies, the weighting functions to calculate the weights are fixed beforehand, and do not change during the whole iterative process. Such predefined weighting functions may not be able to precisely characterize the complicated structure underlying the observed data matrix, especially in the dynamic estimation process, and thus limits its performance. To address this issue, we propose a strategy of adaptive weighting function, for low-rank matrix/tensor completion. Specifically, we first parameterize the weighting function as a simple yet flexible neural network, that can approximate a wide range of monotonic decreasing functions. Then we propose an effective strategy, by virtue of the bi-level optimization technique, to adapt the weighting function, and incorporate this strategy to the alternating direction method of multipliers for solving low-rank matrix and tensor completion problems. Our empirical studies on a series of synthetic and real data have verified the effectiveness of the proposed approach, as compared with representative low-rank matrix and tensor completion methods.},
  langid = {english},
  keywords = {Adaptive weighting function,Artificial Intelligence,Low-rankness,Matrix/tensor completion,Weighted nuclear norm},
  annotation = {abstractTranslation:  重み付き核ノルムは、行列の本質的な低ランク構造を特徴付ける簡単かつ強力な手段を提供し、行列補完問題への適用に成功している。しかし、これまでの研究では、重みを計算するための重み付け関数はあらかじめ固定されており、繰り返し処理の全過程で変化することはない。このようなあらかじめ定義された重み付け関数は、特に動的な推定過程において、観測データ行列の根底にある複雑な構造を正確に特徴付けることができない可能性があり、その結果、その性能に限界がある。この問題に対処するために、我々は、低ランク行列/テンソル補完のための適応的重み付け関数の戦略を提案する。具体的には、まず重み付け関数を単純かつ柔軟なニューラルネットワークとしてパラメータ化し、幅広い単調減少関数を近似できるようにする。次に、2値最適化技術により、重み付け関数を適応させる効果的な戦略を提案し、この戦略を低ランク行列・テンソル補完問題を解くための交互方向の乗法に組み込む。一連の合成データおよび実データを用いた実証研究により、代表的な低ランク行列およびテンソル補完法と比較して、提案手法の有効性が検証された。},
  file = {C:\Users\furuh\Zotero\storage\ZUFGWB8N\Zhao et al. - 2024 - Adaptive weighting function for weighted nuclear n.pdf}
}

@article{zhaoBlockSparseCodingBasedMachine2021,
  title = {Block-{{Sparse Coding-Based Machine Learning Approach}} for {{Dependable Device-Free Localization}} in {{IoT Environment}}},
  author = {Zhao, Lingjun and Huang, Huakun and Su, Chunhua and Ding, Shuxue and Huang, Huawei and Tan, Zhiyuan and Li, Zhenni},
  year = {2021},
  month = mar,
  journal = {IEEE Internet of Things Journal},
  volume = {8},
  number = {5},
  pages = {3211--3223},
  issn = {2327-4662},
  doi = {10.1109/JIOT.2020.3019732},
  urldate = {2024-08-02},
  abstract = {Device-free localization (DFL) locates targets without equipping with wireless devices or tag under the Internet-of-Things (IoT) architectures. As an emerging technology, DFL has spawned extensive applications in the IoT environment, such as intrusion detection, mobile robot localization, and location-based services. Current DFL-related machine learning (ML) algorithms still suffer from low localization accuracy and weak dependability/robustness because the group structure has not been considered in their location estimation, which leads to an undependable process. To overcome these challenges, we propose in this work a dependable block-sparse scheme by particularly considering the group structure of signals. An accurate and robust ML algorithm named block-sparse coding with the proximal operator (BSCPO) is proposed for DFL. In addition, a severe Gaussian noise is added in the original sensing signals for preserving network-related privacy as well as improving the dependability of the model. The real-world data-driven experimental results show that the proposed BSCPO achieves robust localization and signal-recovery performance even under severely noisy conditions and outperforms state-of-the-art DFL methods. For single-target localization, BSCPO retains high accuracy when the signal-to-noise ratio exceeds -10 dB. BSCPO is also able to localize accurately under most multitarget localization test cases.},
  keywords = {Block,Communication system security,device-free localization (DFL),Encoding,Internet of Things,Machine learning,machine learning (ML),multiple targets,Sensors,sparse coding,Wireless communication,Wireless sensor networks},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\SRGFC3ZA\\Zhao et al. - 2021 - Block-Sparse Coding-Based Machine Learning Approac.pdf;C\:\\Users\\furuh\\Zotero\\storage\\8ALRZH82\\9178320.html}
}

@article{zhaoDynamicHypergraphStructure2023,
  title = {Dynamic {{Hypergraph Structure Learning}} for {{Traffic Flow Forecasting}}},
  author = {Zhao, Yusheng and Luo, Xiao and Ju, Wei and Chen, Chong and Hua, Xian-Sheng and Zhang, Ming},
  year = {2023},
  month = apr,
  journal = {2023 IEEE 39th International Conference on Data Engineering (ICDE)},
  pages = {2303--2316},
  publisher = {IEEE},
  address = {Anaheim, CA, USA},
  doi = {10.1109/ICDE55515.2023.00178},
  urldate = {2024-08-20},
  abstract = {This paper studies the problem of traffic flow forecasting, which aims to predict future traffic conditions on the basis of road networks and traffic conditions in the past. The problem is typically solved by modeling complex spatio-temporal correlations in traffic data using spatio-temporal graph neural networks (GNNs). However, the performance of these methods is still far from satisfactory since GNNs usually have limited representation capacity when it comes to complex traffic networks. Graphs, by nature, fall short in capturing non-pairwise relations. Even worse, existing methods follow the paradigm of message passing that aggregates neighborhood information linearly, which fails to capture complicated spatio-temporal high-order interactions. To tackle these issues, in this paper, we propose a novel model named Dynamic Hypergraph Structure Learning (DyHSL) for traffic flow prediction. To learn non-pairwise relationships, our DyHSL extracts hypergraph structural information to model dynamics in the traffic networks, and updates each node representation by aggregating messages from its associated hyperedges. Additionally, to capture high-order spatio-temporal relations in the road network, we introduce an interactive graph convolution block, which further models the neighborhood interaction for each node. Finally, we integrate these two views into a holistic multi-scale correlation extraction module, which conducts temporal pooling with different scales to model different temporal patterns. Extensive experiments on four popular traffic benchmark datasets demonstrate the effectiveness of our proposed DyHSL compared with a broad range of competing baselines.},
  copyright = {https://doi.org/10.15223/policy-029},
  isbn = {9798350322279},
  langid = {american},
  annotation = {abstractTranslation: 本論文では，道路ネットワークと過去の交通状況に基づいて将来の交通状況を予測することを目的とした交通流予測問題を研究する．この問題は通常，時空間グラフニューラルネットワーク（GNN）を用いて交通データの複雑な時空間相関をモデル化することで解決される．しかし、複雑な交通ネットワークを扱う場合、GNNの表現能力には限界があるため、これらの手法の性能はまだ満足のいくものではない。グラフはその性質上、非対関係を捉えるには不十分だからだ。さらに悪いことに、既存の手法は近隣情報を線形に集約するメッセージパッシングのパラダイムに従っているため、複雑な時空間的高次相互作用を捉えることができない。これらの問題に取り組むため、本稿では、交通流予測のための動的ハイパーグラフ構造学習（Dynamic Hypergraph Structure Learning: DyHSL）という新しいモデルを提案する。非対関係を学習するために、我々のDyHSLは交通ネットワークのダイナミクスをモデル化するためのハイパーグラフ構造情報を抽出し、関連するハイパーグラフからのメッセージを集約することで各ノードの表現を更新する。さらに、道路ネットワークにおける高次の時空間関係を捉えるために、対話的グラフ畳み込みブロックを導入し、各ノードの近傍相互作用をさらにモデル化する。最後に、これら2つの視点を全体的なマルチスケール相関抽出モジュールに統合し、異なる時間パターンをモデル化するために異なるスケールで時間プーリングを行う。4つの一般的なトラフィックベンチマークデータセットを用いた広範な実験により、我々の提案するDyHSLの有効性が、広範な競合ベースラインと比較して実証された。},
  file = {C:\Users\furuh\Zotero\storage\IKT5979H\Zhao et al. - 2023 - Dynamic Hypergraph Structure Learning for Traffic Flow Forecasting.pdf}
}

@misc{zhaoGaLoreMemoryEfficientLLM2024,
  title = {{{GaLore}}: {{Memory-Efficient LLM Training}} by {{Gradient Low-Rank Projection}}},
  shorttitle = {{{GaLore}}},
  author = {Zhao, Jiawei and Zhang, Zhenyu and Chen, Beidi and Wang, Zhangyang and Anandkumar, Anima and Tian, Yuandong},
  year = {2024},
  month = mar,
  number = {arXiv:2403.03507},
  eprint = {2403.03507},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2403.03507},
  urldate = {2024-03-11},
  abstract = {Training Large Language Models (LLMs) presents significant memory challenges, predominantly due to the growing size of weights and optimizer states. Common memory-reduction approaches, such as low-rank adaptation (LoRA), add a trainable low-rank matrix to the frozen pre-trained weight in each layer, reducing trainable parameters and optimizer states. However, such approaches typically underperform training with full-rank weights in both pre-training and fine-tuning stages since they limit the parameter search to a low-rank subspace and alter the training dynamics, and further, may require full-rank warm start. In this work, we propose Gradient Low-Rank Projection (GaLore), a training strategy that allows full-parameter learning but is more memory-efficient than common low-rank adaptation methods such as LoRA. Our approach reduces memory usage by up to 65.5\% in optimizer states while maintaining both efficiency and performance for pre-training on LLaMA 1B and 7B architectures with C4 dataset with up to 19.7B tokens, and on fine-tuning RoBERTa on GLUE tasks. Our 8-bit GaLore further reduces optimizer memory by up to 82.5\% and total training memory by 63.3\%, compared to a BF16 baseline. Notably, we demonstrate, for the first time, the feasibility of pre-training a 7B model on consumer GPUs with 24GB memory (e.g., NVIDIA RTX 4090) without model parallel, checkpointing, or offloading strategies.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning}
}

@inproceedings{zhaoGeneralizedGraphSignal2025,
  title = {Generalized {{Graph Signal Reconstruction}} via the {{Uncertainty Principle}}},
  booktitle = {{{ICASSP}} 2025 - 2025 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {Zhao, Yanan and Jian, Xingchao and Ji, Feng and Tay, Wee Peng and Ortega, Antonio},
  year = {2025},
  month = apr,
  pages = {1--5},
  issn = {2379-190X},
  doi = {10.1109/ICASSP49660.2025.10889406},
  urldate = {2025-03-14},
  abstract = {We introduce a novel uncertainty principle for generalized graph signals that extends classical time-frequency and graph uncertainty principles into a unified framework. By defining joint vertex-time and spectral-frequency spreads, we quantify signal localization across these domains, revealing a trade-off between them. This framework allows us to identify a class of signals with maximal energy concentration in both domains, forming the fundamental atoms for a new joint vertex-time dictionary. This dictionary enhances signal reconstruction under practical constraints, such as intermittent data, commonly encountered in sensor and social networks. Numerical experiments on real-world datasets demonstrate the effectiveness of the proposed approach, showing improved reconstruction accuracy and noise robustness compared to existing methods.},
