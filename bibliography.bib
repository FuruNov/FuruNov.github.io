@article{zhangLowRankMatrixRecovery2020,
  title = {Low-{{Rank Matrix Recovery}} via {{Modified Schatten-}}\$p\$ {{Norm Minimization With Convergence Guarantees}}},
  author = {Zhang, Hengmin and Qian, Jianjun and Zhang, Bob and Yang, Jian and Gong, Chen and Wei, Yang},
