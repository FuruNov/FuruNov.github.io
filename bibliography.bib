  doi = {10.1016/j.ins.2023.01.059},
  urldate = {2024-11-11},
  abstract = {Recently, graph neural networks (GNNs) have been widely used for graph representation learning, where the central idea is to recursively aggregate neighborhood information to update the node feature based on the graph topology. Therefore, an appropriate graph topology is crucial for effective graph representation learning in GNNs. However, most existing GNNs assume that the initial graph is complete and accurate, and utilize the fixed initial graph structure in the entire network, which may limit the learning representation capability of the model. In this work, we propose a novel differentiable graph structure learning neural network (DGSLN), which learns suitable graph structures for GNNs. Specifically, our DGSLN presents a general graph generation scheme that integrates various useful graph prior messages to generate normal structures. We describe the generation process with homophily, node degree, and sparsity as examples. Moreover, we develop a hybrid loss function to ensure the quality of learned graphs, which combines taskspecific loss and graph regularization loss to optimize graph structures from both structural adaptive and task-driven aspects. Extensive experiments on graph classification and node classification have shown that our approach significantly improves performance on different benchmark datasets compared to state-of-the-art GNNs methods.},
  langid = {english},
  annotation = {abstractTranslation: 近年、グラフニューラルネットワーク(GNN)はグラフ表現学習に広く用いられており、その中心的な考え方は、グラフトポロジーに基づいてノードの特徴を更新するために近傍情報を再帰的に集約することである。そのため、GNNにおける効果的なグラフ表現学習には、適切なグラフトポロジーが不可欠である。しかしながら、既存のGNNの多くは、初期グラフが完全かつ正確であることを前提としており、ネットワーク全体において固定された初期グラフ構造を利用しているため、モデルの学習表現能力が制限される可能性がある。本研究では、GNNに適したグラフ構造を学習する、新しい微分可能グラフ構造学習ニューラルネットワーク（DGSLN）を提案する。具体的には、我々のDGSLNは、通常の構造を生成するために、様々な有用なグラフ事前メッセージを統合する一般的なグラフ生成スキームを提示する。同類性、ノード次数、スパース性を例として、その生成過程を説明する。さらに、学習されたグラフの品質を保証するためのハイブリッド損失関数を開発する。これは、タスクに特化した損失とグラフ正則化損失を組み合わせ、構造適応的な側面とタスク駆動的な側面の両方からグラフ構造を最適化するものである。グラフ分類とノード分類に関する広範な実験により、我々のアプローチが、様々なベンチマークデータセットにおいて、最新のGNNs手法と比較して著しく性能を向上させることが示された。},
  file = {C:\Users\furuh\Zotero\storage\DV7AB7VW\Zou et al. - 2023 - DGSLN Differentiable graph structure learning neural network for robust graph representations.pdf}
}

@inproceedings{zouLargeCovarianceMatrix2025,
  title = {Large {{Covariance Matrix Estimation}} for {{Groups}} of {{Highly Correlated Variables}} via {{Nonconvex Optimization}}},
  booktitle = {{{ICASSP}} 2025 - 2025 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {Zou, Shanshan and Zhao, Ziping},
  year = {2025},
  month = apr,
  pages = {1--5},
  issn = {2379-190X},
  doi = {10.1109/ICASSP49660.2025.10890766},
  urldate = {2025-03-14},
  abstract = {This paper addresses the problem of covariance matrix estimation in scenarios where the underlying variables can be divided into groups, with variables within each group being highly correlated. Consequently, the covariance matrix displays both sparse and approximately low-rank characteristics due to these highly correlated groups. By appropriately rearranging the variables, the covariance matrix can be transformed into an approximately block diagonal form. In this work, we investigate the estimation of covariance matrices under this structure in high dimensions. We propose a least squares-based covariance estimation method that incorporates a trace norm along with a nonconvex sparsity regularizer to promote both low-rankness and sparsity. Additionally, we introduce a spectral constraint to ensure the positive semi-definiteness of the covariance matrix, even in cases of finite samples, while permitting the integration of prior spectral information. To solve this nonconvex statistical estimation problem, we develop an algorithm based on the majorization-minimization framework, which iteratively solves a convex subproblem. We provide theoretical guarantees that demonstrate the proposed algorithm converges to an estimator achieving the oracle statistical rate under mild technical conditions. Numerical experiments corroborate these theoretical findings.},
  langid = {english},
  keywords = {Acoustics,Approximation algorithms,block diagonal,Clustering algorithms,correlated clusters,Covariance matrices,Covariance matrix estimation,Estimation,joint sparse and low-rank,Least mean squares methods,nonconvex statistical optimization,Optimization,Signal processing,Signal processing algorithms,Speech processing},
  annotation = {abstractTranslation: このペーパーでは、基礎となる変数をグループに分割できるシナリオの共分散行列推定の問題に対処し、各グループ内の変数が高度に相関しています。その結果、共分散行列は、これらの高度に相関したグループのために、スパースとほぼ低いランクの両方の特性を表示します。変数を適切に再配置することにより、共分散マトリックスは、ほぼブロックの対角線形式に変換できます。この作業では、この構造の下での共分散行列の推定を高次元で調査します。トレース規範と非凸スパースリガイザーを組み込んだ最小二乗ベースの共分散推定方法を提案して、低ランクネスとスパースの両方を促進します。さらに、以前のスペクトル情報の統合を許可しながら、有限サンプルの場合でも、共分散行列の正の半定義を確保するためのスペクトル制約を導入します。この非凸統計的推定の問題を解決するために、凸型のサブ問題を繰り返し解決するMaseization-Minimizationフレームワークに基づいたアルゴリズムを開発します。提案されたアルゴリズムが軽度の技術条件下でOracle統計レートを達成する推定器に収束することを示す理論的保証を提供します。数値実験は、これらの理論的発見を裏付けています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\BDK6Z6Y8\\Zou と Zhao - 2025 - Large Covariance Matrix Estimation for Groups of Highly Correlated Variables via Nonconvex Optimizat.pdf;C\:\\Users\\furuh\\Zotero\\storage\\9PSE4PNU\\10890766.html}
}

@article{zouRegularizationVariableSelection2005,
  title = {Regularization and {{Variable Selection Via}} the {{Elastic Net}}},
  author = {Zou, Hui and Hastie, Trevor},
  year = {2005},
  month = apr,
  journal = {Journal of the Royal Statistical Society Series B: Statistical Methodology},
  volume = {67},
  number = {2},
  pages = {301--320},
  issn = {1369-7412},
  doi = {10.1111/j.1467-9868.2005.00503.x},
  urldate = {2024-09-15},
  abstract = {We propose the elastic net, a new regularization and variable selection method. Real world data and a simulation study show that the elastic net often outperforms the lasso, while enjoying a similar sparsity of representation. In addition, the elastic net encourages a grouping effect, where strongly correlated predictors tend to be in or out of the model together. The elastic net is particularly useful when the number of predictors (p) is much bigger than the number of observations (n). By contrast, the lasso is not a very satisfactory variable selection method in the p{$\gg$}n case. An algorithm called LARS-EN is proposed for computing elastic net regularization paths efficiently, much like algorithm LARS does for the lasso.},
  langid = {english},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\PZQ45LEU\\Zou と Hastie - 2005 - Regularization and Variable Selection Via the Elastic Net.pdf;C\:\\Users\\furuh\\Zotero\\storage\\KIBISHAV\\7109482.html}
}

