}

@article{zhengTensorCompletionFullyConnected2022,
  title = {Tensor {{Completion}} via {{Fully-Connected Tensor Network Decomposition}} with {{Regularized Factors}}},
  author = {Zheng, Yu-Bang and Huang, Ting-Zhu and Zhao, Xi-Le and Zhao, Qibin},
  year = {2022},
  month = jul,
  journal = {Journal of Scientific Computing},
  volume = {92},
  number = {1},
  pages = {8},
  issn = {0885-7474, 1573-7691},
  doi = {10.1007/s10915-022-01841-8},
  urldate = {2023-12-03},
  abstract = {The recently proposed fully-connected tensor network (FCTN) decomposition has a powerful ability to capture the low-rankness of tensors and has achieved great success in tensor completion. However, the FCTN decomposition-based method is highly sensitive to the choice of the FCTN-rank and can not provide satisfactory results in the recovery of local details. In this paper, we propose a novel tensor completion model by introducing a factor-based regularization to the framework of the FCTN decomposition. The regularization provides a robust performance to the choice of the FCTN-rank and simultaneously enforces the global low-rankness and the local continuity of the target tensor. More specifically, by illustrating that the unfolding matrices of the FCTN factors can be reasonably assumed to be of low-rank in the gradient domain and further imposing a low-rank matrix factorization (LRMF) on them, the proposed model enhances the robustness to the choice of the FCTN-rank. By employing a Tikhonov regularization to the LRMF factors, the proposed model promotes the local continuity and preserves local details of the target tensor. To solve the optimization problem associated with the proposed model, we develop an efficient proximal alternating minimization (PAM)-based algorithm and theoretically demonstrate its convergence. To reduce the running time of the developed algorithm, we design an automatic rank-increasing strategy. Numerical experimental results demonstrate that the proposed method outperforms its competitors.},
  langid = {english}
}

@misc{zhengTensorCompletionTensor2020,
  title = {Tensor {{Completion}} via {{Tensor QR Decomposition}} and \${{L}}\_\{2,1\}\$-{{Norm Minimization}}},
  author = {Zheng, Yongming and Xu, An-Bao},
  year = {2020},
  month = nov,
  number = {arXiv:2011.04129},
  eprint = {2011.04129},
  publisher = {arXiv},
  urldate = {2024-11-07},
  abstract = {In this paper, we consider the tensor completion problem, which has many researchers in the machine learning particularly concerned. Our fast and precise method is built on extending the \$L\_\{2,1\}\$-norm minimization and Qatar Riyal decomposition (LNM-QR) method for matrix completions to tensor completions, and is different from the popular tensor completion methods using the tensor singular value decomposition (t-SVD). In terms of shortening the computing time, t-SVD is replaced with the method computing an approximate t-SVD based on Qatar Riyal decomposition (CTSVD-QR), which can be used to compute the largest \$r {\textbackslash}left(r{$>$}0 {\textbackslash}right)\$ singular values (tubes) and their associated singular vectors (of tubes) iteratively. We, in addition, use the tensor \$L\_\{2,1\}\$-norm instead of the tensor nuclear norm to minimize our model on account of it is easy to optimize. Then in terms of improving accuracy, ADMM, a gradient-search-based method, plays a crucial part in our method. Numerical experimental results show that our method is faster than those state-of-the-art algorithms and have excellent accuracy.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Numerical Analysis,Mathematics - Numerical Analysis},
  annotation = {abstractTranslation: 本論文では、特に機械学習の多くの研究者が関心を寄せるテンソル補完問題を考察する。我々の高速かつ高精度な手法は、行列補完のための\$L\_\{2,1\}\$ノルム最小化とカタール・リヤル分解(LNM-QR)法をテンソル補完に拡張したものであり、テンソル特異値分解(t-SVD)を用いた一般的なテンソル補完手法とは異なる。計算時間短縮の観点から、t-SVDをQatar Riyal分解に基づく近似t-SVDを計算する方法(CTSVD-QR)に置き換え、これを用いて最大の\$r(r{$>$}0)\$特異値(管)とそれに関連する特異ベクトル(管の)を繰り返し計算することができる。さらに、テンソル核ノルムの代わりにテンソル\$L\_\{2,1\}\$ノルムを用い、最適化が容易であることを理由にモデルを最小化する。そして、精度向上の観点から、勾配探索に基づく手法であるADMMが本手法において重要な役割を果たす。数値実験の結果、本手法は最先端のアルゴリズムよりも高速であり、優れた精度を持つことが示された。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\BCPLBGV3\\Zheng と Xu - 2020 - Tensor Completion via Tensor QR Decomposition and $L_ 2,1 $-Norm Minimization.pdf;C\:\\Users\\furuh\\Zotero\\storage\\8665IYBD\\2011.html}
}

@misc{zhengTensorNtubalRank2018,
  title = {Tensor {{N-tubal}} Rank and Its Convex Relaxation for Low-Rank Tensor Recovery},
  author = {Zheng, Yu-Bang and Huang, Ting-Zhu and Zhao, Xi-Le and Jiang, Tai-Xiang and Ji, Teng-Yu and Ma, Tian-Hui},
  year = {2018},
  month = dec,
  number = {arXiv:1812.00688},
  eprint = {1812.00688},
  primaryclass = {cs},
  publisher = {arXiv},
  urldate = {2023-05-13},
  abstract = {As low-rank modeling has achieved great success in tensor recovery, many research efforts devote to defining the tensor rank. Among them, the recent popular tensor tubal rank, defined based on the tensor singular value decomposition (t-SVD), obtains promising results. However, the framework of the t-SVD and the tensor tubal rank are applicable only to three-way tensors and lack of flexibility to handle different correlations along different modes. To tackle these two issues, we define a new tensor unfolding operator, named mode-\$k\_1k\_2\$ tensor unfolding, as the process of lexicographically stacking the mode-\$k\_1k\_2\$ slices of an \$N\$-way tensor into a three-way tensor, which is a three-way extension of the well-known mode-\$k\$ tensor matricization. Based on it, we define a novel tensor rank, the tensor \$N\$-tubal rank, as a vector whose elements contain the tubal rank of all mode-\$k\_1k\_2\$ unfolding tensors, to depict the correlations along different modes. To efficiently minimize the proposed \$N\$-tubal rank, we establish its convex relaxation: the weighted sum of tensor nuclear norm (WSTNN). Then, we apply WSTNN to low-rank tensor completion (LRTC) and tensor robust principal component analysis (TRPCA). The corresponding WSTNN-based LRTC and TRPCA models are proposed, and two efficient alternating direction method of multipliers (ADMM)-based algorithms are developed to solve the proposed models. Numerical experiments demonstrate that the proposed models significantly outperform the compared ones.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computer Vision and Pattern Recognition},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\XDU2FW9S\\Zheng et al. - 2018 - Tensor N-tubal rank and its convex relaxation for .pdf;C\:\\Users\\furuh\\Zotero\\storage\\TKM8BQA7\\1812.html}
}

@article{zhengTensorNtubalRank2020,
  title = {Tensor {{N-tubal}} Rank and Its Convex Relaxation for Low-Rank Tensor Recovery},
