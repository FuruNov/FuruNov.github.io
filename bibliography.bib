@inproceedings{zhongSparsePCAOracle2025,
  title = {Sparse {{PCA}} with {{Oracle Rate}} in {{High Dimensions}}},
  booktitle = {{{ICASSP}} 2025 - 2025 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {Zhong, Wenfu and Zhao, Ziping},
  year = {2025},
