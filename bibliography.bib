@article{huUnsupervisedFeatureSelection2025,
  title = {Unsupervised {{Feature Selection}} for {{High-Order Embedding Learning}} and {{Sparse Learning}}},
  author = {Hu, Zebiao and Wang, Jian and Ma{\'n}dziuk, Jacek and Ren, Zhongxin and Pal, Nikhil R.},
  year = {2025},
  journal = {IEEE Transactions on Cybernetics},
  pages = {1--14},
  issn = {2168-2275},
  doi = {10.1109/TCYB.2025.3546658},
  urldate = {2025-03-24},
  abstract = {The majority of the unsupervised feature selection methods usually explore the first-order similarity of the data while ignoring the high-order similarity of the instances, which makes it easy to construct a suboptimal similarity graph. Furthermore, such methods, often are not suitable for performing feature selection due to their high complexity, especially when the dimensionality of the data is high. To address the above issues, a novel method, termed as unsupervised feature selection for high-order embedding learning and sparse learning (UFSHS), is proposed to select useful features. More concretely, UFSHS first takes advantage of the high-order similarity of the original input to construct an optimal similarity graph that accurately reveals the essential geometric structure of high-dimensional data. Furthermore, it constructs a unified framework, integrating high-order embedding learning and sparse learning, to learn an appropriate projection matrix with row sparsity, which helps to select an optimal subset of features. Moreover, we design a novel alternative optimization method that provides different optimization strategies according to the relationship between the number of instances and the dimensionality, respectively, which significantly reduces the computational complexity of the model. Even more amazingly, the proposed optimization strategy is shown to be applicable to ridge regression, broad learning systems and fuzzy systems. Extensive experiments are conducted on nine public datasets to illustrate the superiority and efficiency of our UFSHS.},
  langid = {english},
  keywords = {Classification algorithms,Clustering algorithms,Embedding learning,Feature extraction,feature selection,Filtering algorithms,geometric structure,High dimensional data,high-order similarity,Learning systems,Linear programming,Optimization,Petroleum,sparse learning,Sparse matrices},
  annotation = {abstractTranslation: ほとんどの教師なし特徴選択手法は、データの1次類似性を探索する一方で、インスタンスの高次類似性を無視するため、最適でない類似グラフを構築しやすい。さらに、このような手法は、特にデータの次元が高い場合、その高い複雑さのために特徴選択に適さないことが多い。上記の課題に対処するため、高次埋め込み学習とスパース学習のための教師なし特徴選択法（UFSHS）と呼ばれる新規手法を提案する。より具体的には、UFSHSはまず、元の入力の高次類似性を活用して、高次元データの本質的な幾何学的構造を正確に明らかにする最適な類似グラフを構築する。さらに、高次埋め込み学習とスパース学習を統合した統一フレームワークを構築し、行スパース性を有する適切な射影行列を学習することで、最適な特徴部分集合を選択する。さらに、インスタンス数と次元数の関係に応じて異なる最適化戦略を提供する新規な交互最適化手法を設計し、モデルの計算複雑さを大幅に削減する。さらに驚くべきことに、提案された最適化戦略は、リッジ回帰、ブロードラーニングシステム、ファジィシステムに適用できることが示されている。9つの公開データセットを用いた広範な実験により、UFSHSの優位性と効率性を示す。}
}

