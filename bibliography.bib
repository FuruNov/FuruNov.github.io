@article{pena-penaLearningHypergraphsTensor2024,
  title = {Learning {{Hypergraphs Tensor Representations From Data}} via T-{{HGSP}}},
  author = {{Pena-Pena}, Karelia and Taipe, Lucas and Wang, Fuli and Lau, Daniel L. and Arce, Gonzalo R.},
  year = {2024},
  journal = {IEEE Transactions on Signal and Information Processing over Networks},
  volume = {10},
  pages = {17--31},
  issn = {2373-776X, 2373-7778},
  doi = {10.1109/TSIPN.2023.3345142},
  urldate = {2024-08-29},
  abstract = {Representation learning considering high-order relationships in data has recently shown to be advantageous in many applications. The construction of a meaningful hypergraph plays a crucial role in the success of hypergraph-based representation learning methods, which is particularly useful in hypergraph neural networks and hypergraph signal processing. However, a meaningful hypergraph may only be available in specific cases. This paper addresses the challenge of learning the underlying hypergraph topology from the data itself. As in graph signal processing applications, we consider the case in which the data possesses certain regularity or smoothness on the hypergraph. To this end, our method builds on the novel tensor-based hypergraph signal processing framework (t-HGSP) that has recently emerged as a powerful tool for preserving the intrinsic high-order structure of data on hypergraphs. Given the hypergraph spectrum and frequency coefficient definitions within the t-HGSP framework, we propose a method to learn the hypergraph Laplacian from data by minimizing the total variation on the hypergraph (TVL-HGSP). Additionally, we introduce an alternative approach (PDL-HGSP) that improves the connectivity of the learned hypergraph without compromising sparsity and use primal-dual-based algorithms to reduce the computational complexity. Finally, we combine the proposed learning algorithms with novel tensor-based hypergraph convolutional neural networks to propose hypergraph learning-convolutional neural networks (t-HyperGLNN).},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {american},
  annotation = {abstractTranslation: 近年、データ中の高次の関係を考慮した表現学習が、多くの応用において有利であることが示されている。ハイパーグラフに基づく表現学習法の成功には、意味のあるハイパーグラフの構築が重要な役割を果たしており、特にハイパーグラフ・ニューラル・ネットワークやハイパーグラフ信号処理において有用である。しかしながら、意味のあるハイパーグラフは特定の場合にしか利用できないかもしれない。本稿では、データそのものからハイパーグラフのトポロジーを学習するという課題に取り組む。グラフ信号処理アプリケーションと同様に、データがハイパーグラフ上で一定の規則性や滑らかさを持つ場合を考える。この目的のために、我々の手法は、ハイパーグラフ上のデータの本質的な高次構造を保存するための強力なツールとして最近登場した、新しいテンソルベースのハイパーグラフ信号処理フレームワーク(t-HGSP)に基づいている。t-HGSPフレームワークにおけるハイパーグラフスペクトルと周波数係数の定義から、ハイパーグラフ上の全変動を最小化することにより、ハイパーグラフラプラシアンをデータから学習する方法（TVL-HGSP）を提案する。さらに、スパース性を損なうことなく、学習されたハイパーグラフの接続性を改善する代替アプローチ（PDL-HGSP）を導入し、計算複雑度を低減するためにプライマル・デュアルベースのアルゴリズムを用いる。最後に、提案する学習アルゴリズムを、テンソルベースの新しいハイパーグラフ畳み込みニューラルネットワークと組み合わせ、ハイパーグラフ学習畳み込みニューラルネットワーク（t-HyperGLNN）を提案する。},
  file = {C:\Users\furuh\Zotero\storage\5TSDE3W2\Pena-Pena et al. - 2024 - Learning Hypergraphs Tensor Representations From Data via t-HGSP.pdf}
}

@article{pena-penaTHGSPHypergraphSignal2023,
  title = {T-{{HGSP}}: {{Hypergraph Signal Processing Using}} t-{{Product Tensor Decompositions}}},
  shorttitle = {T-{{HGSP}}},
  author = {{Pena-Pena}, Karelia and Lau, Daniel L. and Arce, Gonzalo R.},
  year = {2023},
  journal = {IEEE Transactions on Signal and Information Processing over Networks},
  volume = {9},
