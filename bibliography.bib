  title = {Weighted {{Visibility Graph With Complex Network Features}} in the {{Detection}} of {{Epilepsy}}},
  author = {Supriya, Supriya and Siuly, Siuly and Wang, Hua and Cao, Jinli and Zhang, Yanchun},
  year = {2016},
  journal = {IEEE Access},
