@article{zhangNearlyUnbiasedVariable2010,
  title = {Nearly Unbiased Variable Selection under Minimax Concave Penalty},
  author = {Zhang, Cun-Hui},
  year = {2010},
  month = apr,
  journal = {The Annals of Statistics},
  volume = {38},
  number = {2},
  pages = {894--942},
  publisher = {Institute of Mathematical Statistics},
  issn = {0090-5364, 2168-8966},
  doi = {10.1214/09-AOS729},
  urldate = {2025-03-08},
  abstract = {We propose MC+, a fast, continuous, nearly unbiased and accurate method of penalized variable selection in high-dimensional linear regression. The LASSO is fast and continuous, but biased. The bias of the LASSO may prevent consistent variable selection. Subset selection is unbiased but computationally costly. The MC+ has two elements: a minimax concave penalty (MCP) and a penalized linear unbiased selection (PLUS) algorithm. The MCP provides the convexity of the penalized loss in sparse regions to the greatest extent given certain thresholds for variable selection and unbiasedness. The PLUS computes multiple exact local minimizers of a possibly nonconvex penalized loss function in a certain main branch of the graph of critical points of the penalized loss. Its output is a continuous piecewise linear path encompassing from the origin for infinite penalty to a least squares solution for zero penalty. We prove that at a universal penalty level, the MC+ has high probability of matching the signs of the unknowns, and thus correct selection, without assuming the strong irrepresentable condition required by the LASSO. This selection consistency applies to the case of p{$\gg$}n, and is proved to hold for exactly the MC+ solution among possibly many local minimizers. We prove that the MC+ attains certain minimax convergence rates in probability for the estimation of regression coefficients in {$\ell$}r balls. We use the SURE method to derive degrees of freedom and Cp-type risk estimates for general penalized LSE, including the LASSO and MC+ estimators, and prove their unbiasedness. Based on the estimated degrees of freedom, we propose an estimator of the noise level for proper choice of the penalty level. For full rank designs and general sub-quadratic penalties, we provide necessary and sufficient conditions for the continuity of the penalized LSE. Simulation results overwhelmingly support our claim of superior variable selection properties and demonstrate the computational efficiency of the proposed method.},
  keywords = {62H12,62H25,62J05,62J07,correct selection,Degrees of freedom,least squares,mean squared error,minimax,Model selection,nonconvex minimization,penalized estimation,risk estimation,selection consistency,sign consistency,unbiasedness,Variable selection},
  file = {C:\Users\furuh\Zotero\storage\QF3FG4TU\Zhang - 2010 - Nearly unbiased variable selection under minimax concave penalty.pdf}
}

@inproceedings{zhangOATSOutlierAwarePruning2024,
  title = {{{OATS}}: {{Outlier-Aware Pruning Through Sparse}} and {{Low Rank Decomposition}}},
  shorttitle = {{{OATS}}},
  booktitle = {The {{Thirteenth International Conference}} on {{Learning Representations}}},
  author = {Zhang, Stephen and Papyan, Vardan},
  year = {2024},
  month = oct,
  urldate = {2025-04-26},
  abstract = {The recent paradigm shift to large-scale foundation models has brought about a new era for deep learning that, while has found great success in practice, has also been plagued by prohibitively expensive costs in terms of high memory consumption and compute. To mitigate these issues, there has been a concerted effort in post-hoc neural network pruning techniques that do not require costly retraining. Despite the considerable progress being made, existing methods often exhibit a steady drop in model performance as the compression increases. In this paper, we present a novel approach to compressing large transformers, coined OATS, that compresses the model weights by approximating each weight matrix as the sum of a sparse matrix and a low-rank matrix. Prior to the decomposition, the weights are first scaled by the second moment of their input embeddings, so as to ensure the preservation of outlier features recently observed in large transformer models. Without retraining, OATS achieves state-of-the-art performance when compressing large language models, such as Llama-3 and Phi-3, and vision transformers, such as Google's ViT and DINOv2, by up to \$60{\textbackslash}{\textbackslash}\%\$, all while speeding up the model's inference on a CPU by up to \$1.37{\textbackslash}times\$ compared to prior pruning methods.},
  langid = {english},
  keywords = {Now Reading},
  annotation = {abstractTranslation: 大規模基盤モデルへの近年のパラダイムシフトは、深層学習に新たな時代をもたらしたが、実践において大きな成功を収める一方で、高メモリ消費と計算コストという、法外なコストに悩まされてもいる。これらの問題を軽減するために、コストのかかる再学習を必要としない事後的なニューラルネットワーク剪定技術に集中的な取り組みが行われている。目覚ましい進歩にもかかわらず、既存の方法は、圧縮率が上がるにつれて、モデル性能が着実に低下することが多い。本稿では、OATSと名付けた、大規模トランスフォーマーを圧縮するための新しいアプローチを提案する。これは、各重み行列を、スパース行列と低ランク行列の和として近似することで、モデルの重みを圧縮するものである。分解を行う前に、重みはまず入力埋め込みの二乗モーメントでスケーリングされる。これにより、大規模トランスフォーマーモデルで最近観測された外れ値の特徴の保存を保証する。再学習なしで、OATSは、Llama-3やPhi-3といった大規模言語モデルや、GoogleのViTやDINOv2といったVision Transformerを最大60\%圧縮する際に、最先端の性能を達成すると同時に、既存の剪定方法と比較して、CPU上でのモデルの推論を最大1.37倍高速化する。},
  file = {C:\Users\furuh\Zotero\storage\MK9HTC55\Zhang と Papyan - 2024 - OATS Outlier-Aware Pruning Through Sparse and Low Rank Decomposition.pdf}
}

