  abstract = {Tensor recovery is a fundamental problem in tensor research field. It generally requires to explore intrinsic prior structures underlying tensor data, and formulate them as certain forms of regularization terms for guiding a sound estimate of the restored tensor. Recent researches have made significant progress by adopting two insightful tensor priors, i.e., global low-rankness (L) and local smoothness (S), which are always encoded as a sum of two separate regularizers into recovery models. However, unlike the primary theoretical developments on low-rank tensor recovery, these joint ``L+S'' models have no theoretical exact-recovery guarantees yet, making the methods lack reliability in real practice. To this crucial issue, in this work, we build a unique regularizer termed as tensor correlated total variation (t-CTV), which essentially encodes both L and S priors of a tensor simultaneously. Especially, by equipping t-CTV into the recovery models, we can rigorously prove the exact recovery guarantees for two typical tensor recovery tasks, i.e., tensor completion and tensor robust principal component analysis. To the best of our knowledge, this should be the first exact-recovery results among all related ``L+S'' methods for tensor recovery. We further propose ADMM algorithms with fine convergence to solve the proposed models. Significant recovery accuracy improvements are observed in extensive experiments. Typically, our method achieves a workable performance when the missing rate is extremely large, e.g., 99.5\%, for the color image inpainting task, while all its peers totally fail in such a challenging case. Code is released at https://github.com/wanghailin97.},
  langid = {english},
  keywords = {Color,color image inpainting,Degradation,exact recovery guarantee,Favorite,low-rankness,Mathematical models,regularization,smoothness,Task analysis,tensor completion,Tensor recovery,tensor robust principal component analysis,Tensors,TV,Visualization},
  annotation = {abstractTranslation: テンソルの回復は、テンソル研究分野における基本的な問題です。一般に、テンソル データの基礎となる固有の事前構造を調査し、復元されたテンソルの適切な推定を導くために、それらを特定の形式の正則化項として定式化する必要があります。最近の研究は、洞察力に富んだ 2 つのテンソル事前分布、つまりグローバル低ランクネス (L) とローカル平滑度 (S) を採用することによって大幅な進歩を遂げました。これらは常に 2 つの別個の正則化子の合計として回復モデルにエンコードされます。ただし、低ランクのテンソル回復に関する主要な理論開発とは異なり、これらの統合「L+S」モデルには理論上の正確な回復の保証がまだなく、実際の実践ではこの方法の信頼性が欠けています。この重要な問題に対して、この研究では、テンソル相関合計変動 (t-CTV) と呼ばれる独自の正則化子を構築します。これは、基本的に、テンソルの L 事前分布と S 事前分布の両方を同時にエンコードします。特に、回復モデルに t-CTV を装備することにより、2 つの典型的なテンソル回復タスク、つまりテンソル補完とテンソル ロバスト主成分分析の正確な回復保証を厳密に証明できます。私たちの知る限り、これはテンソル回復に関連するすべての「L+S」手法の中で最初の正確な回復結果となるはずです。さらに、提案されたモデルを解決するために、優れた収束を備えた ADMM アルゴリズムを提案します。広範な実験により、回収精度の大幅な向上が観察されています。通常、カラー画像修復タスクの場合、欠落率が非常に大きい場合（たとえば、99.5\% など）、私たちの方法は実行可能なパフォーマンスを達成しますが、そのような困難なケースでは、他のすべての方法は完全に失敗します。コードは https://github.com/wanghailin97 で公開されています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\EZNYITJF\\Wang et al. - 2023 - Guaranteed Tensor Recovery Fused Low-rankness and Smoothness.pdf;C\:\\Users\\furuh\\Zotero\\storage\\XKIEE3S4\\10078018.html}
}

@misc{wangHankelstructuredTensorRobust2021,
  title = {Hankel-Structured {{Tensor Robust PCA}} for {{Multivariate Traffic Time Series Anomaly Detection}}},
  author = {Wang, Xudong and {Miranda-Moreno}, Luis and Sun, Lijun},
  year = {2021},
  month = oct,
  number = {arXiv:2110.04352},
  eprint = {2110.04352},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2110.04352},
  urldate = {2025-02-01},
  abstract = {Spatiotemporal traffic data (e.g., link speed/flow) collected from sensor networks can be organized as multivariate time series with additional spatial attributes. A crucial task in analyzing such data is to identify and detect anomalous observations and events from the data with complex spatial and temporal dependencies. Robust Principal Component Analysis (RPCA) is a widely used tool for anomaly detection. However, the traditional RPCA purely relies on the global low-rank assumption while ignoring the local temporal correlations. In light of this, this study proposes a Hankel-structured tensor version of RPCA for anomaly detection in spatiotemporal data. We treat the raw data with anomalies as a multivariate time series matrix (location \${\textbackslash}times\$ time) and assume the denoised matrix has a low-rank structure. Then we transform the low-rank matrix to a third-order tensor by applying temporal Hankelization. In the end, we decompose the corrupted matrix into a low-rank Hankel tensor and a sparse matrix. With the Hankelization operation, the model can simultaneously capture the global and local spatiotemporal correlations and exhibit more robust performance. We formulate the problem as an optimization problem and use tensor nuclear norm (TNN) to approximate the tensor rank and \$l\_1\$ norm to approximate the sparsity. We develop an efficient solution algorithm based on the Alternating Direction Method of Multipliers (ADMM). Despite having three hyper-parameters, the model is easy to set in practice. We evaluate the proposed method by synthetic data and metro passenger flow time series and the results demonstrate the accuracy of anomaly detection.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Machine Learning},
  annotation = {abstractTranslation: センサーネットワークから収集された時空間的交通データ（例：リンク速度/フロー）は、追加の空間属性を備えた多変量時系列として編成できます。このようなデータを分析する際の重要なタスクは、複雑な空間的および時間的依存関係を持つデータから異常な観察とイベントを特定して検出することです。堅牢な主成分分析（RPCA）は、異常検出のために広く使用されているツールです。ただし、従来のRPCAは、局所的な時間的相関を無視しながら、グローバルな低ランクの仮定に純粋に依存しています。これに照らして、この研究では、時空間データにおける異常検出のためのRPCAのハンケル構造テンソルバージョンを提案しています。生データを異常で多変量時系列マトリックス（位置\$ {\textbackslash} Times \$ TIME）として扱い、除去されたマトリックスに低いランク構造があると仮定します。次に、一時的なハンケル化を適用することにより、低ランクマトリックスを3次テンソルに変換します。最終的に、破損したマトリックスを低ランクのハンケルテンソルとスパースマトリックスに分解します。ハンケル化操作により、このモデルは同時にグローバルおよびローカルの空間的相関をキャプチャし、より堅牢なパフォーマンスを示すことができます。問題を最適化問題として定式化し、テンソル核基準（TNN）を使用してテンソルランクと\$ L\_1 \$ normを近似してスパースを近似します。乗数の交互方向方法（ADMM）に基づいて、効率的なソリューションアルゴリズムを開発します。 3つのハイパーパラメーターを持っているにもかかわらず、モデルは実際に簡単に設定できます。合成データとメトロ乗客の流れ時系列による提案方法を評価し、結果は異常検出の精度を示しています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\LETIZ2IB\\Wang et al. - 2021 - Hankel-structured Tensor Robust PCA for Multivariate Traffic Time Series Anomaly Detection.pdf;C\:\\Users\\furuh\\Zotero\\storage\\QXHS5DIM\\2110.html}
}

@article{wangHybridPhysicsinformedDatadriven2024,
  title = {A Hybrid Physics-Informed Data-Driven Neural Network for {{CO2}} Storage in Depleted Shale Reservoirs},
  author = {Wang, Yan-Wei and Dai, Zhen-Xue and Wang, Gui-Sheng and Chen, Li and Xia, Yu-Zhou and Zhou, Yu-Hao},
  year = {2024},
  month = feb,
  journal = {Petroleum Science},
  volume = {21},
  number = {1},
  pages = {286--301},
  issn = {1995-8226},
  doi = {10.1016/j.petsci.2023.08.032},
  urldate = {2024-11-12},
  abstract = {To reduce CO2 emissions in response to global climate change, shale reservoirs could be ideal candidates for long-term carbon geo-sequestration involving multi-scale transport processes. However, most current CO2 sequestration models do not adequately consider multiple transport mechanisms. Moreover, the evaluation of CO2 storage processes usually involves laborious and time-consuming numerical simulations unsuitable for practical prediction and decision-making. In this paper, an integrated model involving gas diffusion, adsorption, dissolution, slip flow, and Darcy flow is proposed to accurately characterize CO2 storage in depleted shale reservoirs, supporting the establishment of a training database. On this basis, a hybrid physics-informed data-driven neural network (HPDNN) is developed as a deep learning surrogate for prediction and inversion. By incorporating multiple sources of scientific knowledge, the HPDNN can be configured with limited simulation resources, significantly accelerating the forward and inversion processes. Furthermore, the HPDNN can more intelligently predict injection performance, precisely perform reservoir parameter inversion, and reasonably evaluate the CO2 storage capacity under complicated scenarios. The validation and test results demonstrate that the HPDNN can ensure high accuracy and strong robustness across an extensive applicability range when dealing with field data with multiple noise sources. This study has tremendous potential to replace traditional modeling tools for predicting and making decisions about CO2 storage projects in depleted shale reservoirs.},
  keywords = {CO storage,Deep learning,Depleted shale reservoirs,Physics-informed data-driven neural network,Transport mechanisms},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\S9SI7RRE\\Wang et al. - 2024 - A hybrid physics-informed data-driven neural network for CO2 storage in depleted shale reservoirs.pdf;C\:\\Users\\furuh\\Zotero\\storage\\7TSKW8NL\\S1995822623002285.html}
}

@inproceedings{wangInverseApproximationTheory2023,
  title = {Inverse {{Approximation Theory}} for {{Nonlinear Recurrent Neural Networks}}},
  booktitle = {The {{Twelfth International Conference}} on {{Learning Representations}}},
  author = {Wang, Shida and Li, Zhong and Li, Qianxiao},
  year = {2023},
  month = oct,
  urldate = {2024-06-17},
  abstract = {We prove an inverse approximation theorem for the approximation of nonlinear sequence-to-sequence relationships using recurrent neural networks (RNNs). This is a so-called Bernstein-type result in approximation theory, which deduces properties of a target function under the assumption that it can be effectively approximated by a hypothesis space. In particular, we show that nonlinear sequence relationships that can be stably approximated by nonlinear RNNs must have an exponential decaying memory structure - a notion that can be made precise. This extends the previously identified curse of memory in linear RNNs into the general nonlinear setting, and quantifies the essential limitations of the RNN architecture for learning sequential relationships with long-term memory. Based on the analysis, we propose a principled reparameterization method to overcome the limitations. Our theoretical results are confirmed by numerical experiments.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\QFPCE3LU\Wang et al. - 2023 - Inverse Approximation Theory for Nonlinear Recurre.pdf}
}

@article{wangKroneckerCPDecomposition2023,
  title = {Kronecker {{CP Decomposition With Fast Multiplication}} for {{Compressing RNNs}}},
  author = {Wang, Dingheng and Wu, Bijiao and Zhao, Guangshe and Yao, Man and Chen, Hengnu and Deng, Lei and Yan, Tianyi and Li, Guoqi},
  year = {2023},
  month = may,
  journal = {IEEE Transactions on Neural Networks and Learning Systems},
  volume = {34},
  number = {5},
  pages = {2205--2219},
  issn = {2162-237X, 2162-2388},
  doi = {10.1109/TNNLS.2021.3105961},
  urldate = {2023-10-20},
  abstract = {Recurrent neural networks (RNNs) are powerful in the tasks oriented to sequential data, such as natural language processing and video recognition. However, because the modern RNNs have complex topologies and expensive space/computation complexity, compressing them becomes a hot and promising topic in recent years. Among plenty of compression methods, tensor decomposition, e.g., tensor train (TT), block term (BT), tensor ring (TR), and hierarchical Tucker (HT), appears to be the most amazing approach because a very high compression ratio might be obtained. Nevertheless, none of these tensor decomposition formats can provide both space and computation efficiency. In this article, we consider to compress RNNs based on a novel Kronecker CANDECOMP/PARAFAC (KCP) decomposition, which is derived from Kronecker tensor (KT) decomposition, by proposing two fast algorithms of multiplication between the input and the tensor-decomposed weight. According to our experiments based on UCF11, Youtube Celebrities Face, UCF50, TIMIT, TED-LIUM, and Spiking Heidelberg digits datasets, it can be verified that the proposed KCP-RNNs have a comparable performance of accuracy with those in other tensor-decomposed formats, and even 278 \$219{\textbackslash}times \$ compression ratio could be obtained by the low-rank KCP. More importantly, KCP-RNNs are efficient in both space and computation complexity compared with other tensor-decomposed ones. Besides, we find KCP has the best potential of parallel computing to accelerate the calculations in neural networks.},
  file = {C:\Users\furuh\Zotero\storage\6U7T2UJH\Wang et al. - 2023 - Kronecker CP Decomposition With Fast Multiplicatio.pdf}
}

@article{wangLargeScaleAffineMatrix2022,
  title = {Large-{{Scale Affine Matrix Rank Minimization With}} a {{Novel Nonconvex Regularizer}}},
  author = {Wang, Zhi and Liu, Yu and Luo, Xin and Wang, Jianjun and Gao, Chao and Peng, Dezhong and Chen, Wu},
  year = {2022},
  month = sep,
  journal = {IEEE Transactions on Neural Networks and Learning Systems},
  volume = {33},
  number = {9},
  pages = {4661--4675},
  issn = {2162-237X, 2162-2388},
  doi = {10.1109/TNNLS.2021.3059711},
  urldate = {2023-12-03},
  abstract = {Low-rank minimization aims to recover a matrix of minimum rank subject to linear system constraint. It can be found in various data analysis and machine learning areas, such as recommender systems, video denoising, and signal processing. Nuclear norm minimization is a dominating approach to handle it. However, such a method ignores the difference among singular values of target matrix. To address this issue, nonconvex low-rank regularizers have been widely used. Unfortunately, existing methods suffer from different drawbacks, such as inefficiency and inaccuracy. To alleviate such problems, this article proposes a flexible model with a novel nonconvex regularizer. Such a model not only promotes low rankness but also can be solved much faster and more accurate. With it, the original low-rank problem can be equivalently transformed into the resulting optimization problem under the rank restricted isometry property (rank-RIP) condition. Subsequently, Nesterov's rule and inexact proximal strategies are adopted to achieve a novel algorithm highly efficient in solving this problem at a convergence rate of \$O(1/K)\$ , with \$K\$ being the iterate count. Besides, the asymptotic convergence rate is also analyzed rigorously by adopting the Kurdyka- ojasiewicz (KL) inequality. Furthermore, we apply the proposed optimization model to typical low-rank problems, including matrix completion, robust principal component analysis (RPCA), and tensor completion. Exhaustively empirical studies regarding data analysis tasks, i.e., synthetic data analysis, image recovery, personalized recommendation, and background subtraction, indicate that the proposed model outperforms state-of-the-art models in both accuracy and efficiency.},
  file = {C:\Users\furuh\Zotero\storage\NGYSMF6H\wang2021.pdf.pdf}
}

@article{wangLiftedBregmanTraining2022,
  title = {Lifted {{Bregman Training}} of {{Neural Networks}}},
  author = {Wang, Xiaoyu and Benning, Martin},
  year = {2022},
  publisher = {[object Object]},
  doi = {10.48550/ARXIV.2208.08772},
  urldate = {2024-03-13},
  abstract = {We introduce a novel mathematical formulation for the training of feed-forward neural networks with (potentially non-smooth) proximal maps as activation functions. This formulation is based on Bregman distances and a key advantage is that its partial derivatives with respect to the network's parameters do not require the computation of derivatives of the network's activation functions. Instead of estimating the parameters with a combination of first-order optimisation method and back-propagation (as is the state-of-the-art), we propose the use of non-smooth first-order optimisation methods that exploit the specific structure of the novel formulation. We present several numerical results that demonstrate that these training approaches can be equally well or even better suited for the training of neural network-based classifiers and (denoising) autoencoders with sparse coding compared to more conventional training frameworks.},
  copyright = {Creative Commons Attribution Non Commercial Share Alike 4.0 International},
  keywords = {47A52 65K10 68T01 68W15,FOS: Computer and information sciences,FOS: Mathematics,Machine Learning (cs.LG),Optimization and Control (math.OC)},
  file = {C:\Users\furuh\Zotero\storage\ZXWLJLRK\Wang and Benning - 2022 - Lifted Bregman Training of Neural Networks.pdf}
}

@article{wangModelCompressionEfficient2024,
  title = {Model {{Compression}} and {{Efficient Inference}} for {{Large Language Models}}: {{A Survey}}},
  shorttitle = {Model {{Compression}} and {{Efficient Inference}} for {{Large Language Models}}},
  author = {Wang, Wenxiao and Chen, Wei and Luo, Yicong and Long, Yongliu and Lin, Zhengkai and Zhang, Liye and Lin, Binbin and Cai, Deng and He, Xiaofei},
  year = {2024},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2402.09748},
  urldate = {2024-10-13},
  abstract = {Transformer based large language models have achieved tremendous success. However, the significant memory and computational costs incurred during the inference process make it challenging to deploy large models on resource-constrained devices. In this paper, we investigate compression and efficient inference methods for large language models from an algorithmic perspective. Regarding taxonomy, similar to smaller models, compression and acceleration algorithms for large language models can still be categorized into quantization, pruning, distillation, compact architecture design, dynamic networks. However, Large language models have two prominent characteristics compared to smaller models: (1) Most of compression algorithms require finetuning or even retraining the model after compression. The most notable aspect of large models is the very high cost associated with model finetuning or training. Therefore, many algorithms for large models, such as quantization and pruning, start to explore tuning-free algorithms. (2) Large models emphasize versatility and generalization rather than performance on a single task. Hence, many algorithms, such as knowledge distillation, focus on how to preserving their versatility and generalization after compression. Since these two characteristics were not very pronounced in early large models, we further distinguish large language models into medium models and ``real'' large models. Additionally, we also provide an introduction to some mature frameworks for efficient inference of large models, which can support basic compression or acceleration algorithms, greatly facilitating model deployment for users.},
  copyright = {arXiv.org perpetual, non-exclusive license},
  langid = {american},
  keywords = {Artificial Intelligence (cs.AI),Computation and Language (cs.CL),FOS: Computer and information sciences,Machine Learning (cs.LG),Performance (cs.PF)},
  annotation = {abstractTranslation: 変換器ベースの大規模言語モデルは、大きな成功を収めている。しかし、推論過程で発生する多大なメモリコストと計算コストが、リソースに制約のあるデバイス上に大規模モデルを展開することを困難にしている。本論文では、アルゴリズムの観点から、大規模言語モデルの圧縮と効率的な推論手法を研究する。大規模言語モデルの圧縮・高速化アルゴリズムは、小規模言語モデルと同様に、量子化、枝刈り、蒸留、コンパクトアーキテクチャ設計、動的ネットワークに分類できる。(1)圧縮アルゴリズムの多くは、圧縮後にモデルの微調整や再トレーニングを必要とする。(1)圧縮アルゴリズムの多くは、圧縮後にモデルの微調整や再トレーニングを必要とする。そのため、量子化やプルーニングなど、大規模モデルのための多くのアルゴリズムが、チューニング不要のアルゴリズムの探求を始めている。(2)大規模モデルは、単一のタスクに対する性能よりも、汎用性や汎化を重視する。したがって、知識蒸留のような多くのアルゴリズムは、圧縮後にいかに汎用性と汎化性を保つかに焦点を当てる。これら2つの特徴は初期の大規模モデルではあまり顕著ではなかったため、大規模言語モデルをさらに中規模モデルと``真の'大規模モデルに区別する。さらに、大規模モデルを効率的に推論するためのいくつかの成熟したフレームワークの紹介も行う。これらのフレームワークは、基本的な圧縮アルゴリズムや高速化アルゴリズムをサポートすることができ、ユーザのモデル展開を大幅に容易にする。},
  file = {C:\Users\furuh\Zotero\storage\TRFQBZ5S\Wang et al. - 2024 - Model Compression and Efficient Inference for Large Language Models A Survey.pdf}
}

@article{wangMultiDimensionalVisualData2021,
  title = {Multi-{{Dimensional Visual Data Completion}} via {{Low-Rank Tensor Representation Under Coupled Transform}}},
  author = {Wang, Jian-Li and Huang, Ting-Zhu and Zhao, Xi-Le and Jiang, Tai-Xiang and Ng, Michael K.},
  year = {2021},
  journal = {IEEE Transactions on Image Processing},
  volume = {30},
  pages = {3581--3596},
  issn = {1941-0042},
  doi = {10.1109/TIP.2021.3062995},
  abstract = {This paper addresses the tensor completion problem, which aims to recover missing information of multi-dimensional images. How to represent a low-rank structure embedded in the underlying data is the key issue in tensor completion. In this work, we suggest a novel low-rank tensor representation based on coupled transform, which fully exploits the spatial multi-scale nature and redundancy in spatial and spectral/temporal dimensions, leading to a better low tensor multi-rank approximation. More precisely, this representation is achieved by using two-dimensional framelet transform for the two spatial dimensions, one/two-dimensional Fourier transform for the temporal/spectral dimension, and then Karhunen-Lo{\'e}ve transform (via singular value decomposition) for the transformed tensor. Based on this low-rank tensor representation, we formulate a novel low-rank tensor completion model for recovering missing information in multi-dimensional visual data, which leads to a convex optimization problem. To tackle the proposed model, we develop the alternating directional method of multipliers (ADMM) algorithm tailored for the structured optimization problem. Numerical examples on color images, multispectral images, and videos illustrate that the proposed method outperforms many state-of-the-art methods in qualitative and quantitative aspects.},
  keywords = {2D framelet transform,Color,Correlation,Discrete Fourier transforms,multi-scale representation,tensor completion,tensor nuclear norm,Tensors,Transforms,Videos,Visualization},
  file = {C:\Users\furuh\Zotero\storage\T2UU4VQL\9372832.html}
}

@misc{wangMultiTaskDeepRecommender2023,
  title = {Multi-{{Task Deep Recommender Systems}}: {{A Survey}}},
  shorttitle = {Multi-{{Task Deep Recommender Systems}}},
  author = {Wang, Yuhao and Lam, Ha Tsz and Wong, Yi and Liu, Ziru and Zhao, Xiangyu and Wang, Yichao and Chen, Bo and Guo, Huifeng and Tang, Ruiming},
  year = {2023},
  month = feb,
  number = {arXiv:2302.03525},
  eprint = {2302.03525},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2302.03525},
  urldate = {2024-12-11},
  abstract = {Multi-task learning (MTL) aims at learning related tasks in a unified model to achieve mutual improvement among tasks considering their shared knowledge. It is an important topic in recommendation due to the demand for multi-task prediction considering performance and efficiency. Although MTL has been well studied and developed, there is still a lack of systematic review in the recommendation community. To fill the gap, we provide a comprehensive review of existing multi-task deep recommender systems (MTDRS) in this survey. To be specific, the problem definition of MTDRS is first given, and it is compared with other related areas. Next, the development of MTDRS is depicted and the taxonomy is introduced from the task relation and methodology aspects. Specifically, the task relation is categorized into parallel, cascaded, and auxiliary with main, while the methodology is grouped into parameter sharing, optimization, and training mechanism. The survey concludes by summarizing the application and public datasets of MTDRS and highlighting the challenges and future directions of the field.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Information Retrieval},
  annotation = {abstractTranslation: マルチタスク学習(Multi-task learning, MTL)は、関連するタスクを統一的なモデルで学習することで、タスク間の共有知識を考慮した相互改善を目指す。性能と効率を考慮したマルチタスク予測への要求から、推薦における重要なトピックとなっている。MTLはよく研究され開発されているが、推薦コミュニティでは体系的なレビューがまだ不足している。このギャップを埋めるため、本サーベイでは既存のマルチタスク深層推薦システム（MTDRS）の包括的なレビューを行う。具体的には、まずMTDRSの問題定義を行い、他の関連分野と比較する。次に、MTDRSの発展を描き、タスク関係と方法論の側面から分類法を紹介する。具体的には、タスク関係は並列、カスケード、補助とメインに分類され、方法論はパラメータ共有、最適化、学習メカニズムに分類される。最後に、MTDRSのアプリケーションと公開データセットを要約し、この分野の課題と将来の方向性を強調する。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\9T9IFTJZ\\Wang et al. - 2023 - Multi-Task Deep Recommender Systems A Survey.pdf;C\:\\Users\\furuh\\Zotero\\storage\\98XLH9IL\\2302.html}
}

