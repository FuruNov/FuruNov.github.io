@article{fanVariableSelectionNonconcave2001,
  title = {Variable {{Selection}} via {{Nonconcave Penalized Likelihood}} and Its {{Oracle Properties}}},
  author = {Fan, Jianqing and Li, Runze},
  year = {2001},
  month = dec,
  journal = {Journal of the American Statistical Association},
  volume = {96},
  number = {456},
  pages = {1348--1360},
  publisher = {ASA Website},
  issn = {0162-1459},
  doi = {10.1198/016214501753382273},
  urldate = {2024-09-17},
  abstract = {Variable selection is fundamental to high-dimensional statistical modeling, including nonparametric regression. Many approaches in use are stepwise selection procedures, which can be computationally expensive and ignore stochastic errors in the variable selection process. In this article, penalized likelihood approaches are proposed to handle these kinds of problems. The proposed methods select variables and estimate coefficients simultaneously. Hence they enable us to construct confidence intervals for estimated parameters. The proposed approaches are distinguished from others in that the penalty functions are symmetric, nonconcave on (0, {$\infty$}), and have singularities at the origin to produce sparse solutions. Furthermore, the penalty functions should be bounded by a constant to reduce bias and satisfy certain conditions to yield continuous solutions. A new algorithm is proposed for optimizing penalized likelihood functions. The proposed ideas are widely applicable. They are readily applied to a variety of parametric models such as generalized linear models and robust regression models. They can also be applied easily to nonparametric modeling by using wavelets and splines. Rates of convergence of the proposed penalized likelihood estimators are established. Furthermore, with proper choice of regularization parameters, we show that the proposed estimators perform as well as the oracle procedure in variable selection; namely, they work as well as if the correct submodel were known. Our simulation shows that the newly proposed methods compare favorably with other variable selection techniques. Furthermore, the standard error formulas are tested to be accurate enough for practical applications.},
  langid = {english},
  keywords = {Hard thresholding,LASSO,Nonnegative garrote,Oracle estimator,Penalized likelihood,SCAD,Soft thresholding},
  annotation = {abstractTranslation: 変数選択は、ノンパラメトリック回帰を含む高次元統計モデリングの基本である。現在使われている多くのアプローチはステップワイズ選択法であるが、これは計算コストが高く、変数選択過程における確率誤差を無視することがある。本稿では、このような問題を扱うために、ペナルティ付き尤度アプローチを提案する。提案手法は変数の選択と係数の推定を同時に行う。それゆえ、推定されたパラメータの信頼区間を構成することができる。提案するアプローチは、ペナルティ関数が対称であり、(0, {$\infty$})上で非凹であり、スパース解を生成するために原点に特異点を持つという点で他のアプローチと区別される。さらに、ペナルティ関数はバイアスを減らすために定数で束縛され、連続解を得るためにある条件を満たす必要がある。ペナルティ付き尤度関数を最適化するための新しいアルゴリズムを提案する。提案されたアイデアは広く適用可能である。一般化線形モデルやロバスト回帰モデルなどの様々なパラメトリックモデルに容易に適用できる。また、ウェーブレットやスプラインを用いることで、ノンパラメトリックモデリングにも容易に適用できる。提案するペナルティ付き尤度推定量の収束率が確立されている。さらに、正則化パラメータを適切に選択することで、提案する推定量が変数選択においてオラクル法と同等の性能を持つこと、すなわち、正しいサブモデルが既知である場合と同等に機能することを示す。我々のシミュレーションによれば、新しく提案された手法は他の変数選択手法と比較して優れている。さらに、標準誤差公式は実用的な応用に十分な精度であることが検証された。},
  file = {C:\Users\furuh\Zotero\storage\QG9WF93T\Fan と Li - 2001 - Variable Selection via Nonconcave Penalized Likelihood and its Oracle Properties.pdf}
}

@misc{fariasMixFunnNeuralNetwork2025,
