  year = {2022},
  month = apr,
  journal = {IEEE Transactions on Emerging Topics in Computational Intelligence},
  volume = {6},
  number = {2},
  pages = {287--299},
  issn = {2471-285X},
  doi = {10.1109/TETCI.2021.3058672},
  urldate = {2024-10-14},
  abstract = {Deep Neural Networks (DNNs) is the computing paradigm that has achieved remarkable success in various fields of engineering in recent years, primarily visual recognition. DNNs owe its success to the presence of large number of weight parameters (and increased depth), which led to huge computation and memory costs for implementation. These limiting factors hinder the scalability of such algorithms on resource constraint devices (like IoT devices). In general, DNNs are believed to be over parametrized i.e., the parameters are highly redundant, thus can be structurally removed without significant loss of performance. To solve these issues, we propose to use non-convex T{\textbackslash}ell {$_1$} regularizer along with the additional effect of sparse group lasso to completely remove the redundant neurons/filters that is, to introduce structured sparsity. The network has been trained using the proximal gradient method, which is useful in optimizing functions with the combination of smooth and non-smooth terms. We show that proposed regularizer manages to achieve competitive performances as well as extremely compact networks. Detailed experiments are performed on several benchmark datasets that illustrate the efficiency of the approach. On the ImageNet dataset, our approach removes more than 50\% of parameters of convolutional layers and 85\% parameters of fully connected layers of Alexnet with no drop in accuracy.},
  langid = {american},
  keywords = {Benchmark testing,Biological neural networks,Deep neural networks,Feature extraction,Internet of Things,Jamming,Memory management,Neurons,regularization,sparse group lasso},
  annotation = {abstractTranslation: ディープ・ニューラル・ネットワーク（DNN）は、近年、視覚認識を中心に工学の様々な分野で目覚ましい成功を収めているコンピューティング・パラダイムである。DNNの成功は、多数の重みパラメータ（および深さの増加）が存在することに起因しており、実装のための膨大な計算コストとメモリコストが発生する。これらの制限要因は、（IoTデバイスのような）リソース制約のあるデバイス上で、このようなアルゴリズムのスケーラビリティを妨げている。一般的に、DNNはオーバーパラメトリック、すなわちパラメータが非常に冗長であると考えられており、そのため、性能を大きく損なうことなく構造的に削除することが可能である。このような問題を解決するために、我々は非凸のTell1正則化とスパースグループラッソの追加効果を用いて、冗長なニューロン/フィルタを完全に除去する、つまり構造化されたスパース性を導入することを提案する。ネットワークは、平滑項と非平滑項の組み合わせを持つ関数の最適化に有効な近接勾配法を用いて学習された。提案する正則化器が、非常にコンパクトなネットワークと同様に、競争力のある性能を達成できることを示す。本アプローチの効率性を示すいくつかのベンチマークデータセットを用いて詳細な実験を行った。ImageNetデータセットにおいて、我々のアプローチは、Alexnetの畳み込み層の50\%以上、完全接続層の85\%以上のパラメータを、精度を落とすことなく除去する。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\S33DURZQ\\Pandit et al. - 2022 - Learning Sparse Neural Networks Using Non-Convex Regularization.pdf;C\:\\Users\\furuh\\Zotero\\storage\\MTPYDJ6R\\9372948.html}
