@misc{yeDifferentialTransformer2024,
  title = {Differential {{Transformer}}},
  author = {Ye, Tianzhu and Dong, Li and Xia, Yuqing and Sun, Yutao and Zhu, Yi and Huang, Gao and Wei, Furu},
  year = {2024},
  month = oct,
  number = {arXiv:2410.05258},
  eprint = {2410.05258},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2410.05258},
  urldate = {2024-10-21},
  abstract = {Transformer tends to overallocate attention to irrelevant context. In this work, we introduce Diff Transformer, which amplifies attention to the relevant context while canceling noise. Specifically, the differential attention mechanism calculates attention scores as the difference between two separate softmax attention maps. The subtraction cancels noise, promoting the emergence of sparse attention patterns. Experimental results on language modeling show that Diff Transformer outperforms Transformer in various settings of scaling up model size and training tokens. More intriguingly, it offers notable advantages in practical applications, such as long-context modeling, key information retrieval, hallucination mitigation, in-context learning, and reduction of activation outliers. By being less distracted by irrelevant context, Diff Transformer can mitigate hallucination in question answering and text summarization. For in-context learning, Diff Transformer not only enhances accuracy but is also more robust to order permutation, which was considered as a chronic robustness issue. The results position Diff Transformer as a highly effective and promising architecture to advance large language models.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Computation and Language,Computer Science - Machine Learning},
  annotation = {abstractTranslation: Transformerは、無関係な文脈に注意を集中させる傾向がある。本研究では、ノイズをキャンセルしながら、関連するコンテキストへの注意を増幅するDiff Transformerを導入する。具体的には、この差分注意メカニズムは、2つの別々のソフトマックス注意マップの差分として注意スコアを計算する。減算はノイズをキャンセルし、スパースな注意パターンの出現を促進する。言語モデリングに関する実験結果は、Diff Transformerがモデルサイズや学習トークンをスケールアップする様々な設定においてTransformerを上回ることを示している。さらに興味深いことに、ロングコンテキストモデリング、キー情報検索、幻覚軽減、文脈内学習、活性化異常値の低減などの実用的な応用において、顕著な利点を提供する。無関係な文脈に惑わされることが少ないため、Diff Transformerは質問応答やテキスト要約における幻覚を軽減することができる。文脈内学習においては、Diff Transformerは精度を向上させるだけでなく、慢性的なロバスト性の問題として考えられていた順序の順列変化に対してもよりロバストである。この結果から、Diff Transformerは大規模言語モデルを発展させるための非常に効果的で有望なアーキテクチャであると位置づけられる。},
  file = {C:\Users\furuh\Zotero\storage\MVM5DBRW\Ye et al. - 2024 - Differential Transformer.pdf}
}

@misc{yehTotalVariationOptimization2022,
  title = {Total {{Variation Optimization Layers}} for {{Computer Vision}}},
  author = {Yeh, Raymond A. and Hu, Yuan-Ting and Ren, Zhongzheng and Schwing, Alexander G.},
  year = {2022},
  month = apr,
  number = {arXiv:2204.03643},
  eprint = {2204.03643},
  primaryclass = {cs},
  publisher = {arXiv},
  urldate = {2023-10-12},
  abstract = {Optimization within a layer of a deep-net has emerged as a new direction for deep-net layer design. However, there are two main challenges when applying these layers to computer vision tasks: (a) which optimization problem within a layer is useful?; (b) how to ensure that computation within a layer remains efficient? To study question (a), in this work, we propose total variation (TV) minimization as a layer for computer vision. Motivated by the success of total variation in image processing, we hypothesize that TV as a layer provides useful inductive bias for deep-nets too. We study this hypothesis on five computer vision tasks: image classification, weakly supervised object localization, edge-preserving smoothing, edge detection, and image denoising, improving over existing baselines. To achieve these results we had to address question (b): we developed a GPU-based projected-Newton method which is \$37{\textbackslash}times\$ faster than existing solutions.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computer Vision and Pattern Recognition},
  annotation = {abstractTranslation:  ディープネットのレイヤー内での最適化は、ディープネットのレイヤー設計の新たな方向性として浮上してきた。(a)レイヤー内のどの最適化問題が有用か、(b)レイヤー内の計算が効率的であることをどのように保証するか。(b)レイヤー内の計算が効率的であることを保証する方法。(a)の問題を研究するために、我々はコンピュータビジョンのレイヤーとして全変動(TV)最小化を提案する。画像処理における全変動の成功に動機づけられ、我々は、レイヤーとしてのTVがディープネットにも有用な帰納的バイアスを提供するという仮説を立てた。我々はこの仮説を、画像分類、弱教師付き物体位置特定、エッジ保存スムージング、エッジ検出、画像ノイズ除去という5つのコンピュータビジョンタスクについて研究し、既存のベースラインよりも改善した。これらの結果を達成するために、我々は質問(b)に対処する必要があった：我々は、既存の解決策より\$37times\$速いGPUベースの投影ニュートン法を開発した。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\T7RJEPQE\\Yeh et al. - 2022 - Total Variation Optimization Layers for Computer V.pdf;C\:\\Users\\furuh\\Zotero\\storage\\AYIRRIE3\\2204.html}
}

