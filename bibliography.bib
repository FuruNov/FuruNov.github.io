}

@inproceedings{lobanovBlackBoxOptimizationProblem2023,
  title = {The {{Black-Box Optimization Problem}}: {{Zero-Order Accelerated Stochastic Method}} via {{Kernel Approximation}}},
  shorttitle = {The {{Black-Box Optimization Problem}}},
  author = {Lobanov, A. and Bashirov, Nail and Gasnikov, A.},
  year = {2023},
  month = oct,
  urldate = {2023-10-21},
  abstract = {In this paper, we study the standard formulation of an optimization problem when the computation of gradient is not available. Such a problem can be classified as a"black box"optimization problem, since the oracle returns only the value of the objective function at the requested point, possibly with some stochastic noise. Assuming convex, and increased smoothness of the objective function, this paper provides a zero-order accelerated stochastic gradient descent (ZO-AccSGD) method for solving this problem, which exploits the increased smoothness information via kernel approximation. As theoretical results, we show that the ZO-AccSGD algorithm proposed in this paper improves the convergence results of state-of-the-art algorithms, namely the estimate of iteration complexity. In addition, our theoretical analysis provides an estimate of the maximum allowable noise level at which the desired accuracy can be achieved. We validate the theoretical results with an example of optimizing the negative logarithm of the likelihood function. We also provide a discussion in which we explain the results obtained and the superiority of the proposed algorithm over SOTA algorithms for solving the original problem.},
  file = {C:\Users\furuh\Zotero\storage\UD4PBA6Q\Lobanov et al. - 2023 - The Black-Box Optimization Problem Zero-Order Acc.pdf}
}

@inproceedings{lohRegularizedMestimatorsNonconvexity2013,
  title = {Regularized {{M-estimators}} with Nonconvexity: {{Statistical}} and Algorithmic Theory for Local Optima},
  shorttitle = {Regularized {{M-estimators}} with Nonconvexity},
  booktitle = {Advances in {{Neural Information Processing Systems}}},
  author = {Loh, Po-Ling and Wainwright, Martin J},
  year = {2013},
  volume = {26},
  publisher = {Curran Associates, Inc.},
  urldate = {2025-06-03},
  abstract = {We establish theoretical results concerning all local optima of various regularized M-estimators, where both loss and penalty functions are allowed to be nonconvex. Our results show that as long as the loss function satisfies restricted strong convexity and the penalty function satisfies suitable regularity conditions, any local optimum of the composite objective function lies within statistical precision of the true parameter vector. Our theory covers a broad class of nonconvex objective functions, including corrected versions of the Lasso for errors-in-variables linear models; regression in generalized linear models using nonconvex regularizers such as SCAD and MCP; and graph and inverse covariance matrix estimation. On the optimization side, we show that a simple adaptation of composite gradient descent may be used to compute a global optimum up to the statistical precision epsilon in log(1/epsilon) iterations, which is the fastest possible rate of any first-order method. We provide a variety of simulations to illustrate the sharpness of our theoretical predictions.我々は、損失関数とペナルティ関数の両方が非凸であることが許される、さまざまな正則化された M-推定量のすべての局所最適性に関する理論的結果を確立する。私たちの結果は、損失関数が制限された強い凸性を満たし、ペナルティ関数が適切な規則性条件を満たす限り、複合目的関数の任意の局所最適値は真のパラメーターベクトルの統計的精度内にあることを示しています。私たちの理論は、変数の誤差線形モデルのためのLassoの修正バージョンを含む、幅広いクラスの非凸目的関数をカバーしています。SCADやMCPなどの非凸正則化器を使用した一般化線形モデルでの回帰。グラフと逆共分散行列の推定。最適化の面では、複合勾配降下法の単純な適応を使用して、log(1/epsilon)反復の統計的精度イプシロンまでのグローバル最適値を計算できることを示します。これは、任意の一次法の中で最も速い速度です。私たちは、理論的な予測の鋭さを示すために、さまざまなシミュレーションを提供しています。},
  langid = {english},
  keywords = {No DOI found},
  annotation = {abstractTranslation: 我々は、損失関数とペナルティ関数の両方が非凸であることを許容する、様々な正則化M推定量における全ての局所最適解に関する理論的結果を確立する。我々の結果は、損失関数が制限された強凸性を満たし、ペナルティ関数が適切な正則性条件を満たす限り、複合目的関数の任意の局所最適解は真のパラメータベクトルの統計的精度内に存在することを示す。我々の理論は、変数誤差を伴う線形モデルに対するLassoの修正版、SCADやMCPといった非凸正則化を用いた一般化線形モデルにおける回帰、グラフおよび逆共分散行列の推定など、広範な非凸目的関数を包含する。最適化の観点からは、複合勾配降下法の簡単な適用によって、統計的精度{$\varepsilon$}まで、log(1/{$\varepsilon$})回の反復でグローバル最適解を計算できることを示す。これは、任意の一次法における最速の収束率である。理論的予測の妥当性を示すために、様々なシミュレーションを提供する。},
  file = {C:\Users\furuh\Zotero\storage\5L3EYSSY\loh15a.pdf}
}

