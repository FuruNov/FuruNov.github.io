@article{woodworthCompressedSensingRecovery2016,
  title = {Compressed Sensing Recovery via Nonconvex Shrinkage Penalties},
  author = {Woodworth, Joseph and Chartrand, Rick},
  year = {2016},
  month = jul,
  journal = {Inverse Problems},
  volume = {32},
  number = {7},
  pages = {075004},
  issn = {0266-5611, 1361-6420},
  doi = {10.1088/0266-5611/32/7/075004},
  urldate = {2023-12-13},
  abstract = {The l0 minimization of compressed sensing is often relaxed to l1, which yields easy computation  using the shrinkage mapping known as soft thresholding, and can be shown to recover the original  solution under certain hypotheses. Recent work has derived a general class of shrinkages and associated  nonconvex penalties that better approximate the original l0 penalty and empirically can recover the  original solution from fewer measurements. We specifically examine p-shrinkage and firm thresholding.  In this work, we prove that given data and a measurement matrix from a broad class of matrices, one can  choose parameters for these classes of shrinkages to guarantee exact recovery of the sparsest solution.  We further prove convergence of the algorithm iterative p-shrinkage (IPS) for solving one such relaxed  problem.},
  langid = {american},
  annotation = {abstractTranslation: 圧縮センシングのl0最小化はしばしばl1に緩和され、ソフト閾値として知られる収縮マッピングを用いて簡単に計算でき、ある仮説の下では元の解を回復することが示される。最近の研究では、元のl0ペナルティをより良く近似し、経験的に、より少ない測定値から元の解を回復できる、一般的な収縮と関連する非凸ペナルティを導出している。我々は特にp-shrinkageとfirm thresholdingを検討する。  本研究では、広範なクラスの行列からデータと測定行列が与えられた場合、最も疎な解の厳密な復元を保証するために、これらのクラスの縮小のパラメータを選択できることを証明する。  さらに、このような緩和された問題を解くためのアルゴリズム反復的p-収縮(IPS)の収束を証明する。},
