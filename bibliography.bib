@inproceedings{uekiStableLightweightDeep2025,
  title = {Stable and {{Lightweight Deep Primal-Dual Unrolling}} for {{Constrained Image Restoration}} with {{Convolutional Sparse Coding}}},
  booktitle = {{{ICASSP}} 2025 - 2025 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
