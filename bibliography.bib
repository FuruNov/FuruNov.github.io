@article{prater-bennetteProximityOperatorLogSum2022,
  title = {The {{Proximity Operator}} of the {{Log-Sum Penalty}}},
  author = {{Prater-Bennette}, Ashley and Shen, Lixin and Tripp, Erin E.},
  year = {2022},
  month = oct,
  journal = {Journal of Scientific Computing},
  volume = {93},
  number = {3},
  pages = {67},
  issn = {1573-7691},
  doi = {10.1007/s10915-022-02021-4},
  urldate = {2024-07-20},
  abstract = {The log-sum penalty is often adopted as a replacement for the \$\${\textbackslash}ell \_0\$\$pseudo-norm in compressive sensing and low-rank optimization. The proximity operator of the \$\${\textbackslash}ell \_0\$\$penalty, i.e., the hard-thresholding operator, plays an essential role in applications; similarly, we require an efficient method for evaluating the proximity operator of the log-sum penalty. Due to the nonconvexity of this function, its proximity operator is commonly computed through the iteratively reweighted \$\${\textbackslash}ell \_1\$\$method, which replaces the log-sum term with its first-order approximation. This paper reports that the proximity operator of the log-sum penalty actually has an explicit expression. With it, we show that the iteratively reweighted \$\${\textbackslash}ell \_1\$\$solution disagrees with the true proximity operator in certain regions. As a by-product, the iteratively reweighted \$\${\textbackslash}ell \_1\$\$solution is precisely characterized in terms of the chosen initialization. We also give the explicit form of the proximity operator for the composition of the log-sum penalty with the singular value function, as seen in low-rank applications. These results should be useful in the development of efficient and accurate algorithms for optimization problems involving the log-sum penalty. We present applications to solving compressive sensing problems and to mixed additive Gaussian white noise and impulse noise removal.},
  langid = {english},
  keywords = {Compressive sensing,Iteratively reweighted \ell _1\ell _1,Log-sum function,Low-rank regularization,Proximal mapping,Proximity operator},
  file = {C:\Users\furuh\Zotero\storage\LNFTIEZ5\Prater-Bennette et al. - 2022 - The Proximity Operator of the Log-Sum Penalty.pdf}
}

@inproceedings{priceDEEPNEURALNETWORK2023,
  title = {{{DEEP NEURAL NETWORK INITIALIZATION WITH SPARSITY INDUCING ACTIVATIONS}}},
  booktitle = {The {{Twelfth International Conference}} on {{Learning Representations}}},
  author = {Price, Ilan and Ball, Nicholas Daultry and Jones, Adam Christopher and Lam, Samuel Chun Hei and Tanner, Jared},
  year = {2023},
  month = oct,
  urldate = {2024-06-17},
  abstract = {Inducing and leveraging sparse activations during training and inference is a promising avenue for improving the computational efficiency of deep networks, which is increasingly important as network sizes continue to grow and their application becomes more widespread. Here we use the large width Gaussian process limit to analyze the behaviour, at random initialization, of nonlinear activations that induce sparsity in the hidden outputs. A previously unreported form of training instability is proven for arguably two of the most natural candidates for hidden layer sparsification; those being a shifted ReLU (\${\textbackslash}phi(x)={\textbackslash}max(0, x-{\textbackslash}tau)\$ for \${\textbackslash}tau{\textbackslash}ge 0\$) and soft thresholding (\${\textbackslash}phi(x)=0\$ for \${\textbar}x{\textbar}{\textbackslash}le{\textbackslash}tau\$ and \$x-{\textbackslash}text\{sign\}(x){\textbackslash}tau\$ for \${\textbar}x{\textbar}{$>\backslash$}tau\$). We show that this instability is overcome by clipping the nonlinear activation magnitude, at a level prescribed by the shape of the associated Gaussian process variance map. Numerical experiments verify the theory and show that the proposed magnitude clipped sparsifying activations can be trained with training and test fractional sparsity as high as 85{\textbackslash}\% while retaining close to full accuracy.},
  langid = {english},
  annotation = {abstractTranslation:  学習と推論において疎な活性化を誘導し活用することは、ディープネットワークの計算効率を向上させる有望な手段である。ここでは、大幅ガウス過程極限を用いて、隠れ出力にスパース性をもたらす非線形活性化のランダム初期化時の振る舞いを解析する。これまで報告されていなかった学習不安定性が、間違いなく最も自然な隠れ層スパース化の候補である、シフトReLU（\$tauge 0\$に対して\$phi(x)=max(0, x-tau)\$）とソフト閾値（\${\textbar}x{\textbar}letau\$に対して\$phi(x)=0\$、\${\textbar}x{\textbar}{$>>$}tau\$に対して\$x-text\{sign\}(x) {\textbackslash}tau\$）の2つに対して証明された。この不安定性は、関連するガウス過程分散マップの形状によって規定されるレベルで、非線形活性化の大きさをクリッピングすることによって克服されることを示す。数値実験により理論が検証され、提案された大きさでクリッピングされたスパース化活性化は、訓練とテストの分数スパース性が85％と高くても、完全精度に近いまま訓練できることが示される。},
  file = {C:\Users\furuh\Zotero\storage\JL5RHA56\Price et al. - 2023 - DEEP NEURAL NETWORK INITIALIZATION WITH SPARSITY I.pdf}
}

@inproceedings{princeManipulatingDropoutReveals2023,
  title = {Manipulating Dropout Reveals an Optimal Balance of Efficiency and Robustness in Biological and Machine Visual Systems},
  booktitle = {The {{Twelfth International Conference}} on {{Learning Representations}}},
  author = {Prince, Jacob S. and Fajardo, Gabriel and Alvarez, George A. and Konkle, Talia},
  year = {2023},
  month = oct,
  urldate = {2024-06-17},
  abstract = {According to the efficient coding hypothesis, neural populations encode information optimally when representations are high-dimensional and uncorrelated. However, such codes may carry a cost in terms of generalization and robustness. Past empirical studies of early visual cortex (V1) in rodents have suggested that this tradeoff indeed constrains sensory representations. However, it remains unclear whether these insights generalize across the hierarchy of the human visual system, and particularly to object representations in high-level occipitotemporal cortex (OTC). To gain new empirical clarity, here we develop a family of object recognition models with parametrically varying dropout proportion \$p\$, which induces systematically varying dimensionality of internal responses (while controlling all other inductive biases). We find that increasing dropout produces an increasingly smooth, low-dimensional representational space. Optimal robustness to lesioning is observed at around 70\% dropout, after which both accuracy and robustness decline. Representational comparison to large-scale 7T fMRI data from occipitotemporal cortex in the Natural Scenes Dataset reveals that this optimal degree of dropout is also associated with maximal emergent neural predictivity. Finally, using new techniques for achieving denoised estimates of the eigenspectrum of human fMRI responses, we compare the rate of eigenspectrum decay between model and brain feature spaces. We observe that the match between model and brain representations is associated with a common balance between efficiency and robustness in the representational space. These results suggest that varying dropout may reveal an optimal point of balance between the efficiency of high-dimensional codes and the robustness of low dimensional codes in hierarchical vision systems.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\WWNXNGU7\Prince et al. - 2023 - Manipulating dropout reveals an optimal balance of.pdf}
}

@misc{proctorDynamicModeDecomposition2014,
