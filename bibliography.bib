  booktitle = {The {{Thirteenth International Conference}} on {{Learning Representations}}},
  author = {Gorbunov, Eduard and Tupitsa, Nazarii and Choudhury, Sayantan and Aliev, Alen and Richt{\'a}rik, Peter and Horv{\'a}th, Samuel and Tak{\'a}{\v c}, Martin},
  year = {2024},
  month = oct,
  urldate = {2025-04-26},
  abstract = {Due to the non-smoothness of optimization problems in Machine Learning, generalized smoothness assumptions have been gaining a lot of attention in recent years. One of the most popular assumptions of this type is \$(L\_0,L\_1)\$-smoothness (Zhang et al., 2020). In this paper, we focus on the class of (strongly) convex \$(L\_0,L\_1)\$-smooth functions and derive new convergence guarantees for several existing methods. In particular, we derive improved convergence rates for Gradient Descent with (Smoothed) Gradient Clipping and for Gradient Descent with Polyak Stepsizes. In contrast to the existing results, our rates do not rely on the standard smoothness assumption and do not suffer from the exponential dependency on the initial distance to the solution. We also extend these results to the stochastic case under the over-parameterization assumption, propose a new accelerated method for convex \$(L\_0,L\_1)\$-smooth optimization, and derive new convergence rates for Adaptive Gradient Descent (Malitsky and Mishchenko, 2020).},
  langid = {english},
  annotation = {abstractTranslation: 機械学習における最適化問題の非平滑性のため、近年、一般化された平滑性に関する仮定が注目を集めている。この種の仮定の中で最も一般的なものの一つが\$(L\_0,L\_1)\$-平滑性である（Zhang et al., 2020）。本稿では、（強）凸\$(L\_0,L\_1)\$-平滑関数のクラスに焦点を当て、既存のいくつかの手法に対する新たな収束保証を導出する。特に、(Smoothed) Gradient Clippingを用いた勾配降下法およびPolyak Step sizeを用いた勾配降下法について、改善された収束率を導出する。既存の結果とは対照的に、我々の収束率は標準的な平滑性の仮定に依存せず、解への初期距離に対する指数関数的な依存性を受けない。また、過剰パラメータ化の仮定の下でこれらの結果を確率的な場合に拡張し、凸\$(L\_0,L\_1)\$-平滑最適化のための新たな加速法を提案し、Adaptive Gradient Descent (Malitsky and Mishchenko, 2020)に対する新たな収束率を導出する。},
