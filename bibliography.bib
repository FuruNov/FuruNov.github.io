@article{shiDomainGeneralizationNuclear2023,
  title = {Domain {{Generalization}} via {{Nuclear Norm Regularization}}},
  author = {Shi, Zhenmei and Ming, Yifei and Fan, Ying and Sala, Frederic and Liang, Yingyu},
  year = {2023},
  doi = {10.48550/ARXIV.2303.07527},
  urldate = {2024-08-09},
  abstract = {The ability to generalize to unseen domains is crucial for machine learning systems deployed in the real world, especially when we only have data from limited training domains. In this paper, we propose a simple and effective regularization method based on the nuclear norm of the learned features for domain generalization. Intuitively, the proposed regularizer mitigates the impacts of environmental features and encourages learning domain-invariant features. Theoretically, we provide insights into why nuclear norm regularization is more effective compared to ERM and alternative regularization methods. Empirically, we conduct extensive experiments on both synthetic and real datasets. We show nuclear norm regularization achieves strong performance compared to baselines in a wide range of domain generalization tasks. Moreover, our regularizer is broadly applicable with various methods such as ERM and SWAD with consistently improved performance, e.g., 1.7\% and 0.9\% test accuracy improvements respectively on the DomainBed benchmark.},
  copyright = {arXiv.org perpetual, non-exclusive license},
  keywords = {Computer Vision and Pattern Recognition (cs.CV),FOS: Computer and information sciences,Machine Learning (cs.LG)}
}

@article{shiECGBaselineEstimation2021,
  title = {{{ECG Baseline Estimation}} and {{Denoising With Group Sparse Regularization}}},
  author = {Shi, Hao and Liu, Ruixia and Chen, Changfang and Shu, Minglei and Wang, Yinglong},
  year = {2021},
  journal = {IEEE Access},
  volume = {9},
  pages = {23595--23607},
  issn = {2169-3536},
  doi = {10.1109/ACCESS.2021.3056459},
  urldate = {2024-11-30},
  abstract = {Baseline wander (BW) and electrocardiogram (ECG) noise reduction play an important role in ECG data analysis and disease diagnosis. This article introduces a sparse optimization method, which takes into account the group sparse characteristics of the signal, and combines low-pass filter to denoise the ECG signal and estimate the baseline. Derived from the classic total variation (TV) denoising method, a denoising method considering the structural characteristics of ECG signals is proposed. This method uses a band matrix to represent the sparse optimization problem, and adopts majorization-minimization (MM) algorithm to optimize the solution of the convergence problem. Through data comparison and detailed analysis, we first compares the method with two TV denoising methods. Then, the proposed method is validated in the MIT-BIH arrhythmia database of ECG signals, and compared with nonlocal means (NLM) and complete ensemble empirical mode decomposition with adaptive noise (CEEMDAN) methods. The simulation experiment results show that the proposed algorithm has lower root mean square error (RMSE) and higher signal-to-noise ratio improvement ( {\textbackslash}mathrm SNR\_imp ).},
  langid = {american},
  keywords = {baseline estimation,Dictionaries,ECG denoising,Electrocardiography,group sparsity penalty,Noise reduction,Optimization,sparse optimization,TV,Wavelet transforms},
  annotation = {abstractTranslation: ベースラインワンダ（BW）と心電図（ECG）ノイズ除去は、ECGデータ解析と疾患診断において重要な役割を果たす。この論文では、信号のグループスパース特性を考慮したスパース最適化法を紹介し、ローパスフィルタを組み合わせてECG信号をノイズ除去し、ベースラインを推定する。古典的なtotal variation (TV)ノイズ除去法から派生して、ECG信号の構造的特性を考慮したノイズ除去法を提案する。この方法は、スパース最適化問題を表現するためにバンド行列を使用し、収束問題の解を最適化するためにマジョリゼーション最小化（MM）アルゴリズムを採用する。データ比較と詳細な解析を通して、まず本手法を2つのTVノイズ除去法と比較する。次に、提案手法をECG信号のMIT-Bih不整脈データベースで検証し、非局所平均(NLM)法および適応ノイズを用いた完全アンサンブル経験的モード分解(CEEMDAN)法と比較する。シミュレーション実験の結果、提案アルゴリズムは二乗平均平方根誤差(RMSE)が小さく、S/N比( {\textbackslash}mathrm SNR\_imp )が向上することが示された。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\JRI8MIGH\\Shi et al. - 2021 - ECG Baseline Estimation and Denoising With Group Sparse Regularization.pdf;C\:\\Users\\furuh\\Zotero\\storage\\P2A9CU3A\\9344703.html}
}

