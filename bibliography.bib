  publisher = {IEEE},
  address = {Honolulu, HI},
  doi = {10.1109/CVPR.2017.411},
  urldate = {2024-07-15},
  abstract = {Hyperspectral image (HSI) super-resolution, which fuses a low-resolution (LR) HSI with a high-resolution (HR) multispectral image (MSI), has recently attracted much attention. Most of the current HSI super-resolution approaches are based on matrix factorization, which unfolds the three-dimensional HSI as a matrix before processing. In general, the matrix data representation obtained after the matrix unfolding operation makes it hard to fully exploit the inherent HSI spatial-spectral structures. In this paper, a novel HSI super-resolution method based on non-local sparse tensor factorization (called as the NLSTF) is proposed. The sparse tensor factorization can directly decompose each cube of the HSI as a sparse core tensor and dictionaries of three modes, which reformulates the HSI super-resolution problem as the estimation of sparse core tensor and dictionaries for each cube. To further exploit the non-local spatial self-similarities of the HSI, similar cubes are grouped together, and they are assumed to share the same dictionaries. The dictionaries are learned from the LR-HSI and HR-MSI for each group, and corresponding sparse core tensors are estimated by spare coding on the learned dictionaries for each cube. Experimental results demonstrate the superiority of the proposed NLSTF approach over several state-of-the-art HSI super-resolution approaches.},
  isbn = {9781538604571}
}

@misc{diaoPruningDeepNeural2023,
  title = {Pruning {{Deep Neural Networks}} from a {{Sparsity Perspective}}},
  author = {Diao, Enmao and Wang, Ganghua and Zhan, Jiawei and Yang, Yuhong and Ding, Jie and Tarokh, Vahid},
  year = {2023},
  month = aug,
  number = {arXiv:2302.05601},
  eprint = {2302.05601},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2302.05601},
  urldate = {2024-10-18},
  abstract = {In recent years, deep network pruning has attracted significant attention in order to enable the rapid deployment of AI into small devices with computation and memory constraints. Pruning is often achieved by dropping redundant weights, neurons, or layers of a deep network while attempting to retain a comparable test performance. Many deep pruning algorithms have been proposed with impressive empirical success. However, existing approaches lack a quantifiable measure to estimate the compressibility of a sub-network during each pruning iteration and thus may under-prune or over-prune the model. In this work, we propose PQ Index (PQI) to measure the potential compressibility of deep neural networks and use this to develop a Sparsity-informed Adaptive Pruning (SAP) algorithm. Our extensive experiments corroborate the hypothesis that for a generic pruning procedure, PQI decreases first when a large model is being effectively regularized and then increases when its compressibility reaches a limit that appears to correspond to the beginning of underfitting. Subsequently, PQI decreases again when the model collapse and significant deterioration in the performance of the model start to occur. Additionally, our experiments demonstrate that the proposed adaptive pruning algorithm with proper choice of hyper-parameters is superior to the iterative pruning algorithms such as the lottery ticket-based pruning methods, in terms of both compression efficiency and robustness.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Machine Learning},
  annotation = {abstractTranslation: 近年、計算やメモリに制約のある小型デバイスにAIを迅速に導入するために、ディープネットワークの刈り込みが大きな注目を集めている。プルーニングは多くの場合、ディープネットワークの冗長な重み、ニューロン、またはレイヤーを削除することで達成され、同時に同等のテスト性能を維持することが試みられる。多くのディープ・プルーニング・アルゴリズムが提案され、経験的に大きな成功を収めている。しかし、既存のアプローチには、各プルーニング反復中のサブネットワークの圧縮性を推定する定量化可能な尺度がないため、モデルのプルーニングが過小または過大になる可能性がある。本研究では、ディープニューラルネットワークの潜在的な圧縮性を測定するためにPQインデックス（PQI）を提案し、これを用いてSAP（Sparsity-informed Adaptive Pruning）アルゴリズムを開発する。我々の広範な実験により、一般的な刈り込み手順では、大規模なモデルが効果的に正則化されているときにPQIが最初に減少し、次にその圧縮性がアンダーフィッティングの始まりに対応すると思われる限界に達したときに増加するという仮説が裏付けられた。その後、モデルの崩壊と性能の著しい劣化が起こり始めると、PQIは再び減少する。さらに、我々の実験により、ハイパーパラメータを適切に選択した提案する適応的刈り込みアルゴリズムが、圧縮効率と頑健性の両方において、抽選券ベースの刈り込み手法のような反復刈り込みアルゴリズムよりも優れていることが実証された。},
  file = {C:\Users\furuh\Zotero\storage\KRGRU8N6\Diao et al. - 2023 - Pruning Deep Neural Networks from a Sparsity Perspective.pdf}
}

