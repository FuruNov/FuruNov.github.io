@inproceedings{fangEfficientRobustPrincipal2023,
  title = {Efficient {{Robust Principal Component Analysis}} via {{Block Krylov Iteration}} and {{CUR Decomposition}}},
  booktitle = {2023 {{IEEE}}/{{CVF Conference}} on {{Computer Vision}} and {{Pattern Recognition}} ({{CVPR}})},
  author = {Fang, Shun and Xu, Zhengqin and Wu, Shiqian and Xie, Shoulie},
  year = {2023},
  month = jun,
  pages = {1348--1357},
  issn = {2575-7075},
  doi = {10.1109/CVPR52729.2023.00136},
  urldate = {2025-01-06},
  abstract = {Robust principal component analysis (RPCA) is widely studied in computer vision. Recently an adaptive rank estimate based RPCA has achieved top performance in low-level vision tasks without the prior rank, but both the rank estimate and RPCA optimization algorithm involve singular value decomposition, which requires extremely huge computational resource for large-scale matrices. To address these issues, an efficient RPCA (eRPCA) algorithm is proposed based on block Krylov iteration and CUR decomposition in this paper. Specifically, the Krylov iteration method is employed to approximate the eigenvalue decomposition in the rank estimation, which requires O(ndrq+n(rq){\textasciicircum}2) for an (n{\textbackslash}times d) input matrix, in which q is a parameter with a small value, r is the target rank. Based on the estimated rank, CUR decomposition is adopted to replace SVD in updating low-rank matrix component, whose complexity reduces from O(rnd) to O(r{\textasciicircum}2n) per iteration. Experimental results verify the efficiency and effectiveness of the proposed eRPCA over the state-of-the-art methods in various low-level vision applications.},
  langid = {english},
  keywords = {Approximation algorithms,Computer vision,Estimation,Matrix decomposition,Optimization methods (other than deep learning),Pattern recognition,Robustness,Sparse matrices},
