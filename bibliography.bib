@article{wenSurveyIncompleteMultiview2023,
  title = {A {{Survey}} on {{Incomplete Multi-view Clustering}}},
  author = {Wen, Jie and Zhang, Zheng and Fei, Lunke and Zhang, Bob and Xu, Yong and Zhang, Zhao and Li, Jinxing},
  year = {2023},
  month = feb,
  journal = {IEEE Transactions on Systems, Man, and Cybernetics: Systems},
  volume = {53},
  number = {2},
  eprint = {2208.08040},
  primaryclass = {cs},
  pages = {1136--1149},
  issn = {2168-2216, 2168-2232},
  doi = {10.1109/TSMC.2022.3192635},
  urldate = {2024-09-07},
  abstract = {Conventional multi-view clustering seeks to partition data into respective groups based on the assumption that all views are fully observed. However, in practical applications, such as disease diagnosis, multimedia analysis, and recommendation system, it is common to observe that not all views of samples are available in many cases, which leads to the failure of the conventional multi-view clustering methods. Clustering on such incomplete multi-view data is referred to as incomplete multi-view clustering. In view of the promising application prospects, the research of incomplete multi-view clustering has noticeable advances in recent years. However, there is no survey to summarize the current progresses and point out the future research directions. To this end, we review the recent studies of incomplete multi-view clustering. Importantly, we provide some frameworks to unify the corresponding incomplete multi-view clustering methods, and make an in-depth comparative analysis for some representative methods from theoretical and experimental perspectives. Finally, some open problems in the incomplete multi-view clustering field are offered for researchers.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Machine Learning,Computer Science - Multimedia},
  annotation = {abstractTranslation: 従来のマルチビュークラスタリングは、すべてのビューが完全に観測されているという仮定に基づいて、データをそれぞれのグループに分割しようとするものである。しかし、病気診断、マルチメディア分析、推薦システムなどの実用的なアプリケーションでは、多くの場合、サンプルのすべてのビューが利用できないことが一般的に観察され、これが従来のマルチビュークラスタリング手法の失敗につながる。このような不完全なマルチビューデータに対するクラスタリングは、不完全マルチビュークラスタリングと呼ばれる。このような不完全マルチビューデータに対するクラスタリングは、不完全マルチビュークラスタリングと呼ばれている。しかし，現在の進捗状況を総括し，今後の研究の方向性を示すようなサーベイは存在しない．そこで、本論文では、不完全マルチビュークラスタリングの最近の研究をレビューする。重要な点として、対応する不完全マルチビュークラスタリング手法を統一するためのいくつかのフレームワークを提供し、いくつかの代表的な手法について、理論的・実験的観点から詳細な比較分析を行う。最後に、不完全マルチビュークラスタリング分野におけるいくつかの未解決問題を研究者に提示する。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\2RQUQIUS\\Wen et al. - 2023 - A Survey on Incomplete Multi-view Clustering.pdf;C\:\\Users\\furuh\\Zotero\\storage\\XBWICG4T\\2208.html}
}

@article{wenSurveyNonconvexRegularizationBased2018,
  title = {A {{Survey}} on {{Nonconvex Regularization-Based Sparse}} and {{Low-Rank Recovery}} in {{Signal Processing}}, {{Statistics}}, and {{Machine Learning}}},
  author = {Wen, Fei and Chu, Lei and Liu, Peilin and Qiu, Robert C.},
  year = {2018},
  journal = {IEEE Access},
  volume = {6},
  pages = {69883--69906},
  issn = {2169-3536},
  doi = {10.1109/ACCESS.2018.2880454},
  urldate = {2023-11-27},
  abstract = {In the past decade, sparse and low-rank recovery has drawn much attention in many areas such as signal/image processing, statistics, bioinformatics, and machine learning. To achieve sparsity and/or low-rankness inducing, the  \${\textbackslash}ell \_\{1\}\$  norm and nuclear norm are of the most popular regularization penalties due to their convexity. While the  \${\textbackslash}ell \_\{1\}\$  and nuclear norm are convenient as the related convex optimization problems are usually tractable, it has been shown in many applications that a nonconvex penalty can yield significantly better performance. In recent, nonconvex regularization-based sparse and low-rank recovery is of considerable interest and it in fact is a main driver of the recent progress in nonconvex and nonsmooth optimization. This paper gives an overview of this topic in various fields in signal processing, statistics, and machine learning, including compressive sensing, sparse regression and variable selection, sparse signals separation, sparse principal component analysis (PCA), large covariance and inverse covariance matrices estimation, matrix completion, and robust PCA. We present recent developments of nonconvex regularization based sparse and low-rank recovery in these fields, addressing the issues of penalty selection, applications and the convergence of nonconvex algorithms. Code is available at https://github.com/FWen/ncreg.git.},
  langid = {english},
  keywords = {Favorite},
  annotation = {abstractTranslation: 過去10年間、スパースと低ランクの復元は、信号/画像処理、統計、バイオインフォマティクス、機械学習などの多くの分野で注目を集めてきた。スパース性と低ランク性を実現するために、\$ell\_\{1\}\$ノルムと核ノルムは凸であるため、最も一般的な正則化ペナルティである。ell\_\{1\}\$ノルムと核ノルムは、関連する凸最適化問題が通常扱いやすいので便利であるが、多くの応用において、非凸ペナルティが著しく良い性能をもたらすことが示されている。近年、非凸正則化に基づくスパース・低ランク復元は大きな関心を集めており、実際、非凸・非平滑最適化における最近の進歩の主な原動力となっている。本論文では、圧縮センシング、スパース回帰と変数選択、スパース信号分離、スパース主成分分析（PCA）、大きな共分散行列と逆共分散行列の推定、行列補完、ロバストPCAなど、信号処理、統計、機械学習の様々な分野におけるこのトピックの概要を述べる。本講演では、これらの分野における非凸正則化に基づくスパース・低ランク回復の最近の発展について、ペナルティ選択、応用、非凸アルゴリズムの収束の問題を取り上げながら紹介する。コードはhttps://github.com/FWen/ncreg.git。},
  file = {C:\Users\furuh\Zotero\storage\Z2SZTFDF\Wen et al. - 2018 - A Survey on Nonconvex Regularization-Based Sparse .pdf}
}

@article{wenVisibilityGraphTime2022,
  title = {Visibility Graph for Time Series Prediction and Image Classification: A Review},
  shorttitle = {Visibility Graph for Time Series Prediction and Image Classification},
  author = {Wen, Tao and Chen, Huiling and Cheong, Kang Hao},
  year = {2022},
  month = dec,
  journal = {Nonlinear Dynamics},
  volume = {110},
  number = {4},
  pages = {2979--2999},
  issn = {0924-090X, 1573-269X},
  doi = {10.1007/s11071-022-08002-4},
  urldate = {2024-07-08},
  abstract = {The analysis of time series and images is significant across different fields due to their widespread applications. In the past few decades, many approaches have been developed, including data-driven artificial intelligence methods, mechanism-driven physical methods, and hybrid mechanism and data-driven models. Complex networks have been used to model numerous complex systems due to its characteristics, including time series prediction and image classification. In order to map time series and images into complex networks, many visibility graph algorithms have been developed, such as horizontal visibility graph, limited penetrable visibility graph, multiplex visibility graph, and image visibility graph. The family of visibility graph algorithms will construct different types of complex networks, including (un-) weighted, (un-) directed, and (single-) multi-layered networks, thereby focusing on different kinds of properties. Different types of visibility graph algorithms will be reviewed in this paper. Through exploring the topological structure and information in the network based on statistical physics, the property of time series and images can be discovered. In order to forecast (multivariate) time series, several variations of local random walk algorithms and different information fusion approaches are applied to measure the similarity between nodes in the network. Different forecasting frameworks are also proposed to consider the information in the time series based on the similarity. In order to classify the image, several machine learning models (such as support vector machine and linear discriminant) are used to classify images based on global features, local features, and multiplex features. Through various simulations on a variety of datasets, researchers have found that the visibility graph algorithm outperformed existing algorithms, both in time series prediction and image classification. Clearly, complex networks are closely connected with time series and images by visibility graph algorithms, rendering complex networks to be an important tool for understanding the characteristics of time series and images. Finally, we conclude in the last section with future outlooks for the visibility graph.},
  langid = {english},
