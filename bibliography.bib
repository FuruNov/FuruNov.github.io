  eprint = {1511.03688},
  primaryclass = {stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1511.03688},
  urldate = {2024-12-31},
  abstract = {In the current context of data explosion, online techniques that do not require storing all data in memory are indispensable to routinely perform tasks like principal component analysis (PCA). Recursive algorithms that update the PCA with each new observation have been studied in various fields of research and found wide applications in industrial monitoring, computer vision, astronomy, and latent semantic indexing, among others. This work provides guidance for selecting an online PCA algorithm in practice. We present the main approaches to online PCA, namely, perturbation techniques, incremental methods, and stochastic optimization, and compare their statistical accuracy, computation time, and memory requirements using artificial and real data. Extensions to missing data and to functional data are discussed. All studied algorithms are available in the R package onlinePCA on CRAN.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Machine Learning,Statistics - Machine Learning,Statistics - Methodology},
  annotation = {abstractTranslation: 現在のデータ爆発の状況では、主成分分析 (PCA) などのタスクを日常的に実行するには、すべてのデータをメモリに保存する必要のないオンライン技術が不可欠です。新しい観測ごとに PCA を更新する再帰的アルゴリズムは、さまざまな研究分野で研究されており、特に産業監視、コンピューター ビジョン、天文学、潜在的なセマンティック インデックス作成などに幅広い応用が見出されています。この研究は、実際にオンライン PCA アルゴリズムを選択するためのガイダンスを提供します。オンライン PCA の主なアプローチ、つまり摂動手法、増分手法、確率的最適化を紹介し、人工データと実データを使用してそれらの統計的精度、計算時間、メモリ要件を比較します。欠損データと機能データの拡張について説明します。研究されたすべてのアルゴリズムは、CRAN の R パッケージ onlinePCA で入手できます。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\Y6RUJ6Q2\\Cardot と Degras - 2015 - Online Principal Component Analysis in High Dimension Which Algorithm to Choose.pdf;C\:\\Users\\furuh\\Zotero\\storage\\JSWAXX5J\\1511.html}
}

@inproceedings{carliniEvaluatingRobustnessNeural2017,
  title = {Towards {{Evaluating}} the {{Robustness}} of {{Neural Networks}}},
  booktitle = {Proceedings of {{IEEE Symposium}} on {{Security}} and {{Privacy}}},
  author = {Carlini, Nicholas and Wagner, David},
  year = {2017},
  month = may,
  pages = {39--57},
  publisher = {IEEE Computer Society},
  issn = {2375-1207},
  doi = {10.1109/SP.2017.49},
  urldate = {2025-01-24},
  abstract = {Neural networks provide state-of-the-art results for most machine learning tasks. Unfortunately, neural networks are vulnerable to adversarial examples: given an input x and any target classification t, it is possible to find a new input x' that is similar to x but classified as t. This makes it difficult to apply neural networks in security-critical areas. Defensive distillation is a recently proposed approach that can take an arbitrary neural network, and increase its robustness, reducing the success rate of current attacks' ability to find adversarial examples from 95\% to 0.5\%. In this paper, we demonstrate that defensive distillation does not significantly increase the robustness of neural networks by introducing three new attack algorithms that are successful on both distilled and undistilled neural networks with 100\% probability. Our attacks are tailored to three distance metrics used previously in the literature, and when compared to previous adversarial example generation algorithms, our attacks are often much more effective (and never worse). Furthermore, we propose using high-confidence adversarial examples in a simple transferability test we show can also be used to break defensive distillation. We hope our attacks will be used as a benchmark in future defense attempts to create neural networks that resist adversarial examples.},
  isbn = {978-1-5090-5533-3},
  langid = {english},
  annotation = {abstractTranslation: ニューラルネットワークは、ほとんどの機械学習タスクに最先端の結果を提供します。残念ながら、ニューラルネットワークは敵対例に対して脆弱です。入力Xとターゲット分類tを考えると、xに似ているがtに分類される新しい入力x 'を見つけることができます。これにより、セキュリティクリティカルな領域にニューラルネットワークを適用することが困難になります。防御的蒸留は、任意のニューラルネットワークを採用し、その堅牢性を高めることができる最近提案されたアプローチであり、現在の攻撃の成功率を95％から0.5％に見つける能力を低下させます。この論文では、防御的な蒸留が、蒸留型と紛らわしいニューラルネットワークの両方で100％確率で成功する3つの新しい攻撃アルゴリズムを導入することにより、ニューラルネットワークの堅牢性を大幅に向上させないことを実証します。私たちの攻撃は、以前に文献で使用されていた3つの距離メトリックに合わせて調整されており、以前の敵対的な例生成アルゴリズムと比較すると、攻撃はしばしばはるかに効果的です（そして決して悪いことではありません）。さらに、私たちが示す単純な移転可能性テストで、高い自信の敵対例を使用することも、防御的な蒸留を破るために使用できることを提案します。私たちの攻撃が、敵の例に抵抗するニューラルネットワークを作成しようとする将来の防衛試みのベンチマークとして使用されることを願っています。},
  file = {C:\Users\furuh\Zotero\storage\8B4JMC6S\Carlini と Wagner - 2017 - Towards Evaluating the Robustness of Neural Networks.pdf}
}

