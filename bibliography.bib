  title = {Iterative P-Shrinkage Thresholding Algorithm for Low {{Tucker}} Rank Tensor Recovery},
  author = {Shang, Kun and Li, Yu-Fan and Huang, Zheng-Hai},
  year = {2019},
  month = may,
  journal = {Information Sciences},
  volume = {482},
  pages = {374--391},
  issn = {0020-0255},
  doi = {10.1016/j.ins.2019.01.031},
  urldate = {2023-12-13},
  abstract = {Low-rank tensor recovery, as a higher order extension of low-rank matrix recovery, has generated a great deal of research interests in recent years, such as image inpainting, video inpainting, video decoding, scan completion, and so on. In this paper, we propose an easy-to-implement algorithm based on the framework of alternative direction method, named iterative p-shrinkage thresholding algorithm, for solving the low Tucker rank tensor recovery problem. The performance of the proposed algorithm is investigated on both synthetic and real data. Numerical results on simulation data demonstrate that our algorithm can successfully recover varieties of synthetic low Tucker rank tensors in different sampling ratios with better quality compared to the existing state-of-the-art tensor recovery algorithms. Experiments on real data, including colored image inpainting, MRI image inpainting and hyperspectral image inpainting, further illustrate the effectiveness of the proposed iterative p-shrinkage thresholding algorithm.},
  keywords = {-shrinkage thresholding,Alternative direction method of multipliers,Image inpainting,Low tucker rank tensor recovery,Tensor completion}
}

