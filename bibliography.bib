@misc{yangLargeLanguageModels2023,
  title = {Large {{Language Models}} as {{Optimizers}}},
  author = {Yang, Chengrun and Wang, Xuezhi and Lu, Yifeng and Liu, Hanxiao and Le, Quoc V. and Zhou, Denny and Chen, Xinyun},
  year = {2023},
  month = sep,
  number = {arXiv:2309.03409},
  eprint = {2309.03409},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2309.03409},
  urldate = {2023-09-08},
  abstract = {Optimization is ubiquitous. While derivative-based algorithms have been powerful tools for various problems, the absence of gradient imposes challenges on many real-world applications. In this work, we propose Optimization by PROmpting (OPRO), a simple and effective approach to leverage large language models (LLMs) as optimizers, where the optimization task is described in natural language. In each optimization step, the LLM generates new solutions from the prompt that contains previously generated solutions with their values, then the new solutions are evaluated and added to the prompt for the next optimization step. We first showcase OPRO on linear regression and traveling salesman problems, then move on to prompt optimization where the goal is to find instructions that maximize the task accuracy. With a variety of LLMs, we demonstrate that the best prompts optimized by OPRO outperform human-designed prompts by up to 8\% on GSM8K, and by up to 50\% on Big-Bench Hard tasks.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computation and Language,Computer Science - Machine Learning},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\X7RJ8DMQ\\Yang et al. - 2023 - Large Language Models as Optimizers.pdf;C\:\\Users\\furuh\\Zotero\\storage\\6KK63ZY2\\2309.html}
}

@inproceedings{yangLearningColorEquivariant2024,
  title = {Learning {{Color Equivariant Representations}}},
  booktitle = {The {{Thirteenth International Conference}} on {{Learning Representations}}},
  author = {Yang, Yulong and O'Mahony, Felix and {Allen-Blanchette}, Christine},
  year = {2024},
  month = oct,
  urldate = {2025-04-26},
  abstract = {In this paper, we introduce group convolutional neural networks (GCNNs) equivariant to color variation. GCNNs have been designed for a variety of geometric transformations from 2D and 3D rotation groups, to semi-groups such as scale. Despite the improved interpretability, accuracy and generalizability of these architectures, GCNNs have seen limited application in the context of perceptual quantities. Notably, the recent CEConv network uses a GCNN to achieve equivariance to hue transformations by convolving input images with a hue rotated RGB filter. However, this approach leads to invalid RGB values which break equivariance and degrade performance. We resolve these issues with a lifting layer that transforms the input image directly, thereby circumventing the issue of invalid RGB values and improving equivariance error by over three orders of magnitude. Moreover, we extend the notion of color equivariance to include equivariance to saturation and luminance shift. Our hue-, saturation-, luminance- and color-equivariant networks achieve strong generalization to out-of-distribution perceptual variations and improved sample efficiency over conventional architectures. We demonstrate the utility of our approach on synthetic and real world datasets where we consistently outperform competitive baselines.},
  langid = {english},
  annotation = {abstractTranslation: 本稿では、色の変化に対して同変な群畳み込みニューラルネットワーク（GCNN）を紹介する。GCNNは、2Dおよび3D回転群からスケールのような半群まで、様々な幾何学的変換に対して設計されてきた。これらのアーキテクチャの解釈可能性、精度、一般化可能性が向上しているにもかかわらず、GCNNは知覚量の文脈では限られた応用しか見られていない。特筆すべきは、最近のCEConvネットワークが、色相回転されたRGBフィルタを用いて入力画像を畳み込むことで、色相変換に対する同変性を実現するためにGCNNを使用している点である。しかし、このアプローチは無効なRGB値を引き起こし、同変性を損ない、性能を低下させる。我々は、入力画像を直接変換するリフティング層を用いてこれらの問題を解決し、無効なRGB値の問題を回避し、同変性誤差を3桁以上改善する。さらに、色の同変性の概念を拡張し、彩度および輝度シフトに対する同変性を含める。我々の色相、彩度、輝度、および色同変ネットワークは、分布外の知覚的変動に対して強力な一般化を実現し、従来のアーキテクチャと比較してサンプル効率を向上させる。合成データセットおよび実世界のデータセットにおいて、我々のアプローチの有用性を実証し、競合するベースラインを一貫して上回る性能を示す。},
  file = {C:\Users\furuh\Zotero\storage\WDLVPFQS\Yang et al. - 2024 - Learning Color Equivariant Representations.pdf}
}

@article{yangLearningProximalOperator2020,
  title = {Learning {{Proximal Operator Methods}} for {{Nonconvex Sparse Recovery}} with {{Theoretical Guarantee}}},
  author = {Yang, Chengzhu and Gu, Yuantao and Chen, Badong and Ma, Hongbing and So, Hing Cheung},
  year = {2020},
  journal = {IEEE Transactions on Signal Processing},
  volume = {68},
  pages = {5244--5259},
  issn = {1053-587X, 1941-0476},
  doi = {10.1109/TSP.2020.2978615},
  urldate = {2024-07-21},
  abstract = {Sparse recovery has attracted considerable attention in signal processing community these years, because of its widespread usage in many applications. Though lots of convex and nonconvex methods have been proposed for this topic, most of them are computationally expensive. Recently, learned iterative shrinkage-thresholding algorithm (LISTA) and its variants are incorporated to sparse recovery, which are based on specific deep neural networks designed by unfolding ISTA. However, the problem they are able to solve is regularized by 1 norm, which is less effective at promoting sparseness than some nonconvex sparsity-inducing penalties (SIPs). Motivated by the fact that the problems regularized by these SIPs can be solved by proximal operator methods, we devise a network named learning proximal operator method (LePOM) for sparse recovery. For LePOM on a general class of SIPs, a necessary condition of its convergence is established. Based on this condition, a simplified network is proposed with less parameters. Theoretical analysis of this network inspires us to further reduce the number of parameters and arrive at proposing Analytical LePOM (ALePOM). ALePOM determines most parameters by solving an optimization problem and significantly reduces the number of parameters. Theoretical analysis shows if the signal is sufficiently sparse, ALePOM converges linearly. Simulations confirm our analyses and demonstrate that the proposed solutions outperform stateof-the-art sparse recovery algorithms and neural network-based methods.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {english},
  annotation = {abstractTranslation:  スパース復元は、多くのアプリケーションで広く使用されているため、近年、信号処理コミュニティで大きな注目を集めている。このトピックに対しては、多くの凸法や非凸法が提案されているが、そのほとんどは計算コストが高い。近年、学習型反復収縮閾値アルゴリズム(LISTA)とその変種がスパース回復に取り入れられており、これらはISTAを展開して設計された特定のディープニューラルネットワークに基づいている。しかしながら、これらのアルゴリズムが解くことのできる問題は1ノルムで正則化されており、非凸のスパース性誘起ペナルティ（SIPs）よりもスパース性を促進する効果が低い。これらのSIPによって正則化された問題は近接演算子法によって解くことができるという事実に動機づけられ、我々はスパース回復のための学習近接演算子法(LePOM)と名付けられたネットワークを考案する。一般的なクラスのSIPに対するLePOMについて、その収束の必要条件を確立する。この条件に基づいて、より少ないパラメータで簡略化されたネットワークが提案される。このネットワークの理論的解析により、パラメータ数をさらに減らすことが可能となり、解析的LePOM(ALePOM)の提案に到達した。ALePOMは最適化問題を解くことでほとんどのパラメータを決定し、パラメータ数を大幅に削減する。理論的解析によれば、信号が十分にスパースであれば、ALePOMは線形に収束する。シミュレーションにより、我々の解析が確認され、提案された解決策が、最新のスパース回復アルゴリズムやニューラルネットワークベースの手法を凌駕することが実証された。},
  file = {C:\Users\furuh\Zotero\storage\H254LPAL\Yang et al. - 2020 - Learning Proximal Operator Methods for Nonconvex S.pdf}
}

