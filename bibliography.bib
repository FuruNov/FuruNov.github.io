@article{sharmaScalingLawsData2022,
  title = {Scaling {{Laws}} from the {{Data Manifold Dimension}}},
  author = {Sharma, Utkarsh and Kaplan, Jared},
  year = {2022},
  journal = {Journal of Machine Learning Research},
  volume = {23},
  number = {9},
  pages = {1--34},
  issn = {1533-7928},
  urldate = {2023-03-07},
  abstract = {When data is plentiful, the test loss achieved by well-trained neural networks scales as a power-law \$L {\textbackslash}propto N{\textasciicircum}\{-{\textbackslash}alpha\}\$ in the number of network parameters \$N\$. This empirical scaling law holds for a wide variety of data modalities, and may persist over many orders of magnitude. The scaling law can be explained if neural models are effectively just performing regression on a data manifold of intrinsic dimension \$d\$.  This simple theory predicts that the scaling exponents \${\textbackslash}alpha {\textbackslash}approx 4/d\$ for cross-entropy and mean-squared error losses.  We confirm the theory by independently measuring the intrinsic dimension and the scaling exponents in a teacher/student framework, where we can study a  variety of \$d\$ and \${\textbackslash}alpha\$ by dialing the properties of  random teacher networks.  We also test the theory with CNN image classifiers on several datasets and with GPT-type language models.},
  keywords = {No DOI found}
}

@article{sheikhCorrelatedBlockSparse2025,
  title = {Correlated {{Block Sparse Channel Estimation}} and {{Phase Optimization}} in {{RIS-OTFS Systems}}},
  author = {Sheikh, Mudasir Ahmad and Budhiraja, Rohit},
  year = {2025},
  journal = {IEEE Transactions on Wireless Communications},
  pages = {1--1},
  issn = {1558-2248},
  doi = {10.1109/TWC.2025.3561851},
  urldate = {2025-05-03},
  abstract = {For a reflecting intelligent surface (RIS)-aided orthogonal time-frequency space (OTFS) system, we propose a two-dimensional off-grid sparse channel estimation model that exploits the fact that delay-Doppler (DD) locations of non-zero channel gains in a cascaded RIS-OTFS channel are sum of non-zero DD locations in the base station-RIS and RIS-user channels. Using this model, we estimate channel by considering multiple OTFS frames, which results in a block sparse DD domain channel. The multiple frames allow us to model the temporal correlation in a multi-frame OTFS system. We propose a novel correlated coupled prior to capture the DD sparsity of the channel, and estimate it by developing a sparse Bayesian framework. We maximize the achievable rate for our RIS-OTFS system by developing a gradient descent method, which has a high complexity. We also propose a low-complexity dimension-wise sinusoidal maximization (DSM)-based DD domain channel power maximization to obtain sub-optimal phase shifts. We show that the proposed channel estimation and phase optimization algorithms provide substantial gain over their existing counter-parts. We also show the robustness of an RIS-OTFS system over its non-RIS counterpart in a high-mobility scenario.},
  langid = {english},
  keywords = {Channel estimation,Channel models,Correlation,delay-Doppler (DD),Delays,Dimension-wise sinusoidal maximization (DSM),Matching pursuit algorithms,OFDM,Optimization,orthogonal time-frequency space (OTFS),Reconfigurable intelligent surfaces,Symbols,Time-frequency analysis},
  annotation = {abstractTranslation: 反射型インテリジェントサーフェス（RIS）支援直交時間周波数空間（OTFS）システムにおいて、2次元オフグリッドスパースチャネル推定モデルを提案する。このモデルは、カスケードRIS-OTFSチャネルにおける非ゼロチャネルゲインの遅延-ドップラー（DD）位置が、基地局-RISチャネルとRIS-ユーザーチャネルにおける非ゼロDD位置の和であるという事実を利用する。このモデルを用いて、複数のOTFSフレームを考慮してチャネルを推定し、ブロック状のスパースなDD領域チャネルを得る。複数のフレームを用いることで、マルチフレームOTFSシステムにおける時間相関をモデル化できる。チャネルのDDスパース性を捉えるために、相関結合事前分布を新たに提案し、スパースベイズフレームワークを開発して推定する。RIS-OTFSシステムの達成可能レートを最大化するために、勾配降下法を開発するが、計算量は大きい。そこで、準最適な位相シフトを得るために、低複雑度の次元別正弦波最大化（DSM）に基づくDD領域チャネル電力最大化を提案する。提案するチャネル推定および位相最適化アルゴリズムが、既存の手法と比較して大幅なゲインを提供することを示す。また、高移動度シナリオにおいて、RIS-OTFSシステムが非RISシステムよりもロバストであることを示す。},
  file = {C:\Users\furuh\Zotero\storage\L5YJNMUA\10976498.html}
}

