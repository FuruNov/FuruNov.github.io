@misc{wangSurveyOptimizationMethods2025,
  title = {A {{Survey}} of {{Optimization Methods}} for {{Training DL Models}}: {{Theoretical Perspective}} on {{Convergence}} and {{Generalization}}},
  shorttitle = {A {{Survey}} of {{Optimization Methods}} for {{Training DL Models}}},
  author = {Wang, Jing and Choromanska, Anna},
  year = {2025},
  month = jan,
  number = {arXiv:2501.14458},
  eprint = {2501.14458},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2501.14458},
  urldate = {2025-02-21},
  abstract = {As data sets grow in size and complexity, it is becoming more difficult to pull useful features from them using hand-crafted feature extractors. For this reason, deep learning (DL) frameworks are now widely popular. The Holy Grail of DL and one of the most mysterious challenges in all of modern ML is to develop a fundamental understanding of DL optimization and generalization. While numerous optimization techniques have been introduced in the literature to navigate the exploration of the highly non-convex DL optimization landscape, many survey papers reviewing them primarily focus on summarizing these methodologies, often overlooking the critical theoretical analyses of these methods. In this paper, we provide an extensive summary of the theoretical foundations of optimization methods in DL, including presenting various methodologies, their convergence analyses, and generalization abilities. This paper not only includes theoretical analysis of popular generic gradient-based first-order and second-order methods, but it also covers the analysis of the optimization techniques adapting to the properties of the DL loss landscape and explicitly encouraging the discovery of well-generalizing optimal points. Additionally, we extend our discussion to distributed optimization methods that facilitate parallel computations, including both centralized and decentralized approaches. We provide both convex and non-convex analysis for the optimization algorithms considered in this survey paper. Finally, this paper aims to serve as a comprehensive theoretical handbook on optimization methods for DL, offering insights and understanding to both novice and seasoned researchers in the field.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Distributed Parallel and Cluster Computing,Computer Science - Machine Learning,Mathematics - Optimization and Control}
}

@article{wangTensorDecompositionsHyperspectral2023,
  title = {Tensor {{Decompositions}} for {{Hyperspectral Data Processing}} in {{Remote Sensing}}: {{A}} Comprehensive Review},
  shorttitle = {Tensor {{Decompositions}} for {{Hyperspectral Data Processing}} in {{Remote Sensing}}},
  author = {Wang, Minghua and Hong, Danfeng and Han, Zhu and Li, Jiaxin and Yao, Jing and Gao, Lianru and Zhang, Bing and Chanussot, Jocelyn},
  year = {2023},
  month = mar,
  journal = {IEEE Geoscience and Remote Sensing Magazine},
  volume = {11},
  number = {1},
  pages = {26--72},
  issn = {2168-6831, 2473-2397, 2373-7468},
  doi = {10.1109/MGRS.2022.3227063},
  urldate = {2023-12-03},
  abstract = {Owing to the rapid development of sensor technology, hyperspectral (HS) remote sensing (RS) imaging has provided a significant amount of spatial and spectral information for the observation and analysis of Earth's surface at a distance of data acquisition devices. The recent advancement and even revolution of HS RS techniques offer opportunities to realize the potential of various applications while confronting new challenges for efficiently processing and analyzing the enormous HS acquisition data. Due to the maintenance of the 3D HS inherent structure, tensor decomposition has aroused widespread concern and spurred research in HS data processing tasks over the past decades. In this article, we aim to present a comprehensive overview of tensor decomposition, specifically contextualizing the five broad topics in HS data processing: HS restoration, compressive sensing (CS), anomaly detection (AD), HS--multispectral (MS) fusion, and spectral unmixing (SU). For each topic, we elaborate on the remarkable achievements of tensor decomposition models for HS RS, with a pivotal description of the existing methodologies and a representative exhibition of experimental results. As a result, the remaining challenges of the follow-up research directions are outlined and discussed from the perspective of actual HS RS practices and tensor decomposition merged with advanced priors and even deep neural networks. This article summarizes different tensor decomposition-based HS data processing methods and categorizes them into different classes, from simple adoptions to complex combinations with other priors for algorithm beginners. We expect that this survey provides new investigations and development trends for experienced researchers to some extent.},
  langid = {american},
  annotation = {abstractTranslation: センサー技術の急速な発展に伴い、ハイパースペクトル（HS）リモートセンシング（RS）イメージングは、データ取得デバイスから離れた場所での地球表面の観測および分析のために、膨大な量の空間およびスペクトル情報を提供するようになった。近年のHS RS技術の進歩、さらには革命的な発展は、様々なアプリケーションの可能性を実現する機会を提供する一方で、膨大なHS取得データを効率的に処理および分析するための新たな課題にも直面している。3D HS固有の構造を維持できることから、テンソル分解は過去数十年にわたり、HSデータ処理タスクにおいて広範な関心を集め、研究を促進してきた。本稿では、テンソル分解の包括的な概要を示すことを目的とし、特にHSデータ処理における5つの広範なトピック、すなわちHS復元、圧縮センシング（CS）、異常検知（AD）、HS-マルチスペクトル（MS）融合、およびスペクトル分解（SU）について文脈化する。各トピックについて、HS RSに対するテンソル分解モデルの注目すべき成果を詳細に説明し、既存の方法論の重要な記述と実験結果の代表的な例を示す。その結果、フォローアップ研究の方向性における残された課題について、実際のHS RSの実践と、高度な事前知識、さらには深層ニューラルネットワークと融合されたテンソル分解の観点から概説し、議論する。本稿では、様々なテンソル分解ベースのHSデータ処理法をまとめ、アルゴリズムの初心者向けに、単純な適用から他の事前知識との複雑な組み合わせまで、異なるクラスに分類する。この調査が、経験豊富な研究者にとって、新たな調査や開発動向をある程度提供することを期待する。},
  file = {C:\Users\furuh\Zotero\storage\T62NCJIT\Wang et al. - 2023 - Tensor Decompositions for Hyperspectral Data Proce.pdf}
}

@misc{wangTensorNetworksMeet2023,
  title = {Tensor {{Networks Meet Neural Networks}}: {{A Survey}} and {{Future Perspectives}}},
  shorttitle = {Tensor {{Networks Meet Neural Networks}}},
  author = {Wang, Maolin and Pan, Yu and Xu, Zenglin and Yang, Xiangli and Li, Guangxi and Cichocki, Andrzej},
  year = {2023},
  month = may,
  number = {arXiv:2302.09019},
  eprint = {2302.09019},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2302.09019},
  urldate = {2025-01-18},
  abstract = {Tensor networks (TNs) and neural networks (NNs) are two fundamental data modeling approaches. TNs were introduced to solve the curse of dimensionality in large-scale tensors by converting an exponential number of dimensions to polynomial complexity. As a result, they have attracted significant attention in the fields of quantum physics and machine learning. Meanwhile, NNs have displayed exceptional performance in various applications, e.g., computer vision, natural language processing, and robotics research. Interestingly, although these two types of networks originate from different observations, they are inherently linked through the common multilinearity structure underlying both TNs and NNs, thereby motivating a significant number of intellectual developments regarding combinations of TNs and NNs. In this paper, we refer to these combinations as tensorial neural networks (TNNs), and present an introduction to TNNs in three primary aspects: network compression, information fusion, and quantum circuit simulation. Furthermore, this survey also explores methods for improving TNNs, examines flexible toolboxes for implementing TNNs, and documents TNN development while highlighting potential future directions. To the best of our knowledge, this is the first comprehensive survey that bridges the connections among NNs, TNs, and quantum circuits. We provide a curated list of TNNs at {\textbackslash}url\{https://github.com/tnbar/awesome-tensorial-neural-networks\}.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Machine Learning},
  annotation = {abstractTranslation: テンソルネットワーク (TN) とニューラルネットワーク (NN) は、2 つの基本的なデータモデリング手法です。TN は、大規模テンソルにおける次元の呪いを解決するために導入され、指数関数的な次元数を多項式複雑性に変換しました。その結果、量子物理学と機械学習の分野で大きな注目を集めています。一方、NN は、コンピュータビジョン、自然言語処理、ロボット工学研究など、さまざまなアプリケーションで卓越した性能を示しています。興味深いことに、これら 2 種類のネットワークは異なる観点から生まれたにもかかわらず、TN と NN の両方の根底にある共通の多重線形性構造を通じて本質的に関連しており、TN と NN の組み合わせに関する多くの知的発展を促しています。本稿では、これらの組み合わせをテンソルニューラルネットワーク (TNN) と呼び、ネットワーク圧縮、情報融合、量子回路シミュレーションという 3 つの主要な側面から TNN を紹介します。さらに、本調査では、TNN を改善するための方法を検討し、TNN を実装するための柔軟なツールボックスを検証し、TNN の開発を記録するとともに、将来の潜在的な方向性を強調します。我々の知る限り、これは NN、TN、および量子回路間のつながりを橋渡しする最初の包括的な調査です。TNN の厳選されたリストを {\textbackslash}url\{https://github.com/tnbar/awesome-tensorial-neural-networks\} に提供します。},
  file = {C:\Users\furuh\Zotero\storage\5BDKVWLJ\Wang et al. - 2023 - Tensor Networks Meet Neural Networks A Survey and.pdf}
}

@misc{wangTensorNetworksMeet2025,
  title = {Tensor {{Networks Meet Neural Networks}}: {{A Survey}} and {{Future Perspectives}}},
  shorttitle = {Tensor {{Networks Meet Neural Networks}}},
  author = {Wang, Maolin and Pan, Yu and Xu, Zenglin and Li, Guangxi and Yang, Xiangli and Mandic, Danilo and Cichocki, Andrzej},
  year = {2025},
  month = mar,
  number = {arXiv:2302.09019},
  eprint = {2302.09019},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2302.09019},
  urldate = {2025-06-08},
  abstract = {Tensor networks (TNs) and neural networks (NNs) are two fundamental data modeling approaches. TNs were introduced to solve the curse of dimensionality in large-scale tensors by converting an exponential number of dimensions to polynomial complexity. As a result, they have attracted significant attention in the fields of quantum physics and machine learning. Meanwhile, NNs have displayed exceptional performance in various applications, e.g., computer vision, natural language processing, and robotics research. Interestingly, although these two types of networks originate from different observations, they are inherently linked through the typical multilinearity structure underlying both TNs and NNs, thereby motivating a significant number of developments regarding combinations of TNs and NNs. In this paper, we refer to these combinations as tensorial neural networks{\textasciitilde}(TNNs) and present an introduction to TNNs from both data processing and model architecture perspectives. From the data perspective, we explore the capabilities of TNNs in multi-source fusion, multimodal pooling, data compression, multi-task training, and quantum data processing. From the model perspective, we examine TNNs' integration with various architectures, including Convolutional Neural Networks, Recurrent Neural Networks, Graph Neural Networks, Transformers, Large Language Models, and Quantum Neural Networks. Furthermore, this survey also explores methods for improving TNNs, examines flexible toolboxes for implementing TNNs, and documents TNN development while highlighting potential future directions. To the best of our knowledge, this is the first comprehensive survey that bridges the connections among NNs and TNs. We provide a curated list of TNNs at https://github.com/tnbar/awesome-tensorial-neural-networks.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Machine Learning},
  annotation = {abstractTranslation: テンソルネットワーク（TNs）とニューラルネットワーク（NNs）は、2つの基本的なデータモデリング手法である。TNsは、大規模テンソルにおける次元の呪いを解決するために導入され、指数関数的な数の次元を多項式的な複雑さに変換する。その結果、量子物理学および機械学習の分野で大きな注目を集めている。一方、NNsは、コンピュータビジョン、自然言語処理、ロボティクス研究など、さまざまなアプリケーションにおいて優れた性能を発揮している。興味深いことに、これら2種類のネットワークは異なる観点から生まれたものであるが、TNsとNNsの両方の根底にある典型的な多重線形性構造を通じて本質的に関連しており、それによってTNsとNNsの組み合わせに関する多くの発展が促されている。本稿では、これらの組み合わせをテンソリアルニューラルネットワーク（TNNs）と呼び、データ処理とモデルアーキテクチャの両方の観点からTNNsを紹介する。データの観点からは、マルチソースフュージョン、マルチモーダルプーリング、データ圧縮、マルチタスク学習、および量子データ処理におけるTNNsの能力を探求する。モデルの観点からは、畳み込みニューラルネットワーク、再帰型ニューラルネットワーク、グラフニューラルネットワーク、Transformer、大規模言語モデル、および量子ニューラルネットワークを含む、さまざまなアーキテクチャとのTNNsの統合を検証する。さらに、本調査では、TNNsの改善手法を調査し、TNNsの実装のための柔軟なツールボックスを検証し、TNNの開発を記録し、将来の潜在的な方向性を強調する。我々の知る限り、これはNNsとTNsの間のつながりを橋渡しする最初の包括的な調査である。厳選されたTNNのリストをhttps://github.com/tnbar/awesome-tensorial-neural-networksで提供する。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\E24SE48A\\Wang et al. - 2025 - Tensor Networks Meet Neural Networks A Survey and Future Perspectives.pdf;C\:\\Users\\furuh\\Zotero\\storage\\ZF72XA8E\\2302.html}
}

@misc{wangTheoreticalAnalysisInductive2023,
  title = {Theoretical {{Analysis}} of {{Inductive Biases}} in {{Deep Convolutional Networks}}},
  author = {Wang, Zihao and Wu, Lei},
  year = {2023},
  month = may,
  number = {arXiv:2305.08404},
  eprint = {2305.08404},
  primaryclass = {cs, stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2305.08404},
  urldate = {2023-09-11},
  abstract = {In this paper, we study the inductive biases in convolutional neural networks (CNNs), which are believed to be vital drivers behind CNNs' exceptional performance on vision-like tasks. We first analyze the universality of CNNs, i.e., the ability to approximate continuous functions. We prove that a depth of \${\textbackslash}mathcal\{O\}({\textbackslash}log d)\$ is sufficient for achieving universality, where \$d\$ is the input dimension. This is a significant improvement over existing results that required a depth of \${\textbackslash}Omega(d)\$. We also prove that learning sparse functions with CNNs needs only \${\textbackslash}tilde\{{\textbackslash}mathcal\{O\}\}({\textbackslash}log{\textasciicircum}2d)\$ samples, indicating that deep CNNs can efficiently capture long-range sparse correlations. Note that all these are achieved through a novel combination of increased network depth and the utilization of multichanneling and downsampling. Lastly, we study the inductive biases of weight sharing and locality through the lens of symmetry. To separate two biases, we introduce locally-connected networks (LCNs), which can be viewed as CNNs without weight sharing. Specifically, we compare the performance of CNNs, LCNs, and fully-connected networks (FCNs) on a simple regression task. We prove that LCNs require \$\{{\textbackslash}Omega\}(d)\$ samples while CNNs need only \${\textbackslash}tilde\{{\textbackslash}mathcal\{O\}\}({\textbackslash}log{\textasciicircum}2d)\$ samples, which highlights the cruciality of weight sharing. We also prove that FCNs require \${\textbackslash}Omega(d{\textasciicircum}2)\$ samples while LCNs need only \${\textbackslash}tilde\{{\textbackslash}mathcal\{O\}\}(d)\$ samples, demonstrating the importance of locality. These provable separations quantify the difference between the two biases, and our major observation behind is that weight sharing and locality break different symmetries in the learning process.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning,Statistics - Machine Learning},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\IBHWBYBN\\Wang and Wu - 2023 - Theoretical Analysis of Inductive Biases in Deep C.pdf;C\:\\Users\\furuh\\Zotero\\storage\\J92Q39FV\\2305.html}
}

@misc{wangTHyperGNNsHypergraphNeural2023,
  title = {T-{{HyperGNNs}}: {{Hypergraph Neural Networks Via Tensor Representations}}},
  shorttitle = {T-{{HyperGNNs}}},
  author = {Wang, Fuli and {Pena-Pena}, Karelia and Qia, Wei and Arce, Gonzalo},
  year = {2023},
  month = feb,
  doi = {10.36227/techrxiv.21984797.v1},
  urldate = {2024-08-16},
  abstract = {Hypergraph neural networks (HyperGNNs) are a family of deep neural networks designed to perform inference on hypergraphs. HyperGNNs follow either a spectral or a spatial approach, in which a convolution or message-passing operation is conducted based on a hypergraph algebraic descriptor. While many HyperGNNs have been proposed and achieved state-of- the-art performance on broad applications, there have been limited attempts at exploring high dimensional hypergraph descriptors (tensors) and joint node interactions carried by hyperedges. In this paper, we depart from hypergraph matrix representations and present a new tensor-HyperGNN framework (T-HyperGNN) with cross-node interactions. The T-HyperGNN framework consists of T-spectral convolution, T-spatial convo- lution, and T-message-passing HyperGNNs (T-MPHN). The T- spectral convolution HyperGNN is defined under the t-product algebra that closely connects to the spectral space. To im- prove computational efficiency for large hypergraphs, we localize the T-spectral convolution approach to formulate the T-spatial convolution and further devise a novel tensor message-passing algorithm for practical implementation by studying a compressed adjacency tensor representation. Compared to the state-of-the- art approaches, our T-HyperGNNs preserve intrinsic high-order network structures without any hypergraph reduction and model the joint effects of nodes through a cross-node interaction layer. These advantages of our T-HyperGNNs are demonstrated in a wide range of real-world hypergraph datasets.},
  copyright = {https://creativecommons.org/licenses/by/4.0/},
  langid = {english},
  annotation = {abstractTranslation:  ハイパーグラフ・ニューラル・ネットワーク（HyperGNN）は、ハイパーグラフ上で推論を行うように設計されたディープ・ニューラル・ネットワークの一群である。HyperGNNは、ハイパーグラフ代数記述子に基づいて畳み込みまたはメッセージパッシング演算を行う、スペクトルまたは空間的アプローチのいずれかに従う。多くのHyperGNNが提案され、広範なアプリケーションで最先端の性能を達成している一方で、ハイパーグラフによって運ばれる高次元のハイパーグラフ記述子（テンソル）と結合ノード相互作用を探索する試みは限られている。本稿では、ハイパーグラフ行列表現から出発し、クロスノード相互作用を持つ新しいテンソル-ハイパーGNNフレームワーク(T-HyperGNN)を提案する。T-HyperGNNフレームワークはT-スペクトル畳み込み、T-空間畳み込み、T-メッセージパッシングHyperGNN（T-MPHN）から構成される。T-スペクトル畳み込みHyperGNNは、スペクトル空間と密接に接続するt-積代数の下で定義される。大規模なハイパーグラフの計算効率を向上させるために、T-スペクトル畳み込みのアプローチをT-空間畳み込みの定式化に局在化し、さらに圧縮された隣接テンソル表現を研究することにより、実用的な実装のための新しいテンソルメッセージパッシングアルゴリズムを考案する。最先端のアプローチと比較して、我々のT-HyperGNNは、ハイパーグラフを縮小することなく本質的な高次ネットワーク構造を保持し、ノード間の相互作用層を通してノードの共同効果をモデル化する。我々のT-HyperGNNのこれらの利点は、広範な実世界のハイパーグラフデータセットで実証されている。},
  file = {C:\Users\furuh\Zotero\storage\AG727FJ5\Wang et al. - 2023 - T-HyperGNNs Hypergraph Neural Networks Via Tensor.pdf}
}

@article{wangTimeSeriesComplex2016,
  title = {From Time Series to Complex Networks: {{The}} Phase Space Coarse Graining},
  shorttitle = {From Time Series to Complex Networks},
  author = {Wang, Minggang and Tian, Lixin},
  year = {2016},
  month = nov,
  journal = {Physica A: Statistical Mechanics and its Applications},
  volume = {461},
  pages = {456--468},
  issn = {0378-4371},
  doi = {10.1016/j.physa.2016.06.028},
  urldate = {2024-07-17},
  abstract = {In this paper, we present a simple and fast computational method, the phase space coarse graining algorithm that converts a time series into a directed and weighted complex network. The constructed directed and weighted complex network inherits several properties of the series in its structure. Thereby, periodic series convert into regular networks, and random series do so into random networks. Moreover, chaotic series convert into scale-free networks. It is shown that the phase space coarse graining algorithm allows us to distinguish, identify and describe in detail various time series. Finally, we apply the phase space coarse graining algorithm to the practical observations series, international gasoline regular spot price series and identify its dynamic characteristics.},
  keywords = {Coarse graining,Complex network,Gasoline spot price,Phase space,Time series,Topological structure},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\X8A8RZZ7\\wang2016.pdf.pdf;C\:\\Users\\furuh\\Zotero\\storage\\9VBAIMWP\\S0378437116302965.html}
}

@article{wangTotalVariationGroup2019,
  title = {A Total Variation and Group Sparsity Based Tensor Optimization Model for Video Rain Streak Removal},
  author = {Wang, Ye-Tao and Zhao, Xi-Le and Jiang, Tai-Xiang and Deng, Liang-Jian and Ma, Tian-Hui and Zhang, Yue-Tian and Huang, Ting-Zhu},
  year = {2019},
  month = apr,
  journal = {Signal Processing: Image Communication},
  series = {Tensor {{Image Processing}}},
  volume = {73},
  pages = {96--108},
  issn = {0923-5965},
  doi = {10.1016/j.image.2018.11.008},
  urldate = {2025-06-08},
  abstract = {Rain streak removal is an important issue of the outdoor vision system and has been investigated extensively. In this paper, we propose a novel tensor optimization model for video rain streak removal by fully considering the discriminatively intrinsic characteristics of the rain streaks and the clean video. In specific, the rain streaks are group sparse and smooth along the rain streaks direction; the clean video is smooth along the perpendicular direction of the rain streaks and the temporal direction. For the rain streaks, we use {$\ell$}2,1 norm to characterize the group sparsity and the unidirectional total variation (UTV) to promote the smoothness along the rain streaks direction. For the clean video, we use two UTV regularizers to enhance the smoothness along the perpendicular direction of the rain streaks and the temporal direction. To solve the proposed model we develop an efficient alternating direction method of multipliers (ADMM) algorithm. Experiments on synthetic and real data demonstrate the superiority of the proposed method over state-of-the-art methods both quantitatively and qualitatively.},
  langid = {english},
  keywords = {Alternating direction method of multipliers (ADMM),Group sparsity,Tensor optimization model,Unidirectional total variation (UTV),Video rain streak removal},
