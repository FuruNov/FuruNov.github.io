@misc{jawanpuriaConvexFeatureLearning2012,
  title = {A {{Convex Feature Learning Formulation}} for {{Latent Task Structure Discovery}}},
  author = {Jawanpuria, Pratik and Nath, J. Saketha},
  year = {2012},
  month = jun,
  number = {arXiv:1206.4611},
  eprint = {1206.4611},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1206.4611},
  urldate = {2024-12-11},
  abstract = {This paper considers the multi-task learning problem and in the setting where some relevant features could be shared across few related tasks. Most of the existing methods assume the extent to which the given tasks are related or share a common feature space to be known apriori. In real-world applications however, it is desirable to automatically discover the groups of related tasks that share a feature space. In this paper we aim at searching the exponentially large space of all possible groups of tasks that may share a feature space. The main contribution is a convex formulation that employs a graph-based regularizer and simultaneously discovers few groups of related tasks, having close-by task parameters, as well as the feature space shared within each group. The regularizer encodes an important structure among the groups of tasks leading to an efficient algorithm for solving it: if there is no feature space under which a group of tasks has close-by task parameters, then there does not exist such a feature space for any of its supersets. An efficient active set algorithm that exploits this simplification and performs a clever search in the exponentially large space is presented. The algorithm is guaranteed to solve the proposed formulation (within some precision) in a time polynomial in the number of groups of related tasks discovered. Empirical results on benchmark datasets show that the proposed formulation achieves good generalization and outperforms state-of-the-art multi-task learning algorithms in some cases.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning,Statistics - Machine Learning},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\F8G9TJSL\\Jawanpuria と Nath - 2012 - A Convex Feature Learning Formulation for Latent Task Structure Discovery.pdf;C\:\\Users\\furuh\\Zotero\\storage\\JG9IPIHG\\1206.html}
}

@article{jayakumarTopKASTTopKAlways2021,
  title = {Top-{{KAST}}: {{Top-K Always Sparse Training}}},
  shorttitle = {Top-{{KAST}}},
  author = {Jayakumar, Siddhant M. and Pascanu, Razvan and Rae, Jack W. and Osindero, Simon and Elsen, Erich},
  year = {2021},
  month = jun,
  journal = {ArXiv},
  urldate = {2024-10-13},
  abstract = {Sparse neural networks are becoming increasingly important as the field seeks to improve the performance of existing models by scaling them up, while simultaneously trying to reduce power consumption and computational footprint. Unfortunately, most existing methods for inducing performant sparse models still entail the instantiation of dense parameters, or dense gradients in the backward-pass, during training. For very large models this requirement can be prohibitive. In this work we propose Top-KAST, a method that preserves constant sparsity throughout training (in both the forward and backward-passes). We demonstrate the efficacy of our approach by showing that it performs comparably to or better than previous works when training models on the established ImageNet benchmark, whilst fully maintaining sparsity. In addition to our ImageNet results, we also demonstrate our approach in the domain of language modeling where the current best performing architectures tend to have tens of billions of parameters and scaling up does not yet seem to have saturated performance. Sparse versions of these architectures can be run with significantly fewer resources, making them more widely accessible and applicable. Furthermore, in addition to being effective, our approach is straightforward and can easily be implemented in a wide range of existing machine learning frameworks with only a few additional lines of code. We therefore hope that our contribution will help enable the broader community to explore the potential held by massive models, without incurring massive computational cost.},
  langid = {american},
  keywords = {No DOI found},
  annotation = {abstractTranslation: スパースニューラルネットワークは、既存のモデルをスケールアップして性能を向上させると同時に、消費電力と計算フットプリントを削減しようとする分野で、ますます重要になってきている。残念なことに、性能の高いスパースモデルを誘導するための既存の手法のほとんどは、学習中に密なパラメータ、またはバックワードパスにおける密な勾配をインスタンス化する必要があります。非常に大規模なモデルの場合、この要求は法外なものになる可能性がある。本研究では、学習中（フォワードパスとバックワードパスの両方において）一定のスパース性を保つ手法であるTop-KASTを提案する。我々は、スパース性を完全に維持しながら、確立されたImageNetベンチマークでモデルを学習する際に、先行研究と同等以上の性能を示すことで、本アプローチの有効性を実証する。ImageNetの結果に加え、言語モデリングの分野でも我々のアプローチを実証する。この分野では、現在最も性能の良いアーキテクチャは数百億のパラメータを持つ傾向にあり、スケールアップしても性能は飽和しないようである。これらのアーキテクチャのスパースバージョンは、大幅に少ないリソースで実行することができ、より広くアクセス可能で適用可能である。さらに、効果的であることに加え、我々のアプローチは単純であり、数行のコードを追加するだけで、広範な既存の機械学習フレームワークに容易に実装することができる。したがって、我々の貢献が、大規模な計算コストをかけることなく、大規模なモデルが持つ可能性を、より広範なコミュニティが探求できるようにする一助となることを期待している。},
  file = {C:\Users\furuh\Zotero\storage\PQVJTY3V\Jayakumar et al. - 2021 - Top-KAST Top-K Always Sparse Training.pdf}
}

@article{jayasumanaKernelMethodsRiemannian2015,
  title = {Kernel {{Methods}} on {{Riemannian Manifolds}} with {{Gaussian RBF Kernels}}},
  author = {Jayasumana, Sadeep and Hartley, Richard and Salzmann, Mathieu and Li, Hongdong and Harandi, Mehrtash},
  year = {2015},
  month = feb,
  journal = {IEEE Transactions on Pattern Analysis and Machine Intelligence},
  volume = {37},
  number = {12},
  pages = {2464--2477},
  issn = {1939-3539},
  doi = {10.1109/TPAMI.2015.2414422},
  urldate = {2024-08-22},
  abstract = {In this paper, we develop an approach to exploiting kernel methods with manifold-valued data. In many computer vision problems, the data can be naturally represented as points on a Riemannian manifold. Due to the non-Euclidean geometry of Riemannian manifolds, usual Euclidean computer vision and machine learning algorithms yield inferior results on such data. In this paper, we define Gaussian radial basis function (RBF)-based positive definite kernels on manifolds that permit us to embed a given manifold with a corresponding metric in a high dimensional reproducing kernel Hilbert space. These kernels make it possible to utilize algorithms developed for linear spaces on nonlinear manifold-valued data. Since the Gaussian RBF defined with any given metric is not always positive definite, we present a unified framework for analyzing the positive definiteness of the Gaussian RBF on a generic metric space. We then use the proposed framework to identify positive definite kernels on two specific manifolds commonly encountered in computer vision: the Riemannian manifold of symmetric positive definite matrices and the Grassmann manifold, i.e., the Riemannian manifold of linear subspaces of a Euclidean space. We show that many popular algorithms designed for Euclidean spaces, such as support vector machines, discriminant analysis and principal component analysis can be generalized to Riemannian manifolds with the help of such positive definite Gaussian kernels.},
  keywords = {Computer vision,Gaussian RBF kernels,Grassmann manifolds,Hilbert space,Kernel,kernel methods,Kernel methods,Manifolds,positive definite kernels,Positive definite kernels,Riemannian manifolds,Symmetric matrices,symmetric positive definite matrices,Symmetric positive definite matrices},
  annotation = {abstractTranslation:  本稿では、多様体値を持つデータでカーネル法を利用するアプローチを開発する。多くのコンピュータビジョン問題において、データはリーマン多様体上の点として自然に表現できる。リーマン多様体は非ユークリッド幾何学的であるため、通常のユークリッドコンピュータビジョンや機械学習アルゴリズムは、このようなデータに対して劣った結果をもたらす。本論文では、ガウス放射状基底関数（RBF）に基づく多様体上の正定値カーネルを定義し、高次元の再現カーネル・ヒルベルト空間に、対応するメトリックを持つ多様体を埋め込むことを可能にする。これらのカーネルは、非線形多様体値のデータに対して線形空間で開発されたアルゴリズムを利用することを可能にする。任意の計量で定義されたガウスRBFは必ずしも正定値ではないので、我々は、一般的な計量空間上のガウスRBFの正定値を解析するための統一的な枠組みを提示する。次に、提案したフレームワークを用いて、コンピュータビジョンでよく遭遇する2つの特定の多様体、すなわち対称正定値行列のリーマン多様体とグラスマン多様体、すなわちユークリッド空間の線形部分空間のリーマン多様体上の正定値カーネルを同定する。サポートベクターマシン、判別分析、主成分分析など、ユークリッド空間用に設計された多くの一般的なアルゴリズムが、このような正定値ガウスカーネルの助けを借りて、リーマン多様体に一般化できることを示す。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\6H5VIZ9T\\Jayasumana et al. - 2015 - Kernel Methods on Riemannian Manifolds with Gaussi.pdf;C\:\\Users\\furuh\\Zotero\\storage\\XVBWWHTG\\7063231.html}
}

@article{jeanneretDiffusionModelsCounterfactual2024,
