@article{matsumotoDisorganizationSemanticBrain2022,
  title = {Disorganization of {{Semantic Brain Networks}} in {{Schizophrenia Revealed}} by {{fMRI}}},
  author = {Matsumoto, Yukiko and Nishida, Satoshi and Hayashi, Ryusuke and Son, Shuraku and Murakami, Akio and Yoshikawa, Naganobu and Ito, Hiroyoshi and Oishi, Naoya and Masuda, Naoki and Murai, Toshiya and Friston, Karl and Nishimoto, Shinji and Takahashi, Hidehiko},
