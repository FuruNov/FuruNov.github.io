@inproceedings{idaFastBlockCoordinate2023,
  title = {Fast {{Block Coordinate Descent}} for {{Non-Convex Group Regularizations}}},
  booktitle = {Proceedings of {{The}} 26th {{International Conference}} on {{Artificial Intelligence}} and {{Statistics}}},
  author = {Ida, Yasutoshi and Kanai, Sekitoshi and Kumagai, Atsutoshi},
  year = {2023},
  month = apr,
  pages = {2481--2493},
  publisher = {PMLR},
  issn = {2640-3498},
  urldate = {2025-05-31},
  abstract = {Non-convex sparse regularizations with group structures are useful tools for selecting important feature groups. For optimization with these regularizations, block coordinate descent (BCD) is a standard solver that iteratively updates each parameter group. However, it suffers from high computation costs for a large number of parameter groups. The state-of-the-art method prunes unnecessary updates in BCD by utilizing bounds on the norms of the parameter groups. Unfortunately, since it computes the bound for each iteration, the computation cost still tends to be high when the updates are not sufficiently pruned. This paper proposes a fast BCD for non-convex group regularizations. Specifically, it selects a small subset of the parameter groups from all the parameter groups on the basis of the bounds and performs BCD on the subset. The subset grows step by step in accordance with the bounds during optimization. Since it computes the bounds only when selecting and growing the subsets, the total cost for computing the bounds is smaller than in the previous method. In addition, we theoretically guarantee the convergence of our method. Experiments show that our method is up to four times faster than the state-of-the-art method and 68 times faster than the original BCD without any loss of accuracy.   グループ構造を持つ非凸スパース正則化は、重要な特徴グループを選択するための便利なツールです。これらの正則化による最適化のために、ブロック座標降下法 (BCD) は、各パラメーター グループを反復的に更新する標準ソルバーです。ただし、多数のパラメータグループに対して高い計算コストが発生します。最先端の手法では、パラメーター グループのノルムの境界を利用して、BCD の不要な更新を排除します。残念ながら、各イテレーションの境界を計算するため、更新が十分にプルーニングされていない場合、計算コストは依然として高くなる傾向があります。この論文では、非凸群正則化のための高速 BCD を提案します。具体的には、境界に基づいてすべてのパラメーター・グループからパラメーター・グループの小さなサブセットを選択し、サブセットに対して BCD を実行します。サブセットは、最適化中に境界に従って段階的に成長します。サブセットを選択して拡張するときにのみ境界を計算するため、境界の計算にかかる合計コストは前の方法よりも小さくなります。さらに、理論的には、私たちの方法の収束を保証します。実験によると、私たちの方法は、精度を損なうことなく、最先端の方法よりも最大4倍、元のBCDよりも68倍高速です。},
  langid = {english},
  annotation = {abstractTranslation: グループ構造を持つ非凸スパース正則化は、重要な特徴グループを選択するための有用なツールです。これらの正則化による最適化のために、ブロック座標降下法 (BCD) は、各パラメータグループを反復的に更新する標準的なソルバーです。ただし、多数のパラメータグループに対して高い計算コストが発生します。最先端の手法では、パラメータグループのノルムの境界を利用して、BCD の不要な更新を排除します。残念ながら、各イテレーションで境界を計算するため、更新が十分にプルーニングされていない場合、計算コストは依然として高くなる傾向があります。この論文では、非凸群正則化のための高速 BCD を提案します。具体的には、境界に基づいてすべてのパラメータグループからパラメータグループの小さなサブセットを選択し、サブセットに対して BCD を実行します。サブセットは、最適化中に境界に従って段階的に成長します。サブセットを選択して拡張するときにのみ境界を計算するため、境界の計算にかかる合計コストは前の方法よりも小さくなります。さらに、理論的には、私たちの方法の収束を保証します。実験によると、私たちの方法は、精度を損なうことなく、最先端の方法よりも最大4倍、元のBCDよりも68倍高速です。},
  file = {C:\Users\furuh\Zotero\storage\P8CYLXQZ\Ida et al. - 2023 - Fast Block Coordinate Descent for Non-Convex Group Regularizations.pdf}
}

