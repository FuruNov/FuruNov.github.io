  title = {A {{Selective Overview}} of {{Sparse Principal Component Analysis}}},
  author = {Zou, Hui and Xue, Lingzhou},
  year = {2018},
  month = aug,
  journal = {Proceedings of the IEEE},
  volume = {106},
  number = {8},
  pages = {1311--1320},
  issn = {1558-2256},
  doi = {10.1109/JPROC.2018.2846588},
  urldate = {2024-12-31},
  abstract = {Principal component analysis (PCA) is a widely used technique for dimension reduction, data processing, and feature extraction. The three tasks are particularly useful and important in high-dimensional data analysis and statistical learning. However, the regular PCA encounters great fundamental challenges under high dimensionality and may produce ``wrong'' results. As a remedy, sparse PCA (SPCA) has been proposed and studied. SPCA is shown to offer a ``right'' solution under high dimensions. In this paper, we review methodological and theoretical developments of SPCA, as well as its applications in scientific studies.},
  langid = {english},
  keywords = {Covariance matrices,Data analysis,Dimensionality reduction,mathematical programming,Principal component analysis,principal component analysis (PCA),Sparse matrices,Statistical analysis,statistical learning,Statistical learning},
  annotation = {abstractTranslation: 主成分分析 (PCA) は、次元削減、データ処理、および特徴抽出に広く使用されている手法です。 3 つのタスクは、高次元のデータ分析と統計学習において特に便利で重要です。ただし、通常の PCA は高次元の下で大きな基本的な課題に直面し、「間違った」結果が生じる可能性があります。この解決策として、スパース PCA (SPCA) が提案され、研究されています。 SPCA は、高次元で「適切な」ソリューションを提供することが示されています。この論文では、SPCA の方法論的および理論的発展と、科学研究における SPCA の応用について概説します。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\VM4TG7WM\\Zou と Xue - 2018 - A Selective Overview of Sparse Principal Component Analysis.pdf;C\:\\Users\\furuh\\Zotero\\storage\\CCG88F84\\8412518.html}
}

