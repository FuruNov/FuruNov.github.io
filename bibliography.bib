@article{hurProposalMillimeterWaveChannel2016,
  title = {Proposal on {{Millimeter-Wave Channel Modeling}} for {{5G Cellular System}}},
  author = {Hur, Sooyoung and Baek, Sangkyu and Kim, Byungchul and Chang, Youngbin and Molisch, Andreas F. and Rappaport, Theodore S. and Haneda, Katsuyuki and Park, Jeongho},
  year = {2016},
