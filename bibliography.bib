  issn = {1932-4553, 1941-0484},
  doi = {10.1109/JSTSP.2016.2527364},
  urldate = {2023-07-31},
  abstract = {This paper presents 28 GHz wideband propagation channel characteristics for millimeter wave (mmWave) urban cellular communication systems. The mmWave spectrum is considered as a key-enabling feature of 5G cellular communication systems to provide an enormous capacity increment; however, mmWave channel models are lacking today. The paper compares measurements conducted with a spherical scanning 28 GHz channel sounder system in the urban street-canyon environments of Daejeon, Korea and NYU campus, Manhattan, with ray-tracing simulations made for the same areas. Since such scanning measurements are very costly and time-intensive, only a relatively small number of channel samples can be obtained. The measurements are thus used to quantify the accuracy of a ray-tracer; the ray-tracer is subsequently used to obtain a large number of channel samples to fill gaps in the measurements. A set of mmWave radio propagation parameters is presented based on both the measurement results and ray-tracing, and the corresponding channel models following the 3GPP spatial channel model (SCM) methodology are also described.}
}

@article{huTensorNuclearNorm2025,
  title = {Tensor {{Nuclear Norm}} Based {{Multi-channel Atomic Representation}} for {{Robust Face Recognition}}},
  author = {Hu, Yutao and Wang, Yulong and Wang, Libin and Li, Han and Chen, Hong and Tang, Yuan Yan},
  year = {2025},
  journal = {IEEE Transactions on Image Processing},
  pages = {1--1},
  issn = {1941-0042},
  doi = {10.1109/TIP.2025.3539472},
  urldate = {2025-02-24},
  abstract = {Numerous representation-based classification (RC) methods have been developed for face recognition due to their decent model interpretability and robustness against noise. Most existing RC methods primarily characterize the gray-scale reconstruction error image (single-channel data) in two ways: the one-dimensional (1-D) pixel-based error model and the two-dimensional (2-D) gray-scale image-matrix-based error model. The former measures the reconstruction error pixel by pixel, while the latter leverages 2-D structural information of the gray-scale error image, such as the low-rank property. However, when applying these methods to different color channels of a test color face image (multi-channel data) separately and independently, they neglect the three-dimensional (3-D) structural correlations among distinct color channels. In real-world scenarios, face images are often contaminated with complex noise, including contiguous occlusion and random pixel corruption, which pose significant challenges to these approaches and can lead to a decline in performance. In this paper, we propose a Tensor Nuclear Norm based Robust Multi-channel Atomic Representation (TNN-RMAR) framework with application to color face recognition. The proposed method has the following three critical ingredients: (1) We propose a 3-D color image-tensor-based error model, which can take full advantage of the 3-D structural information of the color error image. (2) To leverage the 3-D structural information of the color error image, we model it as a 3-order tensor {$\varepsilon$} and exploit its low-rank property with the tensor nuclear norm. Given that multiple color channels in a color image are generally corrupted at the same positions, we design a tube-wise tailored loss function to further leverage its tube-wise structure. (3) We devise the multi-channel atomic norm (MAN) regularization for the representation coeffcient matrix, which allows us to jointly harness the correlation information of coeffcients in different color channels. In addition, we also devise an effcient algorithm to solve the TNN-RMAR framework based on the alternating direction method of multipliers (ADMM) framework. By leveraging TNN-RMAR as a general platform, we also develop several novel robust multi-channel RC methods. Experimental results on benchmark real-world databases validate the effectiveness and robustness of the proposed framework for robust color face recognition.},
  langid = {english},
  keywords = {3-D error model,Colored noise,Face recognition,Image color analysis,Image reconstruction,multi-channel atomic representation,robust face recognition,Robustness,Solid modeling,tensor nuclear norm,Tensors,Three-dimensional displays,Training,Vectors},
  annotation = {abstractTranslation: 多数の表現ベースの分類（RC）メソッドは、まともなモデルの解釈可能性とノイズに対する堅牢性のために、顔認識のために開発されています。ほとんどの既存のRCメソッドは、主に1次元（1-d）ピクセルベースのエラーモデルと2次元（2-D）グレースケールの2つの方法で、グレースケール再構成エラーイメージ（シングルチャネルデータ）を特徴づけています。画像マトリックスベースのエラーモデル。前者はピクセルごとに再構成エラーピクセルを測定し、後者は低ランクのプロパティなどのグレースケールエラー画像の2D構造情報をレバレッジします。ただし、これらのメソッドをテストカラーフェイスイメージ（マルチチャネルデータ）の異なるカラーチャネルに個別に適用する場合、個別のカラーチャネル間の3次元（3-D）構造相関を無視します。実際のシナリオでは、顔の画像は、隣接する閉塞やランダムピクセルの腐敗など、複雑なノイズで汚染されることがよくあり、これらのアプローチに大きな課題をもたらし、パフォーマンスの低下につながる可能性があります。このホワイトペーパーでは、色の表認識を適用したテンソル核基準ベースの堅牢なマルチチャネル原子表現（TNN-RMAR）フレームワークを提案します。提案された方法には、次の3つの重要な成分があります。（1）3Dカラー画像テンソルベースのエラーモデルを提案します。これは、カラーエラー画像の3D構造情報を最大限に活用できます。 （2）カラーエラー画像の3D構造情報を活用するために、3次テンソル{$\varepsilon$}としてモデル化し、テンソル核規範と低ランクの特性を活用します。カラー画像の複数のカラーチャネルが一般に同じ位置で破損していることを考えると、チューブごとの構造をさらに活用するために、チューブワイズワイズのテーラード損失関数を設計します。 （3）表現係数マトリックスのマルチチャネル原子標準（MAN）正則化を考案します。これにより、さまざまなカラーチャネルの係数の相関情報を共同で活用できます。さらに、乗数（ADMM）フレームワークの交互方向方法に基づいてTNN-RMARフレームワークを解決するための効率的なアルゴリズムも考案します。 TNN-RMARを一般的なプラットフォームとして活用することにより、いくつかの新しい堅牢なマルチチャネルRCメソッドも開発します。ベンチマークの実験結果RealWorldデータベースは、堅牢な色の顔認識のための提案されたフレームワークの有効性と堅牢性を検証します。},
