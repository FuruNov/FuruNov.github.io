  abstract = {High-accuracy and efficient moving force identification (MFI) serves as an indirect approach that has the potential to meet real-time monitoring of vehicle-bridge interaction forces. The parallel computing-oriented method developed based on time-domain segmentation has demonstrated its advantages in the rapid identification of dynamic forces. However, this method has no strategy in place to highlight the global signal feature of dynamic forces. This study inherits a framework of the existing parallel computing-oriented method, attempting to identify the moving forces in a shorter amount of time by using a parallelizable multi-task optimal method. The proposed method establishes multiple MFI tasks based on a finite number of local time ranges. Each MFI task aims to estimate the moving forces happening within its local analysis duration and the corresponding initial vibration state of the structure. The identified equations for multiple tasks are built based on sparse regularization, intending to improve the ill-posed nature of the MFI inverse problems. To ensure that the identified moving force has an overall horizontal trend line, additional constraint conditions are defined mathematically and added to the sparse regularization-based equations, aiming to limit the differences among all the average values of the moving forces that are identified from different tasks, and resulting in a group of constrained identified equations. By relaxing the added constraints, a practical iterative algorithm is proposed for solving the multi-task MFI problem, wherein, the identified processes of different tasks in each iteration can be solved by parallel computing. Numerical and experimental studies verify the feasibility and effectiveness of the proposed method in identifying moving forces. The comparative analysis highlights its advantages in fast computation rather than the existing l1-norm regularization-based method in the considered cases. Some relative issues are discussed as well.},
  langid = {english},
  keywords = {Inverse problem,Moving force identification,Multi-task decomposition,Parallel computing,Sparse regularization},
  annotation = {abstractTranslation: 高精度と効率的な移動力識別（MFI）は、車両とブリッジの相互作用力のリアルタイム監視を満たす可能性のある間接的なアプローチとして機能します。タイムドメインのセグメンテーションに基づいて開発された並列コンピューティング指向の方法は、動的な力の迅速な識別におけるその利点を実証しています。ただし、この方法には、動的な力のグローバル信号特徴を強調する戦略はありません。この研究は、既存の並列コンピューティング指向の方法のフレームワークを継承し、平行化可能なマルチタスク最適な方法を使用して、移動力をより短い時間で識別しようとします。提案された方法は、現地時間範囲の有限数に基づいて複数のMFIタスクを確立します。各MFIタスクは、局所分析期間内で発生する移動力と、構造の対応する初期振動状態を推定することを目的としています。複数のタスクの識別された方程式は、MFIの逆問題の不適切な性質を改善することを目的とした、まばらな正則化に基づいて構築されています。識別された移動力が全体的な水平方向の傾向ラインを確保するために、追加の制約条件が数学的に定義され、まばらな正則化ベースの方程式に追加され、異なるタスクから識別される移動力のすべての平均値の差を制限し、制約された識別された方程式のグループになります。追加された制約を緩和することにより、マルチタスクMFI問題を解決するために実用的な反復アルゴリズムが提案されています。この問題では、各反復で異なるタスクの特定されたプロセスを並列コンピューティングによって解決できます。数値的および実験的研究では、移動力を特定する際の提案された方法の実現可能性と有効性を検証します。比較分析は、考慮された場合の既存のL1-NORM正規化ベースの方法ではなく、高速計算の利点を強調しています。いくつかの相対的な問題についても議論されています。},
  file = {C:\Users\furuh\Zotero\storage\CT9JYCK6\S0888327025001736.html}
}

@article{panStructureTimedelayEmbedding2020,
  title = {On the {{Structure}} of {{Time-delay Embedding}} in {{Linear Models}} of {{Non-linear Dynamical Systems}}},
  author = {Pan, Shaowu and Duraisamy, Karthik},
  year = {2020},
