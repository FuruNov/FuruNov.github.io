@article{chanStructuralStabilityThermodynamics2024,
  title = {Structural Stability and Thermodynamics of Artistic Composition},
  author = {Chan, San To and Fried, Eliot},
  year = {2024},
  month = dec,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {121},
  number = {51},
  pages = {e2406735121},
  publisher = {Proceedings of the National Academy of Sciences},
  doi = {10.1073/pnas.2406735121},
  urldate = {2024-12-25},
  abstract = {Inspired by the way that digital artists zoom out of the canvas to assess the visual impact of their works, we introduce a conceptually simple yet effective metric for quantifying the clarity of digital images. This metric contrasts original images with progressively ``melted'' counterparts, produced by randomly flipping adjacent pixel pairs. It measures the presence of stable structures, assigning the value zero to completely uniform or random images and finite values for those with discernible patterns. This metric respects the color diversity of the original image and withstands image compression and color quantization. Its suitability for diverse image analysis problems is demonstrated through its effective evaluation of textural images, the identification of structural transitions in physical systems like the Potts model, and its consistency with color theory in digital arts. This allows us to demonstrate that color in visual art functions as a state variable, akin to the spin configuration in magnets, driving artistic designs to transition between states with distinct clarity. When combined with the Shannon entropy, which quantifies color diversity, the structural stability metric can serve as a navigation tool for artists to explore pathways on the complex structural information landscape toward the completion of their artwork. As a practical demonstration, we apply our metric to refine and optimize an emote design for a video game. The structural stability metric emerges as a versatile tool for extracting nuanced structural information from digital images, which may enhance decision-making and data analysis across scientific and creative domains.},
  langid = {english},
  annotation = {デジタルアーティストが作品の視覚的インパクトを評価するためにキャンバスをズームアウトする方法にヒントを得て、デジタル画像の鮮明さを定量化するための、概念的にシンプルで効果的な測定基準を紹介する。この指標は、元の画像と、隣接する画素のペアをランダムに反転させることによって生成された、徐々に「溶けた」対応する画像とを対比する。これは安定した構造の有無を測定するもので、完全に一様な画像やランダムな画像には0を、識別可能なパターンを持つ画像には有限の値を割り当てる。この指標は元画像の色の多様性を尊重し、画像圧縮や色量子化に強い。テクスチャ画像の効果的な評価、Pottsモデルのような物理システムにおける構造遷移の識別、デジタルアートにおける色彩理論との整合性など、多様な画像解析問題への適合性が実証されている。これにより、視覚芸術における色が、磁石におけるスピン配置のような状態変数として機能し、芸術的デザインを明確な明瞭さで状態遷移させることを実証することができる。色の多様性を定量化するシャノンエントロピーと組み合わせることで、構造安定性メトリックは、アーティストが作品の完成に向けて複雑な構造情報景観上の経路を探索するためのナビゲーションツールとして機能します。実用的なデモンストレーションとして、ビデオゲームのエモートデザインを改良し最適化するために、我々のメトリックを適用する。構造安定性メトリックは、デジタル画像からニュアンスのある構造情報を抽出するための汎用的なツールとして登場し、科学的および創造的な領域にわたる意思決定やデータ分析を強化する可能性がある。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\N2WVUY8F\\Chan と Fried - 2024 - Structural stability and thermodynamics of artistic composition.pdf;C\:\\Users\\furuh\\Zotero\\storage\\ZYN998JN\\Chan と Fried - 2024 - Structural stability and thermodynamics of artistic composition-mono.pdf}
}

@inproceedings{chapmanUnconstrainedStochasticCCA2023,
  title = {Unconstrained {{Stochastic CCA}}: {{Unifying Multiview}} and {{Self-Supervised Learning}}},
