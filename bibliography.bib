@article{reddyExemplarBasedSparseRepresentations2023,
  title = {Exemplar-{{Based Sparse Representations}} for {{Detection}} of {{Parkinson}}'s {{Disease From Speech}}},
  author = {Reddy, Mittapalle Kiran and Alku, Paavo},
  year = {2023},
  journal = {IEEE/ACM Transactions on Audio, Speech, and Language Processing},
  volume = {31},
  pages = {1386--1396},
  issn = {2329-9304},
  doi = {10.1109/TASLP.2023.3260709},
  urldate = {2024-11-07},
  abstract = {Parkinson's disease (PD) is a progressive neurological disorder which affects the motor system. The automatic detection of PD improves the diagnosis of the disease, and it can be done in a non-invasive manner from speech. In this paper, we investigate the use of an exemplar-based sparse representation (SR) classification approach for detecting PD from speech. Exemplars are speech feature vectors extracted from the training data. The idea is to formulate the detection task as a problem of finding sparse representations of test speech feature vectors with respect to training speech exemplars. The main advantage of using the SR approach instead of conventional machine learning (ML)-based approaches is that the training step--which is time-consuming and sometimes requires unorganized hyper-parameter tuning--is not needed. Furthermore, SRs are more robust to redundancy and noise in the data. In this work, we study SR classification approaches based on two sparse coding models, namely, l1-regularized least squares (l{$_1$}LS) and non-negative least squares (NNLS). We propose a strategy based on class-specific dictionaries for improving performance of the l{$_1$}LS- and NNLS-based SR classification. To investigate the detection performance, the l{$_1$}LS- and NNLS-based approaches are applied and compared with the traditional PD detection approach based on ML classification algorithms using the PC-GITA PD dataset and an openly available dataset consisting of mobile device voice recordings from healthy and PD patients. The results indicate that the proposed NNLS-based SR classification approach performs better than the traditional ML-based methods in discriminating PD patients from healthy subjects.},
  langid = {american},
  keywords = {Diseases,Exemplar-based,Feature extraction,glottal features,Mathematical models,non-negative least squares,Parkinson's disease,Pipelines,random forest,sparse representation,Support vector machines,SVM,Task analysis,Training},
  annotation = {abstractTranslation: パーキンソン病（PD）は、運動系に影響を及ぼす進行性の神経疾患である。PDの自動検出は病気の診断を改善し、非侵襲的な方法で音声から検出することができる。本論文では、音声からPDを検出するために、模範解答に基づくスパース表現（SR）分類アプローチを用いることを検討する。模範とは、学習データから抽出された音声特徴ベクトルである。このアイデアは、検出タスクを、トレーニング音声模範に対するテスト音声特徴ベクトルのスパース表現を見つける問題として定式化することである。従来の機械学習(ML)ベースのアプローチの代わりにSRアプローチを用いる主な利点は、時間がかかり、時には無秩序なハイパーパラメータチューニングを必要とする学習ステップが不要であることである。さらに、SRはデータの冗長性やノイズに対してより頑健である。本研究では、2つのスパースコーディングモデル、すなわちl1-正則化最小二乗法（l1LS）と非負最小二乗法（NNLS）に基づくSR分類アプローチを研究する。l1LSとNNLSに基づくSR分類の性能を向上させるために、クラス固有の辞書に基づく戦略を提案する。検出性能を調べるために、l1LSとNNLSに基づくアプローチを適用し、PC-GITA PDデータセットと、健常者とPD患者の携帯端末の音声記録からなる公開データセットを用いて、ML分類アルゴリズムに基づく従来のPD検出アプローチと比較した。その結果、提案するNNLSに基づくSR分類アプローチは、PD患者と健常者の識別において、従来のMLに基づく手法よりも優れた性能を示すことが示された。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\BIASFXNN\\Reddy と Alku - 2023 - Exemplar-Based Sparse Representations for Detection of Parkinson's Disease From Speech.pdf;C\:\\Users\\furuh\\Zotero\\storage\\Q5JEVJDD\\Reddy と Alku - 2023 - Exemplar-Based Sparse Representations for Detection of Parkinson's Disease From Speech.pdf;C\:\\Users\\furuh\\Zotero\\storage\\7HR89348\\10081490.html}
