  urldate = {2024-11-07},
  abstract = {To assist the clinical diagnosis and treatment of neurological diseases that cause speech dysarthria such as Parkinson's disease (PD), it is of paramount importance to craft robust features which can be used to automatically discriminate between healthy and dysarthric speech. Since dysarthric speech of patients suffering from PD is breathy, semi-whispery, and is characterized by abnormal pauses and imprecise articulation, it can be expected that its spectro-temporal sparsity differs from the spectro-temporal sparsity of healthy speech. While we have recently successfully used temporal sparsity characterization for dysarthric speech detection, characterizing spectral sparsity poses the challenge of constructing a valid feature vector from signals with a different number of unaligned time frames. Further, although several non-parametric and parametric measures of sparsity exist, it is unknown which sparsity measure yields the best performance in the context of dysarthric speech detection. The objective of this paper is to demonstrate the advantages of spectro-temporal sparsity characterization for automatic dysarthric speech detection. To this end, we first provide a numerical analysis of the suitability of different non-parametric and parametric measures (i.e., l1-norm, kurtosis, Shannon entropy, Gini index, shape parameter of a Chi distribution, and shape parameter of a Weibull distribution) for sparsity characterization. It is shown that kurtosis, the Gini index, and the parametric sparsity measures are advantageous sparsity measures, whereas the l1-norm and entropy measures fail to robustly characterize the temporal sparsity of signals with a different number of time frames. Second, we propose to characterize the spectral sparsity of an utterance by initially time-aligning it to the same utterance uttered by a (arbitrarily selected) reference speaker using dynamic time warping. Experimental results on a Spanish database of healthy and dysarthric speech show that estimating the spectro-temporal sparsity using the Gini index or the parametric sparsity measures and using it as a feature in a support vector machine results in a high classification accuracy of 83.3\%.},
  langid = {american},
  keywords = {DTW,Entropy,Feature extraction,Indexes,Non-parametric sparsity,parametric sparsity,Parkinson's disease,Shape,Spectrogram,SVM,Voice activity detection},
  annotation = {abstractTranslation: パーキンソン病(PD)のような構音障害を引き起こす神経疾患の臨床診断と治療を支援するためには、健常な音声と構音障害を自動的に識別するために使用できるロバストな特徴量を作成することが最も重要である。PD患者の構音障害は、息が荒く、半ささやきで、異常な間や不正確な調音を特徴とするため、そのスペクトルの時間的スパース性は健常音声のスペクトルの時間的スパース性とは異なることが予想される。我々は最近、構音障害音声検出に時間的スパース性を利用することに成功しましたが、スペクトル的スパース性を特徴付けることは、異なる数の非整列時間フレームを持つ信号から有効な特徴ベクトルを構成するという課題を提起します。さらに、いくつかのノンパラメトリックおよびパラメトリックなスパース性尺度が存在するが、どのスパース性尺度が構音障害音声検出の文脈で最良の性能をもたらすかは不明である。本論文の目的は、自動構音障害音声検出のためのスペクトル時間的スパース特性の利点を実証することである。この目的のため、まず、ノンパラメトリックおよびパラメトリック尺度（l1-ノルム、尖度、シャノンエントロピー、ジニ指数、カイ分布の形状パラメータ、ワイブル分布の形状パラメータ）のスパース性の特徴付けに対する適合性の数値解析を行う。その結果、尖度、ジニ指数、パラメトリックなスパース性指標は有利なスパース性指標であるのに対し、l1-ノルムとエントロピー指標は、異なる時間フレーム数を持つ信号の時間的スパース性をロバストに特徴付けることができないことが示される。第二に、動的な時間ワーピングを用いて、（任意に選択された）参照話者によって発話された同じ発話と最初に時間整合させることにより、発話のスペクトル疎密を特徴付けることを提案する。健常音声と構音障害音声のスペイン語データベースを用いた実験の結果、ジニ指数またはパラメトリックスパース性を用いてスペクトルの時間的スパース性を推定し、サポートベクターマシンの特徴として用いることで、83.3\%という高い分類精度が得られることが示された。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\3DF25YSN\\Kodrasi と Bourlard - 2020 - Spectro-Temporal Sparsity Characterization for Dysarthric Speech Detection.pdf;C\:\\Users\\furuh\\Zotero\\storage\\3SMYXZ9K\\9057388.html}
}

@article{kohConceptBottleneckModels2020,
