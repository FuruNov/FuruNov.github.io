  number = {arXiv:1008.4220},
  eprint = {1008.4220},
  primaryclass = {cs},
  doi = {10.48550/arXiv.1008.4220},
  urldate = {2025-04-23},
  abstract = {Sparse methods for supervised learning aim at finding good linear predictors from as few variables as possible, i.e., with small cardinality of their supports. This combinatorial selection problem is often turned into a convex optimization problem by replacing the cardinality function by its convex envelope (tightest convex lower bound), in this case the L1-norm. In this paper, we investigate more general set-functions than the cardinality, that may incorporate prior knowledge or structural constraints which are common in many applications: namely, we show that for nondecreasing submodular set-functions, the corresponding convex envelope can be obtained from its {\textbackslash}lova extension, a common tool in submodular analysis. This defines a family of polyhedral norms, for which we provide generic algorithmic tools (subgradients and proximal operators) and theoretical results (conditions for support recovery or high-dimensional inference). By selecting specific submodular functions, we can give a new interpretation to known norms, such as those based on rank-statistics or grouped norms with potentially overlapping groups; we also define new norms, in particular ones that can be used as non-factorial priors for supervised learning.},
  archiveprefix = {arXiv},
  langid = {american},
  annotation = {abstractTranslation: 教師あり学習のためのスパース手法は、できるだけ少ない変数から優れた線形予測子を見つけること、すなわち、そのサポートの基数が小さいものを目指します。この組み合わせ選択問題は、多くの場合、基数関数をその凸包（最もタイトな凸下界）で置き換えることによって、凸最適化問題に変換されます。この場合、L1ノルムが用いられます。本稿では、基数よりも一般的な集合関数を検討します。これは、多くのアプリケーションで一般的な事前知識や構造的制約を取り込む可能性があります。具体的には、非減少劣モジュラ集合関数に対して、対応する凸包は、劣モジュラ分析で一般的なツールであるLov{\'a}sz拡張から得られることを示します。これは多面体ノルムのファミリーを定義し、それに対して汎用的なアルゴリズムツール（劣勾配と近接演算子）と理論的結果（サポート回復または高次元推論の条件）を提供します。特定の劣モジュラ関数を選択することで、ランク統計に基づくノルムや、潜在的に重複するグループを持つグループノルムなど、既知のノルムに新しい解釈を与えることができます。また、新しいノルム、特に教師あり学習の非階乗事前分布として使用できるノルムを定義します。},
