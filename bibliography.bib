@article{qinLowRankHighOrderTensor2022,
  title = {Low-{{Rank High-Order Tensor Completion With Applications}} in {{Visual Data}}},
  author = {Qin, Wenjin and Wang, Hailin and Zhang, Feng and Wang, Jianjun and Luo, Xin and Huang, Tingwen},
  year = {2022},
  journal = {IEEE Transactions on Image Processing},
  volume = {31},
  pages = {2433--2448},
  issn = {1941-0042},
  doi = {10.1109/TIP.2022.3155949},
  urldate = {2024-08-09},
  abstract = {Recently, tensor Singular Value Decomposition (t-SVD)-based low-rank tensor completion (LRTC) has achieved unprecedented success in addressing various pattern analysis issues. However, existing studies mostly focus on third-order tensors while order- d ( d{\textbackslash}geq 4 ) tensors are commonly encountered in real-world applications, like fourth-order color videos, fourth-order hyper-spectral videos, fifth-order light-field images, and sixth-order bidirectional texture functions. Aiming at addressing this critical issue, this paper establishes an order- d tensor recovery framework including the model, algorithm and theories by innovatively developing a novel algebraic foundation for order- d t-SVD, thereby achieving exact completion for any order- d low t-SVD rank tensors with missing values with an overwhelming probability. Emperical studies on synthetic data and real-world visual data illustrate that compared with other state-of-the-art recovery frameworks, the proposed one achieves highly competitive performance in terms of both qualitative and quantitative metrics. In particular, as the observed data density becomes low, i.e., about 10\%, the proposed recovery framework is still significantly better than its peers. The code of our algorithm is released at https://github.com/Qinwenjinswu/TIP-Code},
  langid = {english},
  keywords = {convex optimization,Data models,Image color analysis,invertible linear transforms,Low-rank order-d tensor completion,Matrix decomposition,order-d tensor singular value decomposition,Singular value decomposition,sparsity measure,Tensors,Videos,Visualization},
  annotation = {abstractTranslation:  近年、テンソル特異値分解(t-SVD)に基づく低ランクテンソル補完(LRTC)は、様々なパターン解析の問題に対処する上で前例のない成功を収めている。しかし、既存の研究は、4次のカラービデオ、4次のハイパースペクトルビデオ、5次のライトフィールド画像、6次の双方向テクスチャ関数など、実世界のアプリケーションでよく遭遇する次数d（dgeq 4）のテンソルに対し、3次のテンソルに焦点を当てたものがほとんどである。この重要な問題に対処することを目的として、本論文では、次数dのt-SVDのための新しい代数的基礎を革新的に開発することにより、モデル、アルゴリズム、理論を含む次数dのテンソル復元フレームワークを確立し、それにより、欠損値を持つ任意の次数dの低いt-SVDランクテンソルの厳密な補完を圧倒的な確率で達成する。合成データと実世界の視覚データを用いた実証研究により、他の最先端の復元フレームワークと比較して、提案するフレームワークが定性的・定量的指標の両面で非常に競争力のある性能を達成していることが示される。特に、観測されるデータ密度が10\%程度と低くなっても、提案する復元フレームワークは同種のフレームワークよりも有意に優れている。我々のアルゴリズムのコードは https://github.com/Qinwenjinswu/TIP-Code で公開されている。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\EAWXQVDP\\Qin et al. - 2022 - Low-Rank High-Order Tensor Completion With Applica.pdf;C\:\\Users\\furuh\\Zotero\\storage\\IQL7XU9Y\\9730793.html}
}

@article{qinNonconvexRobustHighOrder2024,
  title = {Nonconvex {{Robust High-Order Tensor Completion Using Randomized Low-Rank Approximation}}},
  author = {Qin, Wenjin and Wang, Hailin and Zhang, Feng and Ma, Weijun and Wang, Jianjun and Huang, Tingwen},
  year = {2024},
  journal = {IEEE Transactions on Image Processing},
  volume = {33},
  pages = {2835--2850},
  issn = {1941-0042},
  doi = {10.1109/TIP.2024.3385284},
  urldate = {2025-02-01},
  abstract = {Within the tensor singular value decomposition (T-SVD) framework, existing robust low-rank tensor completion approaches have made great achievements in various areas of science and engineering. Nevertheless, these methods involve the T-SVD based low-rank approximation, which suffers from high computational costs when dealing with large-scale tensor data. Moreover, most of them are only applicable to third-order tensors. Against these issues, in this article, two efficient low-rank tensor approximation approaches fusing random projection techniques are first devised under the order-d ( d{\textbackslash}geq 3 ) T-SVD framework. Theoretical results on error bounds for the proposed randomized algorithms are provided. On this basis, we then further investigate the robust high-order tensor completion problem, in which a double nonconvex model along with its corresponding fast optimization algorithms with convergence guarantees are developed. Experimental results on large-scale synthetic and real tensor data illustrate that the proposed method outperforms other state-of-the-art approaches in terms of both computational efficiency and estimated precision.},
  langid = {english},
  keywords = {ADMM algorithm,Approximation algorithms,Computational modeling,High-order T-SVD framework,Image reconstruction,Indexes,nonconvex regularizers,Optimization,randomized low-rank tensor approximation,robust high-order tensor completion,Singular value decomposition,Tensors},
  annotation = {abstractTranslation: テンソル特異値分解（T-SVD）フレームワーク内で、既存の堅牢な低ランクテンソル完了アプローチは、科学と工学のさまざまな分野で大きな成果を上げています。それにもかかわらず、これらの方法には、T-SVDベースの低ランク近似が含まれます。これは、大規模なテンソルデータを扱う際に高い計算コストに苦しんでいます。さらに、それらのほとんどは3次テンソルにのみ適用できます。これらの問題に対して、この記事では、ランダム投影技術の融合を融合する2つの効率的な低ランクテンソル近似アプローチが、最初にOrder-D（D {\textbackslash} Geq 3）T-SVDフレームワークの下で考案されます。提案されたランダム化アルゴリズムのエラー境界に関する理論的結果が提供されます。これに基づいて、堅牢な高次テンソル完了問題をさらに調査します。この問題は、収束保証を備えた対応する高速最適化アルゴリズムとともに二重の非コンベックスモデルとともに開発されます。大規模な合成および実際のテンソルデータの実験結果は、提案された方法が、計算効率と推定精度の両方の観点から、他の最先端のアプローチよりも優れていることを示しています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\YV5T24CM\\Qin et al. - 2024 - Nonconvex Robust High-Order Tensor Completion Using Randomized Low-Rank Approximation.pdf;C\:\\Users\\furuh\\Zotero\\storage\\5WGB5889\\10496551.html}
}

