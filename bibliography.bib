  year = {2022},
  month = sep,
  urldate = {2023-10-13},
  abstract = {It is well known that the finite step-size (\$h\$) in Gradient descent (GD) implicitly regularizes solutions to flatter minimas. A natural question to ask is {\textbackslash}textit\{Does the momentum parameter \${\textbackslash}beta\$ (say) play a role in implicit regularization in Heavy-ball (H.B) momentum accelerated gradient descent (GD+M)?\}. To answer this question, first, we show that the trajectory traced by discrete H.B momentum update (GD+M) is \$O(h{\textasciicircum}2)\$ close to a continuous trajectory induced by a modified loss, which consists of an original loss and an implicit regularizer. This implicit regularizer for (GD+M) is indeed stronger than that of (GD) by factor of \$({\textbackslash}frac\{1+{\textbackslash}beta\}\{1-{\textbackslash}beta\})\$, thus explaining why (GD+M) shows better generalization performance and higher test accuracy than (GD). Furthermore, we extend our analysis to stochastic version of gradient descent with momentum (SGD+M) and propose a deterministic continuous trajectory that is \$O(h{\textasciicircum}2)\$ close to the discrete update of (SGD+M) in a strong approximation sense. We explore the implicit regularization in (SGD+M) and (GD+M) through a series of experiments validating our theory.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\BNMA6NAB\Ghosh et al. - 2022 - Implicit regularization in Heavy-ball momentum acc.pdf}
}

@misc{gidelImplicitRegularizationDiscrete2019,
