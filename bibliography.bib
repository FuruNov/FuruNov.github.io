@article{songUnravelingGradientDescent,
  title = {Unraveling the {{Gradient Descent Dynamics}} of {{Transformers}}},
  author = {Song, Bingqing and Han, Boran and Zhang, Shuai and Ding, Jie and Hong, Mingyi},
  abstract = {While the Transformer architecture has achieved remarkable success across various domains, a thorough theoretical foundation explaining its optimization dynamics is yet to be fully developed. In this study, we aim to bridge this understanding gap by answering the following two core questions: (1) Which types of Transformer architectures allow Gradient Descent (GD) to achieve guaranteed convergence? and (2) Under what initial conditions and architectural specifics does the Transformer achieve rapid convergence during training? By analyzing the loss landscape of a single Transformer layer using Softmax and Gaussian attention kernels, our work provides concrete answers to these questions. Our findings demonstrate that, with appropriate weight initialization, GD can train a Transformer model (with either kernel type) to achieve a global optimal solution, especially when the input embedding dimension is large. Nonetheless, certain scenarios highlight potential pitfalls: training a Transformer using the Softmax attention kernel may sometimes lead to suboptimal local solutions. In contrast, the Gaussian attention kernel exhibits a much favorable behavior. Our empirical study further validate the theoretical findings.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\C3KFIMRJ\Song et al. - Unraveling the Gradient Descent Dynamics of Transformers.pdf}
}

@misc{sorscherNeuralScalingLaws2023,
  title = {Beyond Neural Scaling Laws: Beating Power Law Scaling via Data Pruning},
  shorttitle = {Beyond Neural Scaling Laws},
  author = {Sorscher, Ben and Geirhos, Robert and Shekhar, Shashank and Ganguli, Surya and Morcos, Ari S.},
  year = {2023},
  month = apr,
  number = {arXiv:2206.14486},
  eprint = {2206.14486},
  primaryclass = {cs, stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2206.14486},
  urldate = {2023-06-11},
  abstract = {Widely observed neural scaling laws, in which error falls off as a power of the training set size, model size, or both, have driven substantial performance improvements in deep learning. However, these improvements through scaling alone require considerable costs in compute and energy. Here we focus on the scaling of error with dataset size and show how in theory we can break beyond power law scaling and potentially even reduce it to exponential scaling instead if we have access to a high-quality data pruning metric that ranks the order in which training examples should be discarded to achieve any pruned dataset size. We then test this improved scaling prediction with pruned dataset size empirically, and indeed observe better than power law scaling in practice on ResNets trained on CIFAR-10, SVHN, and ImageNet. Next, given the importance of finding high-quality pruning metrics, we perform the first large-scale benchmarking study of ten different data pruning metrics on ImageNet. We find most existing high performing metrics scale poorly to ImageNet, while the best are computationally intensive and require labels for every image. We therefore developed a new simple, cheap and scalable self-supervised pruning metric that demonstrates comparable performance to the best supervised metrics. Overall, our work suggests that the discovery of good data-pruning metrics may provide a viable path forward to substantially improved neural scaling laws, thereby reducing the resource costs of modern deep learning.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computer Vision and Pattern Recognition,Computer Science - Machine Learning,Statistics - Machine Learning},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\3H9DUQF5\\Sorscher et al. - 2023 - Beyond neural scaling laws beating power law scal.pdf;C\:\\Users\\furuh\\Zotero\\storage\\CZ5PNUEZ\\2206.html}
}

@article{soubiesContinuousExactL02015,
  title = {A {{Continuous Exact L0 Penalty}} ({{CEL0}}) for {{Least Squares Regularized Problem}}},
  author = {Soubies, Emmanuel and {Blanc-F{\'e}raud}, Laure and Aubert, Gilles},
  year = {2015},
  month = jan,
  journal = {SIAM Journal on Imaging Sciences},
  volume = {8},
  number = {3},
  pages = {1607--1639},
  publisher = {{Society for Industrial and Applied Mathematics}},
  doi = {10.1137/151003714},
  urldate = {2025-03-08},
  abstract = {Numerous nonconvex continuous penalties have been proposed to approach the \${\textbackslash}ell\_0\$ pseudonorm for optimization purpose. Apart from the theoretical results for convex \${\textbackslash}ell\_1\$ relaxation under restrictive hypotheses, only few works have been devoted to analyze the consistency, in terms of minimizers, between the \${\textbackslash}ell\_0\$-regularized least squares functional and relaxed ones using continuous approximations. In this context, two questions are of fundamental importance: do  relaxed functionals preserve global minimizers of the initial one? Do these approximations introduce unwanted new (local) minimizers? In this paper we answer  these questions by deriving necessary and sufficient conditions on such \${\textbackslash}ell\_0\$ continuous approximations in order that each (local and global) minimizer of the underlying relaxation is also a minimizer of the \${\textbackslash}ell\_2\$-\${\textbackslash}ell\_0\$ functional and that all the global minimizers of the initial functional are preserved. Hence, a general class of penalties is provided giving a unified view of exact continuous approximations of the \${\textbackslash}ell\_0\$-norm within the \${\textbackslash}ell\_2\$-\${\textbackslash}ell\_0\$ minimization framework. As the inferior limit of this class of penalties, we get the recently proposed continuous exact \${\textbackslash}ell\_0\$ penalty. Finally, state of the art penalties, such as minimax concave penalty, smoothly clipped absolute deviation, or capped-\${\textbackslash}ell\_1\$, are analyzed according to the proposed class of exact continuous penalties.},
  langid = {english},
  annotation = {abstractTranslation: 最適化目的のために\$ {\textbackslash} ell\_0 \$ pseudonormにアプローチするために、多くの非凸の連続ペナルティが提案されています。制限的な仮説の下での凸\$ {\textbackslash} ell\_1 \$緩和の理論的結果とは別に、\$ {\textbackslash} ELL\_0 \$ \$の最小二乗関数型と連続近似を使用してリラックスしたものとの間の一貫性を分析するために専用の作品はほとんどありません。これに関連して、2つの質問が根本的に重要です。リラックスした機能は、最初の最小限のグローバルミニマイザーを保存しますか？これらの近似には、不要な新しい（ローカル）ミニマイザーが導入されますか？この論文では、基礎となるリラクゼーションの各（ローカルおよびグローバルな）ミニマイザーが\$ {\textbackslash} ELL\_2 \$-\$ {\textbackslash} ELL\_0 \$機能のミニマライザーであり、初期機能のすべてのグローバルミニマイズが保存されているため、このような\$ {\textbackslash} ell\_0 \$連続近似に必要かつ十分な条件を導き出すことにより、これらの質問に答えます。したがって、一般的なクラスのペナルティが提供され、\$ {\textbackslash} ell\_0 \$ -normの正確な連続近似の統一ビューが\$ {\textbackslash} ell\_2 \$-\$ {\textbackslash} ell\_0 \$最小化フレームワーク内にあります。このクラスのペナルティの劣等制限として、最近提案された継続的な正確な\$ {\textbackslash} ell\_0 \$ペナルティを取得します。最後に、Minimax凹のペナルティ、スムーズに切り取られた絶対偏差、またはCapped-\$ {\textbackslash} Ell\_1 \$などの最先端のペナルティは、提案されたクラスの正確な継続的ペナルティに従って分析されます。},
  file = {C:\Users\furuh\Zotero\storage\GMZA7YRM\Soubies et al. - 2015 - A Continuous Exact L0 Penalty (CEL0) for Least Squares Regularized Problem.pdf}
}

