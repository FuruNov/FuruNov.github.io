}

@misc{shaoOmniQuantOmnidirectionallyCalibrated2023,
  title = {{{OmniQuant}}: {{Omnidirectionally Calibrated Quantization}} for {{Large Language Models}}},
  shorttitle = {{{OmniQuant}}},
  author = {Shao, Wenqi and Chen, Mengzhao and Zhang, Zhaoyang and Xu, Peng and Zhao, Lirui and Li, Zhiqian and Zhang, Kaipeng and Gao, Peng and Qiao, Yu and Luo, Ping},
  year = {2023},
  month = oct,
  number = {arXiv:2308.13137},
  eprint = {2308.13137},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2308.13137},
  urldate = {2023-11-09},
  abstract = {Large language models (LLMs) have revolutionized natural language processing tasks. However, their practical deployment is hindered by their immense memory and computation requirements. Although recent post-training quantization (PTQ) methods are effective in reducing memory footprint and improving the computational efficiency of LLM, they hand-craft quantization parameters, which leads to low performance and fails to deal with extremely low-bit quantization. To tackle this issue, we introduce an Omnidirectionally calibrated Quantization (OmniQuant) technique for LLMs, which achieves good performance in diverse quantization settings while maintaining the computational efficiency of PTQ by efficiently optimizing various quantization parameters. OmniQuant comprises two innovative components including Learnable Weight Clipping (LWC) and Learnable Equivalent Transformation (LET). LWC modulates the extreme values of weights by optimizing the clipping threshold. Meanwhile, LET tackles activation outliers by shifting the challenge of quantization from activations to weights through a learnable equivalent transformation. Operating within a differentiable framework using block-wise error minimization, OmniQuant can optimize the quantization process efficiently for both weight-only and weight-activation quantization. For instance, the LLaMA-2 model family with the size of 7-70B can be processed with OmniQuant on a single A100-40G GPU within 1-16 hours using 128 samples. Extensive experiments validate OmniQuant's superior performance across diverse quantization configurations such as W4A4, W6A6, W4A16, W3A16, and W2A16. Additionally, OmniQuant demonstrates effectiveness in instruction-tuned models and delivers notable improvements in inference speed and memory reduction on real devices. Codes and models are available at {\textbackslash}url\{https://github.com/OpenGVLab/OmniQuant\}.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computation and Language,Computer Science - Machine Learning}
}

@inproceedings{sharifSuitabilityLpNormsCreating2018,
  title = {On the {{Suitability}} of {{Lp-Norms}} for {{Creating}} and {{Preventing Adversarial Examples}}},
  booktitle = {2018 {{IEEE}}/{{CVF Conference}} on {{Computer Vision}} and {{Pattern Recognition Workshops}} ({{CVPRW}})},
  author = {Sharif, Mahmood and Bauer, Lujo and Reiter, Michael K.},
  year = {2018},
  month = jun,
  pages = {1686--16868},
  publisher = {IEEE Computer Society},
  doi = {10.1109/CVPRW.2018.00211},
  urldate = {2024-11-18},
  abstract = {Much research has been devoted to better understanding adversarial examples, which are specially crafted inputs to machine-learning models that are perceptually similar to benign inputs, but are classified differently (i.e., misclassified). Both algorithms that create adversarial examples and strategies for defending against adversarial examples typically use Lp-norms to measure the perceptual similarity between an adversarial input and its benign original. Prior work has already shown, however, that two images need not be close to each other as measured by an Lp-norm to be perceptually similar. In this work, we show that nearness according to an Lp-norm is not just unnecessary for perceptual similarity, but is also insufficient. Specifically, focusing on datasets (CIFAR10 and MNIST), Lp-norms, and thresholds used in prior work, we show through online user studies that "adversarial examples" that are closer to their benign counterparts than required by commonly used Lp-norm thresholds can nevertheless be perceptually distinct to humans from the corresponding benign examples. Namely, the perceptual distance between two images that are "near" each other according to an Lp-norm can be high enough that participants frequently classify the two images as representing different objects or digits. Combined with prior work, we thus demonstrate that nearness of inputs as measured by Lp-norms is neither necessary nor sufficient for perceptual similarity, which has implications for both creating and defending against adversarial examples. We propose and discuss alternative similarity metrics to stimulate future research in the area.},
  isbn = {978-1-5386-6100-0},
  langid = {english},
  annotation = {abstractTranslation: 敵対的な例は、機械学習モデルへの特別に作成された入力であり、知覚的には無害な入力と似ていますが、異なる方法で分類されます (つまり、誤って分類されます)。敵対的な例を作成するアルゴリズムと、敵対的な例から防御するための戦略はどちらも、通常、Lp ノルムを使用して、敵対的な入力とその無害な元の入力との間の知覚的類似性を測定します。しかし、これまでの研究では、2 つの画像が知覚的に似ているためには、Lp ノルムによって測定されるように互いに近い必要はないことがすでに示されています。この研究では、Lp ノルムに従った近さは、知覚的な類似性に不必要であるだけでなく、不十分であることを示します。具体的には、以前の研究で使用されたデータセット (CIFAR10 および MNIST)、Lp ノルム、およびしきい値に焦点を当て、オンライン ユーザー調査を通じて、一般的に使用される Lp ノルムしきい値で要求されるよりも無害な対応物に近い「敵対的な例」が、それにもかかわらず、人間にとっては、対応する良性の例とは知覚的に区別されます。つまり、Lp ノルムに従って互いに「近い」2 つの画像間の知覚距離は、参加者が 2 つの画像を異なる物体または数字を表すものとして頻繁に分類するほど十分に高い可能性があります。したがって、以前の研究と組み合わせると、Lp ノルムによって測定される入力の近さは、知覚的な類似性にとって必要でも十分でもないことを実証します。これは、敵対的な例の作成と防御の両方に影響を与えます。私たちは、この分野における将来の研究を促進するために、代替の類似性指標を提案し、議論します。},
  file = {C:\Users\furuh\Zotero\storage\99Z96AZP\Sharif et al. - 2018 - On the Suitability of Lp-Norms for Creating and Preventing Adversarial Examples.pdf}
}

