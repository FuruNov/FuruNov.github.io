@article{quHypergraphBasedMultitaskFeature2024,
  title = {Hypergraph-{{Based Multitask Feature Selection}} with {{Temporally Constrained Group Sparsity Learning}} on {{fMRI}}},
  author = {Qu, Youzhi and Fu, Kai and Wang, Linjing and Zhang, Yu and Wu, Haiyan and Liu, Quanying},
