@article{panImprovedNewtonIteration1991,
  title = {An {{Improved Newton Iteration}} for the {{Generalized Inverse}} of a {{Matrix}}, with {{Applications}}},
  author = {Pan, Victor and Schreiber, Robert},
  year = {1991},
