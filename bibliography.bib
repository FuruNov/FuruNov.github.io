  doi = {10.1109/ICASSP.2009.4960226},
  urldate = {2024-09-11},
  abstract = {We consider compressed sensing of block-sparse signals, i.e., sparse signals that have nonzero coefficients occurring in clusters. Based on an uncertainty relation for block-sparse signals, we define a block-coherence measure and show that a block-version of the orthogonal matching pursuit algorithm recovers block k-sparse signals in no more than k steps if the block-coherence is sufficiently small. The same condition on block-sparsity is shown to guarantee successful recovery through a mixed lscr2/lscr1 optimization approach. The significance of the results lies in the fact that making explicit use of block-sparsity can yield better reconstruction properties than treating the signal as being sparse in the conventional sense, thereby ignoring the additional structure in the problem.},
  langid = {english},
  keywords = {Block-sparsity,Clustering algorithms,coherence,Coherence,Compressed sensing,Context,Matching pursuit algorithms,Pursuit algorithms,Robustness,Sufficient conditions,Uncertainty,uncertainty relations,Wireless communication},
  annotation = {abstractTranslation: 本論文では、ブロック・スパース信号、すなわち、クラスタ内で発生する非ゼロ係数を持つスパース信号の圧縮センシングを考察する。ブロック-スパース信号の不確定性関係に基づいて、ブロック-コヒーレンス尺度を定義し、ブロック-コヒーレンスが十分に小さい場合、直交マッチング追求アルゴリズムのブロック版がブロックk-スパース信号をkステップ以内で回復することを示す。ブロック・スパースに関する同じ条件は、lscr2/lscr1の混合最適化アプローチによる回復の成功を保証することが示される。この結果の意義は、ブロック・スパース性を明示的に利用することで、従来の意味で信号をスパースとして扱い、それによって問題の付加的な構造を無視するよりも優れた再構成特性が得られるという事実にある。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\7XUGUZEP\\Eldar と Bolcskei - 2009 - Block-sparsity Coherence and efficient recovery.pdf;C\:\\Users\\furuh\\Zotero\\storage\\BL5S785U\\4960226.html}
}

@misc{eldarCompressedSensingBlockSparse2009,
  title = {Compressed {{Sensing}} of {{Block-Sparse Signals}}: {{Uncertainty Relations}} and {{Efficient Recovery}}},
  shorttitle = {Compressed {{Sensing}} of {{Block-Sparse Signals}}},
  author = {Eldar, Yonina C. and Kuppinger, Patrick and B{\"o}lcskei, Helmut},
  year = {2009},
  month = jun,
  eprint = {0906.3173},
  primaryclass = {cs, math},
  doi = {10.1109/TSP.2010.2044837},
  urldate = {2022-12-06},
  abstract = {We consider compressed sensing of block-sparse signals, i.e., sparse signals that have nonzero coefficients occurring in clusters. An uncertainty relation for block-sparse signals is derived, based on a block-coherence measure, which we introduce. We then show that a block-version of the orthogonal matching pursuit algorithm recovers block \$k\$-sparse signals in no more than \$k\$ steps if the block-coherence is sufficiently small. The same condition on block-coherence is shown to guarantee successful recovery through a mixed \${\textbackslash}ell\_2/{\textbackslash}ell\_1\$-optimization approach. This complements previous recovery results for the block-sparse case which relied on small block-restricted isometry constants. The significance of the results presented in this paper lies in the fact that making explicit use of block-sparsity can provably yield better reconstruction properties than treating the signal as being sparse in the conventional sense, thereby ignoring the additional structure in the problem.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Information Theory},
  annotation = {abstractTranslation: 本論文では、ブロック・スパース信号、すなわち、クラスタ内で発生する非ゼロ係数を持つスパース信号の圧縮センシングを考察する。ブロック-スパース信号の不確定性関係を、ブロック-コヒーレンス尺度に基づいて導出する。そして、ブロックコヒーレンシが十分小さい場合、直交マッチング追求アルゴリズムのブロック版がブロック\$k\$スパース信号を\$k\$ステップ以内で回復することを示す。ブロック・コヒーレンスに関する同じ条件は、混合\$ell\_2/ell\_1\$最適化アプローチにより、成功した回復を保証することが示される。この結果は、小さなブロック制限アイソメトリ定数に依存していたブロック・スパースの場合の過去の回復結果を補完するものである。本論文で示された結果の意義は、ブロック・スパース性を明示的に利用することで、従来の意味で信号をスパースとして扱い、それによって問題の付加的な構造を無視するよりも、より良い再構成特性が証明的に得られるという事実にある。},
  file = {C:\Users\furuh\Zotero\storage\GSIBX56R\Eldar et al_2009_Compressed Sensing of Block-Sparse Signals.pdf}
}

@article{eldarRobustRecoverySignals2008,
  title = {Robust {{Recovery}} of {{Signals From}} a {{Structured Union}} of {{Subspaces}}},
  author = {Eldar, Yonina C. and Mishali, Moshe},
  year = {2008},
  month = jul,
  doi = {10.48550/arXiv.0807.4581},
  urldate = {2023-01-07},
  abstract = {Traditional sampling theories consider the problem of reconstructing an unknown signal \$x\$ from a series of samples. A prevalent assumption which often guarantees recovery from the given measurements is that \$x\$ lies in a known subspace. Recently, there has been growing interest in nonlinear but structured signal models, in which \$x\$ lies in a union of subspaces. In this paper we develop a general framework for robust and efficient recovery of such signals from a given set of samples. More specifically, we treat the case in which \$x\$ lies in a sum of \$k\$ subspaces, chosen from a larger set of \$m\$ possibilities. The samples are modelled as inner products with an arbitrary set of sampling functions. To derive an efficient and robust recovery algorithm, we show that our problem can be formulated as that of recovering a block-sparse vector whose non-zero elements appear in fixed blocks. We then propose a mixed \${\textbackslash}ell\_2/{\textbackslash}ell\_1\$ program for block sparse recovery. Our main result is an equivalence condition under which the proposed convex algorithm is guaranteed to recover the original signal. This result relies on the notion of block restricted isometry property (RIP), which is a generalization of the standard RIP used extensively in the context of compressed sensing. Based on RIP we also prove stability of our approach in the presence of noise and modelling errors. A special case of our framework is that of recovering multiple measurement vectors (MMV) that share a joint sparsity pattern. Adapting our results to this context leads to new MMV recovery methods as well as equivalence conditions under which the entire set can be determined efficiently.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\GMJHCMW4\Eldar_Mishali_2008_Robust Recovery of Signals From a Structured Union of Subspaces.pdf}
}

@article{elenAdaptiveGaussianKernel2022,
  title = {An {{Adaptive Gaussian Kernel}} for {{Support Vector Machine}}},
  author = {Elen, Abdullah and Ba{\c s}, Sel{\c c}uk and K{\"o}zkurt, Cemil},
  year = {2022},
  month = aug,
  journal = {Arabian Journal for Science and Engineering},
  volume = {47},
  number = {8},
  pages = {10579--10588},
  issn = {2191-4281},
  doi = {10.1007/s13369-022-06654-3},
  urldate = {2024-08-03},
  abstract = {The most commonly used kernel function of support vector machine (SVM) in nonlinear separable dataset in machine learning is Gaussian kernel, also known as radial basis function. The Gaussian kernel decays exponentially in the input feature space and uniformly in all directions around the support vector, causing hyper-spherical contours of kernel function. In this study, an adaptive kernel function is designed based on the Gaussian kernel, which is used in SVM. While the sigma parameter is determined as an arbitrary value in the traditional Gaussian kernel, a modified Gaussian kernel method is used that calculates an adaptive value depending on the input vectors in the proposed kernel function. The proposed kernel function is compared with the linear, polynomial and Gaussian kernels commonly used in support vector machines. The results show that the proposed kernel function performs well on separable linear and nonlinear datasets compared to other kernel functions. It is also compared to state-of-the-art support vector machine kernels.},
  langid = {english},
  keywords = {Data classification,Gaussian Kernel,Radial basis function,Support vector machine},
  annotation = {abstractTranslation:  非線形分離可能データセットにおけるサポートベクターマシン(SVM)のカーネル関数は、放射基底関数としても知られるガウシアンカーネルが一般的である。ガウシアンカーネルは，入力特徴空間において指数関数的に減衰し，サポートベクトルの周りの全ての方向において一様に減衰するため，カーネル関数の輪郭が超球状になる．本研究では、SVMに用いる適応カーネル関数をガウシアンカーネルに基づいて設計する。従来のガウシアンカーネルではシグマパラメータは任意の値として決定されるが，提案カーネル関数では入力ベクトルに応じて適応的な値を計算する修正ガウシアンカーネル法を用いる．提案カーネル関数を、サポートベクターマシンで一般的に用いられる線形カーネル、多項式カーネル、ガウシアンカーネルと比較した。その結果、提案カーネル関数は、他のカーネル関数と比較して、分離可能な線形および非線形のデータセットにおいて良好な性能を示す。また、最新のサポートベクターマシンのカーネルとも比較した。},
  file = {C:\Users\furuh\Zotero\storage\7EMCJAU4\Elen et al. - 2022 - An Adaptive Gaussian Kernel for Support Vector Mac.pdf}
}

@inproceedings{elhagManifoldDiffusionFields2023,
  title = {Manifold {{Diffusion Fields}}},
  booktitle = {The {{Twelfth International Conference}} on {{Learning Representations}}},
  author = {Elhag, Ahmed A. A. and Wang, Yuyang and Susskind, Joshua M. and Bautista, Miguel {\'A}ngel},
  year = {2023},
  month = oct,
  urldate = {2024-06-17},
  abstract = {We present Manifold Diffusion Fields (MDF), an approach that unlocks learning of diffusion models of data in general non-euclidean geometries. Leveraging insights from spectral geometry analysis, we define an intrinsic coordinate system on the manifold via the eigen-functions of the Laplace-Beltrami Operator. MDF represents functions using an explicit parametrization formed by a set of multiple input-output pairs. Our approach allows to sample continuous functions on manifolds and is invariant with respect to rigid and isometric transformations of the manifold. In addition, we show that MDF generalizes to the case where the training set contains functions on different manifolds. Empirical results on multiple datasets and manifolds including challenging scientific problems like weather prediction or molecular conformation show that MDF can capture distributions of such functions with better diversity and fidelity than previous approaches.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\VMXEVWVK\Elhag et al. - 2023 - Manifold Diffusion Fields.pdf}
}

@misc{elhagRelaxedEquivarianceMultitask2024,
  title = {Relaxed {{Equivariance}} via {{Multitask Learning}}},
  author = {Elhag, Ahmed A. and Rusch, T. Konstantin and Giovanni, Francesco Di and Bronstein, Michael},
  year = {2024},
  month = oct,
  number = {arXiv:2410.17878},
  eprint = {2410.17878},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2410.17878},
  urldate = {2024-10-29},
  abstract = {Incorporating equivariance as an inductive bias into deep learning architectures to take advantage of the data symmetry has been successful in multiple applications, such as chemistry and dynamical systems. In particular, roto-translations are crucial for effectively modeling geometric graphs and molecules, where understanding the 3D structures enhances generalization. However, equivariant models often pose challenges due to their high computational complexity. In this paper, we introduce REMUL, a training procedure for approximating equivariance with multitask learning. We show that unconstrained models (which do not build equivariance into the architecture) can learn approximate symmetries by minimizing an additional simple equivariance loss. By formulating equivariance as a new learning objective, we can control the level of approximate equivariance in the model. Our method achieves competitive performance compared to equivariant baselines while being \$10 {\textbackslash}times\$ faster at inference and \$2.5 {\textbackslash}times\$ at training.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Machine Learning},
  annotation = {abstractTranslation: データの対称性を利用するために、ディープラーニングアーキテクチャに帰納的バイアスとして等変数を組み込むことは、化学や力学系などの複数のアプリケーションで成功している。特に、幾何学的なグラフや分子を効果的にモデリングするためには、3次元構造を理解することで汎化が促進されるロト変換が不可欠である。しかし、等変数モデルは計算量が多いため、しばしば難題となる。本論文では、マルチタスク学習で等変数を近似するための学習手順であるREMULを紹介する。無制約モデル（アーキテクチャに等変量性を組み込んでいない）は、追加の単純な等変量損失を最小化することで、近似的な対称性を学習できることを示す。等分散を新たな学習目標として定式化することで、モデル中の近似的な等分散のレベルを制御することができる。本手法は、等変量ベースラインと比較して、推論で\$10 ㎟、学習で\$2.5 ㎟の高速化を実現し、競争力のある性能を達成した。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\4ZMGAFXW\\Elhag et al. - 2024 - Relaxed Equivariance via Multitask Learning.pdf;C\:\\Users\\furuh\\Zotero\\storage\\V55Z7MJ6\\2410.html}
}

@inproceedings{enouenSparseInteractionAdditive2022,
  title = {Sparse {{Interaction Additive Networks}} via {{Feature Interaction Detection}} and {{Sparse Selection}}},
  booktitle = {Proceedings of {{International Conference}} on {{Advances}} in {{Neural Information Processing Systems}}},
  author = {Enouen, James and Liu, Yan},
  year = {2022},
  month = may,
  urldate = {2023-10-14},
  abstract = {There is currently a large gap in performance between the statistically rigorous methods like linear regression or additive splines and the powerful deep methods using neural networks. Previous works attempting to close this gap have failed to fully consider the exponentially growing number of feature combinations which deep networks consider automatically during training. In this work, we develop a tractable selection algorithm to efficiently identify the necessary feature combinations by leveraging techniques in feature interaction detection. Our proposed Sparse Interaction Additive Networks (SIAN) construct a bridge from these simple and interpretable models to a fully connected neural network. SIAN achieves competitive performance against state-of-the-art methods across multiple large-scale tabular datasets and consistently finds an optimal tradeoff between the modeling capacity of neural networks and the generalizability of simpler methods.},
  langid = {english},
  annotation = {abstractTranslation: 現在、線形回帰や加法スプラインのような統計的に厳密な手法と、ニューラルネットワークを用いた強力な深層手法との間には、性能に大きなギャップがある。このギャップを埋めようとするこれまでの研究は、ディープネットワークが学習中に自動的に考慮する指数関数的に増加する特徴の組み合わせを十分に考慮できていない。本研究では、特徴の相互作用検出の技術を活用することで、必要な特徴の組み合わせを効率的に特定する、扱いやすい選択アルゴリズムを開発する。我々の提案するスパース相互作用加法ネットワーク（SIAN）は、これらの単純で解釈可能なモデルから完全連結ニューラルネットワークへの橋渡しを構築する。SIANは、複数の大規模な表形式データセットにおいて、最先端の手法に対して競争力のある性能を達成し、ニューラルネットワークのモデル化能力と、より単純な手法の汎化可能性との間の最適なトレードオフを一貫して見出す。},
  file = {C:\Users\furuh\Zotero\storage\VNR9AZ5Q\Enouen and Liu - 2022 - Sparse Interaction Additive Networks via Feature I.pdf}
}

@article{ergenConvexifyingTransformersImproving2022,
  title = {Convexifying {{Transformers}}: {{Improving}} Optimization and Understanding of Transformer Networks},
  shorttitle = {Convexifying {{Transformers}}},
  author = {Ergen, Tolga and Neyshabur, Behnam and Mehta, Harsh},
  year = {2022},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2211.11052},
  urldate = {2023-11-29},
  abstract = {Understanding the fundamental mechanism behind the success of transformer networks is still an open problem in the deep learning literature. Although their remarkable performance has been mostly attributed to the self-attention mechanism, the literature still lacks a solid analysis of these networks and interpretation of the functions learned by them. To this end, we study the training problem of attention/transformer networks and introduce a novel convex analytic approach to improve the understanding and optimization of these networks. Particularly, we first introduce a convex alternative to the self-attention mechanism and reformulate the regularized training problem of transformer networks with our alternative convex attention. Then, we cast the reformulation as a convex optimization problem that is interpretable and easier to optimize. Moreover, as a byproduct of our convex analysis, we reveal an implicit regularization mechanism, which promotes sparsity across tokens. Therefore, we not only improve the optimization of attention/transformer networks but also provide a solid theoretical understanding of the functions learned by them. We also demonstrate the effectiveness of our theory through several numerical experiments.},
  copyright = {arXiv.org perpetual, non-exclusive license},
  keywords = {Artificial Intelligence (cs.AI),Computation and Language (cs.CL),FOS: Computer and information sciences,Machine Learning (cs.LG),Machine Learning (stat.ML)},
  file = {C:\Users\furuh\Zotero\storage\X7VY6C5N\Ergen et al. - 2022 - Convexifying Transformers Improving optimization .pdf}
}

@misc{ergenDemystifyingBatchNormalization2022,
  title = {Demystifying {{Batch Normalization}} in {{ReLU Networks}}: {{Equivalent Convex Optimization Models}} and {{Implicit Regularization}}},
  shorttitle = {Demystifying {{Batch Normalization}} in {{ReLU Networks}}},
  author = {Ergen, Tolga and Sahiner, Arda and Ozturkler, Batu and Pauly, John and Mardani, Morteza and Pilanci, Mert},
  year = {2022},
  month = mar,
  number = {arXiv:2103.01499},
  eprint = {2103.01499},
  primaryclass = {cs, math, stat},
  publisher = {arXiv},
  urldate = {2022-10-09},
  abstract = {Batch Normalization (BN) is a commonly used technique to accelerate and stabilize training of deep neural networks. Despite its empirical success, a full theoretical understanding of BN is yet to be developed. In this work, we analyze BN through the lens of convex optimization. We introduce an analytic framework based on convex duality to obtain exact convex representations of weight-decay regularized ReLU networks with BN, which can be trained in polynomial-time. Our analyses also show that optimal layer weights can be obtained as simple closed-form formulas in the high-dimensional and/or overparameterized regimes. Furthermore, we find that Gradient Descent provides an algorithmic bias effect on the standard non-convex BN network, and we design an approach to explicitly encode this implicit regularization into the convex objective. Experiments with CIFAR image classification highlight the effectiveness of this explicit regularization for mimicking and substantially improving the performance of standard BN networks.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning,Mathematics - Optimization and Control,Statistics - Machine Learning},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\ZTZ8RC9A\\Ergen et al_2022_Demystifying Batch Normalization in ReLU Networks.pdf;C\:\\Users\\furuh\\Zotero\\storage\\MTVETE7P\\2103.html}
}

@misc{ergenGlobalOptimalityTwo2022,
  title = {Global {{Optimality Beyond Two Layers}}: {{Training Deep ReLU Networks}} via {{Convex Programs}}},
  shorttitle = {Global {{Optimality Beyond Two Layers}}},
  author = {Ergen, Tolga and Pilanci, Mert},
  year = {2022},
  month = jan,
  number = {arXiv:2110.05518},
  eprint = {2110.05518},
  primaryclass = {cs, stat},
  publisher = {arXiv},
  urldate = {2022-10-09},
  abstract = {Understanding the fundamental mechanism behind the success of deep neural networks is one of the key challenges in the modern machine learning literature. Despite numerous attempts, a solid theoretical analysis is yet to be developed. In this paper, we develop a novel unified framework to reveal a hidden regularization mechanism through the lens of convex optimization. We first show that the training of multiple threelayer ReLU sub-networks with weight decay regularization can be equivalently cast as a convex optimization problem in a higher dimensional space, where sparsity is enforced via a group 1norm regularization. Consequently, ReLU networks can be interpreted as high dimensional feature selection methods. More importantly, we then prove that the equivalent convex problem can be globally optimized by a standard convex optimization solver with a polynomial-time complexity with respect to the number of samples and data dimension when the width of the network is fixed. Finally, we numerically validate our theoretical results via experiments involving both synthetic and real datasets.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computational Complexity,Computer Science - Machine Learning,Statistics - Machine Learning},
  file = {C:\Users\furuh\Zotero\storage\8XMV8AJY\Ergen_Pilanci_2022_Global Optimality Beyond Two Layers.pdf}
}

@misc{ergenImplicitConvexRegularizers2021,
  title = {Implicit {{Convex Regularizers}} of {{CNN Architectures}}: {{Convex Optimization}} of {{Two-}} and {{Three-Layer Networks}} in {{Polynomial Time}}},
  shorttitle = {Implicit {{Convex Regularizers}} of {{CNN Architectures}}},
  author = {Ergen, Tolga and Pilanci, Mert},
  year = {2021},
  month = mar,
  number = {arXiv:2006.14798},
  eprint = {2006.14798},
  primaryclass = {cs, stat},
  publisher = {arXiv},
  urldate = {2022-09-26},
  abstract = {We study training of Convolutional Neural Networks (CNNs) with ReLU activations and introduce exact convex optimization formulations with a polynomial complexity with respect to the number of data samples, the number of neurons, and data dimension. More specifically, we develop a convex analytic framework utilizing semi-infinite duality to obtain equivalent convex optimization problems for several two- and three-layer CNN architectures. We first prove that two-layer CNNs can be globally optimized via an \${\textbackslash}ell\_2\$ norm regularized convex program. We then show that multi-layer circular CNN training problems with a single ReLU layer are equivalent to an \${\textbackslash}ell\_1\$ regularized convex program that encourages sparsity in the spectral domain. We also extend these results to three-layer CNNs with two ReLU layers. Furthermore, we present extensions of our approach to different pooling methods, which elucidates the implicit architectural bias as convex regularizers.},
