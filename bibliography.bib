@misc{ginceNeuroTorchPythonLibrary2024,
  title = {{{NeuroTorch}}: {{A Python}} Library for Neuroscience-Oriented Machine Learning},
  shorttitle = {{{NeuroTorch}}},
  author = {Gince, J{\'e}r{\'e}mie and Drouin, Anthony and Desrosiers, Patrick and Hardy, Simon V.},
  year = {2024},
  month = dec,
  primaryclass = {New Results},
  pages = {2024.12.29.630683},
  publisher = {bioRxiv},
  doi = {10.1101/2024.12.29.630683},
  urldate = {2024-12-31},
  abstract = {Machine learning (ML) has become a powerful tool for data analysis, leading to significant advances in neuroscience research. While ML algorithms are proficient in general-purpose tasks, their highly technical nature often hinders their compatibility with the observed biological principles and constraints in the brain, thereby limiting their suitability for neuroscience applications. In this work, we introduce NeuroTorch, a comprehensive ML pipeline specifically designed to assist neuroscientists in leveraging ML techniques using biologically inspired neural network models. NeuroTorch enables the training of recurrent neural networks equipped with either spiking or firing-rate dynamics, incorporating additional biological constraints such as Dale's law and synaptic excitatory-inhibitory balance. The pipeline offers various learning methods, including backpropagation through time and eligibility trace forward propagation, aiming to allow neuroscientists to effectively employ ML approaches. To evaluate the performance of NeuroTorch, we conducted experiments on well-established public datasets for classification tasks, namely MNIST, Fashion-MNIST, and Heidelberg. Notably, NeuroTorch achieved accuracies that replicated the results obtained using the Norse and SpyTorch packages. Additionally, we tested NeuroTorch on real neuronal activity data obtained through volumetric calcium imaging in larval zebrafish. On training sets representing 9.3 minutes of activity under darkflash stimuli from 522 neurons, the mean proportion of variance explained for the spiking and firing-rate neural network models, subject to Dale's law, exceeded 0.97 and 0.96, respectively. Our analysis of networks trained on these datasets indicates that both Dale's law and spiking dynamics have a beneficial impact on the resilience of network models when subjected to connection ablations. NeuroTorch provides an accessible and well-performing tool for neuroscientists, granting them access to state-of-the-art ML models used in the field without requiring in-depth expertise in computer science.},
  archiveprefix = {bioRxiv},
  chapter = {New Results},
  copyright = {{\copyright} 2024, Posted by Cold Spring Harbor Laboratory. The copyright holder for this pre-print is the author. All rights reserved. The material may not be redistributed, re-used or adapted without the author's permission.},
  langid = {english},
  annotation = {abstractTranslation: 機械学習 (ML) はデータ分析の強力なツールとなり、神経科学研究の大幅な進歩につながりました。 ML アルゴリズムは汎用タスクには優れていますが、その高度な技術的性質により、観察された脳内の生物学的原理や制約との互換性が妨げられることが多く、そのため神経科学アプリケーションへの適合性が制限されます。この研究では、神経科学者が生物学にヒントを得たニューラル ネットワーク モデルを使用して ML 技術を活用できるように特別に設計された包括的な ML パイプラインである NeuroTorch を紹介します。 NeuroTorch を使用すると、デールの法則やシナプスの興奮性と抑制性のバランスなどの追加の生物学的制約を組み込んだ、スパイクまたは発火率ダイナミクスを備えたリカレント ニューラル ネットワークのトレーニングが可能になります。このパイプラインは、神経科学者が ML アプローチを効果的に採用できるようにすることを目的として、時間による逆伝播や適格性トレース順伝播などのさまざまな学習方法を提供します。 NeuroTorch のパフォーマンスを評価するために、分類タスク用の確立された公開データセット、つまり MNIST、Fashion-MNIST、および Heidelberg で実験を実施しました。特に、NeuroTorch は、Norse および SpyTorch パッケージを使用して得られた結果を再現する精度を達成しました。さらに、ゼブラフィッシュ幼生の体積カルシウムイメージングを通じて得られた実際の神経活動データに対して NeuroTorch をテストしました。 522 個のニューロンからのダークフラッシュ刺激下での 9.3 分間の活動を表すトレーニング セットでは、デールの法則に従い、スパイクおよび発火率ニューラル ネットワーク モデルについて説明された分散の平均割合は、それぞれ 0.97 および 0.96 を超えました。これらのデータセットでトレーニングされたネットワークの分析では、デールの法則とスパイキング ダイナミクスの両方が、接続ア\hspace{0pt}\hspace{0pt}ブレーションを受けた場合のネットワーク モデルの復元力に有益な影響を与えることが示されています。 NeuroTorch は、神経科学者にアクセスしやすく優れたパフォーマンスのツールを提供し、コンピューター サイエンスの深い専門知識を必要とせずに、現場で使用される最先端の ML モデルにアクセスできるようにします。},
  file = {C:\Users\furuh\Zotero\storage\VQHMJRD5\Gince et al. - 2024 - NeuroTorch A Python library for neuroscience-oriented machine learning.pdf}
}

@misc{giovannelliLimitationNeuralNets2023,
  title = {The Limitation of Neural Nets for Approximation and Optimization},
  author = {Giovannelli, Tommaso and Sohab, Oumaima and Vicente, Luis Nunes},
  year = {2023},
  month = nov,
  number = {arXiv:2311.12253},
  eprint = {2311.12253},
  primaryclass = {cs, math, stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2311.12253},
  urldate = {2023-11-24},
  abstract = {We are interested in assessing the use of neural networks as surrogate models to approximate and minimize objective functions in optimization problems. While neural networks are widely used for machine learning tasks such as classification and regression, their application in solving optimization problems has been limited. Our study begins by determining the best activation function for approximating the objective functions of popular nonlinear optimization test problems, and the evidence provided shows that{\textasciitilde}SiLU has the best performance. We then analyze the accuracy of function value, gradient, and Hessian approximations for such objective functions obtained through interpolation/regression models and neural networks. When compared to interpolation/regression models, neural networks can deliver competitive zero- and first-order approximations (at a high training cost) but underperform on second-order approximation. However, it is shown that combining a neural net activation function with the natural basis for quadratic interpolation/regression can waive the necessity of including cross terms in the natural basis, leading to models with fewer parameters to determine. Lastly, we provide evidence that the performance of a state-of-the-art derivative-free optimization algorithm can hardly be improved when the gradient of an objective function is approximated using any of the surrogate models considered, including neural networks.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning,Mathematics - Optimization and Control,Statistics - Machine Learning}
}

@article{giraldoReconstructionTimeVaryingGraph2022,
  title = {Reconstruction of {{Time-Varying Graph Signals}} via {{Sobolev Smoothness}}},
  author = {Giraldo, Jhony H. and Mahmood, Arif and {Garcia-Garcia}, Belmar and Thanou, Dorina and Bouwmans, Thierry},
