@article{gaoIterativeProjectionMeets2023,
  title = {Iterative Projection Meets Sparsity Regularization: Towards Practical Single-Shot Quantitative Phase Imaging with in-Line Holography},
  shorttitle = {Iterative Projection Meets Sparsity Regularization},
  author = {Gao, Yunhui and Cao, Liangcai},
  year = {2023},
  month = feb,
  journal = {Light: Advanced Manufacturing},
  volume = {4},
  number = {1},
  pages = {37--53},
  publisher = {Light: Advanced Manufacturing},
  issn = {2689-9620},
  doi = {10.37188/lam.2023.006},
  urldate = {2024-12-09},
  abstract = {Holography provides access to the optical phase. The emerging compressive phase retrieval approach can achieve in-line holographic imaging beyond the information-theoretic limit or even from a single shot by exploring the signal priors. However, iterative projection methods based on physical knowledge of the wavefield suffer from poor imaging quality, whereas the regularization techniques sacrifice robustness for fidelity. In this work, we present a unified compressive phase retrieval framework for in-line holography that encapsulates the unique advantages of both physical constraints and sparsity priors. In particular, a constrained complex total variation (CCTV) regularizer is introduced that explores the well-known absorption and support constraints together with sparsity in the gradient domain, enabling practical high-quality in-line holographic imaging from a single intensity image. We developed efficient solvers based on the proximal gradient method for the non-smooth regularized inverse problem and the corresponding denoising subproblem. Theoretical analyses further guarantee the convergence of the algorithms with prespecified parameters, obviating the need for manual parameter tuning. As both simulated and optical experiments demonstrate, the proposed CCTV model can characterize complex natural scenes while utilizing physically tractable constraints for quality enhancement. This new compressive phase retrieval approach can be extended, with minor adjustments, to various imaging configurations, sparsifying operators, and physical knowledge. It may cast new light on both theoretical and empirical studies.},
  langid = {american},
  annotation = {abstractTranslation: ホログラフィは光位相へのアクセスを提供する。新たな圧縮位相検索アプローチは、信号プリオールを探索することにより、情報理論的限界を超えた、あるいはシングルショットからのインラインホログラフィックイメージングを達成することができる。しかしながら、波面の物理的知識に基づく反復投影法はイメージング品質の低さに悩まされ、一方、正則化技術はロバスト性を忠実性のために犠牲にしている。本研究では、インラインホログラフィのための統一的な圧縮位相検索フレームワークを提示し、物理的制約とスパース性事前分布の両方のユニークな利点をカプセル化する。特に、勾配領域におけるスパース性とともに、よく知られた吸収・支持制約を探索する制約付き複素全変動（CCTV）正則化器を導入し、単一の強度画像からの実用的な高品質インラインホログラフィックイメージングを可能にする。非平滑正則化逆問題と対応するノイズ除去部分問題に対して、近接勾配法に基づく効率的なソルバーを開発した。さらに、理論的解析により、あらかじめ指定したパラメータによるアルゴリズムの収束を保証し、手動によるパラメータチューニングの必要性を排除した。シミュレーションと光学実験の両方が示すように、提案されたCCTVモデルは、品質向上のために物理的に扱いやすい制約を利用しながら、複雑な自然シーンを特徴付けることができる。この新しい圧縮位相検索アプローチは、微調整により、様々な画像構成、スパース化演算子、物理的知識に拡張可能である。理論的、実証的研究の両方に新しい光を投げかけることができるだろう。},
  file = {C:\Users\furuh\Zotero\storage\276CIRPP\Gao と Cao - 2023 - Iterative projection meets sparsity regularization towards practical single-shot quantitative phase.pdf}
}

@inproceedings{gaoLossFunctionLearning2022,
  title = {Loss {{Function Learning}} for {{Domain Generalization}} by {{Implicit Gradient}}},
  booktitle = {International {{Conference}} on {{Machine Learning}}},
  author = {Gao, Boyan and Gouk, H. and Yang, Yongxin and Hospedales, Timothy M.},
  year = {2022},
  urldate = {2024-01-14},
  abstract = {Generalising robustly to distribution shift is a ma-jor challenge that is pervasive across most real-world applications of machine learning. A recent study highlighted that many advanced algorithms proposed to tackle such domain generalisation (DG) fail to outperform a properly tuned empirical risk minimisation (ERM) baseline. We take a different approach, and explore the impact of the ERM loss function on out-of-domain generalisation. In particular, we introduce a novel meta-learning approach to loss function search based on implicit gradient. This enables us to discover a general purpose parametric loss function that provides a drop-in replacement for cross-entropy. Our loss can be used in standard training pipelines to efficiently train robust models using any neural architecture on new datasets. The results show that it clearly surpasses cross-entropy, enables simple ERM to outperform some more compli-cated prior DG methods, and provides excellent performance across a variety of DG benchmarks. Furthermore, unlike most existing DG approaches, our setup applies to the most practical setting of single-source domain generalisation, on which we show significant improvement.},
  keywords = {No DOI found}
}

@misc{gaoMoreauEnvelopeBased2024,
  title = {Moreau {{Envelope Based Difference-of-weakly-Convex Reformulation}} and {{Algorithm}} for {{Bilevel Programs}}},
  author = {Gao, Lucy L. and Ye, Jane J. and Yin, Haian and Zeng, Shangzhi and Zhang, Jin},
  year = {2024},
  month = jan,
  number = {arXiv:2306.16761},
  eprint = {2306.16761},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2306.16761},
  urldate = {2025-02-04},
  abstract = {Bilevel programming has emerged as a valuable tool for hyperparameter selection, a central concern in machine learning. In a recent study by Ye et al. (2023), a value function-based difference of convex algorithm was introduced to address bilevel programs. This approach proves particularly powerful when dealing with scenarios where the lower-level problem exhibits convexity in both the upper-level and lower-level variables. Examples of such scenarios include support vector machines and \${\textbackslash}ell\_1\$ and \${\textbackslash}ell\_2\$ regularized regression. In this paper, we significantly expand the range of applications, now requiring convexity only in the lower-level variables of the lower-level program. We present an innovative single-level difference of weakly convex reformulation based on the Moreau envelope of the lower-level problem. We further develop a sequentially convergent Inexact Proximal Difference of Weakly Convex Algorithm (iP-DwCA). To evaluate the effectiveness of the proposed iP-DwCA, we conduct numerical experiments focused on tuning hyperparameters for kernel support vector machines on simulated data.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Machine Learning,Mathematics - Optimization and Control},
  annotation = {abstractTranslation: Bilevelプログラミングは、機械学習の中心的な関心事であるハイパーパラメーター選択のための貴重なツールとして浮上しています。 Ye et alによる最近の研究で。 （2023）、凸アルゴリズムの値関数ベースの違いが導入され、Bilevelプログラムに対処しました。このアプローチは、低レベルの問題が上位レベルと低レベルの両方の変数の両方で凸性を示すシナリオを扱う際に特に強力であることが証明されています。このようなシナリオの例には、サポートベクターマシンと\$ {\textbackslash} ell\_1 \$および\$ {\textbackslash} ell\_2 \$の正規化回帰が含まれます。このホワイトペーパーでは、アプリケーションの範囲を大幅に拡大し、現在、低レベルプログラムの低レベル変数でのみ凸性が必要です。低レベルの問題のモローエンベロープに基づいて、弱く凸型の再編成の革新的な単一レベルの違いを提示します。さらに、弱く凸アルゴリズム（IP-DWCA）の連続的に収束的な不正確な近位差を発達させます。提案されたIP-DWCAの有効性を評価するために、シミュレーションデータのカーネルサポートベクターマシンのハイパーパラメーターの調整に焦点を当てた数値実験を実施します。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\2KPP6AF6\\Gao et al. - 2024 - Moreau Envelope Based Difference-of-weakly-Convex Reformulation and Algorithm for Bilevel Programs.pdf;C\:\\Users\\furuh\\Zotero\\storage\\B5F6HXN6\\2306.html}
}

@article{GaoQiaoTeZhengLiangnoTeZhengLiangniyoruTeZhengLiangnoDongDeXuanZe2024,
  title = {特徴量の特徴量による特徴量の動的選択},
  author = {高橋, 克望 and 竹内, 孝 and 鹿島, 久嗣},
