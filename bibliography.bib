}

@article{liuBackgroundSubtractionBased2015,
  title = {Background {{Subtraction Based}} on {{Low-Rank}} and {{Structured Sparse Decomposition}}},
  author = {Liu, Xin and Zhao, Guoying and Yao, Jiawen and Qi, Chun},
  year = {2015},
  month = aug,
  journal = {IEEE Transactions on Image Processing},
  volume = {24},
  number = {8},
  pages = {2502--2514},
  issn = {1057-7149, 1941-0042},
  doi = {10.1109/TIP.2015.2419084},
  urldate = {2024-07-19},
  abstract = {Low rank and sparse representation based methods, which make few specific assumptions about the background, have recently attracted wide attention in background modeling. With these methods, moving objects in the scene are modeled as pixel-wised sparse outliers. However, in many practical scenarios, the distributions of these moving parts are not truly pixel-wised sparse but structurally sparse. Meanwhile a robust analysis mechanism is required to handle background regions or foreground movements with varying scales. Based on these two observations, we first introduce a class of structured sparsity-inducing norms to model moving objects in videos. In our approach, we regard the observed sequence as being constituted of two terms, a low-rank matrix (background) and a structured sparse outlier matrix (foreground). Next, in virtue of adaptive parameters for dynamic videos, we propose a saliency measurement to dynamically estimate the support of the foreground. Experiments on challenging well known data sets demonstrate that the proposed approach outperforms the state-of-the-art methods and works effectively on a wide range of complex videos.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {english},
  annotation = {abstractTranslation:  低ランクとスパース表現に基づく手法は、背景に関する特定の仮定をほとんど必要としないため、背景モデリングにおいて最近広く注目されている。これらの手法では、シーン中の動く物体はピクセル化された疎な外れ値としてモデル化される。しかし、多くの実用的なシナリオにおいて、これらの動く部分の分布は、真にピクセル化されたスパースではなく、構造的にスパースである。一方、様々なスケールを持つ背景領域や前景の動きを扱うためには、ロバストな解析メカニズムが必要である。これら2つの観察に基づき、我々はまず、動画中の動く物体をモデル化するための、構造的スパース性を誘導する規範のクラスを導入する。我々のアプローチでは、観測されたシーケンスを、低ランク行列（背景）と構造化スパース外れ値行列（前景）の2項から構成されるとみなす。次に、動的な動画に対する適応的なパラメータにより、前景のサポートを動的に推定するための顕著性測定を提案する。よく知られた困難なデータセットを用いた実験により、提案手法が最先端の手法を凌駕し、様々な複雑な動画に対して効果的に機能することを示す。},
  file = {C:\Users\furuh\Zotero\storage\QKWUQJEI\xinliu2015.pdf.pdf}
}

@article{liuBackgroundSubtractionUsing2018,
  title = {Background {{Subtraction Using Spatio-Temporal Group Sparsity Recovery}}},
  author = {Liu, Xin and Yao, Jiawen and Hong, Xiaopeng and Huang, Xiaohua and Zhou, Ziheng and Qi, Chun and Zhao, Guoying},
  year = {2018},
  month = aug,
  journal = {IEEE Transactions on Circuits and Systems for Video Technology},
  volume = {28},
  number = {8},
  pages = {1737--1751},
  issn = {1051-8215, 1558-2205},
  doi = {10.1109/TCSVT.2017.2697972},
  urldate = {2024-07-19},
  abstract = {Background subtraction is a key step in a wide spectrum of video applications, such as object tracking and human behavior analysis. Compressive sensing-based methods, which make little specific assumptions about the background, have recently attracted wide attention in background subtraction. Within the framework of compressive sensing, background subtraction is solved as a decomposition and optimization problem, where the foreground is typically modeled as pixel-wised sparse outliers. However, in real videos, foreground pixels are often not randomly distributed, but instead, group clustered. Moreover, due to costly computational expenses, most compressive sensing-based methods are unable to process frames online. In this paper, we take into account the group properties of foreground signals in both spatial and temporal domains, and propose a greedy pursuit-based method called spatio-temporal group sparsity recovery, which prunes data residues in an iterative process, according to both sparsity and group clustering priors, rather than merely sparsity. Furthermore, a random strategy for background dictionary learning is used to handle complex background variations, while foreground-free training is not required. Finally, we propose a two-pass framework to achieve online processing. The proposed method is validated on multiple challenging video sequences. Experiments demonstrate that our approach effectively works on a wide range of complex scenarios and achieves a state-of-the-art performance with far fewer computations.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {english},
  annotation = {abstractTranslation:  背景減算は、物体追跡や人間の行動分析など、幅広いビデオアプリケーションにおける重要なステップである。圧縮センシングに基づく手法は、背景に関する特定の仮定をほとんど必要としないため、背景減算において最近広く注目されている。圧縮センシングの枠組みでは、背景減算は分解と最適化問題として解かれ、前景は一般的にピクセル単位の疎な外れ値としてモデル化される。しかし、実際の映像では、前景ピクセルはランダムに分布しているのではなく、グループ化していることが多い。さらに、計算コストがかかるため、圧縮センシングに基づく手法の多くは、フレームをオンラインで処理することができない。本論文では、前景信号の空間領域と時間領域の両方のグループ特性を考慮し、時空間グループスパース性回復と呼ばれる、貪欲な追求に基づく方法を提案する。さらに、複雑な背景の変化に対応するため、ランダムな背景辞書学習戦略を用いる。最後に、オンライン処理を実現するために、2パスフレームワークを提案する。提案手法を複数の困難なビデオシーケンスで検証する。実験により、本アプローチが幅広い複雑なシナリオで効果的に機能し、遥かに少ない計算量で最先端の性能を達成することが実証された。},
  file = {C:\Users\furuh\Zotero\storage\CUUK4R6T\Liu et al. - 2018 - Background Subtraction Using Spatio-Temporal Group.pdf}
}

@article{liuBinaryQuantizedNetwork2023,
  title = {Binary {{Quantized Network Training With Sharpness-Aware Minimization}}},
  author = {Liu, Ren and Bian, Fengmiao and Zhang, Xiaoqun},
  year = {2023},
  month = jan,
  journal = {Journal of Scientific Computing},
  volume = {94},
  number = {1},
  pages = {16},
  issn = {0885-7474, 1573-7691},
  doi = {10.1007/s10915-022-02064-7},
  urldate = {2023-12-01},
  abstract = {The quantized neural network is a common way to improve inference and memory efficiency for deep learning methods. However, it is challenging to solve this optimization problem with good generalization due to its high nonlinearity and nonconvexity. This paper proposes an algorithm to train one-bit quantization neural networks based on sharpness-aware minimization Foret et al. (Sharpness-aware minimization for efficiently improving generalization, 2021) with two types of gradient approximation. The idea is to improve the generalization by finding a local minimum of a flat landscape of both continuous and quantized neural network loss. The convergence theory is partially established under a one-bit quantization setting. Experiments on the CIFAR-10 Krizhevsky (Learning multiple layers of features from tiny images, 2009) and SVHN Netzer et al. (Reading digits in natural images with unsupervised feature learning, 2011) datasets show improvement in generalization with the proposed algorithm compared to other state-of-the-art quantized training methods.},
  langid = {english}
}

@article{liuBiRealNetEnhancing2018,
  title = {Bi-{{Real Net}}: {{Enhancing}} the {{Performance}} of 1-{{Bit CNNs}} with {{Improved Representational Capability}} and {{Advanced Training Algorithm}}},
  shorttitle = {Bi-{{Real Net}}},
  author = {Liu, Zechun and Wu, Baoyuan and Luo, Wenhan and Yang, Xin and Liu, Wei and Cheng, Kwang-Ting},
  editor = {Ferrari, Vittorio and Hebert, Martial and Sminchisescu, Cristian and Weiss, Yair},
  year = {2018},
  journal = {Computer Vision -- ECCV 2018},
  volume = {11219},
  pages = {747--763},
  publisher = {Springer International Publishing},
  address = {Cham},
  doi = {10.1007/978-3-030-01267-0_44},
  urldate = {2023-12-01},
  abstract = {In this work, we study the 1-bit convolutional neural networks (CNNs), of which both the weights and activations are binary. While being efficient, the classification accuracy of the current 1-bit CNNs is much worse compared to their counterpart real-valued CNN models on the large-scale dataset, like ImageNet. To minimize the performance gap between the 1-bit and real-valued CNN models, we propose a novel model, dubbed Bi-Real net, which connects the real activations (after the 1-bit convolution and/or BatchNorm layer, before the sign function) to activations of the consecutive block, through an identity shortcut. Consequently, compared to the standard 1-bit CNN, the representational capability of the Bi-Real net is significantly enhanced and the additional cost on computation is negligible. Moreover, we develop a specific training algorithm including three technical novelties for 1-bit CNNs. Firstly, we derive a tight approximation to the derivative of the non-differentiable sign function with respect to activation. Secondly, we propose a magnitude-aware gradient with respect to the weight for updating the weight parameters. Thirdly, we pre-train the real-valued CNN model with a clip function, rather than the ReLU function, to better initialize the Bi-Real net. Experiments on ImageNet show that the Bi-Real net with the proposed training algorithm achieves 56.4\% and 62.2\% top-1 accuracy with 18 layers and 34 layers, respectively. Compared to the state-of-the-arts (e.g., XNOR Net), Bi-Real net achieves up to 10\% higher top-1 accuracy with more memory saving and lower computational cost.},
  isbn = {9783030012663 9783030012670},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\UW7XKKPG\Liu et al. - 2018 - Bi-Real Net Enhancing the Performance of 1-Bit CN.pdf}
}

@misc{liuBridgingDiscreteBackpropagation2023,
  title = {Bridging {{Discrete}} and {{Backpropagation}}: {{Straight-Through}} and {{Beyond}}},
  shorttitle = {Bridging {{Discrete}} and {{Backpropagation}}},
  author = {Liu, Liyuan and Dong, Chengyu and Liu, Xiaodong and Yu, Bin and Gao, Jianfeng},
  year = {2023},
  month = apr,
  number = {arXiv:2304.08612},
  eprint = {2304.08612},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2304.08612},
  urldate = {2023-07-04},
  abstract = {Backpropagation, the cornerstone of deep learning, is limited to computing gradients solely for continuous variables. This limitation hinders various research on problems involving discrete latent variables. To address this issue, we propose a novel approach for approximating the gradient of parameters involved in generating discrete latent variables. First, we examine the widely used Straight-Through (ST) heuristic and demonstrate that it works as a first-order approximation of the gradient. Guided by our findings, we propose a novel method called ReinMax, which integrates Heun's Method, a second-order numerical method for solving ODEs, to approximate the gradient. Our method achieves second-order accuracy without requiring Hessian or other second-order derivatives. We conduct experiments on structured output prediction and unsupervised generative modeling tasks. Our results show that {\textbackslash}ours brings consistent improvements over the state of the art, including ST and Straight-Through Gumbel-Softmax. Implementations are released at https://github.com/microsoft/ReinMax.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computation and Language,Computer Science - Computer Vision and Pattern Recognition,Computer Science - Machine Learning},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\A5YSNR2L\\Liu et al. - 2023 - Bridging Discrete and Backpropagation Straight-Th.pdf;C\:\\Users\\furuh\\Zotero\\storage\\VWVT9WUR\\2304.html}
}

@article{liuFastAccurateMatrix2019,
  title = {A {{Fast}} and {{Accurate Matrix Completion Method Based}} on {{QR Decomposition}} and \${{L}}\_\{2,1\}\$ -{{Norm Minimization}}},
  author = {Liu, Qing and Davoine, Franck and Yang, Jian and Cui, Ying and Jin, Zhong and Han, Fei},
  year = {2019},
  month = mar,
  journal = {IEEE Transactions on Neural Networks and Learning Systems},
  volume = {30},
  number = {3},
  pages = {803--817},
  issn = {2162-237X, 2162-2388},
  doi = {10.1109/TNNLS.2018.2851957},
  urldate = {2023-12-03},
  abstract = {Low-rank matrix completion aims to recover matrices with missing entries and has attracted considerable attention from machine learning researchers. Most of the existing methods, such as weighted nuclear-norm-minimization-based methods and Qatar Riyal (QR)-decomposition-based methods, cannot provide both convergence accuracy and convergence speed. To investigate a fast and accurate completion method, an iterative QR-decomposition-based method is proposed for computing an approximate singular value decomposition. This method can compute the largest {$<$}inline-formula{$>$} {$<$}tex-math notation="LaTeX"{$>\$$}r (r{$>$}0)\$ {$<$}/tex-math{$><$}/inline-formula{$>$} singular values of a matrix by iterative QR decomposition. Then, under the framework of matrix trifactorization, a method for computing an approximate SVD based on QR decomposition (CSVD-QR)-based {$<$}inline-formula{$>$} {$<$}tex-math notation="LaTeX"{$>\$$}L\_\{2,1\}\$ {$<$}/tex-math{$><$}/inline-formula{$>$}-norm minimization method (LNM-QR) is proposed for fast matrix completion. Theoretical analysis shows that this QR-decomposition-based method can obtain the same optimal solution as a nuclear norm minimization method, i.e., the {$<$}inline-formula{$>$} {$<$}tex-math notation="LaTeX"{$>\$$}L\_\{2,1\}\$ {$<$}/tex-math{$><$}/inline-formula{$>$}-norm of a submatrix can converge to its nuclear norm. Consequently, an LNM-QR-based iteratively reweighted {$<$}inline-formula{$>$} {$<$}tex-math notation="LaTeX"{$>\$$}L\_\{2,1\}\$ {$<$}/tex-math{$><$}/inline-formula{$>$}-norm minimization method (IRLNM-QR) is proposed to improve the accuracy of LNM-QR. Theoretical analysis shows that IRLNM-QR is as accurate as an iteratively reweighted nuclear norm minimization method, which is much more accurate than the traditional QR-decomposition-based matrix completion methods. Experimental results {$<$}italic{$>$}obtained{$<$}/italic{$>$} on both synthetic and real-world visual data sets show that our methods are much faster and more accurate than the state-of-the-art methods.},
  file = {C:\Users\furuh\Zotero\storage\9MPKBKRZ\Liu et al. - 2019 - A Fast and Accurate Matrix Completion Method Based.pdf}
}

@inproceedings{liuGenerativeAugmentedDeepMatrix2025,
  title = {A {{Generative-Augmented Deep Matrix Factorization Model}} for {{POI Recommendations}}},
  booktitle = {{{ICASSP}} 2025 - 2025 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {Liu, Chunyu and Zhang, Hongli and Tian, Zeshu and Zhang, JiaYu},
  year = {2025},
  month = apr,
  pages = {1--5},
  issn = {2379-190X},
  doi = {10.1109/ICASSP49660.2025.10890082},
  urldate = {2025-03-14},
  abstract = {Deep matrix factorization has become a pivotal technique for Point of Interest (POI) recommendations, effectively capturing complex user-POI interactions to improve user experiences. However, these systems often face challenges such as data sparsity and the geographical constraints of POIs. To address these limitations, we propose the Geographical Generative-Augmented Deep Matrix Factorization (GeoGMF) model, which integrates deep matrix factorization with a generative augmented network. This model incorporates the learning of user geographical information, including function impacts and transfer costs, while mitigating data sparsity through two novel strategies involving augmented optimization of matrix sampling and matrix update generation. Experiments on real-world datasets demonstrate that our proposed model outperforms existing methods across multiple evaluation metrics.},
  langid = {english},
  keywords = {Acoustics,Adaptation models,Costs,Data models,deep matrix factorization,Faces,generative augmented network,Measurement,Optimization,POI recommendation,Real-time systems,Signal processing,Speech processing},
  annotation = {abstractTranslation: ディープマトリックスの因数分解は、関心のあるポイント（POI）の推奨事項のための極めて重要な手法となり、複雑なユーザーPOIインタラクションを効果的にキャプチャしてユーザーエクスペリエンスを向上させます。ただし、これらのシステムは、データスパースやPOIの地理的制約などの課題に直面することがよくあります。これらの制限に対処するために、深いマトリックス因数分解を生成拡張ネットワークと統合する地理的生成熟成ディープマトリックス因数分解（GEOGMF）モデルを提案します。このモデルには、関数の影響や転送コストなど、ユーザーの地理情報の学習が組み込まれていますが、マトリックスサンプリングとマトリックス更新生成の拡張最適化を含む2つの新しい戦略を通じてデータスパース性を軽減します。実際のデータセットでの実験は、提案されたモデルが複数の評価メトリックにわたって既存のメソッドを上回ることを示しています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\VMZNZRVT\\Liu et al. - 2025 - A Generative-Augmented Deep Matrix Factorization Model for POI Recommendations.pdf;C\:\\Users\\furuh\\Zotero\\storage\\F5WTLP9E\\10890082.html}
}

@misc{liuGroupSparsityExtension2023,
  type = {{{SSRN Scholarly Paper}}},
  title = {Group {{Sparsity Extension}} of `` {{Non-Convex Sparse Regularization Via Convex Optimization}} for {{Impact Force Identification}} ''},
  author = {Liu, Junjiang and Qiao, Baijie and Wang, Yanan and He, Weifeng and Chen, Xuefeng},
  year = {2023},
  month = apr,
  number = {4431448},
  eprint = {4431448},
  publisher = {Social Science Research Network},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.4431448},
  urldate = {2025-05-15},
  abstract = {We recently proposed a non-convex sparse regularization method in the ADMM framework to reconstruct and localize unknown impact forces. This method surpasses the convex L1 regularization not only in inducing sparsity but also in avoiding the high-amplitude underestimation of solutions. In this work, we aim to improve the identification performance and enable the monitoring of unknown impact forces with fewer sensors by incorporating prior information in the form of natural grouping of the solution components. To achieve this, we extend our previous work on non-convex sparse regularization by incorporating group information into the method. The resulting group sparsity problem is challenging to solve due to the mixed structure and possible grouping irregularity. To address this, we develop an efficient ADMM solver in a grouped manner, featuring a novel shrinkage operator.~ We validate our approach both numerically and experimentally on aircraft-like composite laminated plates. Our case studies demonstrate that the proposed method achieves high accuracy and strong robustness in impact localization and time-history reconstruction from single-sensor-based measurements. 私たちは最近、未知の衝撃力を再構成して位置を特定するために、ADMMフレームワークに非凸スパース正則化法を提案しました。この方法は、スパース性を誘発するだけでなく、解の高振幅過小評価を回避する点でも、凸型L1正則化を上回っています。この作業では、識別性能を向上させ、ソリューションコンポーネントの自然なグループ化という形で事前情報を組み込むことにより、より少ないセンサーで未知の衝撃力を監視できるようにすることを目指しています。これを達成するために、グループ情報をメソッドに組み込むことにより、非凸スパース正則化に関する以前の研究を拡張します。結果として生じるグループスパース性の問題は、混合構造とグループ化の不規則性の可能性のために解決するのが困難です。これに対処するために、新しい収縮演算子を特徴とする、グループ化された効率的なADMMソルバーを開発します。 私たちは、航空機のような複合積層板で、数値的にも実験的にもアプローチを検証しています。私たちのケーススタディでは、提案手法が単一センサベースの測定から衝撃の定位と時刻歴の再構成において高い精度と強力なロバスト性を達成していることを示しています。},
  archiveprefix = {Social Science Research Network},
  langid = {english},
  keywords = {Alternating direction method of multipliers.,Group structured sparsity,Impact force Identification,Non-convex optimization},
  annotation = {abstractTranslation: 我々は最近、未知の衝撃力を再構成し位置特定するために、ADMMフレームワークにおける非凸スパース正則化法を提案した。この方法は、スパース性の誘導だけでなく、解の高振幅過小評価の回避においても、凸L1正則化を凌駕する。本研究では、解成分の自然なグループ化という事前情報を組み込むことで、識別性能の向上を図り、より少ないセンサ数で未知の衝撃力をモニタリングすることを目指す。これを達成するため、グループ情報を手法に組み込むことで、我々の以前の非凸スパース正則化に関する研究を拡張する。結果として生じるグループスパース性の問題は、混合構造とグループ化の不規則性のために解決が困難である。これに対処するため、新規な縮小演算子を特徴とするグループ化された効率的なADMMソルバーを開発する。航空機様の複合積層板を用いて、提案手法を数値的および実験的に検証する。事例研究の結果、提案手法が単一センサベースの計測から、衝撃位置の特定と時間履歴の再構成において、高い精度と強いロバスト性を達成することが示された。},
  file = {C:\Users\furuh\Zotero\storage\F2FQQG23\Liu et al. - 2023 - Group Sparsity Extension of “ Non-Convex Sparse Regularization Via Convex Optimization for Impact Fo.pdf}
}

@article{liuImageRestorationUsing2015,
  title = {Image Restoration Using Total Variation with Overlapping Group Sparsity},
  author = {Liu, Jun and Huang, Ting-Zhu and Selesnick, Ivan W. and Lv, Xiao-Guang and Chen, Po-Yu},
  year = {2015},
  month = feb,
  journal = {Information Sciences},
  volume = {295},
  pages = {232--246},
  issn = {0020-0255},
  doi = {10.1016/j.ins.2014.10.041},
  urldate = {2025-01-18},
  abstract = {Image restoration is one of the most fundamental issues in imaging science. Total variation regularization is widely used in image restoration problems for its capability to preserve edges. In the literature, however, it is also well known for producing staircase artifacts. In this work we extend the total variation with overlapping group sparsity, which we previously developed for one dimension signal processing, to image restoration. A convex cost function is given and an efficient algorithm is proposed for solving the corresponding minimization problem. In the experiments, we compare our method with several state-of-the-art methods. The results illustrate the efficiency and effectiveness of the proposed method in terms of PSNR and computing time.},
  langid = {english},
  keywords = {ADMM,Convex optimization,Image restoration,MM,Overlapping group sparsity,Total variation},
  annotation = {abstractTranslation: 画像修復は、イメージング科学の最も基本的な問題の1つです。総変動の正則化は、エッジを保存する能力のために、画像修復問題で広く使用されています。しかし、文献では、階段アーティファクトを生産することでもよく知られています。この作業では、1つの次元信号処理用に開発された重複するグループスパース性で、全体の変動を画像回復に拡張します。凸コスト関数が与えられ、対応する最小化問題を解決するために効率的なアルゴリズムが提案されています。実験では、方法をいくつかの最先端の方法と比較します。結果は、PSNRとコンピューティング時間の観点から提案された方法の効率と有効性を示しています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\XBJZG6AP\\Liu et al. - 2015 - Image restoration using total variation with overlapping group sparsity.pdf;C\:\\Users\\furuh\\Zotero\\storage\\GUQVFNMB\\S002002551401024X.html}
}

@article{liuInexactAugmentedLagrangian2022,
  title = {An {{Inexact Augmented Lagrangian Algorithm}} for {{Training Leaky ReLU Neural Network}} with {{Group Sparsity}}},
  author = {Liu, Wei and Liu, Xin and Chen, Xiaojun},
  year = {2022},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2205.05428},
  urldate = {2024-07-16},
  abstract = {The leaky ReLU network with a group sparse regularization term has been widely used in the recent years. However, training such a network yields a nonsmooth nonconvex optimization problem and there exists a lack of approaches to compute a stationary point deterministically. In this paper, we first resolve the multi-layer composite term in the original optimization problem by introducing auxiliary variables and additional constraints. We show the new model has a nonempty and bounded solution set and its feasible set satisfies the Mangasarian-Fromovitz constraint qualification. Moreover, we show the relationship between the new model and the original problem. Remarkably, we propose an inexact augmented Lagrangian algorithm for solving the new model and show the convergence of the algorithm to a KKT point. Numerical experiments demonstrate that our algorithm is more efficient for training sparse leaky ReLU neural networks than some well-known algorithms.},
  copyright = {arXiv.org perpetual, non-exclusive license},
  keywords = {FOS: Computer and information sciences,FOS: Mathematics,Machine Learning (cs.LG),Optimization and Control (math.OC)},
  file = {C:\Users\furuh\Zotero\storage\SSMU54H8\Liu et al. - 2022 - An Inexact Augmented Lagrangian Algorithm for Trai.pdf}
}

@article{liuInfraredSmallTarget2023,
  title = {Infrared {{Small Target Detection}} via {{Nonconvex Tensor Tucker Decomposition With Factor Prior}}},
  author = {Liu, Ting and Yang, Jungang and Li, Boyang and Wang, Yingqian and An, Wei},
  year = {2023},
  journal = {IEEE Transactions on Geoscience and Remote Sensing},
  volume = {61},
  pages = {1--17},
  issn = {0196-2892, 1558-0644},
  doi = {10.1109/TGRS.2023.3298192},
  urldate = {2024-09-07},
  abstract = {Infrared small target detection in complex scenes is an important but challenging research hotspot in infrared early warning fields. Previous studies have proved that low-rank Tucker decomposition (TD) achieves good detection performance in complex scenes. However, a key limitation of existing low-rank TD methods is that the rank needs to be set in advance, and an inaccurate predefined rank can lead to performance degradation. Inspired by the theorem that n-rank is upper bounded by the rank of each Tucker factor matrix, we propose a nonconvex tensor TD model with factor prior for infrared small target detection. In our method, we use a logdet-based function to constrain the latent factors of low-rank TD, which avoids empirical rank selection and sufficiently uses the latent data structure information in the factor matrix. Meanwhile, performing singular value decomposition (SVD) calculations on small factor matrices can reduce computational complexity. Then, group sparsity regularized total variation is used to better exploit the shared sparse pattern of difference images, which helps better remove background clutter and obtain better detection results. Finally, the proposed method is efficiently solved by the well-designed alternating direction method of multipliers (ADMM). Extensive experimental results demonstrate that our method is more effective and robust in complex scenes than other state-of-the-art methods.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {american},
  annotation = {abstractTranslation: 複雑なシーンにおける赤外線微小目標検出は、赤外線早期警戒分野における重要かつ挑戦的な研究ホットスポットです。これまでの研究により、低ランクTucker分解（TD）が複雑なシーンにおいて良好な検出性能を達成することが証明されています。しかし、既存の低ランクTD法の主な制限は、ランクを事前に設定する必要があることであり、不正確な事前定義ランクは性能低下につながる可能性があります。nランクが各Tucker因子行列のランクによって上限が定められるという定理に触発され、赤外線微小目標検出のための因子事前分布を持つ非凸テンソルTDモデルを提案します。本手法では、低ランクTDの潜在因子を制約するためにlogdetベースの関数を使用し、経験的なランク選択を回避し、因子行列内の潜在的なデータ構造情報を十分に活用します。一方、小さな因子行列に対して特異値分解（SVD）計算を実行することで、計算量を削減できます。次に、グループスパース正則化全変動を用いて、差分画像の共有スパースパターンをより良く利用し、背景のクラッタをより良く除去し、より良い検出結果を得ることを支援します。最後に、提案手法は、適切に設計された交互方向乗数法（ADMM）によって効率的に解かれます。広範な実験結果は、提案手法が他の最先端手法よりも複雑なシーンにおいてより効果的かつロバストであることを示しています。}
}

@misc{liuKANKolmogorovArnoldNetworks2024,
  title = {{{KAN}}: {{Kolmogorov-Arnold Networks}}},
  shorttitle = {{{KAN}}},
  author = {Liu, Ziming and Wang, Yixuan and Vaidya, Sachin and Ruehle, Fabian and Halverson, James and Solja{\v c}i{\'c}, Marin and Hou, Thomas Y. and Tegmark, Max},
  year = {2024},
  month = apr,
  number = {arXiv:2404.19756},
  eprint = {2404.19756},
  primaryclass = {cond-mat, stat},
  publisher = {arXiv},
  urldate = {2024-05-01},
  abstract = {Inspired by the Kolmogorov-Arnold representation theorem, we propose Kolmogorov-Arnold Networks (KANs) as promising alternatives to Multi-Layer Perceptrons (MLPs). While MLPs have fixed activation functions on nodes ("neurons"), KANs have learnable activation functions on edges ("weights"). KANs have no linear weights at all -- every weight parameter is replaced by a univariate function parametrized as a spline. We show that this seemingly simple change makes KANs outperform MLPs in terms of accuracy and interpretability. For accuracy, much smaller KANs can achieve comparable or better accuracy than much larger MLPs in data fitting and PDE solving. Theoretically and empirically, KANs possess faster neural scaling laws than MLPs. For interpretability, KANs can be intuitively visualized and can easily interact with human users. Through two examples in mathematics and physics, KANs are shown to be useful collaborators helping scientists (re)discover mathematical and physical laws. In summary, KANs are promising alternatives for MLPs, opening opportunities for further improving today's deep learning models which rely heavily on MLPs.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Machine Learning,Condensed Matter - Disordered Systems and Neural Networks,Statistics - Machine Learning},
  file = {C:\Users\furuh\Zotero\storage\R6UWZQ7Q\Liu et al. - 2024 - KAN Kolmogorov-Arnold Networks.pdf}
}

@misc{liuMoiraiMoEEmpoweringTime2024,
  title = {Moirai-{{MoE}}: {{Empowering Time Series Foundation Models}} with {{Sparse Mixture}} of {{Experts}}},
  shorttitle = {Moirai-{{MoE}}},
  author = {Liu, Xu and Liu, Juncheng and Woo, Gerald and Aksu, Taha and Liang, Yuxuan and Zimmermann, Roger and Liu, Chenghao and Savarese, Silvio and Xiong, Caiming and Sahoo, Doyen},
  year = {2024},
  month = oct,
  number = {arXiv:2410.10469},
  eprint = {2410.10469},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2410.10469},
  urldate = {2024-12-05},
  abstract = {Time series foundation models have demonstrated impressive performance as zero-shot forecasters. However, achieving effectively unified training on time series remains an open challenge. Existing approaches introduce some level of model specialization to account for the highly heterogeneous nature of time series data. For instance, Moirai pursues unified training by employing multiple input/output projection layers, each tailored to handle time series at a specific frequency. Similarly, TimesFM maintains a frequency embedding dictionary for this purpose. We identify two major drawbacks to this human-imposed frequency-level model specialization: (1) Frequency is not a reliable indicator of the underlying patterns in time series. For example, time series with different frequencies can display similar patterns, while those with the same frequency may exhibit varied patterns. (2) Non-stationarity is an inherent property of real-world time series, leading to varied distributions even within a short context window of a single time series. Frequency-level specialization is too coarse-grained to capture this level of diversity. To address these limitations, this paper introduces Moirai-MoE, using a single input/output projection layer while delegating the modeling of diverse time series patterns to the sparse mixture of experts (MoE) within Transformers. With these designs, Moirai-MoE reduces reliance on human-defined heuristics and enables automatic token-level specialization. Extensive experiments on 39 datasets demonstrate the superiority of Moirai-MoE over existing foundation models in both in-distribution and zero-shot scenarios. Furthermore, this study conducts comprehensive model analyses to explore the inner workings of time series MoE foundation models and provides valuable insights for future research.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Machine Learning,Statistics - Machine Learning},
  annotation = {abstractTranslation: 時系列基礎モデルは、ゼロショット予測器として素晴らしい性能を示してきた。しかし、時系列の効果的な統一学習を実現することは、依然として未解決の課題である。既存のアプローチは、時系列データの高度に異質な性質を考慮するために、ある程度のモデルの特殊化を導入している。例えば、Moiraiは複数の入出力投影レイヤーを採用し、それぞれが特定の周波数の時系列を扱うように調整することで、統一的な学習を追求している。同様に、TimesFMはこの目的のために周波数埋め込み辞書を保持している。(1)周波数は時系列の基本的なパターンの信頼できる指標ではない。例えば、異なる周波数を持つ時系列は類似したパターンを示すことがあるが、同じ周波数を持つ時系列は多様なパターンを示すことがある。(2) 非定常性は実世界の時系列に固有の性質であり、1つの時系列の短いコンテクスト・ウィンドウの中でさえ、さまざまな分布につながる。周波数レベルの特殊化は、このレベルの多様性を捉えるには粒度が粗すぎる。これらの限界に対処するため、本論文では、単一の入出力投影層を使用しながら、多様な時系列パターンのモデリングをTransformers内のスパース混合エキスパート（MoE）に委ねるMoirai-MoEを紹介する。これらの設計により、Moirai-MoEは人間が定義したヒューリスティックへの依存を減らし、トークンレベルの自動的な特殊化を可能にする。39のデータセットを用いた広範な実験により、Moirai-MoEが既存の基礎モデルよりも優れていることが、分布内シナリオとゼロショットシナリオの両方で実証された。さらに、本研究では、時系列MoE基礎モデルの内部構造を探るために包括的なモデル分析を行い、将来の研究のための貴重な洞察を提供する。},
  file = {C:\Users\furuh\Zotero\storage\F7XUQRNB\Liu et al. - 2024 - Moirai-MoE Empowering Time Series Foundation Models with Sparse Mixture of Experts.pdf}
}

@inproceedings{liuMoreauEnvelopeNonconvex2024,
  title = {Moreau Envelope for Nonconvex {{Bi-level}} Optimization: A Single-Loop and {{Hessian-free}} Solution Strategy},
  shorttitle = {Moreau Envelope for Nonconvex {{Bi-level}} Optimization},
  booktitle = {Proceedings of the 41st {{International Conference}} on {{Machine Learning}}},
  author = {Liu, Risheng and Liu, Zhu and Yao, Wei and Zeng, Shangzhi and Zhang, Jin},
  year = {2024},
  month = jul,
  series = {{{ICML}}'24},
  volume = {235},
  pages = {31566--31596},
  publisher = {JMLR.org},
  address = {Vienna, Austria},
  urldate = {2025-02-03},
  abstract = {This work focuses on addressing two major challenges in the context of large-scale nonconvex Bi-Level Optimization (BLO) problems, which are increasingly applied in machine learning due to their ability to model nested structures. These challenges involve ensuring computational efficiency and providing theoretical guarantees. While recent advances in scalable BLO algorithms have primarily relied on lower-level convexity simplification, our work specifically tackles large-scale BLO problems involving nonconvexity in both the upper and lower levels. We simultaneously address computational and theoretical challenges by introducing an innovative single-loop gradient-based algorithm, utilizing the Moreau envelope-based reformulation, and providing non-asymptotic convergence analysis for general nonconvex BLO problems. Notably, our algorithm relies solely on first-order gradient information, enhancing its practicality and efficiency, especially for large-scale BLO learning tasks. We validate our approach's effectiveness through experiments on various synthetic problems, two typical hyper-parameter learning tasks, and a real-world neural architecture search application, collectively demonstrating its superior performance.},
  langid = {english},
  annotation = {abstractTranslation: この作業は、ネストされた構造をモデル化する能力のために機械学習にますます適用される大規模な非コンベックスBIレベル最適化（BLO）問題のコンテキストで2つの主要な課題に対処することに焦点を当てています。これらの課題には、計算効率を確保し、理論的保証を提供することが含まれます。スケーラブルなBLOアルゴリズムの最近の進歩は主に低レベルの凸性単純化に依存していましたが、私たちの作業は、特に上位レベルと低いレベルの両方で非概念性を含む大規模なBLO問題に取り組んでいます。モローエンベロープベースの再編成を利用し、一般的な非コンベックスBLO問題に対して非症状の収束分析を提供することにより、革新的なシングルループ勾配ベースのアルゴリズムを導入することにより、同時に計算および理論的課題に対処します。特に、私たちのアルゴリズムは、特に大規模なBLO学習タスクにおいて、一次勾配情報のみに依存しており、その実用性と効率を向上させます。さまざまな合成問題、2つの典型的なハイパーパラメーター学習タスク、および実際のニューラルアーキテクチャ検索アプリケーションに関する実験を通じて、アプローチの有効性を検証し、その優れたパフォーマンスをまとめて実証します。},
  file = {C:\Users\furuh\Zotero\storage\3JAWKBKB\Liu et al. - 2024 - Moreau envelope for nonconvex Bi-level optimization a single-loop and Hessian-free solution strateg.pdf}
}

@inproceedings{liuMoreConvNets2020s2022,
  title = {More {{ConvNets}} in the 2020s: {{Scaling}} up {{Kernels Beyond}} 51x51 Using {{Sparsity}}},
  shorttitle = {More {{ConvNets}} in the 2020s},
  booktitle = {The {{Eleventh International Conference}} on {{Learning Representations}}},
  author = {Liu, Shiwei and Chen, Tianlong and Chen, Xiaohan and Chen, Xuxi and Xiao, Qiao and Wu, Boqian and K{\"a}rkk{\"a}inen, Tommi and Pechenizkiy, Mykola and Mocanu, Decebal Constantin and Wang, Zhangyang},
  year = {2022},
  month = sep,
  urldate = {2025-03-02},
  abstract = {Transformers have quickly shined in the computer vision world since the emergence of Vision Transformers (ViTs). The dominant role of convolutional neural networks (CNNs) seems to be challenged by increasingly effective transformer-based models. Very recently, a couple of advanced convolutional models strike back with large kernels motivated by the local-window attention mechanism, showing appealing performance and efficiency. While one of them, i.e. RepLKNet, impressively manages to scale the kernel size to 31x31 with improved performance, the performance starts to saturate as the kernel size continues growing, compared to the scaling trend of advanced ViTs such as Swin Transformer. In this paper, we explore the possibility of training extreme convolutions larger than 31x31 and test whether the performance gap can be eliminated by strategically enlarging convolutions. This study ends up with a recipe for applying extremely large kernels from the perspective of sparsity, which can smoothly scale up kernels to 61x61 with better performance. Built on this recipe, we propose Sparse Large Kernel Network (SLaK), a pure CNN architecture equipped with sparse factorized 51x51 kernels that can perform on par with or better than state-of-the-art hierarchical Transformers and modern ConvNet architectures like ConvNeXt and RepLKNet, on ImageNet classification as well as a wide range of downstream tasks including semantic segmentation on ADE20K, object detection on PASCAL VOC 2007, and object detection/segmentation on MS COCO. Codes are available at https://github.com/VITA-Group/SLaK.},
  langid = {english},
  annotation = {ヴィジョン・トランスフォーマー（ViTs）の登場以来、トランスフォーマーはコンピュータ・ヴィジョンの世界で急速に輝きを増している。畳み込みニューラルネットワーク（CNN）の支配的な役割は、ますます効果的になるトランスフォーマーベースのモデルによって挑戦されているようだ。ごく最近、いくつかの先進的な畳み込みモデルが、ローカルウィンドウ注目メカニズムに動機づけられた大きなカーネルで逆襲し、魅力的な性能と効率を示した。そのうちの1つであるRepLKNetは、カーネルサイズを31x31に拡張し、性能を向上させることに成功しているが、Swin Transformerのような先進的なViTの拡張傾向と比較すると、カーネルサイズが大きくなり続けるにつれて性能は飽和し始める。本論文では、31x31より大きな極端な畳み込みを学習する可能性を探り、戦略的に畳み込みを大きくすることで性能差を解消できるかどうかを検証する。この研究は、スパース性の観点から極端に大きなカーネルを適用するレシピに行き着き、より良い性能でカーネルを61x61まで滑らかにスケールアップできる。このレシピに基づき、我々はスパース大カーネルネットワーク(Sparse Large Kernel Network: SLaK)を提案する。Sparse Large Kernel Networkは、スパース因数分解された51x51カーネルを備えた純粋なCNNアーキテクチャであり、最先端の階層型変換器や、ConvNeXtやRepLKNetのような最新のConvNetアーキテクチャと同等かそれ以上の性能を、ImageNet分類や、ADE20Kのセマンティックセグメンテーション、PASCAL VOC 2007の物体検出、MS COCOの物体検出/セグメンテーションを含む幅広い下流タスクで発揮することができる。コードはhttps://github.com/VITA-Group/SLaK。},
  file = {C:\Users\furuh\Zotero\storage\I2QYW9M3\Liu et al. - 2022 - More ConvNets in the 2020s Scaling up Kernels Beyond 51x51 using Sparsity.pdf}
}

@incollection{liuMultiViewClusteringJoint2013,
  title = {Multi-{{View Clustering}} via {{Joint Nonnegative Matrix Factorization}}},
  booktitle = {Proceedings of the 2013 {{SIAM International Conference}} on {{Data Mining}} ({{SDM}})},
  author = {Liu, Jialu and Wang, Chi and Gao, Jing and Han, Jiawei},
  year = {2013},
  month = may,
  series = {Proceedings},
  pages = {252--260},
  publisher = {{Society for Industrial and Applied Mathematics}},
  doi = {10.1137/1.9781611972832.28},
  urldate = {2025-06-08},
  abstract = {要約Many real-world datasets are comprised of different representations or views which often provide information complementary to each other. To integrate information from multiple views in the unsupervised setting, multi-view clustering algorithms have been developed to cluster multiple views simultaneously to derive a solution which uncovers the common latent structure shared by multiple views. In this paper, we propose a novel NMF-based multi-view clustering algorithm by searching for a factorization that gives compatible clustering solutions across multiple views. The key idea is to formulate a joint matrix factorization process with the constraint that pushes clustering solution of each view towards a common consensus instead of fixing it directly. The main challenge is how to keep clustering solutions across different views meaningful and comparable. To tackle this challenge, we design a novel and effective normalization strategy inspired by the connection between NMF and PLSA. Experimental results on synthetic and several real datasets demonstrate the effectiveness of our approach.多くの実世界のデータセットは、多くの場合、互いに補完し合う情報を提供するさまざまな表現またはビューで構成されています。教師なし設定で複数のビューからの情報を統合するために、マルチビュークラスタリングアルゴリズムが開発され、複数のビューが同時にクラスタリングして、複数のビューが共有する共通の潜在構造を明らかにするソリューションを導き出しました。この論文では、複数のビュー間で互換性のあるクラスタリングソリューションを提供する因数分解を探索することにより、新しいNMFベースのマルチビュークラスタリングアルゴリズムを提案します。重要な考え方は、各ビューのクラスタリング解を直接固定するのではなく、共通のコンセンサスに向けて推進する制約を使用して、結合行列分解プロセスを定式化することです。主な課題は、異なるビュー間でクラスタリング ソリューションを意味があり、比較可能な状態に保つ方法です。この課題に取り組むために、NMFとPLSAの関係に触発された斬新で効果的な正規化戦略を設計します。合成データセットといくつかの実際のデータセットでの実験結果は、私たちのアプローチの有効性を示しています。},
  isbn = {978-1-61197-262-7},
  file = {C:\Users\furuh\Zotero\storage\2PUNDBTM\Liu et al. - 2013 - Multi-View Clustering via Joint Nonnegative Matrix Factorization.pdf}
}

