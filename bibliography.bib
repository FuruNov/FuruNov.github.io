  urldate = {2025-03-03},
  abstract = {Fault diagnosis of multivariate signals is a significant area of engineering research. Feature information is collected from multiple dimensions. This improves the accuracy and robustness of mechanical fault diagnosis. Dynamic mode decomposition (DMD) is a method that extracts the basic structure and mode of motion, describing the behavior of dynamic systems. It decomposes a high-dimensional nonlinear dynamic system into single-frequency DMD modes. With the advent of the big data era, the interest in tensor analysis has increased. Tensor train (TT) decomposition represents the tensor structure through a series of low-rank tensor products. To extract the fault features of multivariate signals, a low-rank tensor train dynamic mode decomposition (LRTTDMD) model is proposed in this paper. The multivariate signals are first converted into a data tensor using phase space reconstruction. Subsequently, the data tensor is transformed into TT format using TT decomposition, while ensuring a certain level of error. The tensor operation is introduced into the original DMD to process the data tensor of TT format and extract the fault feature. The construction of tensor low-rank extraction framework enhances the robustness of the algorithm to noise. Finally, the effectiveness and feasibility of LRTTDMD are validated using simulation signals and laboratory self-test bearing fault signals.},
  keywords = {Bearing fault diagnosis,Eigenvalues and eigenfunctions,Fault diagnosis,feature extraction,Feature extraction,Heuristic algorithms,low-rank tensor train dynamic mode decomposition (LRTTDMD),Matrix converters,Matrix decomposition,multivariate signal processing,Noise,Nonlinear dynamical systems,Robustness,tensor train decomposition,Tensors},
