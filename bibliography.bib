@inproceedings{krishnanGraphSignalReconstruction2025,
  title = {Graph {{Signal Reconstruction}} via {{Koopman Autoencoder}}},
  booktitle = {{{ICASSP}} 2025 - 2025 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
