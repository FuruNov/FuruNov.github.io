@article{takabeConvergenceAccelerationChebyshev2022,
  title = {Convergence {{Acceleration}} via {{Chebyshev Step}}: {{Plausible Interpretation}} of {{Deep-Unfolded Gradient Descent}}},
  shorttitle = {Convergence {{Acceleration}} via {{Chebyshev Step}}},
  author = {Takabe, Satoshi and Wadayama, Tadashi},
  year = {2022},
  journal = {IEICE Transactions on Fundamentals of Electronics, Communications and Computer Sciences},
  volume = {E105.A},
  number = {8},
  pages = {1110--1120},
  doi = {10.1587/transfun.2021EAP1139},
  abstract = {Deep unfolding is a promising deep-learning technique, whose network architecture is based on expanding the recursive structure of existing iterative algorithms. Although deep unfolding realizes convergence acceleration, its theoretical aspects have not been revealed yet. This study details the theoretical analysis of the convergence acceleration in deep-unfolded gradient descent (DUGD) whose trainable parameters are step sizes. We propose a plausible interpretation of the learned step-size parameters in DUGD by introducing the principle of Chebyshev steps derived from Chebyshev polynomials. The use of Chebyshev steps in gradient descent (GD) enables us to bound the spectral radius of a matrix governing the convergence speed of GD, leading to a tight upper bound on the convergence rate. Numerical results show that Chebyshev steps numerically explain the learned step-size parameters in DUGD well.},
  langid = {english},
  keywords = {Chebyshev polynomials,deep unfolding,gradient descent},
  annotation = {abstractTranslation: ディープ アンフォールディングは、有望なディープラーニング技術であり、そのネットワーク アーキテクチャは、既存の反復アルゴリズムの再帰構造の拡張に基づいています。深層展開は収束加速を実現しますが、その理論的な側面はまだ明らかにされていません。この研究では、トレーニング可能なパラメータがステップ サイズである深展開勾配降下法 (DUGD) における収束加速の理論的解析について詳しく説明します。チェビシェフ多項式から導出されたチェビシェフ ステップの原理を導入することにより、DUGD で学習されたステップ サイズ パラメーターのもっともらしい解釈を提案します。勾配降下法 (GD) でチェビシェフ ステップを使用すると、GD の収束速度を制御する行列のスペクトル半径を制限できるため、収束速度の上限が厳しくなります。数値結果は、チェビシェフ ステップが DUGD で学習されたステップ サイズ パラメーターを数値的によく説明していることを示しています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\SQFBE4J4\\Takabe と Wadayama - 2022 - Convergence Acceleration via Chebyshev Step Plausible Interpretation of Deep-Unfolded Gradient Desc.pdf;C\:\\Users\\furuh\\Zotero\\storage\\LEUVYXEJ\\ja.html}
}

@misc{takadaAdaptiveLassoTransfer2023b,
  title = {Adaptive {{Lasso}}, {{Transfer Lasso}}, and {{Beyond}}: {{An Asymptotic Perspective}}},
  shorttitle = {Adaptive {{Lasso}}, {{Transfer Lasso}}, and {{Beyond}}},
  author = {Takada, Masaaki and Fujisawa, Hironori},
  year = {2023},
  month = aug,
  number = {arXiv:2308.15838},
