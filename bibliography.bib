@misc{tongScalingScalabilityProvable2022a,
  title = {Scaling and {{Scalability}}: {{Provable Nonconvex Low-Rank Tensor Estimation}} from {{Incomplete Measurements}}},
  shorttitle = {Scaling and {{Scalability}}},
