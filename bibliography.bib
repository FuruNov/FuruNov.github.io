  doi = {10.1109/ICASSP40776.2020.9053500},
  urldate = {2025-02-18},
  abstract = {Fused lasso norm is classically adopted to model sparse piecewise constant signals, however it is not the convex hull of the best representation of such simultaneously structured signal. In this paper, we propose a convex variational norm for better modeling sparse piecewise constant signals. The norm is based on (1) promoting sparsity in first-order difference with total variation norm and (2) exploiting latent group structure in first-order difference with simple linear constraints. We demonstrate the proposed norm outperforms fused lasso norm in a denoising setup with numerical experiments.},
  langid = {english},
  keywords = {Acoustics,Conferences,Fused Lasso,Noise reduction,Numerical models,Signal processing,Simultaneously Structured Model,Speech processing,Variational Norm},
  annotation = {abstractTranslation: Fused Lasso Normは、まばらな区分定数信号をモデル化するために古典的に採用されていますが、そのような同時構造信号の最良の表現の凸型の船体ではありません。この論文では、まばらな区分定数信号をより適切にモデル化するために、凸型の変動規範を提案します。 Normは、（1）総変動規範との1次差のスパース性を促進することに基づいており、（2）単純な線形制約との1次差で潜在的なグループ構造を悪用することに基づいています。提案されている規範が、数値実験を備えた除去セ\hspace{0pt}\hspace{0pt}ットアップで融合したラッソノルムよりも優れていることを示します。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\IP6B3QRI\\Feng と Selesnick - 2020 - Latent Fused Lasso.pdf;C\:\\Users\\furuh\\Zotero\\storage\\IYGK7GSA\\9053500.html}
}

@article{fengMultiplexTransformedTensor2023,
  title = {Multiplex {{Transformed Tensor Decomposition}} for {{Multidimensional Image Recovery}}},
  author = {Feng, Lanlan and Zhu, Ce and Long, Zhen and Liu, Jiani and Liu, Yipeng},
  year = {2023},
  journal = {IEEE Transactions on Image Processing},
  volume = {32},
  pages = {3397--3412},
  issn = {1941-0042},
  doi = {10.1109/TIP.2023.3284673},
  urldate = {2025-01-26},
  abstract = {Low-rank tensor completion aims to recover the missing entries of multi-way data, which has become popular and vital in many fields such as signal processing and computer vision. It varies with different tensor decomposition frameworks. Compared with matrix SVD, recently emerging transform t-SVD can better characterize the low-rank structure of order-3 data. However, it suffers from rotation sensitivity, and dimensional limitation (i.e., only effective for order-3 tensors). To alleviate these deficiencies, we develop a novel multiplex transformed tensor decomposition (MTTD) framework, which can characterize the global low-rank structure along all modes for any order- N tensor. Based on MTTD, we propose a related multi-dimensional square model for low-rank tensor completion. Besides, a total variation term is also introduced to utilize the local piecewise smoothness of the tensor data. The classic alternating direction method of multipliers is used to solve the convex optimization problems. For performance testing, we choose three linear invertible transforms including FFT, DCT, and a group of unitary transform matrices for our proposed methods. The simulated and real-data experiments demonstrate the superior recovery accuracy and computational efficiency of our method compared with state-of-the-art ones.},
  langid = {english},
  keywords = {Discrete cosine transforms,image recovery,low-rank tensor completion,Matrix decomposition,multidimensional signal processing,Multiplexing,Singular value decomposition,Tensor singular value decomposition,Tensors,Transforms,TV},
  annotation = {abstractTranslation: 低ランクのテンソル補完は、マルチウェイ データの欠落したエントリを回復することを目的としています。これは、信号処理やコンピューター ビジョンなどの多くの分野で普及し、不可欠になっています。これは、テンソル分解フレームワークによって異なります。行列 SVD と比較して、最近登場した変換 t-SVD は、次数 3 データの低ランク構造をより適切に特徴付けることができます。ただし、回転の感度と次元の制限があります (つまり、次数 3 のテンソルに対してのみ有効です)。これらの欠陥を軽減するために、我々は、任意の次数 N テンソルのすべてのモードに沿ってグローバルな低ランク構造を特徴付けることができる、新しい多重変換テンソル分解 (MTTD) フレームワークを開発しました。 MTTDに基づいて、低ランクテンソル完成のための関連する多次元正方モデルを提案します。さらに、テンソル データの局所的な区分的平滑性を利用するために、全変動項も導入されています。凸型最適化問題を解決するには、乗算器の古典的な交互方向方法が使用されます。性能テストでは、FFT、DCT、および提案手法のユニタリ変換行列のグループを含む 3 つの線形可逆変換を選択します。シミュレートされた実際のデータ実験は、最先端の方法と比較して、私たちの方法の優れた回復精度と計算効率を示しています。},
  file = {C:\Users\furuh\Zotero\storage\9FIKSNCP\10153488.html}
}

