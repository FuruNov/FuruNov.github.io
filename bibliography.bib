@article{sasakiSparseRegularizationReverse2025,
  title = {Sparse {{Regularization}} with {{Reverse Sorted Sum}} of {{Squares}} via an {{Unrolled Difference-of-Convex Approach}}},
  author = {Sasaki, Takayuki and Hayase, Kazuya and Kitahara, Masaki and Ono, Shunsuke},
  year = {2025},
  journal = {IEEE Open Journal of Signal Processing},
  pages = {1--9},
  issn = {2644-1322},
  doi = {10.1109/OJSP.2025.3529312},
  urldate = {2025-01-20},
  abstract = {This paper proposes a sparse regularization method with a novel sorted regularization function. Sparse regularization is commonly used to solve underdetermined inverse problems. Traditional sparse regularization functions, such as L{$_1$}-norm, suffer from problems like amplitude underestimation and vanishing perturbations. The reverse ordered weighted L{$_1$}-norm (ROWL) addresses these issues but introduces new challenges. These include developing an algorithm grounded in theory, not heuristics, reducing computational complexity, enabling the automatic determination of numerous parameters, and ensuring the number of iterations remains feasible. In this study, we propose a novel sparse regularization function called the reverse sorted sum of squares (RSSS) and then construct an unrolled algorithm that addresses both the aforementioned two problems and these four challenges. The core idea of our proposed method lies in transforming the optimization problem into a difference-of-convex programming problem, for which solutions are known. In experiments, we apply the RSSS regularization method to image deblurring and super-resolution tasks and confirmed its superior performance compared to conventional methods, all with feasible computational complexity.},
  langid = {english},
  keywords = {Computational complexity,Convergence,Convex functions,Deep unrolling,Difference-of-convex,Inverse problem,Inverse problems,Non-convex optimization,Optimization,Perturbation methods,Programming,Proximal splitting method,Signal processing,Signal processing algorithms,Sparse regularization,Vectors},
  annotation = {abstractTranslation: 本稿では、新しいソート正則化関数を備えたスパース正則化手法を提案します。スパース正則化は、過小決定逆問題を解決するためによく使用されます。 L1 ノルムなどの従来のスパース正則化関数には、振幅の過小評価や摂動の消失などの問題があります。逆順序加重 L1 ノルム (ROWL) はこれらの問題に対処しますが、新たな課題も生じます。これらには、ヒューリスティックではなく理論に基づいたアルゴリズムの開発、計算の複雑さの軽減、多数のパラメータの自動決定の有効化、実行可能な反復回数の確保などが含まれます。この研究では、逆ソート二乗和 (RSSS) と呼ばれる新しいスパース正則化関数を提案し、前述の 2 つの問題とこれら 4 つの課題の両方に対処するアンロール アルゴリズムを構築します。私たちが提案する方法の中心的なアイデアは、最適化問題を凸の差分計画問題に変換することにあり、その解決策は既知です。実験では、RSSS 正則化手法を画像のブレ除去や超解像タスクに適用し、従来の手法と比較して実行可能な計算量で優れたパフォーマンスを確認しました。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\ISSHYTIT\\Sasaki et al. - 2025 - Sparse Regularization with Reverse Sorted Sum of Squares via an Unrolled Difference-of-Convex Approa.pdf;C\:\\Users\\furuh\\Zotero\\storage\\V7WCV8RC\\10840312.html}
}

@inproceedings{sassenParametrizingProductShape2022,
