@inproceedings{thakerReverseEngineering$ell_p$2022,
  title = {Reverse {{Engineering}} \${\textbackslash}ell\_p\$ Attacks: {{A}} Block-Sparse Optimization Approach with Recovery Guarantees},
  shorttitle = {Reverse {{Engineering}} \${\textbackslash}ell\_p\$ Attacks},
  booktitle = {Proceedings of the 39th {{International Conference}} on {{Machine Learning}}},
  author = {Thaker, Darshan and Giampouras, Paris and Vidal, Rene},
  year = {2022},
  month = jun,
  pages = {21253--21271},
  publisher = {PMLR},
  issn = {2640-3498},
  urldate = {2024-11-18},
  abstract = {Deep neural network-based classifiers have been shown to be vulnerable to imperceptible perturbations to their input, such as {$\ell$}p{$\ell$}p{\textbackslash}ell\_p-bounded norm adversarial attacks. This has motivated the development of many defense methods, which are then broken by new attacks, and so on. This paper focuses on a different but related problem of reverse engineering adversarial attacks. Specifically, given an attacked signal, we study conditions under which one can determine the type of attack ({$\ell$}1{$\ell$}1{\textbackslash}ell\_1, {$\ell$}2{$\ell$}2{\textbackslash}ell\_2 or {$\ell\infty\ell\infty\backslash$}ell\_{\textbackslash}infty) and recover the clean signal. We pose this problem as a block-sparse recovery problem, where both the signal and the attack are assumed to lie in a union of subspaces that includes one subspace per class and one subspace per attack type. We derive geometric conditions on the subspaces under which any attacked signal can be decomposed as the sum of a clean signal plus an attack. In addition, by determining the subspaces that contain the signal and the attack, we can also classify the signal and determine the attack type. Experiments on digit and face classification demonstrate the effectiveness of the proposed approach.},
  langid = {english},
  annotation = {abstractTranslation: ディープニューラルネットワークベースの分類器は、plpell\_p-boundedノルム敵対的攻撃のような、入力に対する知覚できない摂動に対して脆弱であることが示されてきた。このため、多くの防御手法が開発されてきたが、それらは新たな攻撃によって破られるなど、その動機付けは様々である。本論文では、敵対的攻撃をリバースエンジニアリングするという、異なるが関連する問題に焦点を当てる。具体的には、攻撃された信号が与えられたとき、攻撃の種類（l1、l2、l{$\infty$}）を決定し、クリーンな信号を回復できる条件を研究する。我々はこの問題を、信号と攻撃の両方が、クラス毎に1つの部分空間と攻撃タイプ毎に1つの部分空間を含む部分空間の和にあると仮定する、ブロック・スパース回復問題として提起する。攻撃された信号がクリーンな信号と攻撃の和として分解できるような部分空間に関する幾何学的条件を導出する。さらに、信号と攻撃を含む部分空間を決定することにより、信号を分類し、攻撃タイプを決定することもできる。数字と顔の分類の実験により、提案アプローチの有効性を示す。},
