  doi = {10.1109/TNNLS.2022.3144630},
  urldate = {2023-12-03},
  abstract = {As a spotlighted nonlocal image representation model, group sparse representation (GSR) has demonstrated a great potential in diverse image restoration tasks. Most of the existing GSR-based image restoration approaches exploit the nonlocal self-similarity (NSS) prior by clustering similar patches into groups and imposing sparsity to each group coefficient, which can effectively preserve image texture information. However, these methods have imposed only plain sparsity over each individual patch of the group, while neglecting other beneficial image properties, e.g., low-rankness (LR), leads to degraded image restoration results. In this article, we propose a novel low-rankness guided group sparse representation (LGSR) model for highly effective image restoration applications. The proposed LGSR jointly utilizes the sparsity and LR priors of each group of similar patches under a unified framework. The two priors serve as the complementary priors in LGSR for effectively preserving the texture and structure information of natural images. Moreover, we apply an alternating minimization algorithm with an adaptively adjusted parameter scheme to solve the proposed LGSR-based image restoration problem. Extensive experiments are conducted to demonstrate that the proposed LGSR achieves superior results compared with many popular or state-of-the-art algorithms in various image restoration tasks, including denoising, inpainting, and compressive sensing (CS).},
  file = {C:\Users\furuh\Zotero\storage\E4JLQN9T\Zha et al. - 2023 - Low-Rankness Guided Group Sparse Representation fo.pdf}
}

@inproceedings{zhangAdvancingModelPruning2022,
  title = {Advancing Model Pruning via Bi-Level Optimization},
  booktitle = {Proceedings of the 36th {{International Conference}} on {{Neural Information Processing Systems}}},
  author = {Zhang, Yihua and Yao, Yuguang and Ram, Parikshit and Zhao, Pu and Chen, Tianlong and Hong, Mingyi and Wang, Yanzhi and Liu, Sijia},
  year = {2022},
  month = nov,
  series = {{{NIPS}} '22},
  pages = {18309--18326},
  publisher = {Curran Associates Inc.},
  address = {Red Hook, NY, USA},
  urldate = {2025-02-09},
  abstract = {The deployment constraints in practical applications necessitate the pruning of large-scale deep learning models, i.e., promoting their weight sparsity. As illustrated by the Lottery Ticket Hypothesis (LTH), pruning also has the potential of improving their generalization ability. At the core of LTH, iterative magnitude pruning (IMP) is the predominant pruning method to successfully find 'winning tickets'. Yet, the computation cost of IMP grows prohibitively as the targeted pruning ratio increases. To reduce the computation overhead, various efficient 'one-shot' pruning methods have been developed but these schemes are usually unable to find winning tickets as good as IMP. This raises the question of how to close the gap between pruning accuracy and pruning efficiency? To tackle it, we pursue the algorithmic advancement of model pruning. Specifically, we formulate the pruning problem from a fresh and novel viewpoint, bi-level optimization (BLO). We show that the BLO interpretation provides a technically-grounded optimization base for an efficient implementation of the pruning-retraining learning paradigm used in IMP. We also show that the proposed bi-level optimization-oriented pruning method (termed BIP) is a special class of BLO problems with a bi-linear problem structure. By leveraging such bi-linearity, we theoretically show that BIP can be solved as easily as first-order optimization, thus inheriting the computation efficiency. Through extensive experiments on both structured and unstructured pruning with 5 model architectures and 4 data sets, we demonstrate that B IP can find better winning tickets than IMP in most cases, and is computationally as efficient as the one-shot pruning schemes, demonstrating 2-7 {\texttimes} speedup over IMP for the same level of model accuracy and sparsity.},
  isbn = {978-1-7138-7108-8},
  langid = {english},
  keywords = {Favorite},
  annotation = {abstractTranslation: 実際のアプリケーションでの展開の制約により、大規模な深い学習モデルの剪定、つまり体重のスパースを促進する必要があります。宝くじのチケット仮説（LTH）が示すように、剪定には一般化能力を改善する可能性もあります。 LTHの中核では、反復マグニチュードプルーニング（IMP）は、「勝利のチケット」を正常に見つけるための主要な剪定方法です。しかし、ターゲットを絞った剪定比が増加するにつれて、IMPの計算コストは\hspace{0pt}\hspace{0pt}法外に増加します。計算オーバーヘッドを減らすために、さまざまな効率的な「ワンショット」剪定方法が開発されましたが、これらのスキームは通常、IMPと同じくらい優れた勝利チケットを見つけることができません。これは、剪定精度と剪定効率の間のギャップをどのように閉じるかという問題を提起しますか？それに取り組むために、モデル剪定のアルゴリズムの進歩を追求します。具体的には、新鮮で斬新な視点であるBiレベルの最適化（BLO）から剪定問題を定式化します。 BLOの解釈は、IMPで使用される剪定再抑制学習パラダイムを効率的に実装するための技術的に接地された最適化ベースを提供することを示します。また、提案されている双レベルの最適化指向剪定法（BIPと呼ばれる）は、双線形の問題構造を伴う特別なクラスのBLO問題であることを示しています。このような二重線を活用することにより、BIPを1次最適化と同じくらい簡単に解決できるため、計算効率を継承できることを理論的に示します。 5つのモデルアーキテクチャと4つのデータセットを使用した構造化されたおよび非構造化されていないプルーニングの両方に関する広範な実験により、B IPはほとんどの場合、IMPよりも優れた勝利チケットを見つけることができ、ワンショット剪定スキームと同じくらい効率的であり、2-を実証することを実証します。同じレベルのモデルの精度とスパース性のために、7{\texttimes}IMPのスピードアップ。},
  file = {C:\Users\furuh\Zotero\storage\ZT2LURZJ\Zhang et al. - Advancing Model Pruning via Bi-level Optimization.pdf}
}

@article{zhangAMPNetDenoisingBasedDeep2021,
  title = {{{AMP-Net}}: {{Denoising-Based Deep Unfolding}} for {{Compressive Image Sensing}}},
  shorttitle = {{{AMP-Net}}},
  author = {Zhang, Zhonghao and Liu, Yipeng and Liu, Jiani and Wen, Fei and Zhu, Ce},
  year = {2021},
  journal = {IEEE Transactions on Image Processing},
  volume = {30},
  pages = {1487--1500},
  issn = {1941-0042},
  doi = {10.1109/TIP.2020.3044472},
  urldate = {2025-05-31},
  abstract = {Most compressive sensing (CS) reconstruction methods can be divided into two categories, i.e. model-based methods and classical deep network methods. By unfolding the iterative optimization algorithm for model-based methods onto networks, deep unfolding methods have the good interpretation of model-based methods and the high speed of classical deep network methods. In this article, to solve the visual image CS problem, we propose a deep unfolding model dubbed AMP-Net. Rather than learning regularization terms, it is established by unfolding the iterative denoising process of the well-known approximate message passing algorithm. Furthermore, AMP-Net integrates deblocking modules in order to eliminate the blocking artifacts that usually appear in CS of visual images. In addition, the sampling matrix is jointly trained with other network parameters to enhance the reconstruction performance. Experimental results show that the proposed AMP-Net has better reconstruction accuracy than other state-of-the-art methods with high reconstruction speed and a small number of network parameters.},
  keywords = {approximate message passing,Compressive sensing,deep unfolding,image denoising,image reconstruction,Image reconstruction,Iterative algorithms,Neural networks,Noise reduction,Optimization,Sparse matrices,Visualization},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\2ZVF5EBF\\Zhang et al. - 2021 - AMP-Net Denoising-Based Deep Unfolding for Compressive Image Sensing.pdf;C\:\\Users\\furuh\\Zotero\\storage\\BIWGNQD8\\9298950.html}
}

@article{zhangAnalysisMultistageConvex,
  title = {Analysis of {{Multi-stage Convex Relaxation}} for {{Sparse Regularization}}},
  author = {Zhang, Tong},
  abstract = {We consider learning formulations with non-convex objective functions that often occur in practical applications. There are two approaches to this problem: {$\bullet$} Heuristic methods such as gradient descent that only find a local minimum. A drawback of this approach is the lack of theoretical guarantee showing that the local minimum gives a good solution. {$\bullet$} Convex relaxation such as L1-regularization that solves the problem under some conditions. However it often leads to a sub-optimal solution in reality. This paper tries to remedy the above gap between theory and practice. In particular, we present a multi-stage convex relaxation scheme for solving problems with non-convex objective functions. For learning formulations with sparse regularization, we analyze the behavior of a specific multistage relaxation scheme. Under appropriate conditions, we show that the local solution obtained by this procedure is superior to the global solution of the standard L1 convex relaxation for learning sparse targets.},
  langid = {english},
  keywords = {No DOI found},
  annotation = {abstractTranslation: 我々は、実用的なアプリケーションでしばしば発生する非凸目的関数を持つ学習定式化について考察する。この問題には2つのアプローチがある：- 勾配降下のような発見的手法で、局所最小値のみを求める。このアプローチの欠点は、局所最小値が良い解を与えることを示す理論的保証がないことである。- L1正則化のような凸緩和法は、ある条件下で問題を解く。しかし、現実には最適解にならないことが多い。本論文では、理論と実践の間にある上記のギャップを改善することを試みる。特に、非凸目的関数を持つ問題を解くための多段階凸緩和スキームを提示する。スパース正則化を持つ学習定式化に対して、特定の多段凸緩和スキームの振る舞いを解析する。適切な条件下で、この手続きによって得られる局所解が、スパースな目的関数を学習するための標準的なL1凸緩和の大域解よりも優れていることを示す。},
  file = {C:\Users\furuh\Zotero\storage\LTVRCI8F\Zhang - Analysis of Multi-stage Convex Relaxation for Sparse Regularization.pdf}
}

