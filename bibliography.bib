@inproceedings{jacotWideNeuralNetworks2024,
  title = {Wide {{Neural Networks Trained}} with {{Weight Decay Provably Exhibit Neural Collapse}}},
  booktitle = {The {{Thirteenth International Conference}} on {{Learning Representations}}},
  author = {Jacot, Arthur and S{\'u}ken{\'i}k, Peter and Wang, Zihan and Mondelli, Marco},
  year = {2024},
  month = oct,
  urldate = {2025-04-26},
  abstract = {Deep neural networks (DNNs) at convergence consistently represent the training data in the last layer via a geometric structure referred to as neural collapse. This empirical evidence has spurred a line of theoretical research aimed at proving the emergence of neural collapse, mostly focusing on the unconstrained features model. Here, the features of the penultimate layer are free variables, which makes the model data-agnostic and puts into question its ability to capture DNN training. Our work addresses the issue, moving away from unconstrained features and studying DNNs that end with at least two linear layers. We first prove generic guarantees on neural collapse that assume {\textbackslash}emph\{(i)\} low training error and balancedness of linear layers (for within-class variability collapse), and {\textbackslash}emph\{(ii)\} bounded conditioning of the features before the linear part (for orthogonality of class-means, and their alignment with weight matrices). The balancedness refers to the fact that \$W\_\{{\textbackslash}ell+1\}{\textasciicircum}{\textbackslash}top W\_\{{\textbackslash}ell+1\}{\textbackslash}approx W\_{\textbackslash}ell W\_{\textbackslash}ell {\textasciicircum}{\textbackslash}top\$ for any pair of consecutive weight matrices of the linear part, and the bounded conditioning requires a well-behaved ratio between largest and smallest non-zero singular values of the features. We then show that such assumptions hold for gradient descent training with weight decay: {\textbackslash}emph\{(i)\} for networks with a wide first layer, we prove low training error and balancedness, and {\textbackslash}emph\{(ii)\} for solutions that are either nearly optimal or stable under large learning rates, we additionally prove the bounded conditioning. Taken together, our results are the first to show neural collapse in the end-to-end training of DNNs.},
  langid = {english},
  annotation = {abstractTranslation: 深層ニューラルネットワーク（DNN）は、収束時に最終層においてニューラルコラプスと呼ばれる幾何学的構造を通じて、一貫して訓練データを表現します。この経験的な証拠は、主に制約のない特徴量モデルに焦点を当て、ニューラルコラプスの出現を証明することを目的とした一連の理論研究を促してきました。ここでは、最終層の前の層の特徴量が自由変数であるため、モデルはデータに依存せず、DNNの訓練を捉える能力に疑問が生じます。我々の研究は、この問題に取り組み、制約のない特徴量から離れ、少なくとも2つの線形層で終わるDNNを研究します。まず、次のことを仮定するニューラルコラプスに関する一般的な保証を証明します。（i）低い訓練誤差と線形層のバランス（クラス内変動コラプスの場合）、および（ii）線形部分の前の特徴量の有界な条件数（クラス平均の直交性、および重み行列との整列の場合）。ここでいうバランスとは、線形部分の連続する重み行列の任意のペアについて、\$W\_\{{\textbackslash}ell+1\}{\textasciicircum}{\textbackslash}top W\_\{{\textbackslash}ell+1\}{\textbackslash}approx W\_{\textbackslash}ell W\_{\textbackslash}ell {\textasciicircum}{\textbackslash}top\$が成り立つことを指し、有界な条件数は、特徴量の最大および最小の非ゼロ特異値の間の比が良好な振る舞いをすることを要求します。次に、重み減衰を用いた勾配降下法による訓練において、そのような仮定が成り立つことを示します。（i）最初の層が広いネットワークの場合、低い訓練誤差とバランスを証明し、（ii）ほぼ最適であるか、大きな学習率の下で安定している解の場合、有界な条件数をさらに証明します。これらの結果を総合すると、我々の結果は、DNNのエンドツーエンドの訓練におけるニューラルコラプスを示す最初のものです。},
  file = {C:\Users\furuh\Zotero\storage\3H5R7RRW\Jacot et al. - 2024 - Wide Neural Networks Trained with Weight Decay Provably Exhibit Neural Collapse.pdf}
}

