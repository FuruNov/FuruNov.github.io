@misc{liSparsePCA$l_2p$Norm2020,
  title = {Sparse {{PCA}} via \$l\_\{2,P\}\$-{{Norm Regularization}} for {{Unsupervised Feature Selection}}},
  author = {Li, Zhengxin and Nie, Feiping and Bian, Jintang and Li, Xuelong},
  year = {2020},
  month = dec,
  number = {arXiv:2012.14595},
  eprint = {2012.14595},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2012.14595},
  urldate = {2024-12-10},
  abstract = {In the field of data mining, how to deal with high-dimensional data is an inevitable problem. Unsupervised feature selection has attracted more and more attention because it does not rely on labels. The performance of spectral-based unsupervised methods depends on the quality of constructed similarity matrix, which is used to depict the intrinsic structure of data. However, real-world data contain a large number of noise samples and features, making the similarity matrix constructed by original data cannot be completely reliable. Worse still, the size of similarity matrix expands rapidly as the number of samples increases, making the computational cost increase significantly. Inspired by principal component analysis, we propose a simple and efficient unsupervised feature selection method, by combining reconstruction error with \$l\_\{2,p\}\$-norm regularization. The projection matrix, which is used for feature selection, is learned by minimizing the reconstruction error under the sparse constraint. Then, we present an efficient optimization algorithm to solve the proposed unsupervised model, and analyse the convergence and computational complexity of the algorithm theoretically. Finally, extensive experiments on real-world data sets demonstrate the effectiveness of our proposed method.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Machine Learning,Statistics - Machine Learning},
  annotation = {abstractTranslation: データマイニングの分野において、高次元データをどのように扱うかは避けて通れない問題である。教師なし特徴選択はラベルに依存しないため、ますます注目を集めている。スペクトルベースの教師なし手法の性能は、データの本質的な構造を描写するために用いられる、構築された類似度行列の品質に依存する。しかし、実世界のデータには多数のノイズサンプルや特徴が含まれており、元データによって構築された類似度行列は完全には信頼できない。さらに悪いことに、類似度行列のサイズはサンプル数の増加とともに急激に拡大し、計算コストを著しく増大させる。我々は、主成分分析に着想を得て、再構成誤差と\$l\_\{2,p\}\$ノルム正則化を組み合わせた、シンプルで効率的な教師なし特徴選択法を提案する。特徴選択に用いられる射影行列は、スパース制約の下で再構成誤差を最小化することにより学習される。次に、提案する教師なしモデルを解くための効率的な最適化アルゴリズムを提示し、アルゴリズムの収束性と計算量を理論的に解析する。最後に、実世界のデータセットを用いた広範な実験により、提案手法の有効性を実証する。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\JDJHCIUN\\Li et al. - 2020 - Sparse PCA via $l_ 2,p $-Norm Regularization for Unsupervised Feature Selection.pdf;C\:\\Users\\furuh\\Zotero\\storage\\ECWSPK3E\\2012.html}
}

@article{liSparseRegularizationBasedSpatial2023,
  title = {Sparse {{Regularization-Based Spatial}}--{{Temporal Twist Tensor Model}} for {{Infrared Small Target Detection}}},
  author = {Li, Jie and Zhang, Ping and Zhang, Lingyi and Zhang, Zhiyuan},
  year = {2023},
  journal = {IEEE Transactions on Geoscience and Remote Sensing},
  volume = {61},
  pages = {1--17},
  issn = {0196-2892, 1558-0644},
  doi = {10.1109/TGRS.2023.3234608},
  urldate = {2024-09-07},
  abstract = {Infrared (IR) small target detection under complex environments is an essential part of IR search and track systems. However, previously proposed IR small target detection algorithms cannot achieve complete suppression of complex and significant backgrounds. The spatial--temporal information of image sequences is not fully exploited. In this article, we present a sparse regularization-based twist tensor model for IR small target detection. First, the twist tensor model is built via perspective conversion based on the target's local continuity in the spatial--temporal domain, which makes the original complicated background components more structured and increases the difference between the background and the target. Then, the structured sparsity-inducing norm is introduced to define the locality and continuity of the target. To further minimize the sparse background structures and global noise, the structured sparsity-inducing norm and the \$l\_\{1\}\$ norm are combined as the target's parse constraint. Experimental results on real scenes reveal that the suggested method can process images with high detection accuracy and outstanding background suppression ability compared to various state-of-the-art methods.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {english},
  annotation = {abstractTranslation: 複雑な環境下での赤外線（IR）小目標検出は、IR探索・追跡システムにとって不可欠な要素である。しかし、これまでに提案されている赤外線小目標検出アルゴリズムは、複雑で重要な背景を完全に抑制することはできない。画像シーケンスの空間的・時間的情報が十分に利用されていないのである。本稿では、IR小目標検出のための、スパース正則化に基づくツイストテンソルモデルを提案する。まず、ツイストテンソルモデルは、空間-時間領域におけるターゲットの局所的連続性に基づく透視変換により構築され、これにより、元の複雑な背景成分がより構造化され、背景とターゲットの差が増大する。次に、ターゲットの局所性と連続性を定義するために、構造化スパース誘導ノルムを導入する。さらに疎な背景構造とグローバルノイズを最小化するために、構造化疎誘起ノルムと\$l\_\{1\}\$ノルムをターゲットのパース制約として組み合わせる。実シーンでの実験結果から、提案手法は様々な最新手法と比較して、高い検出精度と優れた背景抑制能力で画像を処理できることが明らかになった。}
}

@article{liStatisticalModelingComplex2004,
  title = {Statistical Modeling of Complex Backgrounds for Foreground Object Detection},
  author = {Li, Liyuan and Huang, Weimin and Gu, Irene Yu-Hua and Tian, Qi},
  year = {2004},
  month = jan,
  journal = {IEEE Transactions on Image Processing},
  volume = {13},
  number = {11},
  pages = {1459--1472},
  issn = {1941-0042},
  doi = {10.1109/TIP.2004.836169},
  urldate = {2025-01-17},
  abstract = {This paper addresses the problem of background modeling for foreground object detection in complex environments. A Bayesian framework that incorporates spectral, spatial, and temporal features to characterize the background appearance is proposed. Under this framework, the background is represented by the most significant and frequent features, i.e., the principal features , at each pixel. A Bayes decision rule is derived for background and foreground classification based on the statistics of principal features. Principal feature representation for both the static and dynamic background pixels is investigated. A novel learning method is proposed to adapt to both gradual and sudden "once-off" background changes. The convergence of the learning process is analyzed and a formula to select a proper learning rate is derived. Under the proposed framework, a novel algorithm for detecting foreground objects from complex environments is then established. It consists of change detection, change classification, foreground segmentation, and background maintenance. Experiments were conducted on image sequences containing targets of interest in a variety of environments, e.g., offices, public buildings, subway stations, campuses, parking lots, airports, and sidewalks. Good results of foreground detection were obtained. Quantitative evaluation and comparison with the existing method show that the proposed method provides much improved results.},
  keywords = {Bayesian methods,Computer vision,Feature extraction,Image sequences,Layout,Learning systems,Motion analysis,Object detection,Pixel,Statistics},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\DG8JYY49\\Li et al. - 2004 - Statistical modeling of complex backgrounds for foreground object detection.pdf;C\:\\Users\\furuh\\Zotero\\storage\\Q5FQ3JGF\\1344037.html}
}

@article{liStructuredSparseCoding2022,
  title = {Structured {{Sparse Coding With}} the {{Group Log-regularizer}} for {{Key Frame Extraction}}},
  author = {Li, Zhenni and Li, Yujie and Tan, Benying and Ding, Shuxue and Xie, Shengli},
  year = {2022},
  month = oct,
  journal = {IEEE/CAA Journal of Automatica Sinica},
  volume = {9},
  number = {10},
  pages = {1818--1830},
  issn = {2329-9274},
  doi = {10.1109/JAS.2022.105602},
  urldate = {2025-02-11},
  abstract = {Key frame extraction based on sparse coding can reduce the redundancy of continuous frames and concisely express the entire video. However, how to develop a key frame extraction algorithm that can automatically extract a few frames with a low reconstruction error remains a challenge. In this paper, we propose a novel model of structured sparse-coding-based key frame extraction, wherein a nonconvex group log-regularizer is used with strong sparsity and a low reconstruction error. To automatically extract key frames, a decomposition scheme is designed to separate the sparse coefficient matrix by rows. The rows enforced by the nonconvex group log-regularizer become zero or nonzero, leading to the learning of the structured sparse coefficient matrix. To solve the nonconvex problems due to the log-regularizer, the difference of convex algorithm (DCA) is employed to decompose the log-regularizer into the difference of two convex functions related to the I{$_1$} norm, which can be directly obtained through the proximal operator. Therefore, an efficient structured sparse coding algorithm with the group log-regularizer for key frame extraction is developed, which can automatically extract a few frames directly from the video to represent the entire video with a low reconstruction error. Experimental results demonstrate that the proposed algorithm can extract more accurate key frames from most SumMe videos compared to the state-of-the-art methods. Furthermore, the proposed algorithm can obtain a higher compression with a nearly 18\% increase compared to sparse modeling representation selection (SMRS) and an 8\% increase compared to SC-det on the VSUMM dataset.},
  langid = {english},
  keywords = {Approximation algorithms,Data mining,Difference of convex algorithm (DCA),Encoding,group log-regularizer,Heuristic algorithms,key frame extraction,Matrix decomposition,Optimization,Sparse matrices,structured sparse coding},
  annotation = {abstractTranslation: まばらなコーディングに基づいたキーフレーム抽出は、連続フレームの冗長性を減らし、ビデオ全体を簡潔に表現することができます。ただし、再構成エラーが低い場合に数フレームを自動的に抽出できるキーフレーム抽出アルゴリズムを開発する方法は依然として課題です。このホワイトペーパーでは、構造化されたスパースコードベースのキーフレーム抽出の新しいモデルを提案します。これは、強力なスパース性と低再構成エラーで使用されていないグループログレルガイザーが使用されます。キーフレームを自動的に抽出するために、分解スキームは、スパース係数マトリックスを行ごとに分離するように設計されています。非コンベックスグループログレルガイザーによって施行される行はゼロまたは非ゼロになり、構造化されたスパース係数マトリックスの学習につながります。ログ - 正規者による非凸の問題を解決するために、凸アルゴリズム（DCA）の違いを採用して、対数正規者をI1 NORMに関連する2つの凸関数の差に分解します。 。したがって、キーフレーム抽出のためのグループログ - レナジライザーを備えた効率的な構造化されたスパースコーディングアルゴリズムが開発され、ビデオ全体を直接抽出して、再構成エラーが低いビデオ全体を表すことができます。実験結果は、提案されたアルゴリズムが、最先端の方法と比較して、ほとんどのSummeビデオからより正確なキーフレームを抽出できることを示しています。さらに、提案されたアルゴリズムは、SOMSMMデータセットのSC-detと比較して、スパースモデリング表現の選択（SMRS）と比較して、ほぼ18％の増加でより高い圧縮を取得できます。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\Y7NBFFJS\\Li et al. - 2022 - Structured Sparse Coding With the Group Log-regularizer for Key Frame Extraction.pdf;C\:\\Users\\furuh\\Zotero\\storage\\BSG4LPDX\\9774986.html}
}

@inproceedings{liSurveyImplicitBias2022,
  title = {A {{Survey}} on {{Implicit Bias}} of {{Gradient Descent}}},
  booktitle = {2022 14th {{International Conference}} on {{Computer Research}} and {{Development}} ({{ICCRD}})},
  author = {Li, Peiyan and Liang, Xu and Song, Haochen},
  year = {2022},
  month = jan,
  pages = {108--114},
  doi = {10.1109/ICCRD54409.2022.9730384},
  abstract = {Gradient descent, as an optimization method in training models, is of great appliances due to its low cost and explanatory ability. However, the fact that over-parameterization models prevent itself from overfitting without explicit regularizations remains unsolved. There are a tremendous amount of papers focusing on explaining such implicit bias for different models and spaces. This paper will present a mixed review on most of the current research of such bias. Multiple types of implicit bias are suggested throughout the paper, alongside their behavior analysis. Contents are ordered logistically from how the bias was first discovered, followed by the connection between explicit regularization and implicit bias. Next, the converging behavior of the predictor space in different networks is divided into various cases and detailly explained. There is further discussion on the existence of zero training loss on an over-parameterized model. The paper then develops more generally towards different types of datasets and introduces why some common assumptions about the convergence could be removed. Finally, some discussion about how work can be improved in the future is provided at the end of the paper.},
  keywords = {Computational modeling,Costs,explicit bias,Focusing,gradient descent,History,implicit bias,neural network,optimization,Optimization methods,Research and development,Training,training loss},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\YLCM6RK3\\Li et al. - 2022 - A Survey on Implicit Bias of Gradient Descent.pdf;C\:\\Users\\furuh\\Zotero\\storage\\BKM2FNDZ\\9730384.html}
}

