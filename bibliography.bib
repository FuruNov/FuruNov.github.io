@article{louizosLearningSparseNeural2017,
  title = {Learning {{Sparse Neural Networks}} through {{L0 Regularization}}},
  author = {Louizos, Christos and Welling, M. and Kingma, Diederik P.},
  year = {2017},
  month = dec,
  journal = {ArXiv},
  doi = {10.48550/arxiv.1712.01312},
  urldate = {2024-09-26},
  abstract = {We propose a practical method for \$L\_0\$ norm regularization for neural networks: pruning the network during training by encouraging weights to become exactly zero. Such regularization is interesting since (1) it can greatly speed up training and inference, and (2) it can improve generalization. AIC and BIC, well-known model selection criteria, are special cases of \$L\_0\$ regularization. However, since the \$L\_0\$ norm of weights is non-differentiable, we cannot incorporate it directly as a regularization term in the objective function. We propose a solution through the inclusion of a collection of non-negative stochastic gates, which collectively determine which weights to set to zero. We show that, somewhat surprisingly, for certain distributions over the gates, the expected \$L\_0\$ norm of the resulting gated weights is differentiable with respect to the distribution parameters. We further propose the {\textbackslash}emph\{hard concrete\} distribution for the gates, which is obtained by "stretching" a binary concrete distribution and then transforming its samples with a hard-sigmoid. The parameters of the distribution over the gates can then be jointly optimized with the original network parameters. As a result our method allows for straightforward and efficient learning of model structures with stochastic gradient descent and allows for conditional computation in a principled way. We perform various experiments to demonstrate the effectiveness of the resulting approach and regularizer.},
  langid = {american},
  annotation = {abstractTranslation: 我々はニューラルネットワークの\$L\_0\$ノルム正則化のための実用的な方法を提案する。このような正則化は、(1)学習と推論を大幅に高速化できる、(2)汎化を改善できる、という点で興味深い。よく知られたモデル選択基準であるAICとBICは、\$L\_0\$正則化の特別なケースである。しかし、重みの\$L\_0\$ノルムは微分不可能であるため、目的関数の正則化項として直接組み込むことはできない。我々は、どの重みをゼロにするかを決定する、非負の確率ゲートの集合を組み込むことによる解決策を提案する。このゲートは、どの重みをゼロにするかを決定するものである。我々は、ゲート上のある分布について、少々驚くべきことに、結果として得られるゲートの重みの期待\$L\_0\$ノルムは、分布パラメータに関して微分可能であることを示す。さらに、二元具象分布を「伸張」し、そのサンプルをハードシグモイドで変換することによって得られる、ゲートに対する{$\Gamma$}emph\{ハード具象\}分布を提案する。ゲート上の分布のパラメータは、元のネットワークパラメータと共同で最適化することができます。その結果、我々の手法は、確率的勾配降下によるモデル構造の素直で効率的な学習を可能にし、原理的な方法で条件計算を可能にする。得られたアプローチと正則化の有効性を実証するために、様々な実験を行う。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\AN4CKJRF\\Louizos et al. - 2017 - Learning Sparse Neural Networks through L0 Regularization.pdf;C\:\\Users\\furuh\\Zotero\\storage\\FS5SMRWH\\presentlearningsparseneuralnetworksthroughl0regularization-180826154536__1_.pdf}
}

@misc{luBlockSparseTensorRecovery2024,
  title = {Block-{{Sparse Tensor Recovery}}},
  author = {Lu, Liyang and Wang, Zhaocheng and Gao, Zhen and Chen, Sheng and Poor, H. Vincent},
  year = {2024},
  month = feb,
  number = {arXiv:2402.02410},
  eprint = {2402.02410},
  primaryclass = {eess},
  publisher = {arXiv},
  urldate = {2024-04-09},
  abstract = {This work explores the fundamental problem of the recoverability of a sparse tensor being reconstructed from its compressed embodiment. We present a generalized model of block-sparse tensor recovery as a theoretical foundation, where concepts measuring holistic mutual incoherence property (MIP) of the measurement matrix set are defined. A representative algorithm based on the orthogonal matching pursuit (OMP) framework, called tensor generalized block OMP (T-GBOMP), is applied to the theoretical framework elaborated for analyzing both noiseless and noisy recovery conditions. Specifically, we present the exact recovery condition (ERC) and sufficient conditions for establishing it with consideration of different degrees of restriction. Reliable reconstruction conditions, in terms of the residual convergence, the estimated error and the signal-to-noise ratio bound, are established to reveal the computable theoretical interpretability based on the newly defined MIP, which we introduce. The flexibility of tensor recovery is highlighted, i.e., the reliable recovery can be guaranteed by optimizing MIP of the measurement matrix set. Analytical comparisons demonstrate that the theoretical results developed are tighter and less restrictive than the existing ones (if any). Further discussions provide tensor extensions for several classic greedy algorithms, indicating that the sophisticated results derived are universal and applicable to all these tensorized variants.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Electrical Engineering and Systems Science - Signal Processing},
  annotation = {abstractTranslation: この研究では、圧縮された具体化から再構築されるまばらなテンソルの回復可能性の基本的な問題を探ります。測定マトリックスセットの総合的な相互の一貫性プロパティ（MIP）を測定する概念が定義されている理論的基礎として、ブロックスパーステンソル回復の一般化モデルを提示します。テンソル一般化ブロックOMP（T-GBOMP）と呼ばれる直交マッチング追跡（OMP）フレームワークに基づく代表的なアルゴリズムは、ノイズレスとノイズの多い回復条件の両方を分析するために詳述された理論的フレームワークに適用されます。具体的には、異なる程度の制限を考慮してそれを確立するための正確な回復条件（ERC）と十分な条件を提示します。残留収束の観点から、信頼できる再構成条件は、新たに定義されたMIPに基づいて計算可能な理論的解釈可能性を明らかにするために、残留収束、推定誤差、および信号対雑音比を確立します。テンソル回復の柔軟性が強調されています。つまり、測定マトリックスセットのMIPを最適化することにより、信頼できる回復を保証できます。分析的比較は、開発された理論的結果が既存の結果よりも緊密で制限が少ないことを示しています（もしあれば）。さらなる議論は、いくつかの古典的な貪欲なアルゴリズムのテンソル拡張を提供します。これは、導き出された洗練された結果が普遍的であり、これらすべてのテンソレートバリアントに適用可能であることを示しています。},
  file = {C:\Users\furuh\Zotero\storage\8R5YWCFJ\Lu et al. - 2024 - Block-Sparse Tensor Recovery.pdf}
}

