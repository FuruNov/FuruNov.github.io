  journal = {Medical Image Analysis},
  volume = {76},
  pages = {102297},
  issn = {1361-8415},
  doi = {10.1016/j.media.2021.102297},
  urldate = {2024-10-29},
  abstract = {The advances in technologies for acquiring brain imaging and high-throughput genetic data allow the researcher to access a large amount of multi-modal data. Although the sparse canonical correlation analysis is a powerful bi-multivariate association analysis technique for feature selection, we are still facing major challenges in integrating multi-modal imaging genetic data and yielding biologically meaningful interpretation of imaging genetic findings. In this study, we propose a novel multi-task learning based structured sparse canonical correlation analysis (MTS2CCA) to deliver interpretable results and improve integration in imaging genetics studies. We perform comparative studies with state-of-the-art competing methods on both simulation and real imaging genetic data. On the simulation data, our proposed model has achieved the best performance in terms of canonical correlation coefficients, estimation accuracy, and feature selection accuracy. On the real imaging genetic data, our proposed model has revealed promising features of single-nucleotide polymorphisms and brain regions related to sleep. The identified features can be used to improve clinical score prediction using promising imaging genetic biomarkers. An interesting future direction is to apply our model to additional neurological or psychiatric cohorts such as patients with Alzheimer's or Parkinson's disease to demonstrate the generalizability of our method.},
  langid = {american},
  keywords = {Brain imaging genetics,Multi-task learning,Outcome prediction,Sparse canonical correlation analysis},
  annotation = {abstractTranslation: 脳画像やハイスループット遺伝子データの取得技術の進歩により、研究者は大量のマルチモーダルデータにアクセスできるようになった。スパース正準相関分析は、特徴選択のための強力な2変量関連解析手法であるが、マルチモーダル画像遺伝データを統合し、画像遺伝学的知見の生物学的に意味のある解釈を得る上で、我々は依然として大きな課題に直面している。本研究では、解釈可能な結果を提供し、画像遺伝学研究における統合を改善するために、新しいマルチタスク学習に基づく構造化スパース正準相関分析（MTS2CCA）を提案する。シミュレーションデータと実際の画像遺伝データを用いて、最新の競合手法との比較研究を行った。シミュレーションデータにおいて、我々の提案モデルは正準相関係数、推定精度、特徴選択精度において最高の性能を達成した。実画像遺伝データにおいて、提案モデルは睡眠に関連する一塩基多型と脳領域の有望な特徴を明らかにした。この特徴量は、有望な画像遺伝学的バイオマーカーを用いた臨床スコア予測の改善に利用できる。今後の興味深い方向性としては、アルツハイマー病やパーキンソン病患者などの神経学的または精神医学的コホートに我々のモデルを適用し、我々の手法の一般性を実証することである。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\GKMZLMHW\\Kim et al. - 2022 - Multi-task learning based structured sparse canonical correlation analysis for brain imaging genetic.pdf;C\:\\Users\\furuh\\Zotero\\storage\\PVUEAZUI\\S136184152100342X.html}
}

@article{kimNeuralArchitectureSearch2022,
  title = {Neural {{Architecture Search}} for {{Spiking Neural Networks}}},
