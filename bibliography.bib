  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2211.15231},
  urldate = {2023-01-03},
  abstract = {Deep neural networks are susceptible to shortcut learning, using simple features to achieve low training loss without discovering essential semantic structure. Contrary to prior belief, we show that generative models alone are not sufficient to prevent shortcut learning, despite an incentive to recover a more comprehensive representation of the data than discriminative approaches. However, we observe that shortcuts are preferentially encoded with minimal information, a fact that generative models can exploit to mitigate shortcut learning. In particular, we propose Chroma-VAE, a two-pronged approach where a VAE classifier is initially trained to isolate the shortcut in a small latent subspace, allowing a secondary classifier to be trained on the complementary, shortcut-free latent subspace. In addition to demonstrating the efficacy of Chroma-VAE on benchmark and real-world shortcut learning tasks, our work highlights the potential for manipulating the latent space of generative classifiers to isolate or interpret specific correlations.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning},
  file = {C:\Users\furuh\Zotero\storage\9QFM7J34\Yang et al_2022_Chroma-VAE.pdf}
}

@article{yangConstructingHighorderFunctional2023,
  title = {Constructing High-Order Functional Networks Based on Hypergraph for Diagnosis of Autism Spectrum Disorders},
  author = {Yang, Jie and Wang, Fang and Li, Zhen and Yang, Zhen and Dong, Xishang and Han, Qinghua},
  year = {2023},
  month = aug,
  journal = {Frontiers in Neuroscience},
  volume = {17},
  issn = {1662-453X},
  doi = {10.3389/fnins.2023.1257982},
  urldate = {2024-08-28},
  abstract = {{$<$}sec{$><$}title{$>$}Introduction{$<$}/title{$><$}p{$>$}High-order functional connectivity networks (FCNs) that reflect the connection relationships among multiple brain regions have become important tools for exploring the deep workings of the brain and revealing the mechanisms of brain diseases. The traditional high-order FCN constructed based on the ``correlation of correlations'' strategy, is a representative method for conducting whole-brain connectivity analysis and revealing global network characteristics. However, whole-brain connectivity analysis may be affected by noise carried by less important brain regions, resulting in redundant information and affecting the accuracy and reliability of the analysis. Moreover, this type of analysis has a high computational complexity.{$<$}/p{$><$}/sec{$><$}sec{$><$}title{$>$}Methods{$<$}/title{$><$}p{$>$}To address these issues, a new method for constructing high-order FCN based on hypergraphs is proposed in this article, which is used to accurately capture the real interaction relationships among brain regions. Specifically, first, a low-order FCN reflecting the connection relationships between pairs of brain regions based on resting-state functional Magnetic Resonance Imaging (rs-fMRI) time series is constructed, the method first constructs the low-order FCN that reflects the connection relationships between pairs of brain regions based on rs-fMRI time series, and then selects the ``good friends'' of each brain region from hypergraph perspective, which refers to the local friend circles with closer relationships. Then, the rs-fMRI time series corresponding to the ``good friends'' in each brain region's friend circle are averaged to obtain a sequence that reflects the intimacy between brain regions in each friend circle. Finally, hypergraph high-order FCN, which reflects the interaction relationships among multiple brain regions, is obtained by calculating the correlations based on the sequence of friend circles.{$<$}/p{$><$}/sec{$><$}sec{$><$}title{$>$}Results{$<$}/title{$><$}p{$>$}The experimental results demonstrate that the proposed method outperforms traditional high-order FCN construction methods. Furthermore, integrating the high-order FCN constructed based on hypergraphs and the low-order FCN through feature fusion to achieve complementary information improves the accuracy of assisting in the diagnosis of brain diseases.{$<$}/p{$><$}/sec{$><$}sec{$><$}title{$>$}Discussion{$<$}/title{$><$}p{$>$}In addition, the effectiveness of our method has only been validated in the diagnosis of ASD. For future work, we plan to extend this method to other brain connectivity patterns.{$<$}/p{$><$}/sec{$>$}},
  langid = {american},
  keywords = {Autism spectrum disorder (ASD),Classification fusion,high-order functional connectivity network,Hypergraph,Resting-state functional magnetic resonance imaging (rs-fMRI)},
  annotation = {abstractTranslation: {$<$}sec{$><$}title{$>$}はじめに{$<$}/title{$><$}p{$>$}複数の脳領域間の結合関係を反映する高次機能的結合ネットワーク（FCN）は、脳の深部の働きを探り、脳疾患のメカニズムを明らかにするための重要なツールとなっている。相関の相関」戦略に基づいて構築された従来の高次FCNは、全脳結合解析を行い、グローバルなネットワーク特性を明らかにする代表的な手法である。しかし、全脳結合解析は、重要度の低い脳領域が持つノイズの影響を受け、冗長な情報となり、解析の精度や信頼性に影響を与える可能性がある。{$<$}/p{$><$}/sec{$><$}title{$>$}方法{$<$}/title{$><$}p{$>$}これらの問題を解決するために、本稿ではハイパーグラフに基づく高次FCNを構築する新しい方法を提案し、これを用いて脳領域間の実際の相互作用関係を正確に捉える。具体的には、まず、安静時機能的磁気共鳴画像法(rs-fMRI)の時系列に基づいて、脳領域のペア間の接続関係を反映した低次FCNを構築し、ハイパーグラフの観点から、各脳領域の「仲の良い友達」（より関係の深いローカルな友達サークルを指す）を選択する。そして、各脳領域のフレンドサークル内の「仲良し」に対応するrs-fMRI時系列を平均化し、各フレンドサークル内の脳領域間の親密度を反映するシーケンスを得る。最後に、複数の脳領域間の相互作用関係を反映するハイパーグラフ高次FCNを、友人サークルのシーケンスに基づいて相関を計算することで得る。{$<$}/p{$><$}/sec{$><$}sec{$><$}title{$>$}結果{$<$}/title{$><$}p{$>$}実験結果は、提案手法が従来の高次FCN構築手法を凌駕することを示している。さらに、ハイパーグラフに基づいて構築された高次FCNと特徴量融合による低次FCNを統合し、相補的な情報を得ることで、脳疾患の診断支援精度が向上する。{$<$}/p{$><$}/sec{$><$}title{$>$}考察{$<$}/title{$><$}p{$>$}なお、本手法の有効性はASDの診断においてのみ検証されている。今後の課題として、この方法を他の脳結合パターンに拡張する予定である。},
  file = {C:\Users\furuh\Zotero\storage\5PXQQYQJ\Yang et al. - 2023 - Constructing high-order functional networks based on hypergraph for diagnosis of autism spectrum dis.pdf}
}

