  doi = {10.1109/INFCOM.2011.5935018},
  urldate = {2024-11-29},
  abstract = {In this paper, motivated by network inference and tomography applications, we study the problem of compressive sensing for sparse signal vectors over graphs. In particular, we are interested in recovering sparse vectors representing the properties of the edges from a graph. Unlike existing compressive sensing results, the collective additive measurements we are allowed to take must follow connected paths over the underlying graph. For a sufficiently connected graph with n nodes, it is shown that, using O(k log(n)) path measurements, we are able to recover any k-sparse link vector (with no more than k nonzero elements), even though the measurements have to follow the graph path constraints. We mainly show that the computationally efficient {$\ell$}1 minimization can provide theoretical guarantees for inferring such k-sparse vectors with O(k log(n)) path measurements from the graph.},
  langid = {american},
  keywords = {Bipartite graph,Compressed sensing,Delay,Indexes,Minimization,Testing,Tomography},
  annotation = {abstractTranslation: 本論文では、ネットワーク推論とトモグラフィの応用を動機として、グラフ上の疎な信号ベクトルの圧縮センシング問題を研究する。特に、グラフからエッジの特性を表す疎なベクトルを復元することに興味がある。既存の圧縮センシングの結果とは異なり、我々が取ることを許される集合的な加算測定は、基礎となるグラフ上の連結経路に従わなければならない。n個のノードを持つ十分に連結されたグラフに対して、O(k log(n))個のパス計測を用いると、計測がグラフのパス制約に従わなければならないにもかかわらず、任意のk個の疎なリンクベクトル（k個以下の非ゼロ要素を持つ）を回復できることが示される。我々は主に、計算効率の良いl1最小化により、グラフからO(k log(n))個のパス測定値を用いて、このようなk個の疎なベクトルを推論することが理論的に保証されることを示す。},
