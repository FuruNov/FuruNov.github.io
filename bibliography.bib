@inproceedings{chenOnlyTrainOnce2021,
  title = {Only {{Train Once}}: {{A One-Shot Neural Network Training And Pruning Framework}}},
  shorttitle = {Only {{Train Once}}},
  booktitle = {Neural {{Information Processing Systems}}},
  author = {Chen, Tianyi and Ji, Bo and Ding, Tianyu and Fang, Biyi and Wang, Guanyi and Zhu, Zhihui and Liang, Luming and Shi, Yixin and Yi, Sheng and Tu, Xiao},
  year = {2021},
  month = jul,
  urldate = {2024-10-28},
  abstract = {Structured pruning is a commonly used technique in deploying deep neural networks (DNNs) onto resource-constrained devices. However, the existing pruning methods are usually heuristic, task-specified, and require an extra fine-tuning procedure. To overcome these limitations, we propose a framework that compresses DNNs into slimmer architectures with competitive performances and significant FLOPs reductions by Only-Train-Once (OTO). OTO contains two keys: (i) we partition the parameters of DNNs into zero-invariant groups, enabling us to prune zero groups without affecting the output; and (ii) to promote zero groups, we then formulate a structured-sparsity optimization problem and propose a novel optimization algorithm, Half-Space Stochastic Projected Gradient (HSPG), to solve it, which outperforms the standard proximal methods on group sparsity exploration and maintains comparable convergence. To demonstrate the effectiveness of OTO, we train and compress full models simultaneously from scratch without fine-tuning for inference speedup and parameter reduction, and achieve state-of-the-art results on VGG16 for CIFAR10, ResNet50 for CIFAR10 and Bert for SQuAD and competitive result on ResNet50 for ImageNet. The source code is available at https://github.com/tianyic/only\_train\_once.},
  langid = {american},
  annotation = {abstractTranslation: 構造化刈り込みは、リソースに制約のあるデバイスにディープニューラルネットワーク（DNN）を展開する際によく使われる手法である。しかし、既存の刈り込み手法は、通常、発見的で、タスクが特定され、余分な微調整手順を必要とする。これらの限界を克服するために、我々はOnly-Train-Once（OTO）により、DNNをよりスリムなアーキテクチャに圧縮し、競争力のある性能と大幅なFLOPs削減を実現するフレームワークを提案する。OTOには2つの鍵が含まれる：(i)DNNのパラメータをゼロ不変グループに分割し、出力に影響を与えることなくゼログループの刈り込みを可能にする、(ii)ゼログループを促進するために、構造化スパース最適化問題を定式化し、それを解くための新しい最適化アルゴリズムであるHSPG（Half-Space Stochastic Projected Gradient）を提案する。OTOの有効性を実証するため、推論高速化とパラメータ削減のための微調整を行わず、ゼロからフルモデルの学習と圧縮を同時に行い、CIFAR10のVGG16、CIFAR10のResNet50、SQuADのBertで最先端の結果を、ImageNetのResNet50で競争力のある結果を達成した。ソースコードはhttps://github.com/tianyic/only\_train\_once。},
  file = {C:\Users\furuh\Zotero\storage\X9STQRGK\Chen et al. - 2021 - Only Train Once A One-Shot Neural Network Training And Pruning Framework.pdf}
}

@misc{chenPhysicsinformedNeuralNetworks2020,
  title = {Physics-Informed Neural Networks for Inverse Problems in Nano-Optics and Metamaterials},
  author = {Chen, Yuyao and Lu, Lu and Karniadakis, George Em and Negro, Luca Dal},
  year = {2020},
  month = mar,
  number = {arXiv:1912.01085},
  eprint = {1912.01085},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1912.01085},
  urldate = {2024-11-12},
  abstract = {In this paper we employ the emerging paradigm of physics-informed neural networks (PINNs) for the solution of representative inverse scattering problems in photonic metamaterials and nano-optics technologies. In particular, we successfully apply mesh-free PINNs to the difficult task of retrieving the effective permittivity parameters of a number of finite-size scattering systems that involve many interacting nanostructures as well as multi-component nanoparticles. Our methodology is fully validated by numerical simulations based on the Finite Element Method (FEM). The development of physics-informed deep learning techniques for inverse scattering can enable the design of novel functional nanostructures and significantly broaden the design space of metamaterials by naturally accounting for radiation and finite-size effects beyond the limitations of traditional effective medium theories.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Physics - Computational Physics,Physics - Optics},
  annotation = {abstractTranslation: 本論文では、フォトニックメタマテリアルとナノオプティクス技術における代表的な逆散乱問題を解くために、物理情報ニューラルネットワーク（PINN）という新しいパラダイムを採用する。特に、多数の相互作用するナノ構造や多成分ナノ粒子を含む有限サイズ散乱系の実効誘電率パラメータを求めるという困難な課題に対して、メッシュフリーPINNを適用することに成功した。我々の方法論は、有限要素法（FEM）に基づく数値シミュレーションによって完全に検証されている。逆散乱のための物理情報に基づくディープラーニング技術の開発により、新規機能性ナノ構造の設計が可能になり、従来の有効媒質理論の限界を超えた輻射効果と有限サイズ効果を自然に考慮することで、メタマテリアルの設計空間を大幅に広げることができる。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\ZLHZE2HY\\Chen et al. - 2020 - Physics-informed neural networks for inverse problems in nano-optics and metamaterials.pdf;C\:\\Users\\furuh\\Zotero\\storage\\5JW4UHKY\\1912.html}
}

@misc{chenPhysicsInformedNeuralNetworks2024,
  title = {Physics-{{Informed Neural Networks}} with {{Hard Linear Equality Constraints}}},
  author = {Chen, Hao and Flores, Gonzalo E. Constante and Li, Can},
  year = {2024},
  month = feb,
  number = {arXiv:2402.07251},
  eprint = {2402.07251},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2402.07251},
  urldate = {2025-02-10},
  abstract = {Surrogate modeling is used to replace computationally expensive simulations. Neural networks have been widely applied as surrogate models that enable efficient evaluations over complex physical systems. Despite this, neural networks are data-driven models and devoid of any physics. The incorporation of physics into neural networks can improve generalization and data efficiency. The physics-informed neural network (PINN) is an approach to leverage known physical constraints present in the data, but it cannot strictly satisfy them in the predictions. This work proposes a novel physics-informed neural network, KKT-hPINN, which rigorously guarantees hard linear equality constraints through projection layers derived from KKT conditions. Numerical experiments on Aspen models of a continuous stirred-tank reactor (CSTR) unit, an extractive distillation subsystem, and a chemical plant demonstrate that this model can further enhance the prediction accuracy.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Machine Learning,Mathematics - Optimization and Control},
  annotation = {abstractTranslation: 代理モデリングは、計算上の高価なシミュレーションを置き換えるために使用されます。ニューラルネットワークは、複雑な物理システムよりも効率的な評価を可能にする代理モデルとして広く適用されています。それにもかかわらず、ニューラルネットワークはデータ駆動型モデルであり、物理学がありません。物理学をニューラルネットワークに組み込むと、一般化とデータ効率が向上する可能性があります。物理学に基づいたニューラルネットワーク（PINN）は、データに存在する既知の物理的制約を活用するアプローチですが、予測では厳密に満たすことはできません。この作業は、新しい物理学に基づいたニューラルネットワークであるKKT-HPINNを提案します。これは、KKT条件から派生した投影層を介して硬い線形等式制約を厳密に保証します。連続攪拌タンク反応器（CSTR）ユニット、抽出蒸留サブシステムのアスペンモデルに関する数値実験、および化学プラントは、このモデルが予測精度をさらに高めることができることを示しています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\LBSLSLWQ\\Chen et al. - 2024 - Physics-Informed Neural Networks with Hard Linear Equality Constraints.pdf;C\:\\Users\\furuh\\Zotero\\storage\\AQMXJU5U\\2402.html}
}

@article{chenPortableNanoporesequencingTechnology2023,
  title = {Portable Nanopore-Sequencing Technology: {{Trends}} in Development and Applications},
  shorttitle = {Portable Nanopore-Sequencing Technology},
  author = {Chen, Pin and Sun, Zepeng and Wang, Jiawei and Liu, Xinlong and Bai, Yun and Chen, Jiang and Liu, Anna and Qiao, Feng and Chen, Yang and Yuan, Chenyan and Sha, Jingjie and Zhang, Jinghui and Xu, Li-Qun and Li, Jian},
  year = {2023},
  journal = {Frontiers in Microbiology},
  volume = {14},
  pages = {1043967},
  issn = {1664-302X},
  doi = {10.3389/fmicb.2023.1043967},
  abstract = {Sequencing technology is the most commonly used technology in molecular biology research and an essential pillar for the development and applications of molecular biology. Since 1977, when the first generation of sequencing technology opened the door to interpreting the genetic code, sequencing technology has been developing for three generations. It has applications in all aspects of life and scientific research, such as disease diagnosis, drug target discovery, pathological research, species protection, and SARS-CoV-2 detection. However, the first- and second-generation sequencing technology relied on fluorescence detection systems and DNA polymerization enzyme systems, which increased the cost of sequencing technology and limited its scope of applications. The third-generation sequencing technology performs PCR-free and single-molecule sequencing, but it still depends on the fluorescence detection device. To break through these limitations, researchers have made arduous efforts to develop a new advanced portable sequencing technology represented by nanopore sequencing. Nanopore technology has the advantages of small size and convenient portability, independent of biochemical reagents, and direct reading using physical methods. This paper reviews the research and development process of nanopore sequencing technology (NST) from the laboratory to commercially viable tools; discusses the main types of nanopore sequencing technologies and their various applications in solving a wide range of real-world problems. In addition, the paper collates the analysis tools necessary for performing different processing tasks in nanopore sequencing. Finally, we highlight the challenges of NST and its future research and application directions.},
  langid = {american},
  pmcid = {PMC9929578},
  pmid = {36819021},
  keywords = {application,challenge,development,portable nanopore-sequencing technology,protein nanopore,solid-state nanopore},
  annotation = {abstractTranslation: シーケンシング技術は、分子生物学研究において最も一般的に使用されている技術であり、分子生物学の発展と応用に不可欠な柱である。1977年に第1世代のシークエンシング技術が遺伝暗号解釈への扉を開いて以来、シークエンシング技術は3世代にわたって発展してきた。疾病診断、創薬標的の発見、病理学的研究、種の保護、SARS-CoV-2の検出など、生命と科学研究のあらゆる側面に応用されている。しかし、第1世代と第2世代のシーケンシング技術は、蛍光検出システムとDNA重合酵素システムに依存しており、シーケンシング技術のコストが上昇し、応用範囲が限られていた。第3世代のシークエンシング技術は、PCRフリーで1分子シークエンシングを行うが、依然として蛍光検出装置に依存している。このような限界を打破するため、研究者たちはナノポアシーケンスに代表される新しい先進的なポータブルシーケンステクノロジーを開発するために奮闘してきた。ナノポア技術は、小型で携帯に便利であり、生化学試薬に依存せず、物理的手法で直接読み取れるという利点がある。本論文では、ナノポアシークエンシング技術（NST）の研究室から商業的に利用可能なツールに至るまでの研究開発プロセスをレビューし、ナノポアシークエンシング技術の主な種類と、実世界の様々な問題を解決するための様々なアプリケーションについて議論する。さらに、ナノポアシークエンシングにおけるさまざまな処理タスクの実行に必要な解析ツールについてもまとめている。最後に、NSTの課題と今後の研究および応用の方向性を強調する。},
  file = {C:\Users\furuh\Zotero\storage\NLHVXDVT\Chen et al. - 2023 - Portable nanopore-sequencing technology Trends in development and applications.pdf}
}

@article{chenPredictionPerformanceAnalysis2025,
  title = {The {{Prediction Performance Analysis}} of the {{Lasso Model}} with {{Convex Non-Convex Sparse Regularization}}},
  author = {Chen, Wei and Liu, Qiuyue and Li, Hancong and Zou, Jian},
  year = {2025},
  month = apr,
  journal = {Algorithms},
  volume = {18},
  number = {4},
  pages = {195},
  issn = {1999-4893},
  doi = {10.3390/a18040195},
  urldate = {2025-04-06},
  abstract = {The incorporation of {$\ell$}1 regularization in Lasso regression plays a crucial role by inducing convexity to the objective function, thereby facilitating its minimization; when compared to non-convex regularization, the utilization of {$\ell$}1 regularization introduces bias through artificial coefficient shrinkage towards zero. Recently, the convex non-convex (CNC) regularization framework has emerged as a powerful technique that enables the incorporation of non-convex regularization terms while maintaining the overall convexity of the optimization problem. Although this method has shown remarkable performance in various empirical studies, its theoretical understanding is still relatively limited. In this paper, we provide a theoretical investigation into the prediction performance of the Lasso model with CNC sparse regularization. By leveraging oracle inequalities, we establish a tighter upper bound on prediction performance compared to the traditional {$\ell$}1 regularizer. Additionally, we propose an alternating direction method of multipliers (ADMM) algorithm to efficiently solve the proposed model and rigorously analyze its convergence property. Our numerical results, evaluated on both synthetic data and real-world magnetic resonance imaging (MRI) reconstruction tasks, confirm the superior effectiveness of our proposed approach.},
  copyright = {https://creativecommons.org/licenses/by/4.0/},
  langid = {english},
  annotation = {abstractTranslation: Lasso回帰におけるL1正則化の導入は、目的関数の凸性を誘導し、その最小化を容易にする上で極めて重要な役割を果たします。非凸正則化と比較すると、L1正則化は人工的な係数のゼロへの収縮を通じてバイアスを導入します。近年、凸非凸（CNC）正則化フレームワークが、非凸正則化項を組み込みながら最適化問題全体の凸性を維持できる強力な手法として台頭しています。この方法は様々な経験的研究で顕著な性能を示していますが、その理論的理解はまだ比較的限られています。本論文では、CNCスパース正則化を用いたLassoモデルの予測性能に関する理論的研究を行います。オラクル不等式を活用することにより、従来のL1正則化器と比較して、予測性能の上限をより厳密に設定します。さらに、提案モデルを効率的に解くためのAlternating Direction Method of Multipliers（ADMM）アルゴリズムを提案し、その収束特性を厳密に分析します。合成データと現実世界の磁気共鳴画像（MRI）再構成タスクの両方で評価された数値結果は、提案手法の優れた有効性を確認しています。},
  file = {C:\Users\furuh\Zotero\storage\4RCJL5YI\Chen et al. - 2025 - The Prediction Performance Analysis of the Lasso Model with Convex Non-Convex Sparse Regularization.pdf}
}

@article{chenRecursiveL1Infty2012,
  title = {Recursive L1, Infty {{Group Lasso}}},
  author = {Chen, Yilun and Hero, Alfred O.},
  year = {2012},
  month = aug,
  journal = {IEEE Transactions on Signal Processing},
  volume = {60},
  number = {8},
  pages = {3978--3987},
  issn = {1941-0476},
  doi = {10.1109/TSP.2012.2192924},
  urldate = {2025-04-02},
  abstract = {We introduce a recursive adaptive group lasso algorithm for real-time penalized least squares prediction that produces a time sequence of optimal sparse predictor coefficient vectors. At each time index the proposed algorithm computes an exact update of the optimal {$\ell$}1,{$\infty$}-penalized recursive least squares (RLS) predictor. Each update minimizes a convex but nondifferentiable function optimization problem. We develop an on-line homotopy method to reduce the computational complexity. Numerical simulations demonstrate that the proposed algorithm outperforms the {$\ell$}1 regularized RLS algorithm for a group sparse system identification problem and has lower implementation complexity than direct group lasso solvers.},
