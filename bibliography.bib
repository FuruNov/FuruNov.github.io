@inproceedings{reddynareddyIntriguingObservationsLearnt2025,
  title = {Some {{Intriguing Observations}} on the {{Learnt Matrices}} in {{Deep Unfolded Networks}}},
  booktitle = {{{ICASSP}} 2025 - 2025 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {Reddy Nareddy, Kartheek Kumar and Perumal, Inbasekaran and Seelamantula, Chandra Sekhar},
  year = {2025},
  month = apr,
  pages = {1--5},
  issn = {2379-190X},
  doi = {10.1109/ICASSP49660.2025.10890318},
  urldate = {2025-03-13},
  abstract = {Deep-unfolded networks (DUNs) have set new performance benchmarks in fields such as compressed sensing, image restoration, and wireless communications. DUNs are built from conventional iterative algorithms, where an iteration is transformed into a layer/block of a network with learnable parameters. Despite their huge success, the reasons behind their superior performance over their iterative counterparts are not fully understood. This paper focuses on enhancing the explainability of DUNs by investigating potential reasons behind their superior performance over traditional iterative methods. We concentrate on the Learnt Iterative Shrinkage-Thresholding Algorithm (LISTA), a foundational contribution that achieves sparse recovery with significantly fewer layers than its iterative counterpart, ISTA. Our findings reveal that the learnt matrices in LISTA always have Gaussian distributed entries regardless of whether the sensing matrix is random Gaussian, Bernoulli, exponential, or uniform. The findings also show that the singular values of the learnt matrices exceed unity, despite which, the reconstruction scheme is stable. We conjecture that the activation function may have a role to play in ensuring stability. We also present an unbiasing technique that substantially improves the sparse recovery performance by reestimating the amplitudes based on the converged support.},
  langid = {english},
  keywords = {Accuracy,Convergence,deep-unfolded networks,Gaussian distribution,Image reconstruction,Iterative algorithms,iterative shrinkage-thresholding algorithm (ISTA),learnt ISTA (LISTA),Signal processing algorithms,Sparse matrices,sparse signal recovery,Superresolution,Training,Wireless communication},
  annotation = {abstractTranslation: ディープウンフォールドネットワーク（DUNS）は、圧縮センシング、画像修復、ワイヤレス通信などのフィールドで新しいパフォーマンスベンチマークを設定しています。 DUNSは、従来の反復アルゴリズムから構築されており、そこでは、学習可能なパラメーターを備えたネットワークのレイヤー/ブロックに反復が変換されます。彼らの大成功にもかかわらず、反復的なカウンターパートよりも優れたパフォーマンスの背後にある理由は完全には理解されていません。このペーパーでは、従来の反復方法よりも優れたパフォーマンスの背後にある潜在的な理由を調査することにより、DUNの説明可能性を高めることに焦点を当てています。学習した反復収縮科目アルゴリズム（LISTA）に集中します。これは、反復的な対応物であるISTAよりも大幅に少ない層でスパースリカバリを達成する基本的な貢献です。私たちの調査結果は、Listaの学習されたマトリックスには、センシングマトリックスがランダムガウス、ベルヌーリ、指数関数、または均一であるかどうかに関係なく、常にガウス分布エントリがあることが明らかになりました。調査結果はまた、学習されたマトリックスの特異な値が統一を超えていることを示していますが、それにもかかわらず、再構成スキームは安定しています。アクティベーション関数が安定性を確保する上で役割を果たす可能性があると推測します。また、収束したサポートに基づいて振幅を再発見することにより、まばらな回復パフォーマンスを大幅に改善する未塩の技術も提示します。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\CI8YSE2G\\Reddy Nareddy et al. - 2025 - Some Intriguing Observations on the Learnt Matrices in Deep Unfolded Networks.pdf;C\:\\Users\\furuh\\Zotero\\storage\\NFPFZ66T\\10890318.html}
}

@article{redmanKoopmanModeDecomposition2021,
  title = {On {{Koopman Mode Decomposition}} and {{Tensor Component Analysis}}},
  author = {Redman, William T.},
  year = {2021},
  month = may,
  journal = {Chaos: An Interdisciplinary Journal of Nonlinear Science},
  volume = {31},
  number = {5},
  eprint = {2101.00555},
  primaryclass = {cs, math},
  pages = {051101},
  issn = {1054-1500, 1089-7682},
  doi = {10.1063/5.0046325},
  urldate = {2023-07-01},
  abstract = {Koopman mode decomposition and tensor component analysis (also known as CANDECOMP/PARAFAC or canonical polyadic decomposition) are two popular approaches of decomposing high dimensional data sets into low dimensional modes that capture the most relevant features and/or dynamics. Despite their similar goal, the two methods are largely used by different scientific communities and formulated in distinct mathematical languages. We examine the two together and show that, under a certain (reasonable) condition on the data, the theoretical decomposition given by tensor component analysis is the {\textbackslash}textit\{same\} as that given by Koopman mode decomposition. This provides a "bridge" with which the two communities should be able to more effectively communicate. When this condition is not met, Koopman mode decomposition still provides a tensor decomposition with an {\textbackslash}textit\{a priori\} computable error, providing an alternative to the non-convex optimization that tensor component analysis requires. Our work provides new possibilities for algorithmic approaches to Koopman mode decomposition and tensor component analysis, provides a new perspective on the success of tensor component analysis, and builds upon a growing body of work showing that dynamical systems, and Koopman operator theory in particular, can be useful for problems that have historically made use of optimization theory.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Numerical Analysis},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\AQBNGXDX\\Redman - 2021 - On Koopman Mode Decomposition and Tensor Component.pdf;C\:\\Users\\furuh\\Zotero\\storage\\N4G2PR92\\2101.html}
}

@misc{reehorstRegularizationDenoisingClarifications2018,
  title = {Regularization by {{Denoising}}: {{Clarifications}} and {{New Interpretations}}},
  shorttitle = {Regularization by {{Denoising}}},
  author = {Reehorst, Edward T. and Schniter, Philip},
  year = {2018},
  month = nov,
  number = {arXiv:1806.02296},
  eprint = {1806.02296},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1806.02296},
  urldate = {2024-07-26},
  abstract = {Regularization by Denoising (RED), as recently proposed by Romano, Elad, and Milanfar, is powerful image-recovery framework that aims to minimize an explicit regularization objective constructed from a plug-in image-denoising function. Experimental evidence suggests that the RED algorithms are state-of-the-art. We claim, however, that explicit regularization does not explain the RED algorithms. In particular, we show that many of the expressions in the paper by Romano et al. hold only when the denoiser has a symmetric Jacobian, and we demonstrate that such symmetry does not occur with practical denoisers such as non-local means, BM3D, TNRD, and DnCNN. To explain the RED algorithms, we propose a new framework called Score-Matching by Denoising (SMD), which aims to match a "score" (i.e., the gradient of a log-prior). We then show tight connections between SMD, kernel density estimation, and constrained minimum mean-squared error denoising. Furthermore, we interpret the RED algorithms from Romano et al. and propose new algorithms with acceleration and convergence guarantees. Finally, we show that the RED algorithms seek a consensus equilibrium solution, which facilitates a comparison to plug-and-play ADMM.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computer Vision and Pattern Recognition},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\7W5ZIMWE\\Reehorst and Schniter - 2018 - Regularization by Denoising Clarifications and Ne.pdf;C\:\\Users\\furuh\\Zotero\\storage\\HX36NE2V\\1806.html}
}

@article{refinettiNeuralNetworksTrained2022,
  title = {Neural Networks Trained with {{SGD}} Learn Distributions of Increasing Complexity},
  author = {Refinetti, Maria and Ingrosso, Alessandro and Goldt, Sebastian},
  year = {2022},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2211.11567},
  urldate = {2023-11-07},
  abstract = {The ability of deep neural networks to generalise well even when they interpolate their training data has been explained using various "simplicity biases". These theories postulate that neural networks avoid overfitting by first learning simple functions, say a linear classifier, before learning more complex, non-linear functions. Meanwhile, data structure is also recognised as a key ingredient for good generalisation, yet its role in simplicity biases is not yet understood. Here, we show that neural networks trained using stochastic gradient descent initially classify their inputs using lower-order input statistics, like mean and covariance, and exploit higher-order statistics only later during training. We first demonstrate this distributional simplicity bias (DSB) in a solvable model of a neural network trained on synthetic data. We empirically demonstrate DSB in a range of deep convolutional networks and visual transformers trained on CIFAR10, and show that it even holds in networks pre-trained on ImageNet. We discuss the relation of DSB to other simplicity biases and consider its implications for the principle of Gaussian universality in learning.},
  copyright = {arXiv.org perpetual, non-exclusive license},
  keywords = {Disordered Systems and Neural Networks (cond-mat.dis-nn),FOS: Computer and information sciences,FOS: Physical sciences,Machine Learning (cs.LG),Machine Learning (stat.ML),Statistical Mechanics (cond-mat.stat-mech)},
  file = {C:\Users\furuh\Zotero\storage\KM455Q7N\Refinetti et al. - 2022 - Neural networks trained with SGD learn distributio.pdf}
}

@misc{reinbacherRealTimeIntensityImageReconstruction2016,
  title = {Real-{{Time Intensity-Image Reconstruction}} for {{Event Cameras Using Manifold Regularisation}}},
  author = {Reinbacher, Christian and Graber, Gottfried and Pock, Thomas},
