  urldate = {2025-04-26},
  abstract = {In this paper, we provide tight lower bounds for the oracle complexity of minimizing high-order H{\"o}lder smooth and uniformly convex functions. Specifically, for a function whose \$p{\textasciicircum}\{th\}\$-order derivatives are H{\"o}lder continuous with degree \${\textbackslash}nu\$ and parameter \$H\$, and that is uniformly convex with degree \$q\$ and parameter \${\textbackslash}sigma\$, we focus on two asymmetric cases: (1) \$q {$>$} p + {\textbackslash}nu\$, and (2) \$q {$<$} p+{\textbackslash}nu\$. Given up to \$p{\textasciicircum}\{th\}\$-order oracle access, we establish worst-case oracle complexities of \${\textbackslash}Omega{\textbackslash}left( {\textbackslash}left( {\textbackslash}frac\{H\}\{{\textbackslash}sigma\}{\textbackslash}right){\textasciicircum}{\textbackslash}frac\{2\}\{3(p+{\textbackslash}nu)-2\}{\textbackslash}left( {\textbackslash}frac\{{\textbackslash}sigma\}\{{\textbackslash}epsilon\}{\textbackslash}right){\textasciicircum}{\textbackslash}frac\{2(q-p-{\textbackslash}nu)\}\{q(3(p+{\textbackslash}nu)-2)\}{\textbackslash}right)\$ in the first case with an \${\textbackslash}ell\_{\textbackslash}infty\$-ball-truncated-Gaussian smoothed hard function and \${\textbackslash}Omega{\textbackslash}left({\textbackslash}left({\textbackslash}frac\{H\}\{{\textbackslash}sigma\}{\textbackslash}right){\textasciicircum}{\textbackslash}frac\{2\}\{3(p+{\textbackslash}nu)-2\}+ {\textbackslash}log{\textbackslash}log{\textbackslash}left({\textbackslash}left({\textbackslash}frac\{{\textbackslash}sigma{\textasciicircum}\{p+{\textbackslash}nu\}\}\{H{\textasciicircum}q\}{\textbackslash}right){\textasciicircum}{\textbackslash}frac\{1\}\{p+{\textbackslash}nu-q\}{\textbackslash}frac\{1\}\{{\textbackslash}epsilon\}{\textbackslash}right){\textbackslash}right)\$ in the second case, for reaching an \${\textbackslash}epsilon\$-approximate solution in terms of the optimality gap. Our analysis generalizes previous lower bounds for functions under first- and