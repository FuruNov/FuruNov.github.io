  title = {Low-{{Rankness Guided Group Sparse Representation}} for {{Image Restoration}}},
  author = {Zha, Zhiyuan and Wen, Bihan and Yuan, Xin and Zhou, Jiantao and Zhu, Ce and Kot, Alex Chichung},
  year = {2023},
