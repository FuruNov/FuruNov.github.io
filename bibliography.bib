@article{zhaGroupSparsityResidual2020,
  title = {Group {{Sparsity Residual Constraint With Non-Local Priors}} for {{Image Restoration}}},
  author = {Zha, Zhiyuan and Yuan, Xin and Wen, Bihan and Zhou, Jiantao and Zhu, Ce},
  year = {2020},
  journal = {IEEE Transactions on Image Processing},
  volume = {29},
  pages = {8960--8975},
  issn = {1057-7149, 1941-0042},
  doi = {10.1109/TIP.2020.3021291},
  urldate = {2023-12-03},
  abstract = {Group sparse representation (GSR) has made great strides in image restoration producing superior performance, realized through employing a powerful mechanism to integrate the local sparsity and nonlocal self-similarity of images. However, due to some form of degradation (e.g., noise, down-sampling or pixels missing), traditional GSR models may fail to faithfully estimate sparsity of each group in an image, thus resulting in a distorted reconstruction of the original image. This motivates us to design a simple yet effective model that aims to address the above mentioned problem. Specifically, we propose group sparsity residual constraint with nonlocal priors (GSRC-NLP) for image restoration. Through introducing the group sparsity residual constraint, the problem of image restoration is further defined and simplified through attempts at reducing the group sparsity residual. Towards this end, we first obtain a good estimation of the group sparse coefficient of each original image group by exploiting the image nonlocal self-similarity (NSS) prior along with self-supervised learning scheme, and then the group sparse coefficient of the corresponding degraded image group is enforced to approximate the estimation. To make the proposed scheme tractable and robust, two algorithms, i.e., iterative shrinkage/thresholding (IST) and alternating direction method of multipliers (ADMM), are employed to solve the proposed optimization problems for different image restoration tasks. Experimental results on image denoising, image inpainting and image compressive sensing (CS) recovery, demonstrate that the proposed GSRC-NLP based image restoration algorithm is comparable to state-of-the-art denoising methods and outperforms several testing image inpainting and image CS recovery methods in terms of both objective and perceptual quality metrics.},
  langid = {english},
  annotation = {abstractTranslation: グループスパース表現（GSR）は、局所的なスパース性と非局所的な自己類似性を統合するための強力なメカニズムを使用することで実現される、優れたパフォーマンスを生成する画像修復に大きな進歩を遂げました。ただし、何らかの形の劣化（たとえば、ノイズ、ダウンサンプリング、またはピクセルが欠落している）により、従来のGSRモデルは画像内の各グループのスパース性を忠\hspace{0pt}\hspace{0pt}実に推定できないため、元の画像の歪んだ再構築が生じる可能性があります。これにより、上記の問題に対処することを目的とするシンプルで効果的なモデルを設計するようになります。具体的には、画像修復のために非ローカルプライアー（GSRC-NLP）によるグループスパースの残留制約を提案します。グループスパースの残留制約を導入することにより、画像の修復の問題は、グループスパースの残留を減らす試みを通じてさらに定義および簡素化されます。この目的に向けて、最初に、自己監視学習スキームとともにイメージの非局所的自己相似性（NSS）を利用することにより、各元の画像グループのグループスパース係数の良い推定を取得し、次に対応する分解された劣化のグループスパース係数を取得します。画像グループは、推定に近似するように強制されています。提案されたスキームを扱いやすく堅牢にするために、2つのアルゴリズム、すなわち反復収縮/しきい値（IST）および交互方向の乗数（ADMM）を使用して、さまざまな画像修復タスクの提案された最適化問題を解決するために採用されています。画像の除去、画像の入力、画像圧縮センシング（CS）の回復に関する実験結果は、提案されているGSRC-NLPベースの画像修復アルゴリズムが最先端の除去方法に匹敵し、いくつかのテストイメージを上回っていることを示しています。客観的な品質メトリックと知覚品質の両方の点での方法。},
  file = {C:\Users\furuh\Zotero\storage\9E2M3TIN\10.1109@TIP.2020.3021291.pdf.pdf}
}

@misc{zhaiCompleteDictionaryLearning2021,
  title = {Complete {{Dictionary Learning}} via \${\textbackslash}ell{\textasciicircum}4\$-{{Norm Maximization}} over the {{Orthogonal Group}}},
  author = {Zhai, Yuexiang and Yang, Zitong and Liao, Zhenyu and Wright, John and Ma, Yi},
  year = {2021},
  month = apr,
  number = {arXiv:1906.02435},
  eprint = {1906.02435},
  primaryclass = {cs, eess, stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1906.02435},
  urldate = {2023-01-18},
  abstract = {This paper considers the fundamental problem of learning a complete (orthogonal) dictionary from samples of sparsely generated signals. Most existing methods solve the dictionary (and sparse representations) based on heuristic algorithms, usually without theoretical guarantees for either optimality or complexity. The recent \${\textbackslash}ell{\textasciicircum}1\$-minimization based methods do provide such guarantees but the associated algorithms recover the dictionary one column at a time. In this work, we propose a new formulation that maximizes the \${\textbackslash}ell{\textasciicircum}4\$-norm over the orthogonal group, to learn the entire dictionary. We prove that under a random data model, with nearly minimum sample complexity, the global optima of the \${\textbackslash}ell{\textasciicircum}4\$ norm are very close to signed permutations of the ground truth. Inspired by this observation, we give a conceptually simple and yet effective algorithm based on "matching, stretching, and projection" (MSP). The algorithm provably converges locally at a superlinear (cubic) rate and cost per iteration is merely an SVD. In addition to strong theoretical guarantees, experiments show that the new algorithm is significantly more efficient and effective than existing methods, including KSVD and \${\textbackslash}ell{\textasciicircum}1\$-based methods. Preliminary experimental results on mixed real imagery data clearly demonstrate advantages of so learned dictionary over classic PCA bases.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning,Electrical Engineering and Systems Science - Signal Processing,Statistics - Computation,Statistics - Machine Learning},
  file = {C:\Users\furuh\Zotero\storage\LYGU6XP8\Zhai et al_2021_Complete Dictionary Learning via $-ell^4$-Norm Maximization over the Orthogonal.pdf}
}

@article{zhaImageRestorationReconciliation2021,
  title = {Image {{Restoration}} via {{Reconciliation}} of {{Group Sparsity}} and {{Low-Rank Models}}},
  author = {Zha, Zhiyuan and Wen, Bihan and Yuan, Xin and Zhou, Jiantao and Zhu, Ce},
  year = {2021},
  journal = {IEEE Transactions on Image Processing},
  volume = {30},
  pages = {5223--5238},
  issn = {1057-7149, 1941-0042},
  doi = {10.1109/TIP.2021.3078329},
  urldate = {2023-12-03},
  abstract = {Image nonlocal self-similarity (NSS) property has been widely exploited via various sparsity models such as joint sparsity (JS) and group sparse coding (GSC). However, the existing NSS-based sparsity models are either too restrictive, e.g., JS enforces the sparse codes to share the same support, or too general, e.g., GSC imposes only plain sparsity on the group coefficients, which limit their effectiveness for modeling real images. In this paper, we propose a novel NSS-based sparsity model, namely, low-rank regularized group sparse coding (LR-GSC), to bridge the gap between the popular GSC and JS. The proposed LR-GSC model simultaneously exploits the sparsity and low-rankness of the dictionary-domain coefficients for each group of similar patches. An alternating minimization with an adaptive adjusted parameter strategy is developed to solve the proposed optimization problem for different image restoration tasks, including image denoising, image deblocking, image inpainting, and image compressive sensing. Extensive experimental results demonstrate that the proposed LR-GSC algorithm outperforms many popular or state-of-the-art methods in terms of objective and perceptual metrics.},
  file = {C:\Users\furuh\Zotero\storage\CHKFSFUC\zha2021.pdf.pdf}
}

@article{zhaImageRestorationSimultaneous2020,
  title = {Image {{Restoration}} via {{Simultaneous Nonlocal Self-Similarity Priors}}},
  author = {Zha, Zhiyuan and Yuan, Xin and Zhou, Jiantao and Zhu, Ce and Wen, Bihan},
  year = {2020},
  journal = {IEEE Transactions on Image Processing},
  volume = {29},
  pages = {8561--8576},
  issn = {1057-7149, 1941-0042},
  doi = {10.1109/TIP.2020.3015545},
  urldate = {2023-12-03},
  abstract = {Through exploiting the image nonlocal self-similarity (NSS) prior by clustering similar patches to construct patch groups, recent studies have revealed that structural sparse representation (SSR) models can achieve promising performance in various image restoration tasks. However, most existing SSR methods only exploit the NSS prior from the input degraded (internal) image, and few methods utilize the NSS prior from external clean image corpus; how to jointly exploit the NSS priors of internal image and external clean image corpus is still an open problem. In this article, we propose a novel approach for image restoration by simultaneously considering internal and external nonlocal self-similarity (SNSS) priors that offer mutually complementary information. Specifically, we first group nonlocal similar patches from images of a training corpus. Then a group-based Gaussian mixture model (GMM) learning algorithm is applied to learn an external NSS prior. We exploit the SSR model by integrating the NSS priors of both internal and external image data. An alternating minimization with an adaptive parameter adjusting strategy is developed to solve the proposed SNSS-based image restoration problems, which makes the entire algorithm more stable and practical. Experimental results on three image restoration applications, namely image denoising, deblocking and deblurring, demonstrate that the proposed SNSS produces superior results compared to many popular or state-of-the-art methods in both objective and perceptual quality measurements.},
  file = {C:\Users\furuh\Zotero\storage\EYHLLUD7\10.1109@TIP.2020.3015545.pdf.pdf}
}

@article{zhaLearningNonlocalSparse2023,
  title = {Learning {{Nonlocal Sparse}} and {{Low-Rank Models}} for {{Image Compressive Sensing}}: {{Nonlocal}} Sparse and Low-Rank Modeling},
  shorttitle = {Learning {{Nonlocal Sparse}} and {{Low-Rank Models}} for {{Image Compressive Sensing}}},
  author = {Zha, Zhiyuan and Wen, Bihan and Yuan, Xin and Ravishankar, Saiprasad and Zhou, Jiantao and Zhu, Ce},
  year = {2023},
  month = jan,
  journal = {IEEE Signal Processing Magazine},
  volume = {40},
  number = {1},
  pages = {32--44},
  issn = {1053-5888, 1558-0792},
  doi = {10.1109/MSP.2022.3217936},
  urldate = {2023-12-03},
  abstract = {The compressive sensing (CS) scheme exploits many fewer measurements than suggested by the Nyquist--Shannon sampling theorem to accurately reconstruct images, which has attracted considerable attention in the computational imaging community. While classic image CS schemes employ sparsity using analytical transforms or bases, the learning-based approaches have become increasingly popular in recent years. Such methods can effectively model the structure of image patches by optimizing their sparse representations or learning deep neural networks while preserving the known or modeled sensing process. Beyond exploiting local image properties, advanced CS schemes adopt nonlocal image modeling by extracting similar or highly correlated patches at different locations of an image to form a group to process jointly. More recent learning-based CS schemes apply nonlocal structured sparsity priors using group sparse (and related) representation (GSR) and/or low-rank (LR) modeling, which have demonstrated promising performance in various computational imaging and image processing applications.},
  langid = {american},
  annotation = {abstractTranslation: 圧縮センシング(CS)方式は、Nyquist-Shannonサンプリング定理が示唆するよりも少ない測定値を利用して、画像を正確に再構成するものであり、計算機画像処理の分野で大きな注目を集めている。古典的な画像CS方式は、解析的変換や基底を用いたスパース性を採用しているが、近年、学習ベースのアプローチがますます普及している。このような手法は、既知またはモデル化されたセンシングプロセスを保持しながら、スパース表現を最適化したり、ディープニューラルネットワークを学習したりすることで、画像パッチの構造を効果的にモデル化することができる。局所的な画像特性を利用するだけでなく、高度なCSスキームは、画像の異なる位置にある類似または相関性の高いパッチを抽出してグループを形成し、共同で処理することにより、非局所的な画像モデリングを採用している。より最近の学習ベースのCSスキームは、グループスパース（および関連）表現（GSR）および／または低ランク（LR）モデリングを用いた非局所構造化スパース性プリオールを適用し、様々な計算イメージングおよび画像処理アプリケーションにおいて有望な性能を実証している。},
  file = {C:\Users\furuh\Zotero\storage\MCQ4C3WI\Zha et al. - 2022 - Learning Nonlocal Sparse and Low-Rank Models for I.pdf}
}

