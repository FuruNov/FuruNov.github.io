}

@article{yiSpatialTemporalTensorRing2023,
  title = {Spatial-{{Temporal Tensor Ring Norm Regularization}} for {{Infrared Small Target Detection}}},
  author = {Yi, Haiyang and Yang, Chunping and Qie, Ruochen and Liao, Jingwen and Wu, Fengyi and Pu, Tian and Peng, Zhenming},
  year = {2023},
  journal = {IEEE Geoscience and Remote Sensing Letters},
  volume = {20},
  pages = {1--5},
  issn = {1545-598X, 1558-0571},
  doi = {10.1109/LGRS.2023.3236030},
  urldate = {2024-09-07},
  abstract = {Infrared small target detection (ISTD) technique is widely used in infrared searching and tracking (IRST) and military surveillance. Existing detection methods must sufficiently address the challenges of the heterogeneous background with high concealment targets. In this letter, we propose a novel spatial-temporal tensor ring norm regularization (STT-TRNR) to detect infrared small targets. First, to utilize the spatial and temporal context information in a sequence, nonrepetitive spatial-temporal patches are formed by sliding windows in the consecutive frames. The patches are stacked into a tensor structure with spatial and temporal information. Second, the tensor ring nuclear norm is introduced to approximate the rank of the background tensor. The tensor ring regularization improves the correlation between dimensions, protects the internal structure of the tensor, and avoids the dimension disaster caused by train decomposition. Third, the local contrastive feature is used as a priori information to suppress the false alarms caused by the corner edges and other noises and avoid the distortion caused by target movement. Finally, the alternating direction multiplier method (ADMM) is employed to reconstruct the sequence images and retrieve the targets. The experimental results reveal that the suggested model provides improved detection performance and higher robustness across various complicated scene types.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {english},
  annotation = {abstractTranslation: 赤外線小目標検出（ISTD）技術は、赤外線捜索・追跡（IRST）や軍事監視で広く使用されている。既存の検出手法は、高い隠蔽率を持つターゲットと不均質な背景の課題に十分に対処しなければならない。本レターでは、赤外線小ターゲットを検出するための新しい空間-時間テンソルリングノルム正則化(STT-TRNR)を提案する。まず、シーケンスの空間的・時間的コンテキスト情報を利用するために、連続するフレームにおいて、スライディングウィンドウにより非反復的な空間的・時間的パッチを形成する。このパッチは空間情報と時間情報を持つテンソル構造にスタックされる。次に、背景テンソルのランクを近似するためにテンソルリング核ノルムを導入する。テンソルリング正則化は次元間の相関を改善し、テンソルの内部構造を保護し、列車分解によって引き起こされる次元災害を回避する。第三に、局所コントラスト特徴量を先験的情報として用いることで、コーナーエッジやその他のノイズによる誤警報を抑制し、ターゲットの動きによる歪みを回避する。最後に、交互方向乗算法（ADMM）を用いてシーケンス画像を再構成し、ターゲットを検索する。実験結果から、提案モデルは、様々な複雑なシーンタイプにおいて、検出性能の向上と高いロバスト性を提供することが明らかになった。}
}

