@misc{bhusalGeneralFrameworkGroup2025,
  title = {A {{General Framework}} for {{Group Sparsity}} in {{Hyperspectral Unmixing Using Endmember Bundles}}},
  author = {Bhusal, Gokul and Lou, Yifei and {Garcia-Cardona}, Cristina and Merkurjev, Ekaterina},
  year = {2025},
