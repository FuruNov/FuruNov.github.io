@article{xiaoMultiHypergraphLearningBased2020,
  title = {Multi-{{Hypergraph Learning Based Brain Functional Connectivity Analysis}} in {{fMRI Data}}},
  author = {Xiao, Li and Wang, Junqi and Kassani, Peyman H. and Zhang, Yipu and Bai, Yuntong and Stephen, Julia M. and Wilson, Tony W. and Calhoun, Vince D. and Wang, Yu-Ping},
  year = {2020},
  month = may,
  journal = {IEEE transactions on medical imaging},
  volume = {39},
  number = {5},
  pages = {1746--1758},
  issn = {0278-0062},
  doi = {10.1109/TMI.2019.2957097},
  urldate = {2024-08-28},
  abstract = {Recently, a hypergraph constructed from functional magnetic resonance imaging (fMRI) was utilized to explore brain functional connectivity networks (FCNs) for the classification of neurodegenerative diseases. Each edge of a hypergraph (called hyperedge) can connect any number of brain regions-of-interest (ROIs) instead of only two ROIs, and thus characterizes high-order relations among multiple ROIs that cannot be uncovered by a simple graph in the traditional graph based FCN construction methods. Unlike the existing hypergraph based methods where all hyperedges are assumed to have equal weights and only certain topological features are extracted from the hypergraphs, we propose a hypergraph learning based method for FCN construction in this paper. Specifically, we first generate hyperedges from fMRI time series based on sparse representation, then employ hypergraph learning to adaptively learn hyperedge weights, and finally define a hypergraph similarity matrix to represent the FCN. In our proposed method, weighting hyperedges results in better discriminative FCNs across subjects, and the defined hypergraph similarity matrix can better reveal the overall structure of brain network than using those hypergraph topological features. Moreover, we propose a multi-hypergraph learning based method by integrating multi-paradigm fMRI data, where the hyperedge weights associated with each fMRI paradigm are jointly learned and then a unified hypergraph similarity matrix is computed to represent the FCN. We validate the effectiveness of the proposed method on the Philadelphia Neurodevelopmental Cohort dataset for the classification of individuals' learning ability from three paradigms of fMRI data. Experimental results demonstrate that our proposed approach outperforms the traditional graph based methods (i.e., Pearson's correlation and partial correlation with the graphical Lasso) and the existing unweighted hypergraph based methods, which sheds light on how to optimize estimation of FCNs for cognitive and behavioral study.},
  langid = {american},
  pmcid = {PMC7376954},
  pmid = {31796393},
  annotation = {abstractTranslation: 近年、機能的磁気共鳴画像法（fMRI）から構築されたハイパーグラフが、神経変性疾患の分類のために脳機能結合ネットワーク（FCN）を探索するために利用されている。ハイパーグラフの各エッジ（ハイパーエッジと呼ばれる）は、2つの関心領域（ROI）だけでなく、任意の数のROIを接続できるため、従来のグラフベースのFCN構築法における単純なグラフでは明らかにできない、複数のROI間の高次な関係を特徴づける。既存のハイパーグラフベースの方法では、すべてのハイパーエッジが等しい重みを持つと仮定し、特定のトポロジー的特徴のみをハイパーグラフから抽出するのとは異なり、本稿では、FCN構築のためのハイパーグラフ学習に基づく方法を提案する。具体的には、まずスパース表現に基づいてfMRI時系列からハイパーエッジを生成し、次にハイパーグラフ学習を用いてハイパーエッジの重みを適応的に学習し、最後にハイパーグラフ類似度行列を定義してFCNを表現する。提案手法では、ハイパーエッジに重み付けすることで、被験者間でより識別力の高いFCNが得られ、定義されたハイパーグラフ類似度行列は、ハイパーグラフのトポロジー的特徴を使用するよりも、脳ネットワーク全体の構造をよりよく明らかにすることができる。さらに、マルチパラダイムfMRIデータを統合したマルチハイパーグラフ学習に基づく方法を提案し、各fMRIパラダイムに関連するハイパーエッジの重みを共同で学習し、統合されたハイパーグラフ類似度行列を計算してFCNを表現する。提案手法の有効性を検証するため、フィラデルフィア神経発達コホートデータセットを用いて、3つのパラダイムのfMRIデータから個人の学習能力を分類する。実験結果は、提案手法が、従来のグラフベースの手法（すなわち、ピアソンの相関およびグラフィカルLassoによる偏相関）および既存の重み付けされていないハイパーグラフベースの手法よりも優れており、認知および行動研究のためのFCNの推定を最適化する方法を明らかにする。},
  file = {C:\Users\furuh\Zotero\storage\HVB7CQXJ\Xiao et al. - 2020 - Multi-Hypergraph Learning Based Brain Functional Connectivity Analysis in fMRI Data.pdf}
}

