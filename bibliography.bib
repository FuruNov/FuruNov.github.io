@inproceedings{liAlternatingLocalEnumeration2023b,
  title = {Alternating Local Enumeration ({{TnALE}}): Solving Tensor Network Structure Search with Fewer Evaluations},
  shorttitle = {Alternating Local Enumeration ({{TnALE}})},
  booktitle = {Proceedings of {{International Conference}} on {{Machine Learning}}},
  author = {Li, Chao and Zeng, Junhua and Li, Chunmei and Caiafa, Cesar and Zhao, Qibin},
  year = {2023},
  month = jul,
  series = {{{ICML}}'23},
  volume = {202},
  pages = {20384--20411},
  publisher = {JMLR.org},
  address = {Honolulu, Hawaii, USA},
  urldate = {2025-01-17},
  abstract = {Tensor network (TN) is a powerful framework in machine learning, but selecting a good TN model, known as TN structure search (TN-SS), is a challenging and computationally intensive task. The recent approach TNLS (Li et al., 2022) showed promising results for this task. However, its computational efficiency is still unaffordable, requiring too many evaluations of the objective function. We propose TnALE, a surprisingly simple algorithm that updates each structure-related variable alternately by local enumeration, greatly reducing the number of evaluations compared to TNLS. We theoretically investigate the descent steps for TNLS and TnALE, proving that both the algorithms can achieve linear convergence up to a constant if a sufficient reduction of the objective is reached in each neighborhood. We further compare the evaluation efficiency of TNLS and TnALE, revealing that {\textohm}(2K) evaluations are typically required in TNLS for reaching the objective reduction, while ideally O(KR) evaluations are sufficient in TnALE, where K denotes the dimension of search space and R reflects the "low-rankness" of the neighborhood. Experimental results verify that TnALE can find practically good TN structures with vastly fewer evaluations than the state-of-the-art algorithms. Our code is available at https://github.com/ChaoLiAtRIKEN/TnALE.}
}

@article{liangNoiseNanoporeSensors2020,
  title = {Noise in Nanopore Sensors: {{Sources}}, Models, Reduction, and Benchmarking},
  shorttitle = {Noise in Nanopore Sensors},
  author = {Liang, Shengfa and Xiang, Feibin and Tang, Zifan and Nouri, Reza and He, Xiaodong and Dong, Ming and Guan, Weihua},
  year = {2020},
  month = mar,
  journal = {Nanotechnology and Precision Engineering},
  volume = {3},
  number = {1},
  pages = {9--17},
  issn = {2589-5540},
  doi = {10.1016/j.npe.2019.12.008},
  urldate = {2024-08-03},
  abstract = {Label-free nanopore sensors have emerged as a new generation technology of DNA sequencing and have been widely used for single molecule analysis. Since the first {$\alpha$}-hemolysin biological nanopore, various types of nanopores made of different materials have been under extensive development. Noise represents a common challenge among all types of nanopore sensors. The nanopore noise can be decomposed into four components in the frequency domain (1/f noise, white noise, dielectric noise, and amplifier noise). In this work, we reviewed and summarized the physical models, origins, and reduction methods for each of these noise components. For the first time, we quantitatively benchmarked the root mean square (RMS) noise levels for different types of nanopores, demonstrating a clear material-dependent RMS noise. We anticipate this review article will enhance the understanding of nanopore sensor noises and provide an informative tutorial for developing future nanopore sensors with a high signal-to-noise ratio.},
  langid = {american},
  keywords = {Material,Model,Nanopore,Noise,Noise reduction},
  annotation = {abstractTranslation: 無標識ナノポアセンサーは、DNA配列決定の新世代技術として登場し、単一分子分析に広く用いられてきた。最初の{$\alpha$}-ヘモリシン生物学的ナノポア以来、様々な材料で作られた様々なタイプのナノポアが広範囲に開発されてきた。ノイズは、あらゆるタイプのナノポア・センサーに共通する課題である。ナノポアのノイズは、周波数領域で4つの成分（1/fノイズ、ホワイトノイズ、誘電体ノイズ、アンプノイズ）に分解できる。本研究では、これらの各ノイズ成分の物理モデル、起源、低減法について概説し、要約した。初めて、異なるタイプのナノ細孔の二乗平均平方根（RMS）ノイズ・レベルを定量的にベンチマークし、RMSノイズが材料に依存することを明らかにした。我々は、この総説がナノポアセンサーのノイズに関する理解を深め、高いS/N比を持つ将来のナノポアセンサーの開発に有益なチュートリアルを提供することを期待している。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\EHG79TK7\\Liang et al. - 2020 - Noise in nanopore sensors Sources, models, reduct.pdf;C\:\\Users\\furuh\\Zotero\\storage\\NK3A4TYJ\\S2589554019300546.html}
}

