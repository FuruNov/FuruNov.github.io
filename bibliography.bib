  doi = {10.1109/ICASSP49660.2025.10889291},
  urldate = {2025-03-14},
  abstract = {This work presents a low-rank tensor model for multidimensional Markov chains. A common approach to simplify the dynamical behavior of a Markov chain is to impose low-rankness on the transition probability matrix. Inspired by the success of these matrix techniques, we present low-rank tensors for representing transition probabilities on multi-dimensional state spaces. Through tensor decomposition, we provide a connection between our method and classical probabilistic models. Moreover, our proposed model yields a parsimonious representation with fewer parameters than matrix-based approaches. Unlike these methods, which impose low-rankness uniformly across all states, our tensor method accounts for the multi-dimensionality of the state space. We also propose an optimization-based approach to estimate a Markov model as a low-rank tensor. Our optimization problem can be solved by the alternating direction method of multipliers (ADMM), which enjoys convergence to a stationary solution. We empirically demonstrate that our tensor model estimates Markov chains more efficiently than conventional techniques, requiring both fewer samples and parameters. We perform numerical simulations for both a synthetic low-rank Markov chain and a real-world example with New York City taxi data, showcasing the advantages of multi-dimensionality for modeling state spaces.},
  langid = {english},
  keywords = {Convex functions,low-rank tensors,Markov model,Matrix decomposition,Numerical models,Optimization,Signal processing,Signal processing algorithms,Speech processing,tensor decomposition,Tensors,Trajectory,Urban areas},
  annotation = {abstractTranslation: この作業は、多次元マルコフチェーンの低ランクテンソルモデルを提供します。マルコフ連鎖の動的挙動を簡素化するための一般的なアプローチは、遷移確率マトリックスに低ランクネスを課すことです。これらのマトリックス技術の成功に触発されて、多次元状態空間での遷移確率を表すための低ランクテンソルを提示します。テンソル分解により、方法と古典的な確率モデルの間の接続を提供します。さらに、提案されているモデルは、マトリックスベースのアプローチよりもパラメーターが少ないpar約的な表現を生成します。これらの方法は、すべての州で均一に低いランクネスを課す方法とは異なり、私たちのテンソル法は、状態空間の多次元性を説明しています。また、マルコフモデルを低ランクテンソルとして推定するための最適化ベースのアプローチを提案します。最適化の問題は、静止ソリューションへの収束を享受する乗数の交互方向方法（ADMM）によって解決できます。私たちのテンソルモデルは、マルコフチェーンが従来の手法よりも効率的に推定され、より少ないサンプルとパラメーターが必要であることを経験的に実証します。合成低ランクマルコフチェーンと、ニューヨーク市のタクシーデータを使用した実世界の例の両方に対して数値シミュレーションを実行し、状態空間をモデリングするための多次元性の利点を示しています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\6SZF79MS\\Navarro et al. - 2025 - Low-Rank Tensors for Multi-Dimensional Markov Models.pdf;C\:\\Users\\furuh\\Zotero\\storage\\P4N4NIYM\\10889291.html}
}

