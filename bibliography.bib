  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2301.03580},
  urldate = {2023-01-20},
  abstract = {We identify and overcome two key obstacles in extending the success of BERT-style pre-training, or the masked image modeling, to convolutional networks (convnets): (i) convolution operation cannot handle irregular, random-masked input images; (ii) the single-scale nature of BERT pre-training is inconsistent with convnet's hierarchical structure. For (i), we treat unmasked pixels as sparse voxels of 3D point clouds and use sparse convolution to encode. This is the first use of sparse convolution for 2D masked modeling. For (ii), we develop a hierarchical decoder to reconstruct images from multi-scale encoded features. Our method called Sparse masKed modeling (SparK) is general: it can be used directly on any convolutional model without backbone modifications. We validate it on both classical (ResNet) and modern (ConvNeXt) models: on three downstream tasks, it surpasses both state-of-the-art contrastive learning and transformer-based masked modeling by similarly large margins (around +1.0\%). Improvements on object detection and instance segmentation are more substantial (up to +3.5\%), verifying the strong transferability of features learned. We also find its favorable scaling behavior by observing more gains on larger models. All this evidence reveals a promising future of generative pre-training on convnets. Codes and models are released at https://github.com/keyu-tian/SparK.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computer Vision and Pattern Recognition,Computer Science - Machine Learning},
  file = {C:\Users\furuh\Zotero\storage\VX6B8YBC\Tian et al_2023_Designing BERT for Convolutional Networks.pdf}
}

@misc{tianHigherOrderNetworksRepresentation2024,
  title = {Higher-{{Order Networks Representation}} and {{Learning}}: {{A Survey}}},
  shorttitle = {Higher-{{Order Networks Representation}} and {{Learning}}},
  author = {Tian, Hao and Zafarani, Reza},
  year = {2024},
  month = apr,
  number = {arXiv:2402.19414},
  eprint = {2402.19414},
  primaryclass = {cs},
  publisher = {arXiv},
  urldate = {2024-07-05},
  abstract = {Network data has become widespread, larger, and more complex over the years. Traditional network data is dyadic, capturing the relations among pairs of entities. With the need to model interactions among more than two entities, significant research has focused on higher-order networks and ways to represent, analyze, and learn from them. There are two main directions to studying higher-order networks. One direction has focused on capturing higher-order patterns in traditional (dyadic) graphs by changing the basic unit of study from nodes to small frequently observed subgraphs, called motifs. As most existing network data comes in the form of pairwise dyadic relationships, studying higher-order structures within such graphs may uncover new insights. The second direction aims to directly model higher-order interactions using new and more complex representations such as simplicial complexes or hypergraphs. Some of these models have long been proposed, but improvements in computational power and the advent of new computational techniques have increased their popularity. Our goal in this paper is to provide a succinct yet comprehensive summary of the advanced higher-order network analysis techniques. We provide a systematic review of its foundations and algorithms, along with use cases and applications of higher-order networks in various scientific domains.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {68Q06,A.1,Computer Science - Data Structures and Algorithms,Computer Science - Social and Information Networks,I.5.1},
  annotation = {abstractTranslation: ネットワークデータは近年、広範化、大規模化、複雑化の一途を辿っています。従来のネットワークデータは二者関係（dyadic）であり、エンティティ間のペアの関係を捉えるものでした。しかし、3つ以上のエンティティ間の相互作用をモデル化する必要性が高まるにつれ、高階ネットワークとその表現、分析、学習方法に焦点が当てられるようになりました。高階ネットワークの研究には主に2つの方向性があります。1つは、ノードではなく、モチーフと呼ばれる頻繁に観察される小さな部分グラフに研究の基本単位を変更することで、従来の（二者関係）グラフにおける高階パターンを捉えることに焦点を当てています。既存のネットワークデータのほとんどがペアワイズな二者関係の形式であるため、そのようなグラフ内の高階構造を研究することで、新たな洞察が得られる可能性があります。もう1つは、シンプレックス複合体やハイパーグラフなどの新しい、より複雑な表現を使用して、高階の相互作用を直接モデル化することを目指しています。これらのモデルの中には以前から提案されていたものもありますが、計算能力の向上と新しい計算技術の出現により、その人気が高まっています。本稿の目的は、高度な高階ネットワーク分析技術の簡潔かつ包括的な概要を提供することです。その基礎とアルゴリズム、および様々な科学分野における高階ネットワークのユースケースと応用事例を体系的にレビューします。},
  file = {C:\Users\furuh\Zotero\storage\Y2TLWBNG\Tian and Zafarani - 2024 - Higher-Order Networks Representation and Learning.pdf}
}

