  urldate = {2024-08-29},
  abstract = {HyperGraph Convolutional Neural Networks (HGCNNs) have demonstrated their potential in modeling high-order relations preserved in graph-structured data. However, most existing convolution filters are localized and determined by the pre-defined initial hypergraph topology, neglecting to explore implicit and long-range relations in real-world data. In this paper, we propose the first learning-based method tailored for constructing adaptive hypergraph structure, termed HypERgrAph Laplacian aDaptor (HERALD), which serves as a generic plug-and-play module for improving the representational power of HGCNNs. Specifically, HERALD adaptively optimizes the adjacency relationship between vertices and hyperedges in an end-to-end manner and thus the task-aware hypergraph is learned. Furthermore, HERALD employs the self-attention mechanism to capture the non-local paired-nodes relation. Extensive experiments on various popular hypergraph datasets for node classification and graph classification tasks demonstrate that our approach obtains consistent and considerable performance enhancement, proving its effectiveness and generalization ability.},
  langid = {american},
  keywords = {adaptive hypergraph structure,Convolution,Data models,hypergraph convolutional neural network,Laplace equations,Learning systems,Network topology,non-local relation,self-attention,Topology,Training},
  annotation = {abstractTranslation: ハイパーグラフ畳み込みニューラルネットワーク（HGCNN）は、グラフ構造化されたデータに保存された高次の関係をモデル化する可能性を示してきた。しかしながら、既存のほとんどの畳み込みフィルタは、あらかじめ定義された初期ハイパーグラフトポロジーによって局所化され決定されるため、実世界のデータにおける暗黙的で長距離の関係を探索することがおろそかになっている。本論文では、HGCNNの表現力を向上させるための汎用的なプラグアンドプレイモジュールとして機能する、HypERgrAph Laplacian aDaptor (HERALD)と呼ばれる、適応的なハイパーグラフ構造を構築するために調整された初の学習ベースの手法を提案する。具体的には、HERALDは頂点とハイパーエッジ間の隣接関係をエンド・ツー・エンドで適応的に最適化し、タスクを考慮したハイパーグラフを学習する。さらに、HERALDは、非局所的なペアノード関係を捕捉するために、自己アテンション機構を採用している。ノード分類とグラフ分類タスクのための様々な一般的なハイパーグラフデータセットを用いた広範な実験により、我々のアプローチが一貫した大幅な性能向上を達成し、その有効性と汎化能力が証明された。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\YFNUX54H\\Zhang et al. - 2022 - Learnable Hypergraph Laplacian for Hypergraph Learning.pdf;C\:\\Users\\furuh\\Zotero\\storage\\WCMGZZB5\\9747687.html}
}

@misc{zhangLearningDifferenceofConvexRegularizers2025,
  title = {Learning {{Difference-of-Convex Regularizers}} for {{Inverse Problems}}: {{A Flexible Framework}} with {{Theoretical Guarantees}}},
  shorttitle = {Learning {{Difference-of-Convex Regularizers}} for {{Inverse Problems}}},
  author = {Zhang, Yasi and Leong, Oscar},
  year = {2025},
  month = feb,
  number = {arXiv:2502.00240},
  eprint = {2502.00240},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2502.00240},
  urldate = {2025-02-21},
  abstract = {Learning effective regularization is crucial for solving ill-posed inverse problems, which arise in a wide range of scientific and engineering applications. While data-driven methods that parameterize regularizers using deep neural networks have demonstrated strong empirical performance, they often result in highly nonconvex formulations that lack theoretical guarantees. Recent work has shown that incorporating structured nonconvexity into neural network-based regularizers, such as weak convexity, can strike a balance between empirical performance and theoretical tractability. In this paper, we demonstrate that a broader class of nonconvex functions, difference-of-convex (DC) functions, can yield improved empirical performance while retaining strong convergence guarantees. The DC structure enables the use of well-established optimization algorithms, such as the Difference-of-Convex Algorithm (DCA) and a Proximal Subgradient Method (PSM), which extend beyond standard gradient descent. Furthermore, we provide theoretical insights into the conditions under which optimal regularizers can be expressed as DC functions. Extensive experiments on computed tomography (CT) reconstruction tasks show that our approach achieves strong performance across sparse and limited-view settings, consistently outperforming other weakly supervised learned regularizers. Our code is available at {\textbackslash}url\{https://github.com/YasminZhang/ADCR\}.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning,Electrical Engineering and Systems Science - Image and Video Processing,Mathematics - Optimization and Control,Statistics - Machine Learning}
}

