@misc{katsumaSparsityEnhancedMultilayeredNonConvex2024,
  title = {Sparsity-{{Enhanced Multilayered Non-Convex Regularization}} with {{Epigraphical Relaxation}} for {{Debiased Signal Recovery}}},
  author = {Katsuma, Akari and Kyochi, Seisuke and Ono, Shunsuke and Selesnick, Ivan},
  year = {2024},
  month = sep,
  number = {arXiv:2409.14768},
  eprint = {2409.14768},
  primaryclass = {eess},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2409.14768},
  urldate = {2025-06-03},
  abstract = {This paper proposes a precise signal recovery method with multilayered non-convex regularization, enhancing sparsity/low-rankness for high-dimensional signals including images and videos. In optimization-based signal recovery, multilayered convex regularization functions based on the L1 and nuclear-norms not only guarantee a global optimal solution but also offer more accurate estimation than single-layered ones, thanks to their faithful modeling of structured sparsity and low-rankness in high-dimensional signals. However, these functions are known to yield biased solutions (estimated with smaller amplitude values than the true ones). To address this issue, multilayered non-convex regularization functions have been considered, although they face their own challenges: 1) their closed-form proximity operators are unavailable, and 2) convergence may result in a local optimal solution. In this paper, we resolve the two issues with an approach based on epigraphical relaxation (ER). First, ER decomposes a multilayered non-convex regularization function into the outermost function and epigraph constraints for the inner functions, facilitating the computation of proximity operators. Second, the relaxed regularization functions by ER are integrated into a non-convexly regularized convex optimization model to estimate a global optimal solution with less bias. Numerical experiments demonstrate the bias reduction achieved by the proposed method in image recovery and principal component analysis.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Electrical Engineering and Systems Science - Signal Processing,Mathematics - Optimization and Control},
  annotation = {abstractTranslation: 本稿では、画像やビデオを含む高次元信号に対して、スパース性/低ランク性を強化する多層非凸正則化を用いた高精度な信号復元法を提案する。最適化に基づく信号復元において、L1ノルムおよび核ノルムに基づく多層凸正則化関数は、大域最適解を保証するだけでなく、高次元信号における構造化されたスパース性および低ランク性を忠実にモデル化することにより、単層のものよりも高精度な推定を提供する。しかしながら、これらの関数は、バイアスのある解（真の値よりも振幅値が小さい推定）をもたらすことが知られている。この問題に対処するため、多層非凸正則化関数が検討されているが、それらはそれら自身の課題に直面している。1）それらの閉形式の近接作用素は利用できない。2）収束は局所最適解をもたらす可能性がある。本稿では、エピグラフ緩和（ER）に基づくアプローチを用いて、これら二つの問題点を解決する。まず、ERは、多層非凸正則化関数を、最も外側の関数と内側の関数に対するエピグラフ制約に分解し、近接作用素の計算を容易にする。次に、ERによって緩和された正則化関数を、バイアスの少ない大域最適解を推定するための非凸正則化された凸最適化モデルに統合する。数値実験により、提案手法が画像復元および主成分分析において達成するバイアス低減を示す。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\TSF9AII2\\Katsuma et al. - 2024 - Sparsity-Enhanced Multilayered Non-Convex Regularization with Epigraphical Relaxation for Debiased S.pdf;C\:\\Users\\furuh\\Zotero\\storage\\P3RW5QBH\\2409.html}
}

@misc{kaziDifferentiableGraphModule2022,
  title = {Differentiable {{Graph Module}} ({{DGM}}) for {{Graph Convolutional Networks}}},
  author = {Kazi, Anees and Cosmo, Luca and Ahmadi, Seyed-Ahmad and Navab, Nassir and Bronstein, Michael},
  year = {2022},
  month = may,
  number = {arXiv:2002.04999},
  eprint = {2002.04999},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2002.04999},
  urldate = {2024-11-11},
  abstract = {Graph deep learning has recently emerged as a powerful ML concept allowing to generalize successful deep neural architectures to non-Euclidean structured data. Such methods have shown promising results on a broad spectrum of applications ranging from social science, biomedicine, and particle physics to computer vision, graphics, and chemistry. One of the limitations of the majority of current graph neural network architectures is that they are often restricted to the transductive setting and rely on the assumption that the underlying graph is \{{\textbackslash}em known\} and \{{\textbackslash}em fixed\}. Often, this assumption is not true since the graph may be noisy, or partially and even completely unknown. In such cases, it would be helpful to infer the graph directly from the data, especially in inductive settings where some nodes were not present in the graph at training time. Furthermore, learning a graph may become an end in itself, as the inferred structure may provide complementary insights next to the downstream task. In this paper, we introduce Differentiable Graph Module (DGM), a learnable function that predicts edge probabilities in the graph which are optimal for the downstream task. DGM can be combined with convolutional graph neural network layers and trained in an end-to-end fashion. We provide an extensive evaluation of applications from the domains of healthcare (disease prediction), brain imaging (age prediction), computer graphics (3D point cloud segmentation), and computer vision (zero-shot learning). We show that our model provides a significant improvement over baselines both in transductive and inductive settings and achieves state-of-the-art results.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Machine Learning,Statistics - Machine Learning},
  annotation = {abstractTranslation: グラフ深層学習は、成功した深層ニューラルアーキテクチャを非ユークリッド構造データに一般化することを可能にする強力なMLコンセプトとして最近登場した。このような手法は、社会科学、生物医学、素粒子物理学からコンピュータビジョン、グラフィックス、化学に至るまで、幅広い応用分野で有望な結果を示している。現在のグラフ・ニューラル・ネットワーク・アーキテクチャの大半の限界の1つは、それらが多くの場合、推移的設定に制限され、基礎となるグラフが\{既知\}かつ\{固定\}であるという仮定に依存していることである。多くの場合、グラフはノイズが多かったり、部分的あるいは完全に未知であったりするため、この仮定は正しくない。このような場合、データからグラフを直接推論することが有用であり、特に学習時にグラフに存在しないノードがあるような帰納的な設定では有用である。さらに、推論された構造が、下流のタスクの次に補足的な洞察を提供する可能性があるため、グラフの学習はそれ自体が目的になる可能性がある。本論文では、下流のタスクに最適なグラフのエッジ確率を予測する、学習可能な関数である差分グラフモジュール（DGM）を紹介する。DGMは畳み込みグラフニューラルネットワーク層と組み合わせることができ、エンドツーエンドで学習させることができる。我々は、ヘルスケア（病気予測）、脳画像（年齢予測）、コンピュータグラフィックス（3D点群セグメンテーション）、コンピュータビジョン（ゼロショット学習）の各領域からの応用の広範な評価を提供する。我々は、我々のモデルが、帰納的な設定と帰納的な設定の両方において、ベースラインを大幅に改善し、最先端の結果を達成することを示す。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\5HVA96GD\\Kazi et al. - 2022 - Differentiable Graph Module (DGM) for Graph Convolutional Networks.pdf;C\:\\Users\\furuh\\Zotero\\storage\\TWTERA96\\2002.html}
