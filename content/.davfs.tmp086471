@misc{kaganVitroNeuronsLearn2021,
  title = {In Vitro Neurons Learn and Exhibit Sentience When Embodied in a Simulated Game-World},
  author = {Kagan, Brett J. and Kitchen, Andy C. and Tran, Nhi T. and Parker, Bradyn J. and Bhat, Anjali and Rollo, Ben and Razi, Adeel and Friston, Karl J.},
  year = {2021},
  month = dec,
  pages = {2021.12.02.471005},
  institution = {Cold Spring Harbor Laboratory},
  doi = {10.1101/2021.12.02.471005},
  urldate = {2022-01-06},
  abstract = {Integrating neurons into digital systems to leverage their innate intelligence may enable performance infeasible with silicon alone, along with providing insight into the cellular origin of intelligence. We developed DishBrain, a system which exhibits natural intelligence by harnessing the inherent adaptive computation of neurons in a structured environment. In vitro neural networks from human or rodent origins, are integrated with in silico computing via high-density multielectrode array. Through electrophysiological stimulation and recording, cultures were embedded in a simulated game-world, mimicking the arcade game `Pong'. Applying a previously untestable theory of active inference via the Free Energy Principle, we found that learning was apparent within five minutes of real-time gameplay, not observed in control conditions. Further experiments demonstrate the importance of closed-loop structured feedback in eliciting learning over time. Cultures display the ability to self-organise in a goal-directed manner in response to sparse sensory information about the consequences of their actions.},
  chapter = {New Results},
  copyright = {{\copyright} 2021, Posted by Cold Spring Harbor Laboratory. This pre-print is available under a Creative Commons License (Attribution-NonCommercial-NoDerivs 4.0 International), CC BY-NC-ND 4.0, as described at http://creativecommons.org/licenses/by-nc-nd/4.0/},
  langid = {english},
  keywords = {game,neuron},
  file = {C:\Users\furuh\Zotero\storage\JQK83YZ5\Kagan et al_2021_In vitro neurons learn and exhibit sentience when embodied in a simulated.pdf}
}

@misc{KaiErChengJianDinghaHewoyatuteirunoka|kogurahuZhuShiHuiSheDetaanariteikusuShiYeBu2024,
  title = {{カイ二乗検定は何をやっているのか｜コグラフ株式会社 データアナリティクス事業部}},
  year = {2024},
  month = oct,
  journal = {note（ノート）},
  urldate = {2024-12-07},
  abstract = {こんにちは。コグラフ株式会社データアナリティクス事業部の塩見です。  私は「カイ二乗検定」に対して、当初は納得できない部分がありました。やりたいことに対して、必要以上に複雑な手法のように感じたからです。同じような疑問を持つ方も多いのではないでしょうか。この記事では、私が「カイ二乗検定」を理解し納得するまでの過程をお伝えします。  結論から言いますと、一度頻度論を離れてベイズ統計の視点で考えてみたところ、実は非常に単純なことを行っていると気づきました。その後、カイ二乗検定を再び考え直すと、すんなり理解できたというお話です。   カイ二乗検定の手順  まず、サイコロを何度も投げ、出た目の回},
  howpublished = {https://note.com/cograph\_data/n/n7e330ded4147},
  langid = {japanese},
  file = {C:\Users\furuh\Zotero\storage\A4E5FJUS\カイ二乗検定は何をやっているのか.pdf}
}

@article{kakikawaBayesianFusedLasso2023,
  title = {Bayesian Fused Lasso Modeling via Horseshoe Prior},
  author = {Kakikawa, Yuko and Shimamura, Kaito and Kawano, Shuichi},
  year = {2023},
  month = nov,
  journal = {Japanese Journal of Statistics and Data Science},
  volume = {6},
  number = {2},
  pages = {705--727},
  issn = {2520-8764},
  doi = {10.1007/s42081-023-00213-2},
  urldate = {2025-05-08},
  abstract = {Bayesian fused lasso is one of the sparse Bayesian methods, which shrinks both regression coefficients and their successive differences simultaneously. In this paper, we propose a Bayesian fused lasso modeling via horseshoe prior. By assuming a horseshoe prior on the difference of successive regression coefficients, the proposed method enables us to prevent over-shrinkage of those differences. We also propose a Bayesian nearly hexagonal operator for regression with shrinkage and equality selection with horseshoe prior, which imposes priors on all combinations of differences of regression coefficients. Simulation studies and an application to real data show that the proposed method gives better performance than existing methods.},
  langid = {english},
  keywords = {Fusion of coefficients,Hierarchical Bayesian model,Horseshoe prior,Markov chain Monte Carlo},
  annotation = {abstractTranslation: ベイズ fused lassoは、スパースベイズ法の1つであり、回帰係数とその連続する差分を同時に縮小する。本稿では、ホースシュー事前分布を用いたベイズ fused lassoモデリングを提案する。連続する回帰係数の差分にホースシュー事前分布を仮定することで、提案手法は差分の過剰な縮小を防ぐことができる。また、縮小と等値選択を伴う回帰のために、ホースシュー事前分布を用いたベイズ nearly hexagonal operatorを提案する。これは、回帰係数の差分のすべての組み合わせに事前分布を課すものである。シミュレーション研究と実データへの応用により、提案手法が既存の手法よりも優れた性能を示すことが示された。},
  file = {C:\Users\furuh\Zotero\storage\V9QYTLS7\Kakikawa et al. - 2023 - Bayesian fused lasso modeling via horseshoe prior.pdf}
}

@misc{kaleGradientFlowPopulation2022,
  title = {From {{Gradient Flow}} on {{Population Loss}} to {{Learning}} with {{Stochastic Gradient Descent}}},
  author = {Kale, Satyen and Lee, Jason D. and De Sa, Chris and Sekhari, Ayush and Sridharan, Karthik},
  year = {2022},
  month = oct,
  number = {arXiv:2210.06705},
  eprint = {2210.06705},
  primaryclass = {cs, math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2210.06705},
  urldate = {2022-12-17},
  abstract = {Stochastic Gradient Descent (SGD) has been the method of choice for learning large-scale non-convex models. While a general analysis of when SGD works has been elusive, there has been a lot of recent progress in understanding the convergence of Gradient Flow (GF) on the population loss, partly due to the simplicity that a continuous-time analysis buys us. An overarching theme of our paper is providing general conditions under which SGD converges, assuming that GF on the population loss converges. Our main tool to establish this connection is a general converse Lyapunov like theorem, which implies the existence of a Lyapunov potential under mild assumptions on the rates of convergence of GF. In fact, using these potentials, we show a one-to-one correspondence between rates of convergence of GF and geometrical properties of the underlying objective. When these potentials further satisfy certain self-bounding properties, we show that they can be used to provide a convergence guarantee for Gradient Descent (GD) and SGD (even when the paths of GF and GD/SGD are quite far apart). It turns out that these self-bounding assumptions are in a sense also necessary for GD/SGD to work. Using our framework, we provide a unified analysis for GD/SGD not only for classical settings like convex losses, or objectives that satisfy PL / KL properties, but also for more complex problems including Phase Retrieval and Matrix sq-root, and extending the results in the recent work of Chatterjee 2022.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Machine Learning,Mathematics - Optimization and Control},
  file = {C:\Users\furuh\Zotero\storage\FLHR5Q56\Kale et al_2022_From Gradient Flow on Population Loss to Learning with Stochastic Gradient.pdf}
}

@article{kalsotraComprehensiveSurveyVideo2019,
  title = {A {{Comprehensive Survey}} of {{Video Datasets}} for {{Background Subtraction}}},
  author = {Kalsotra, Rudrika and Arora, Sakshi},
  year = {2019},
  journal = {IEEE Access},
  volume = {7},
  pages = {59143--59171},
  issn = {2169-3536},
  doi = {10.1109/ACCESS.2019.2914961},
  urldate = {2025-01-17},
  abstract = {Background subtraction is an effective method of choice when it comes to detection of moving objects in videos and has been recognized as a breakthrough for the wide range of applications of intelligent video analytics (IVA). In recent years, a number of video datasets intended for background subtraction have been created to address the problem of large realistic datasets with accurate ground truth. The use of these datasets enables qualitative as well as quantitative comparisons and allows benchmarking of different algorithms. Finding the appropriate dataset is generally a cumbersome task for an exhaustive evaluation of algorithms. Therefore, we systematically survey standard video datasets and list their applicability for different applications. This paper presents a comprehensive account of public video datasets for background subtraction and attempts to cover the lack of a detailed description of each dataset. The video datasets are presented in chronological order of their appearance. Current trends of deep learning in background subtraction along with top-ranked background subtraction methods are also discussed in this paper. The survey introduced in this paper will assist researchers of the computer vision community in the selection of appropriate video dataset to evaluate their algorithms on the basis of challenging scenarios that exist in both indoor and outdoor environments.},
  langid = {english},
  keywords = {Background model,background subtraction,Cameras,challenges,datasets,deep neural networks,foreground,intelligent video analytics (IVA),Lighting,Man-machine systems,Streaming media,Surveillance,video frames,Video sequences,Visualization},
  annotation = {abstractTranslation: 背景減算は、ビデオ内の移動物体を検出する場合に選択される効果的な方法であり、インテリジェント ビデオ分析 (IVA) の幅広いアプリケーションの画期的な方法として認識されています。近年、正確なグラウンド トゥルースを備えた大規模で現実的なデータセットの問題に対処するために、背景の減算を目的とした多数のビデオ データセットが作成されています。これらのデータセットを使用すると、定性的および定量的な比較が可能になり、さまざまなアルゴリズムのベンチマークが可能になります。アルゴリズムを徹底的に評価する場合、適切なデータセットを見つけるのは一般に面倒な作業です。したがって、私たちは標準的なビデオ データセットを体系的に調査し、さまざまなアプリケーションへの適用可能性をリストします。このペーパーでは、背景減算のための公開ビデオ データセットの包括的な説明を示し、各データセットの詳細な説明の不足を補おうとしています。ビデオ データセットは、出現の時系列順に表示されます。この論文では、背景減算における深層学習の現在の傾向と、トップランクの背景減算手法についても説明します。このペーパーで紹介する調査は、コンピューター ビジョン コミュニティの研究者が、屋内と屋外の両方の環境に存在する困難なシナリオに基づいてアルゴリズムを評価するための適切なビデオ データセットを選択するのに役立ちます。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\84LXKMX8\\Kalsotra と Arora - 2019 - A Comprehensive Survey of Video Datasets for Background Subtraction.pdf;C\:\\Users\\furuh\\Zotero\\storage\\72YIL3AY\\8706931.html}
}

@article{kamaliPhysicsinformedUNetsDiscovering2024,
  title = {Physics-Informed {{UNets}} for Discovering Hidden Elasticity in Heterogeneous Materials},
  author = {Kamali, Ali and Laksari, Kaveh},
  year = {2024},
  month = feb,
  journal = {Journal of the Mechanical Behavior of Biomedical Materials},
  volume = {150},
  pages = {106228},
  issn = {1751-6161},
  doi = {10.1016/j.jmbbm.2023.106228},
  urldate = {2024-11-13},
  abstract = {Soft biological tissues often have complex mechanical properties due to variation in structural components. In this paper, we develop a novel UNet-based neural network model for inversion in elasticity (El-UNet) to infer the spatial distributions of mechanical parameters from strain maps as input images, normal stress boundary conditions, and domain physics information. We show superior performance -- both in terms of accuracy and computational cost -- by El-UNet compared to fully-connected physics-informed neural networks in estimating unknown parameters and stress distributions for isotropic linear elasticity. We characterize different variations of El-UNet and propose a self-adaptive spatial loss weighting approach. To validate our inversion models, we performed various finite-element simulations of isotropic domains with heterogenous distributions of material parameters to generate synthetic data. El-UNet is faster and more accurate than the fully-connected physics-informed implementation in resolving the distribution of unknown fields. Among the tested models, the self-adaptive spatially weighted models had the most accurate reconstructions in equal computation times. The learned spatial weighting distribution visibly corresponded to regions that the unweighted models were resolving inaccurately. Our work demonstrates a computationally efficient inversion algorithm for elasticity imaging using convolutional neural networks and presents a potential fast framework for three-dimensional inverse elasticity problems that have proven unachievable through previously proposed methods.},
  langid = {american},
  keywords = {Deep learning,Elasticity imaging,Model-based elastography,Tissue biomechanics},
  annotation = {abstractTranslation: 柔らかい生体組織は、構造成分のばらつきにより複雑な力学的特性を持つことが多い。本論文では、入力画像としてのひずみマップ、法線応力境界条件、およびドメイン物理情報から力学的パラメータの空間分布を推測するための、新しいUNetベースの弾性反転ニューラルネットワークモデル（El-UNet）を開発する。El-UNetは、等方性線形弾性に関する未知のパラメータと応力分布を推定する際に、完全接続された物理情報ニューラルネットワークと比較して、精度と計算コストの両面で優れた性能を示す。我々は、El-UNetの様々なバリエーションを特徴付け、自己適応的な空間損失重み付けアプローチを提案します。我々のインバージョンモデルを検証するために、材料パラメータの分布が不均質な等方性領域の様々な有限要素シミュレーションを行い、合成データを作成しました。El-UNetは、未知の場の分布を解決する上で、完全に接続された物理情報に基づく実装よりも高速かつ高精度でした。テストされたモデルの中で、自己適応的空間重み付けモデルは、同じ計算時間で最も正確な再構成を行った。学習された空間重み付け分布は、重み付けなしモデルが不正確に解決していた領域に目に見えて対応した。本研究は、畳み込みニューラルネットワークを用いた弾性イメージングにおける計算効率の高いインバージョンアルゴリズムを実証し、これまで提案されてきた手法では達成できなかった3次元逆弾性問題に対する高速なフレームワークの可能性を提示するものである。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\GPIM8MFA\\Kamali と Laksari - 2024 - Physics-informed UNets for discovering hidden elasticity in heterogeneous materials.pdf;C\:\\Users\\furuh\\Zotero\\storage\\4PFSXSZE\\S1751616123005817.html}
}

@inproceedings{kamathDesignWeaklyConvexRegularizers2025,
  title = {On the {{Design}} of {{Weakly-Convex Regularizers}} for {{Solving Linear Inverse Problems}}},
  booktitle = {{{ICASSP}} 2025 - 2025 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {Kamath, Abijith Jagannath and Bhandiwad, Abhishek Shreekant and Seelamantula, Chandra Sekhar},
  year = {2025},
  month = apr,
  pages = {1--5},
  issn = {2379-190X},
  doi = {10.1109/ICASSP49660.2025.10889256},
  urldate = {2025-03-14},
  abstract = {Linear inverse problems are ubiquitous in signal processing and computational imaging. The prototypical problem is to recover a signal from noisy linear measurements. A typical optimization-based approach is to minimize the sum of a data-fidelity loss and a regularization function. The data-fidelity function ensures consistency with the measurements and the regularization function imparts desired properties to the solution. Convex regularization functions are typically preferred as one can provide theoretical guarantees. However, the convex-nonconvex (CNC) framework, which employs a convex data-fidelity loss and a nonconvex regularization function has been shown to be superior in terms of the quality of signal recovery. In this paper, we consider model-based and data-driven nonconvex regularization objectives to solve linear inverse problems. We consider the denoising problem and propose a constructive approach to design weakly convex regularization functions by minimizing a measure of maximum concavity. Our design approach captures known model-based regularization functions, including those that promote sparsity, and also includes learnable convolutional neural networks. Minimization of the objective follows first-order gradient-based methods. Our approach ensures that the overall reconstruction technique is provably convergent. We show that it outperforms state-of-the-art model-based techniques and is comparable to the benchmark learningbased methods. Crucially, our technique results in reconstructions with fewer artifacts compared to the state-of-the-art learning-based methods. Our reconstruction approach reduces the number of network parameters to be learnt for similar neural network architectures making it easier/faster to train.},
  langid = {english},
  keywords = {Benchmark testing,Computational imaging,Convex functions,Convolutional neural networks,image denoising,Image reconstruction,Inverse problems,linear inverse problems,minimax concave penalty,Neural networks,Noise measurement,Noise reduction,Prototypes,Speech processing,weakly convex functions},
  annotation = {abstractTranslation: 線形逆の問題は、信号処理と計算イメージングで遍在しています。原型的な問題は、ノイズの多い線形測定から信号を回復することです。典型的な最適化ベースのアプローチは、データ忠実な損失と正則化関数の合計を最小化することです。データの忠実度関数は、測定との一貫性を保証し、正規化関数はソリューションに望ましい特性を伝えます。凸状の正規化関数は、理論的保証を提供できるため、通常好まれます。ただし、凸データ忠実度の損失を採用している凸状非知らせ（CNC）フレームワークと非凸の正規化関数は、信号回復の品質の点で優れていることが示されています。この論文では、線形逆問題を解決するために、モデルベースとデータ駆動型の非凸の正規化目標を検討します。除去の問題を考慮し、最大の凹面の尺度を最小限に抑えることにより、弱く凸状の正規化関数を設計するための建設的なアプローチを提案します。当社の設計アプローチは、スパースを促進し、学習可能な畳み込みニューラルネットワークを含む既知のモデルベースの正規化関数をキャプチャします。目的の最小化は、1次勾配ベースの方法に従います。私たちのアプローチにより、全体的な再構成技術が確実に収束することが保証されます。最先端のモデルベースの手法よりも優れており、ベンチマーク学習ベースの方法に匹敵することを示しています。重要なことに、私たちの手法は、最先端の学習ベースの方法と比較して、アーティファクトが少ないことで再構築されます。再構成アプローチにより、同様のニューラルネットワークアーキテクチャについて学習するネットワークパラメーターの数が減り、トレーニングが容易/高速になります。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\UUL2IAS9\\Kamath et al. - 2025 - On the Design of Weakly-Convex Regularizers for Solving Linear Inverse Problems.pdf;C\:\\Users\\furuh\\Zotero\\storage\\KGMTL5NK\\10889256.html}
}

@article{kamilovPlugPlayMethodsIntegrating2023,
  title = {Plug-and-{{Play Methods}} for {{Integrating Physical}} and {{Learned Models}} in {{Computational Imaging}}},
  author = {Kamilov, Ulugbek S. and Bouman, Charles A. and Buzzard, Gregery T. and Wohlberg, Brendt},
  year = {2023},
  month = jan,
  journal = {IEEE Signal Processing Magazine},
  volume = {40},
  number = {1},
  eprint = {2203.17061},
  primaryclass = {eess},
  pages = {85--97},
  issn = {1053-5888, 1558-0792},
  doi = {10.1109/MSP.2022.3199595},
  urldate = {2023-10-07},
  abstract = {Plug-and-Play Priors (PnP) is one of the most widely-used frameworks for solving computational imaging problems through the integration of physical models and learned models. PnP leverages high-fidelity physical sensor models and powerful machine learning methods for prior modeling of data to provide state-of-the-art reconstruction algorithms. PnP algorithms alternate between minimizing a data-fidelity term to promote data consistency and imposing a learned regularizer in the form of an image denoiser. Recent highly-successful applications of PnP algorithms include bio-microscopy, computerized tomography, magnetic resonance imaging, and joint ptycho-tomography. This article presents a unified and principled review of PnP by tracing its roots, describing its major variations, summarizing main results, and discussing applications in computational imaging. We also point the way towards further developments by discussing recent results on equilibrium equations that formulate the problem associated with PnP algorithms.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Electrical Engineering and Systems Science - Image and Video Processing},
  annotation = {abstractTranslation: Plug-and-Play Priors (PnP)は、物理モデルと学習済みモデルの統合を通じて計算画像問題を解決するための、最も広く使用されているフレームワークの1つである。PnPは、高忠実度の物理センサーモデルと、データの事前モデリングのための強力な機械学習手法を活用し、最先端の再構成アルゴリズムを提供する。PnPアルゴリズムは、データの一貫性を促進するためにデータ忠実度の項を最小化することと、画像ノイズ除去の形で学習された正則化を課すことを交互に行う。PnPアルゴリズムの最近の成功例は、生体顕微鏡、コンピュータ断層撮影、磁気共鳴画像、関節プチオトモグラフィーなどである。本稿では、PnPのルーツを辿り、その主なバリエーションを説明し、主な結果を要約し、計算機画像処理における応用について議論することで、PnPの統一的かつ原理的なレビューを行う。また、PnPアルゴリズムに関連する問題を定式化する平衡方程式に関する最近の結果について論じることで、さらなる発展への道を指し示す。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\4PUZ82TB\\Kamilov et al. - 2023 - Plug-and-Play Methods for Integrating Physical and.pdf;C\:\\Users\\furuh\\Zotero\\storage\\RBETVZ26\\2203.html}
}

