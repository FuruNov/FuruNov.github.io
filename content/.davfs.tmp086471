@inproceedings{liEvolutionaryTopologySearch2020a,
  title = {Evolutionary {{Topology Search}} for {{Tensor Network Decomposition}}},
  booktitle = {Proceedings of the 37th {{International Conference}} on {{Machine Learning}}},
  author = {Li, Chao and Sun, Zhun},
  year = {2020},
  month = nov,
  pages = {5947--5957},
  publisher = {PMLR},
  issn = {2640-3498},
  urldate = {2023-10-22},
  abstract = {Tensor network (TN) decomposition is a promising framework to represent extremely high-dimensional problems with few parameters. However, it is challenging to search the (near-)optimal topological structures for TN decomposition, since the number of candidate solutions exponentially grows with increasing the order of a tensor. In this paper, we claim that the issue can be practically tackled by evolutionary algorithms in an affordable manner. We encode the complex topological structures into binary strings, and develop a simple genetic meta-algorithm to search the optimal topology on Hamming space. The experimental results by both synthetic and real-world data demonstrate that our method can effectively discover the ground-truth topology or even better structures with a small number of generations, and significantly boost the representational power of TN decomposition compared with well-known tensor-train (TT) or tensor-ring (TR) models.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\2FVMST6N\Li and Sun - 2020 - Evolutionary Topology Search for Tensor Network De.pdf}
}

@misc{liExponentiallyImprovedDimensionality2021,
  title = {Exponentially {{Improved Dimensionality Reduction}} for \${\textbackslash}ell\_1\$: {{Subspace Embeddings}} and {{Independence Testing}}},
  shorttitle = {Exponentially {{Improved Dimensionality Reduction}} for \${\textbackslash}ell\_1\$},
  author = {Li, Yi and Woodruff, David P. and Yasuda, Taisuke},
  year = {2021},
  month = aug,
  number = {arXiv:2104.12946},
  eprint = {2104.12946},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2104.12946},
  urldate = {2022-12-16},
  abstract = {Despite many applications, dimensionality reduction in the \${\textbackslash}ell\_1\$-norm is much less understood than in the Euclidean norm. We give two new oblivious dimensionality reduction techniques for the \${\textbackslash}ell\_1\$-norm which improve exponentially over prior ones: 1. We design a distribution over random matrices \$S {\textbackslash}in {\textbackslash}mathbb\{R\}{\textasciicircum}\{r {\textbackslash}times n\}\$, where \$r = 2{\textasciicircum}\{{\textbackslash}tilde O(d/({\textbackslash}varepsilon {\textbackslash}delta))\}\$, such that given any matrix \$A {\textbackslash}in {\textbackslash}mathbb\{R\}{\textasciicircum}\{n {\textbackslash}times d\}\$, with probability at least \$1-{\textbackslash}delta\$, simultaneously for all \$x\$, \${\textbackslash}{\textbar}SAx{\textbackslash}{\textbar}\_1 = (1 {\textbackslash}pm {\textbackslash}varepsilon){\textbackslash}{\textbar}Ax{\textbackslash}{\textbar}\_1\$. Note that \$S\$ is linear, does not depend on \$A\$, and maps \${\textbackslash}ell\_1\$ into \${\textbackslash}ell\_1\$. Our distribution provides an exponential improvement on the previous best known map of Wang and Woodruff (SODA, 2019), which required \$r = 2{\textasciicircum}\{2{\textasciicircum}\{{\textbackslash}Omega(d)\}\}\$, even for constant \${\textbackslash}varepsilon\$ and \${\textbackslash}delta\$. Our bound is optimal, up to a polynomial factor in the exponent, given a known \$2{\textasciicircum}\{{\textbackslash}sqrt d\}\$ lower bound for constant \${\textbackslash}varepsilon\$ and \${\textbackslash}delta\$. 2. We design a distribution over matrices \$S {\textbackslash}in {\textbackslash}mathbb\{R\}{\textasciicircum}\{k {\textbackslash}times n\}\$, where \$k = 2{\textasciicircum}\{O(q{\textasciicircum}2)\}({\textbackslash}varepsilon{\textasciicircum}\{-1\} q {\textbackslash}log d){\textasciicircum}\{O(q)\}\$, such that given any \$q\$-mode tensor \$A {\textbackslash}in ({\textbackslash}mathbb\{R\}{\textasciicircum}\{d\}){\textasciicircum}\{{\textbackslash}otimes q\}\$, one can estimate the entrywise \${\textbackslash}ell\_1\$-norm \${\textbackslash}{\textbar}A{\textbackslash}{\textbar}\_1\$ from \$S(A)\$. Moreover, \$S = S{\textasciicircum}1 {\textbackslash}otimes S{\textasciicircum}2 {\textbackslash}otimes {\textbackslash}cdots {\textbackslash}otimes S{\textasciicircum}q\$ and so given vectors \$u\_1, {\textbackslash}ldots, u\_q {\textbackslash}in {\textbackslash}mathbb\{R\}{\textasciicircum}d\$, one can compute \$S(u\_1 {\textbackslash}otimes u\_2 {\textbackslash}otimes {\textbackslash}cdots {\textbackslash}otimes u\_q)\$ in time \$2{\textasciicircum}\{O(q{\textasciicircum}2)\}({\textbackslash}varepsilon{\textasciicircum}\{-1\} q {\textbackslash}log d){\textasciicircum}\{O(q)\}\$, which is much faster than the \$d{\textasciicircum}q\$ time required to form \$u\_1 {\textbackslash}otimes u\_2 {\textbackslash}otimes {\textbackslash}cdots {\textbackslash}otimes u\_q\$. Our linear map gives a streaming algorithm for independence testing using space \$2{\textasciicircum}\{O(q{\textasciicircum}2)\}({\textbackslash}varepsilon{\textasciicircum}\{-1\} q {\textbackslash}log d){\textasciicircum}\{O(q)\}\$, improving the previous doubly exponential \$({\textbackslash}varepsilon{\textasciicircum}\{-1\} {\textbackslash}log d){\textasciicircum}\{q{\textasciicircum}\{O(q)\}\}\$ space bound of Braverman and Ostrovsky (STOC, 2010).},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Data Structures and Algorithms},
  file = {C:\Users\furuh\Zotero\storage\MUR23QS5\Li et al_2021_Exponentially Improved Dimensionality Reduction for $-ell_1$.pdf}
}

@article{liExtendedDynamicMode2017,
  title = {Extended Dynamic Mode Decomposition with Dictionary Learning: {{A}} Data-Driven Adaptive Spectral Decomposition of the {{Koopman}} Operator},
  shorttitle = {Extended Dynamic Mode Decomposition with Dictionary Learning},
  author = {Li, Qianxiao and Dietrich, Felix and Bollt, Erik M. and Kevrekidis, Ioannis G.},
  year = {2017},
  month = oct,
  journal = {Chaos: An Interdisciplinary Journal of Nonlinear Science},
  volume = {27},
  number = {10},
  pages = {103111},
  issn = {1054-1500, 1089-7682},
  doi = {10.1063/1.4993854},
  urldate = {2024-07-13},
  abstract = {Numerical approximation methods for the Koopman operator have advanced considerably in the last few years. In particular, data-driven approaches such as dynamic mode decomposition (DMD)51 and its generalization, the extended-DMD (EDMD), are becoming increasingly popular in practical applications. The EDMD improves upon the classical DMD by the inclusion of a flexible choice of dictionary of observables which spans a finite dimensional subspace on which the Koopman operator can be approximated. This enhances the accuracy of the solution reconstruction and broadens the applicability of the Koopman formalism. Although the convergence of the EDMD has been established, applying the method in practice requires a careful choice of the observables to improve convergence with just a finite number of terms. This is especially difficult for high dimensional and highly nonlinear systems. In this paper, we employ ideas from machine learning to improve upon the EDMD method. We develop an iterative approximation algorithm which couples the EDMD with a trainable dictionary represented by an artificial neural network. Using the Duffing oscillator and the Kuramoto Sivashinsky partical differential equation as examples, we show that our algorithm can effectively and efficiently adapt the trainable dictionary to the problem at hand to achieve good reconstruction accuracy without the need to choose a fixed dictionary a priori. Furthermore, to obtain a given accuracy, we require fewer dictionary terms than EDMD with fixed dictionaries. This alleviates an important shortcoming of the EDMD algorithm and enhances the applicability of the Koopman framework to practical problems.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\JALTEZ8P\Li et al. - 2017 - Extended dynamic mode decomposition with dictionar.pdf}
}

@article{liFastProjectionOrdered2022,
  title = {Fast Projection onto the Ordered Weighted {$\ell$}1 Norm Ball},
  author = {Li, Qinzhen and Li, Xudong},
  year = {2022},
  month = apr,
  journal = {Science China Mathematics},
  volume = {65},
  number = {4},
  pages = {869--886},
  issn = {1674-7283, 1869-1862},
  doi = {10.1007/s11425-020-1743-9},
  urldate = {2024-07-20},
  abstract = {In this paper, we provide a finitely terminated yet efficient approach to compute the Euclidean projection onto the ordered weighted {$\ell$}1 (OWL1) norm ball. In particular, an efficient semismooth Newton method is proposed for solving the dual of a reformulation of the original projection problem. Global and local quadratic convergence results, as well as the finite termination property, of the algorithm are proved. Numerical comparisons with the two best-known methods demonstrate the efficiency of our method. In addition, we derive the generalized Jacobian of the studied projector which, we believe, is crucial for the future designing of fast second-order nonsmooth methods for solving general OWL1 norm constrained problems.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\WF59VP5N\Li and Li - 2022 - Fast projection onto the ordered weighted ℓ1 norm .pdf}
}

@article{liFaultDiagnosisRolling2021,
  title = {Fault {{Diagnosis}} of {{Rolling Bearing Based}} on {{WHVG}} and {{GCN}}},
  author = {Li, Chenyang and Mo, Lingfei and Yan, Ruqiang},
  year = {2021},
  journal = {IEEE Transactions on Instrumentation and Measurement},
  volume = {70},
  pages = {1--11},
  issn = {1557-9662},
  doi = {10.1109/TIM.2021.3087834},
  urldate = {2024-07-17},
  abstract = {In recent years, emerging intelligent algorithms have achieved great success in the domain of fault diagnosis due to effective feature extraction and powerful learning ability. However, the current models can only handle the data in Euclidean space, ignoring latent structure relationships of the signal, which can provide additional helpful information to distinguish diverse fault patterns. To address this issue, a graph convolution network (GCN) incorporating the weighted horizontal visibility graph (WHVG) is proposed for bearing faults diagnosis. The WHVG is utilized to transform time series to graph data from a geometric perspective. Edges are weighted by the difference between the sampling indexes to weaken the influence of remote nodes that are considered as noise. Furthermore, the graph isomorphism network (GIN) is improved as GIN+ to learn the graph representation and perform fault classification. Finally, the validity of WHVG and GIN+ is testified by three real-world bearing datasets. Meanwhile, the GIN+ model is compared with other machine learning models, multilayer perceptron (MLP), long short-term memory (LSTM), and two GCN models. The experimental results show that GIN+ boosts the performance and the internal structure relationships of the data contribute to the bearing faults diagnosis.},
  keywords = {Convolution,Fault diagnosis,Feature extraction,graph convolution network (GCN),Laplace equations,rolling bearing,Time series analysis,Topology,Vibrations,weighted horizontal visibility graph (WHVG)},
  file = {C:\Users\furuh\Zotero\storage\XYSQ79JP\9449834.html}
}

@misc{liFoundationModelsMixed2024,
  title = {Towards {{Foundation Models}} for {{Mixed Integer Linear Programming}}},
  author = {Li, Sirui and Kulkarni, Janardhan and Menache, Ishai and Wu, Cathy and Li, Beibin},
  year = {2024},
  month = oct,
  journal = {arXiv.org},
  urldate = {2024-10-20},
  abstract = {Mixed Integer Linear Programming (MILP) is essential for modeling complex decision-making problems but faces challenges in computational tractability and requires expert formulation. Current deep learning approaches for MILP focus on specific problem classes and do not generalize to unseen classes. To address this shortcoming, we take a foundation model training approach, where we train a single deep learning model on a diverse set of MILP problems to generalize across problem classes. As existing datasets for MILP lack diversity and volume, we introduce MILP-Evolve, a novel LLM-based evolutionary framework that is capable of generating a large set of diverse MILP classes with an unlimited amount of instances. We study our methodology on three key learning tasks that capture diverse aspects of MILP: (1) integrality gap prediction, (2) learning to branch, and (3) a new task of aligning MILP instances with natural language descriptions. Our empirical results show that models trained on the data generated by MILP-Evolve achieve significant improvements on unseen problems, including MIPLIB benchmarks. Our work highlights the potential of moving towards a foundation model approach for MILP that can generalize to a broad range of MILP applications. We are committed to fully open-sourcing our work to advance further research.},
  howpublished = {https://arxiv.org/abs/2410.08288v1},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\IBDIPHT9\Li et al. - 2024 - Towards Foundation Models for Mixed Integer Linear Programming.pdf}
}

@inproceedings{liGuaranteedMatrixCompletion2019,
  title = {Guaranteed {{Matrix Completion Under Multiple Linear Transformations}}},
  booktitle = {Proceedings of {{International Conference}} on {{Computer Vision}} and {{Pattern Recognition}}},
  author = {Li, Chao and He, Wei and Yuan, Longhao and Sun, Zhun and Zhao, Qibin},
  year = {2019},
  month = jun,
  pages = {11128--11137},
  publisher = {IEEE},
  doi = {10.1109/CVPR.2019.01139},
  urldate = {2023-09-02},
  abstract = {Low-rank matrix completion (LRMC) is a classical model in both computer vision (CV) and machine learning, and has been successfully applied to various real applications. In the recent CV tasks, the completion is usually employed on the variants of data, such as ``non-local'' or filtered, rather than their original forms. This fact makes that the theoretical analysis of the conventional LRMC is no longer suitable in these applications. To tackle this problem, we propose a more general framework for LRMC, in which the linear transformations of the data are taken into account. We rigorously prove the identifiability of the proposed model and show an upper bound of the reconstruction error. Furthermore, we derive an efficient completion algorithm by using augmented Lagrangian multipliers and the sketching trick. In the experiments, we apply the proposed method to the classical image inpainting problem and achieve the state-of-the-art results.},
  isbn = {978-1-7281-3293-8},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\RPPNYFLW\Li et al. - 2019 - Guaranteed Matrix Completion Under Multiple Linear.pdf}
}

@article{liHeuristicRankSelection2022,
  title = {Heuristic Rank Selection with Progressively Searching Tensor Ring Network},
  author = {Li, Nannan and Pan, Yu and Chen, Yaran and Ding, Zixiang and Zhao, Dongbin and Xu, Zenglin},
  year = {2022},
  month = apr,
  journal = {Complex \& Intelligent Systems},
  volume = {8},
  number = {2},
  pages = {771--785},
  issn = {2199-4536, 2198-6053},
  doi = {10.1007/s40747-021-00308-x},
  urldate = {2023-10-26},
  abstract = {Abstract             Recently, tensor ring networks (TRNs) have been applied in deep networks, achieving remarkable successes in compression ratio and accuracy. Although highly related to the performance of TRNs, rank selection is seldom studied in previous works and usually set to equal in experiments. Meanwhile, there is not any heuristic method to choose the rank, and an enumerating way to find appropriate rank is extremely time-consuming. Interestingly, we discover that part of the rank elements is sensitive and usually aggregate in a narrow region, namely an interest region. Therefore, based on the above phenomenon, we propose a novel progressive genetic algorithm named progressively searching tensor ring network search (PSTRN), which has the ability to find optimal rank precisely and efficiently. Through the evolutionary phase and progressive phase, PSTRN can converge to the interest region quickly and harvest good performance. Experimental results show that PSTRN can significantly reduce the complexity of seeking rank, compared with the enumerating method. Furthermore, our method is validated on public benchmarks like MNIST, CIFAR10/100, UCF11 and HMDB51, achieving the state-of-the-art performance.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\EIXDGZNM\Li et al. - 2022 - Heuristic rank selection with progressively search.pdf}
}

@article{liHypernetworkConstructionFeature2020,
  title = {Hypernetwork {{Construction}} and {{Feature Fusion Analysis Based}} on {{Sparse Group Lasso Method}} on {{fMRI Dataset}}},
  author = {Li, Yao and Sun, Chao and Li, Pengzu and Zhao, Yunpeng and Mensah, Godfred Kim and Xu, Yong and Guo, Hao and Chen, Junjie},
  year = {2020},
  journal = {Frontiers in Neuroscience},
  volume = {14},
  publisher = {Frontiers Media SA},
  doi = {10.3389/fnins.2020.00060},
  urldate = {2024-09-04},
  abstract = {Recent works have shown that the resting-state brain functional connectivity hypernetwork, where multiple nodes can be connected, are an effective technique for brain disease diagnosis and classification research. The lasso method was used to construct hypernetworks by solving sparse linear regression models in previous research. But, constructing a hypernetwork based on the lasso method simply selects a single variable, in that it lacks the ability to interpret the grouping effect. Considering the group structure problem, the previous study proposed to create a hypernetwork based on the elastic net and the group lasso methods, and the results showed that the former method had the best classification performance. However, the highly correlated variables selected by the elastic net method were not necessarily in the active set in the group. Therefore, we extended our research to address this issue. Herein, we propose a new method that introduces the sparse group lasso method to improve the construction of the hypernetwork by solving the group structure problem of the brain regions. We used the traditional lasso, group lasso method, and sparse group lasso method to construct a hypernetwork in patients with depression and normal subjects. Meanwhile, other clustering coefficients (clustering coefficients based on pairs of nodes) were also introduced to extract features with traditional clustering coefficients. Two types of features with significant differences obtained after feature selection were subjected to multi-kernel learning for feature fusion and classification using each method, respectively. The network topology results revealed differences among the three networks, where hypernetwork using the lasso method was the strictest; the group lasso, most lenient; and the sgLasso method, moderate. The network topology of the sparse group lasso method was similar to that of the group lasso method but different from the lasso method. The classification results show that the sparse group lasso method achieves the best classification accuracy by using multi-kernel learning, which indicates that better classification performance can be achieved when the group structure exists and is properly extended.},
  langid = {english},
  pmid = {32116508},
  annotation = {abstractTranslation: 近年の研究により、複数のノードが接続可能な安静時脳機能接続ハイパーネットワークが、脳疾患の診断や分類研究に有効な手法であることが示されている。これまでの研究では、スパース線形回帰モデルを解くことによりハイパーネットワークを構築するために、lasso法が用いられてきた。しかし、投げ縄法に基づくハイパーネットワークの構築は、単に単一の変数を選択するだけであり、グループ化効果を解釈する能力に欠ける。グループ構造の問題を考慮し、先行研究ではエラスティック・ネット法とグループ・ラッソ法に基づくハイパーネットワークの作成を提案し、その結果、前者の方法が最も優れた分類性能を持つことが示された。しかし、エラスティック・ネット法で選択された相関の高い変数は、必ずしもグループ内のアクティブセットに含まれているわけではなかった。そこで、この問題を解決するために研究を拡張した。ここでは、脳領域のグループ構造問題を解決することにより、ハイパーネットワークの構築を改善するために、スパースグループラッソ法を導入した新しい手法を提案する。うつ病患者と健常者を対象に、従来の投げ縄法、グループ投げ縄法、スパースグループ投げ縄法を用いてハイパーネットワークを構築した。一方、他のクラスタリング係数（ノードのペアに基づくクラスタリング係数）も導入し、従来のクラスタリング係数による特徴量を抽出した。特徴選択後に得られた有意差のある2種類の特徴について、それぞれマルチカーネル学習を行い、特徴融合と各手法による分類を行った。ネットワークトポロジーの結果、ラッソ法を用いたハイパーネットワークが最も厳しく、グループラッソ法が最も甘く、sgLasso法が中程度であった。スパース・グループ・ラッソ法のネットワーク・トポロジーは、グループ・ラッソ法と類似していたが、ラッソ法とは異なっていた。分類結果は、スパース・グループ・ラッソ法がマルチカーネル学習により最高の分類精度を達成したことを示しており、これは、グループ構造が存在し、適切に拡張された場合に、より良い分類性能が達成できることを示している。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\6328DJIJ\\Li et al. - 2020 - Hypernetwork Construction and Feature Fusion Analysis Based on Sparse Group Lasso Method on fMRI Dat.pdf;C\:\\Users\\furuh\\Zotero\\storage\\5N9N9TTJ\\PMC7029661.html}
}

@misc{liImplicitRegularizationBregman2023,
  title = {Implicit {{Regularization}} of {{Bregman Proximal Point Algorithm}} and {{Mirror Descent}} on {{Separable Data}}},
  author = {Li, Yan and Ju, Caleb and Fang, Ethan X. and Zhao, Tuo},
  year = {2023},
  month = aug,
  number = {arXiv:2108.06808},
  eprint = {2108.06808},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2108.06808},
  urldate = {2023-09-09},
  abstract = {Bregman proximal point algorithm (BPPA) has witnessed emerging machine learning applications, yet its theoretical understanding has been largely unexplored. We study the computational properties of BPPA through learning linear classifiers with separable data, and demonstrate provable algorithmic regularization of BPPA. For any BPPA instantiated with a fixed Bregman divergence, we provide a lower bound of the margin obtained by BPPA with respect to an arbitrarily chosen norm. The obtained margin lower bound differs from the maximal margin by a multiplicative factor, which inversely depends on the condition number of the distance-generating function measured in the dual norm. We show that the dependence on the condition number is tight, thus demonstrating the importance of divergence in affecting the quality of the learned classifiers. We then extend our findings to mirror descent, for which we establish similar connections between the margin and Bregman divergence, together with a non-asymptotic analysis. Numerical experiments on both synthetic and real-world datasets are provided to support our theoretical findings. To the best of our knowledge, the aforementioned findings appear to be new in the literature of algorithmic regularization.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning}
}

@misc{liImplicitRegularizationGroup2023,
  title = {Implicit {{Regularization}} for {{Group Sparsity}}},
  author = {Li, Jiangyuan and Nguyen, Thanh V. and Hegde, Chinmay and Wong, Raymond K. W.},
  year = {2023},
  month = jan,
  number = {arXiv:2301.12540},
  eprint = {2301.12540},
  primaryclass = {cs, stat},
  urldate = {2023-02-21},
  abstract = {We study the implicit regularization of gradient descent towards structured sparsity via a novel neural reparameterization, which we call a diagonally grouped linear neural network. We show the following intriguing property of our reparameterization: gradient descent over the squared regression loss, without any explicit regularization, biases towards solutions with a group sparsity structure. In contrast to many existing works in understanding implicit regularization, we prove that our training trajectory cannot be simulated by mirror descent. We analyze the gradient dynamics of the corresponding regression problem in the general noise setting and obtain minimax-optimal error rates. Compared to existing bounds for implicit sparse regularization using diagonal linear networks, our analysis with the new reparameterization shows improved sample complexity. In the degenerate case of size-one groups, our approach gives rise to a new algorithm for sparse linear regression. Finally, we demonstrate the efficacy of our approach with several numerical experiments.},
  archiveprefix = {arXiv},
  langid = {english},
  annotation = {abstractTranslation: 我々は、対角的にグループ化された線形ニューラルネットワークと呼ぶ新しいニューラル再パラメータ化によって、構造化されたスパース性に向かう勾配降下の暗黙の正則化を研究する。明示的な正則化なしに、回帰損失の2乗に対する勾配降下は、群スパース構造を持つ解に偏る。暗黙的な正則化を理解する多くの既存の研究とは対照的に、我々は、我々の学習軌跡はミラー降下ではシミュレートできないことを証明する。一般的なノイズ設定における対応する回帰問題の勾配ダイナミクスを解析し、最小最適誤差率を求める。対角線形ネットワークを用いた暗黙的スパース正則化の既存の境界と比較して、新しい再パラメータ化を用いた我々の解析は、サンプルの複雑さが改善されていることを示す。サイズ1群の退化的な場合において、我々のアプローチはスパース線形回帰の新しいアルゴリズムを生み出す。最後に、いくつかの数値実験により、我々のアプローチの有効性を示す。},
  file = {C:\Users\furuh\Zotero\storage\LSZ28DEU\Li et al_2023_Implicit Regularization for Group Sparsity.pdf}
}

@misc{liImplicitSparseRegularization2021,
  title = {Implicit {{Sparse Regularization}}: {{The Impact}} of {{Depth}} and {{Early Stopping}}},
  shorttitle = {Implicit {{Sparse Regularization}}},
  author = {Li, Jiangyuan and Nguyen, Thanh V. and Hegde, Chinmay and Wong, Raymond K. W.},
  year = {2021},
  month = oct,
  number = {arXiv:2108.05574},
  eprint = {2108.05574},
  primaryclass = {cs, stat},
  urldate = {2023-02-20},
  abstract = {In this paper, we study the implicit bias of gradient descent for sparse regression. We extend results on regression with quadratic parametrization, which amounts to depth-2 diagonal linear networks, to more general depth-N networks, under more realistic settings of noise and correlated designs. We show that early stopping is crucial for gradient descent to converge to a sparse model, a phenomenon that we call implicit sparse regularization. This result is in sharp contrast to known results for noiseless and uncorrelated-design cases. We characterize the impact of depth and early stopping and show that for a general depth parameter N, gradient descent with early stopping achieves minimax optimal sparse recovery with sufficiently small initialization and step size. In particular, we show that increasing depth enlarges the scale of working initialization and the early-stopping window so that this implicit sparse regularization effect is more likely to take place.},
  archiveprefix = {arXiv},
  file = {C:\Users\furuh\Zotero\storage\C3EEAY6N\Li et al_2021_Implicit Sparse Regularization.pdf}
}

@inproceedings{liLoftQLoRAFineTuningawareQuantization2023,
  title = {{{LoftQ}}: {{LoRA-Fine-Tuning-aware Quantization}} for {{Large Language Models}}},
  shorttitle = {{{LoftQ}}},
  booktitle = {The {{Twelfth International Conference}} on {{Learning Representations}}},
  author = {Li, Yixiao and Yu, Yifan and Liang, Chen and Karampatziakis, Nikos and He, Pengcheng and Chen, Weizhu and Zhao, Tuo},
  year = {2023},
  month = oct,
  urldate = {2024-06-17},
  abstract = {Quantization is an indispensable technique for serving Large Language Models (LLMs) and has recently found its way into LoRA fine-tuning (Dettmers et al., 2023). In this work we focus on the scenario where quantization and LoRA fine- tuning are applied together on a pre-trained model. In such cases it is common to observe a consistent gap in the performance on downstream tasks between full fine-tuning and quantization plus LoRA fine-tuning approach. In response, we propose LoftQ (LoRA-Fine-Tuning-aware Quantization), a novel quantization framework that simultaneously quantizes an LLM and finds a proper low-rank initialization for LoRA fine-tuning. Such an initialization alleviates the discrep- ancy between the quantized and full-precision model and significantly improves the generalization in downstream tasks. We evaluate our method on natural lan- guage understanding, question answering, summarization, and natural language generation tasks. Experiments show that our method is highly effective and out- performs existing quantization methods, especially in the challenging 2-bit and 2/4-bit mixed precision regimes. We will release our code.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\7JPJ6JCY\Li et al. - 2023 - LoftQ LoRA-Fine-Tuning-aware Quantization for Lar.pdf}
}

@article{liLoSparseStructuredCompression2023,
  title = {{{LoSparse}}: {{Structured Compression}} of {{Large Language Models}} Based on {{Low-Rank}} and {{Sparse Approximation}}},
  shorttitle = {{{LoSparse}}},
  author = {Li, Yixiao and Yu, Yifan and Zhang, Qingru and Liang, Chen and He, Pengcheng and Chen, Weizhu and Zhao, Tuo},
  year = {2023},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2306.11222},
  urldate = {2023-11-29},
  abstract = {Transformer models have achieved remarkable results in various natural language tasks, but they are often prohibitively large, requiring massive memories and computational resources. To reduce the size and complexity of these models, we propose LoSparse (Low-Rank and Sparse approximation), a novel model compression technique that approximates a weight matrix by the sum of a low-rank matrix and a sparse matrix. Our method combines the advantages of both low-rank approximations and pruning, while avoiding their limitations. Low-rank approximation compresses the coherent and expressive parts in neurons, while pruning removes the incoherent and non-expressive parts in neurons. Pruning enhances the diversity of low-rank approximations, and low-rank approximation prevents pruning from losing too many expressive neurons. We evaluate our method on natural language understanding, question answering, and natural language generation tasks. We show that it significantly outperforms existing compression methods.},
  copyright = {arXiv.org perpetual, non-exclusive license},
  langid = {american},
  keywords = {Computation and Language (cs.CL),FOS: Computer and information sciences,Machine Learning (cs.LG)},
  annotation = {abstractTranslation: 変換モデルは様々な自然言語タスクにおいて顕著な成果を上げているが、しばしば法外に大きく、膨大なメモリと計算資源を必要とする。このようなモデルのサイズと複雑さを低減するために、我々は、重み行列を低ランク行列とスパース行列の和で近似する新しいモデル圧縮手法であるLoSparse（低ランク・スパース近似）を提案する。本手法は、低ランク近似とプルーニングの両方の利点を併せ持ち、同時にそれらの限界を回避する。低ランク近似はニューロン中のコヒーレントで表現的な部分を圧縮し、プルーニングはニューロン中の非コヒーレントで非表現的な部分を除去する。プルーニングは低ランク近似の多様性を強化し、低ランク近似はプルーニングによって表現力の高いニューロンが失われすぎるのを防ぐ。本手法を自然言語理解、質問応答、自然言語生成タスクで評価した。その結果、既存の圧縮手法を大幅に凌駕することを示す。},
  file = {C:\Users\furuh\Zotero\storage\XPUXILSN\Li et al. - 2023 - LoSparse Structured Compression of Large Language.pdf}
}

@article{liLowDimensionalTrajectory2022,
  title = {Low {{Dimensional Trajectory Hypothesis}} Is {{True}}: {{DNNs}} Can Be {{Trained}} in {{Tiny Subspaces}}},
  shorttitle = {Low {{Dimensional Trajectory Hypothesis}} Is {{True}}},
  author = {Li, Tao and Tan, Lei and Huang, Zhehao and Tao, Qinghua and Liu, Yipeng and Huang, Xiaolin},
  year = {2022},
  journal = {IEEE Transactions on Pattern Analysis and Machine Intelligence},
  pages = {1--1},
  issn = {0162-8828, 2160-9292, 1939-3539},
  doi = {10.1109/TPAMI.2022.3178101},
  urldate = {2023-10-21},
  abstract = {Deep neural networks (DNNs) usually contain massive parameters, but there is redundancy such that it is guessed that they could be trained in low-dimensional subspaces. In this paper, we propose a Dynamic Linear Dimensionality Reduction (DLDR) based on the low-dimensional properties of the training trajectory. The reduction method is efficient, supported by comprehensive experiments: optimizing DNNs in 40-dimensional spaces can achieve comparable performance as regular training over thousands or even millions of parameters. Since there are only a few variables to optimize, we develop an efficient quasi-Newton-based algorithm, obtain robustness to label noise, and improve the performance of well-trained models, which are three follow-up experiments that can show the advantages of finding such low-dimensional subspaces. The code is released (Pytorch: https://github.com/nblt/DLDR and Mindspore: https://gitee.com/mindspore/docs/tree/r1.6/docs/sample\_code/dimension\_reduce\_training).}
}

@misc{limGraphMetanetworksProcessing2023,
  title = {Graph {{Metanetworks}} for {{Processing Diverse Neural Architectures}}},
  author = {Lim, Derek and Maron, Haggai and Law, Marc T. and Lorraine, Jonathan and Lucas, James},
  year = {2023},
  month = dec,
  number = {arXiv:2312.04501},
  eprint = {2312.04501},
  primaryclass = {cs, stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2312.04501},
  urldate = {2024-05-10},
  abstract = {Neural networks efficiently encode learned information within their parameters. Consequently, many tasks can be unified by treating neural networks themselves as input data. When doing so, recent studies demonstrated the importance of accounting for the symmetries and geometry of parameter spaces. However, those works developed architectures tailored to specific networks such as MLPs and CNNs without normalization layers, and generalizing such architectures to other types of networks can be challenging. In this work, we overcome these challenges by building new metanetworks - neural networks that take weights from other neural networks as input. Put simply, we carefully build graphs representing the input neural networks and process the graphs using graph neural networks. Our approach, Graph Metanetworks (GMNs), generalizes to neural architectures where competing methods struggle, such as multi-head attention layers, normalization layers, convolutional layers, ResNet blocks, and group-equivariant linear layers. We prove that GMNs are expressive and equivariant to parameter permutation symmetries that leave the input neural network functions unchanged. We validate the effectiveness of our method on several metanetwork tasks over diverse neural network architectures.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Machine Learning,Statistics - Machine Learning}
}

@inproceedings{limKSupportOrderedWeighted2017,
  title = {K-{{Support}} and {{Ordered Weighted Sparsity}} for {{Overlapping Groups}}: {{Hardness}} and {{Algorithms}}},
  shorttitle = {K-{{Support}} and {{Ordered Weighted Sparsity}} for {{Overlapping Groups}}},
  booktitle = {Neural {{Information Processing Systems}}},
  author = {Lim, Cong Han and Wright, Stephen J.},
  year = {2017},
  urldate = {2024-08-24},
  abstract = {The k-support and OWL norms generalize the l1 norm, providing better prediction accuracy and better handling of correlated variables. We study the norms obtained from extending the k-support norm and OWL norms to the setting in which there are overlapping groups. The resulting norms are in general NP-hard to compute, but they are tractable for certain collections of groups. To demonstrate this fact, we develop a dynamic program for the problem of projecting onto the set of vectors supported by a fixed number of groups. Our dynamic program utilizes tree decompositions and its complexity scales with the treewidth. This program can be converted to an extended formulation which, for the associated group structure, models the k-group support norms and an overlapping group variant of the ordered weighted l1 norm. Numerical results demonstrate the efficacy of the new penalties.},
  keywords = {No DOI found}
}

@article{limNonnegativeApproximationsNonnegative2009,
  title = {Nonnegative Approximations of Nonnegative Tensors},
  author = {Lim, Lek-Heng and Comon, Pierre},
  year = {2009},
  month = jul,
  journal = {Journal of Chemometrics},
  volume = {23},
  number = {7-8},
  pages = {432--441},
  issn = {0886-9383, 1099-128X},
  doi = {10.1002/cem.1244},
  urldate = {2023-10-19},
  abstract = {Abstract             We study the decomposition of a nonnegative tensor into a minimal sum of outer product of nonnegative vectors and the associated parsimonious na{\"i}ve Bayes probabilistic model. We show that the corresponding approximation problem, which is central to nonnegative PARAFAC, will always have optimal solutions. The result holds for any choice of norms and, under a mild assumption, even Br{\`e}gman divergences. Copyright {\copyright} 2009 John Wiley \& Sons, Ltd.           ,              We study the decomposition of a nonnegative tensor into a minimal sum of outer product of nonnegative vectors and the associated parsimonious na{\"i}ve Bayes probabilistic model. We show that the corresponding approximation problem, which is central to nonnegative PARAFAC, will always have optimal solutions. The result holds for any choice of norms and, under a mild assumption, even Bregman divergences.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\KIQNC55S\Lim and Comon - 2009 - Nonnegative approximations of nonnegative tensors.pdf}
}

@article{liModelCompressionDeep2023,
  title = {Model {{Compression}} for {{Deep Neural Networks}}: {{A Survey}}},
  shorttitle = {Model {{Compression}} for {{Deep Neural Networks}}},
  author = {Li, Zhuo and Li, Hengyi and Meng, Lin},
  year = {2023},
  month = mar,
  journal = {Computers},
  volume = {12},
  number = {3},
  pages = {60},
  issn = {2073-431X},
  doi = {10.3390/computers12030060},
  urldate = {2024-10-18},
  abstract = {Currently, with the rapid development of deep learning, deep neural networks (DNNs) have been widely applied in various computer vision tasks. However, in the pursuit of performance, advanced DNN models have become more complex, which has led to a large memory footprint and high computation demands. As a result, the models are difficult to apply in real time. To address these issues, model compression has become a focus of research. Furthermore, model compression techniques play an important role in deploying models on edge devices. This study analyzed various model compression methods to assist researchers in reducing device storage space, speeding up model inference, reducing model complexity and training costs, and improving model deployment. Hence, this paper summarized the state-of-the-art techniques for model compression, including model pruning, parameter quantization, low-rank decomposition, knowledge distillation, and lightweight model design. In addition, this paper discusses research challenges and directions for future work.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  keywords = {deep neural networks,knowledge distillation,lightweight model design,low-rank decomposition,model compression,model pruning,parameter quantization},
  annotation = {abstractTranslation: 現在、ディープラーニングの急速な発展に伴い、ディープニューラルネットワーク（DNN）は様々なコンピュータビジョンタスクに広く応用されている。しかし、性能を追求するあまり、先進的なDNNモデルは複雑化し、メモリフットプリントが大きく、計算要求が高くなっている。その結果、モデルをリアルタイムで適用することが困難になっている。これらの問題に対処するため、モデルの圧縮が研究の焦点となっています。さらに、モデル圧縮技術は、エッジデバイス上にモデルを展開する際に重要な役割を果たす。本研究では、研究者がデバイスのストレージ容量を削減し、モデル推論を高速化し、モデルの複雑さと学習コストを削減し、モデル展開を改善するのを支援するために、様々なモデル圧縮手法を分析した。そのため、本稿では、モデルの刈り込み、パラメータ量子化、低ランク分解、知識蒸留、軽量モデル設計など、モデル圧縮のための最先端の技術を要約した。さらに、本論文では、今後の研究課題と方向性について議論する。},
  file = {C:\Users\furuh\Zotero\storage\G7LAX7TB\Li et al. - 2023 - Model Compression for Deep Neural Networks A Survey.pdf}
}

@inproceedings{limSparseAutoencodersReveal2024,
  title = {Sparse Autoencoders Reveal Selective Remapping of Visual Concepts during Adaptation},
  booktitle = {The {{Thirteenth International Conference}} on {{Learning Representations}}},
  author = {Lim, Hyesu and Choi, Jinho and Choo, Jaegul and Schneider, Steffen},
  year = {2024},
  month = oct,
  urldate = {2025-04-26},
  abstract = {Adapting foundation models for specific purposes has become a standard approach to build machine learning systems for downstream applications. Yet, it is an open question which mechanisms take place during adaptation. Here we develop a new Sparse Autoencoder (SAE) for the CLIP vision transformer, named PatchSAE, to extract interpretable concepts at granular levels (e.g., shape, color, or semantics of an object) and their patch-wise spatial attributions. We explore how these concepts influence the model output in downstream image classification tasks and investigate how recent state-of-the-art prompt-based adaptation techniques change the association of model inputs to these concepts. While activations of concepts slightly change between adapted and non-adapted models, we find that the majority of gains on common adaptation tasks can be explained with the existing concepts already present in the non-adapted foundation model. This work provides a concrete framework to train and use SAEs for Vision Transformers and provides insights into explaining adaptation mechanisms.},
  langid = {english},
  annotation = {abstractTranslation: 特定の目的のために基盤モデルを適応させることは、ダウンストリームアプリケーション向けの機械学習システムを構築するための標準的なアプローチとなっています。しかし、適応中にどのようなメカニズムが起こるかは未解決の問題です。本研究では、CLIPビジョントランスフォーマーのための新しいSparse Autoencoder（SAE）であるPatchSAEを開発し、粒度の細かいレベル（例：オブジェクトの形状、色、または意味）で解釈可能な概念と、それらのパッチごとの空間的属性を抽出します。これらの概念が、ダウンストリームの画像分類タスクにおけるモデル出力にどのように影響するかを調査し、最近の最先端のプロンプトベースの適応技術が、モデル入力とこれらの概念との関連性をどのように変化させるかを検証します。適応されたモデルと適応されていないモデルの間で、概念の活性化はわずかに変化するものの、一般的な適応タスクにおけるゲインの大部分は、適応されていない基盤モデルに既に存在する既存の概念で説明できることがわかりました。本研究は、ビジョントランスフォーマーのためのSAEをトレーニングし、使用するための具体的なフレームワークを提供し、適応メカニズムを説明するための洞察を提供します。},
  file = {C:\Users\furuh\Zotero\storage\6JIT5HTH\Lim et al. - 2024 - Sparse autoencoders reveal selective remapping of visual concepts during adaptation.pdf}
}

@article{liMultilabelFeatureSelection2023,
  title = {Multi-Label Feature Selection via Robust Flexible Sparse Regularization},
  author = {Li, Yonghao and Hu, Liang and Gao, Wanfu},
  year = {2023},
  month = feb,
  journal = {Pattern Recognition},
  volume = {134},
  pages = {109074},
  issn = {00313203},
  doi = {10.1016/j.patcog.2022.109074},
  urldate = {2024-12-09},
  abstract = {Multi-label feature selection is an efficient technique to deal with the high dimensional multi-label data by selecting the optimal feature subset. Existing researches have demonstrated that l1-norm and l2,1norm are promising roles for multi-label feature selection. However, two important issues are ignored when existing l1-norm and l2,1-norm based methods select discriminative features for multi-label data. First, l1-norm can enforce sparsity on each feature across all instances while numerous selected features lack discrimination due to the generated zero weight values. Second, l2,1-norm not only neglects labelspecific features but also ignores the redundancy among features. To this end, we design a Robust Flexible Sparse Regularization norm (RFSR), furthermore, proposing a global optimization framework named Robust Flexible Sparse regularized multi-label Feature Selection (RFSFS) based on RFSR. Finally, an efficient alternating multipliers based optimization scheme is developed to iteratively optimize RFSFS. Empirical studies on fifteen benchmark multi-label data sets demonstrate the effectiveness and efficiency of RFSFS. {\copyright} 2022 Elsevier Ltd. All rights reserved.},
  langid = {english},
  annotation = {abstractTranslation: 多ラベル特徴選択は，高次元の多ラベルデータを扱うための効率的な手法である．既存の研究では、l1-normとl2,1-normがマルチラベル特徴選択に有望であることが示されている。しかし、既存のl1-normとl2,1-normに基づく手法がマルチラベルデータの識別特徴を選択する際に、2つの重要な問題が無視されている。第一に、l1-normは全インスタンスに渡って各特徴のスパース性を強制することができるが、生成されるゼロ重み値のために多数の選択された特徴が識別性を欠く。第二に、l2,1-normはラベル固有の特徴を無視するだけでなく、特徴間の冗長性も無視する。このため、我々はロバスト・フレキシブル・スパース正則化ノルム(RFSR)を設計し、さらにRFSRに基づくロバスト・フレキシブル・スパース正則化マルチラベル特徴選択(RFSFS)という大域的最適化フレームワークを提案する。最後に、RFSFSを繰り返し最適化するために、効率的な交互乗数に基づく最適化スキームを開発する。15のベンチマークマルチラベルデータセットを用いた実証研究により、RFSFSの有効性と効率性が実証された。{\copyright} 2022 Elsevier Ltd.無断複写・転載を禁じます。},
  file = {C:\Users\furuh\Zotero\storage\JTNP2PET\Li et al. - 2023 - Multi-label feature selection via robust flexible sparse regularization.pdf}
}

@inproceedings{linAdversarialTrainingPurification2023,
  title = {Adversarial {{Training}} on {{Purification}} ({{AToP}}): {{Advancing Both Robustness}} and {{Generalization}}},
  shorttitle = {Adversarial {{Training}} on {{Purification}} ({{AToP}})},
  booktitle = {The {{Twelfth International Conference}} on {{Learning Representations}}},
  author = {Lin, Guang and Li, Chao and Zhang, Jianhai and Tanaka, Toshihisa and Zhao, Qibin},
  year = {2023},
  month = oct,
  urldate = {2024-09-30},
  abstract = {The deep neural networks are known to be vulnerable to well-designed adversarial attacks. The most successful defense technique based on adversarial training (AT) can achieve optimal robustness against particular attacks but cannot generalize well to unseen attacks. Another effective defense technique based on adversarial purification (AP) can enhance generalization but cannot achieve optimal robustness. Meanwhile, both methods share one common limitation on the degraded standard accuracy. To mitigate these issues, we propose a novel pipeline to acquire the robust purifier model, named Adversarial Training on Purification (AToP), which comprises two components: perturbation destruction by random transforms (RT) and purifier model fine-tuned (FT) by adversarial loss. RT is essential to avoid overlearning to known attacks, resulting in the robustness generalization to unseen attacks, and FT is essential for the improvement of robustness. To evaluate our method in an efficient and scalable way, we conduct extensive experiments on CIFAR-10, CIFAR-100, and ImageNette to demonstrate that our method achieves optimal robustness and exhibits generalization ability against unseen attacks.},
  langid = {english},
  annotation = {abstractTranslation: ディープニューラルネットワークは、よく設計された敵対的攻撃に対して脆弱であることが知られている。敵対的訓練（AT）に基づく最も成功した防御技術は、特定の攻撃に対して最適なロバスト性を達成できるが、未知の攻撃に対してうまく汎化できない。敵対的純化（AP）に基づく別の効果的な防御手法は、汎化性を高めることはできるが、最適な頑健性を達成することはできない。一方、両手法には、標準精度の低下という共通の限界がある。これらの問題を軽減するために、我々は、ランダム変換による摂動破壊(RT)と、敵対的損失による浄化モデルの微調整(FT)の2つの要素から構成される、AToP(Adversarial Training on Purification)と名付けた、ロバストな浄化モデルを獲得するための新しいパイプラインを提案する。RTは既知の攻撃に対する過学習を回避し、未知の攻撃に対する頑健性の汎化をもたらすために不可欠であり、FTは頑健性の向上に不可欠である。本手法を効率的かつスケーラブルに評価するため、CIFAR-10、CIFAR-100、ImageNetteを用いた広範な実験を行い、本手法が最適なロバスト性を達成し、未知の攻撃に対する汎化能力を示すことを実証する。},
  file = {C:\Users\furuh\Zotero\storage\RFIWZI3U\Lin et al. - 2023 - Adversarial Training on Purification (AToP) Advancing Both Robustness and Generalization.pdf}
}

