@article{horvathMaestroUncoveringLowRank2023,
  title = {Maestro: {{Uncovering Low-Rank Structures}} via {{Trainable Decomposition}}},
  shorttitle = {Maestro},
  author = {Horvath, Samuel and Laskaridis, Stefanos and Rajput, Shashank and Wang, Hongyi},
  year = {2023},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2308.14929},
  urldate = {2024-08-03},
  abstract = {Deep Neural Networks (DNNs) have been a large driver for AI breakthroughs in recent years. However, these models have been getting increasingly large as they become more accurate and safe. This means that their training becomes increasingly costly and time-consuming and typically yields a single model to fit all targets. Various techniques have been proposed in the literature to mitigate this, including pruning, sparsification, or quantization of model weights and updates. While achieving high compression rates, they often incur significant computational overheads at training or lead to non-negligible accuracy penalty. Alternatively, factorization methods have been leveraged for low-rank compression of DNNs. Similarly, such techniques (e.g., SVD) frequently rely on heavy iterative decompositions of layers and are potentially sub-optimal for non-linear models, such as DNNs. We take a further step in designing efficient low-rank models and propose Maestro, a framework for trainable low-rank layers. Instead of iteratively applying a priori decompositions, the low-rank structure is baked into the training process through LoD, a low-rank ordered decomposition. Not only is this the first time importance ordering via sampling is applied on the decomposed DNN structure, but it also allows selecting ranks at a layer granularity. Our theoretical analysis demonstrates that in special cases LoD recovers the SVD decomposition and PCA. Applied to DNNs, Maestro enables the extraction of lower footprint models that preserve performance. Simultaneously, it enables the graceful trade-off between accuracy-latency for deployment to even more constrained devices without retraining.},
  copyright = {arXiv.org perpetual, non-exclusive license},
  keywords = {FOS: Computer and information sciences,Machine Learning (cs.LG)},
  file = {C:\Users\furuh\Zotero\storage\KXT8VDYP\Horvath et al. - 2023 - Maestro Uncovering Low-Rank Structures via Traina.pdf}
}

@article{houDeepNeuralNetwork2023,
  title = {Deep {{Neural Network Denoising Model Based}} on {{Sparse Representation Algorithm}} for {{ECG Signal}}},
  author = {Hou, Yanrong and Liu, Ruixia and Shu, Minglei and Xie, Xiaoyun and Chen, Changfang},
  year = {2023},
  journal = {IEEE Transactions on Instrumentation and Measurement},
  volume = {72},
  pages = {1--11},
  issn = {1557-9662},
  doi = {10.1109/TIM.2023.3251408},
  urldate = {2024-12-04},
  abstract = {Electrocardiogram (ECG) denoising is very important for heart disease diagnosis. The traditional ECG denoising models have problems such as single noise type and poor interpretability of deep neural networks. The innovation of the proposed method is to incorporate the precious achievements of traditional methods into the design of neural networks and to build a bridge between them. Therefore, a novel interpretable deep denoising framework based on sparse representation is proposed in this study, and the half quadratic splitting (HQS) algorithm is applied to decompose the denoising method into sparse representations as an iterative solution process. In addition, a new weight distribution (WD) module is designed to extract adaptive hyperparameters based on ECG correlation instead of empirical values and greatly improves the efficiency of hyperparameter selection. To demonstrate the fairness and effectiveness of the proposed method, four different denoising models with different data preprocessing techniques are used for comparison. The extensive experimental validation and simulation studies demonstrated that the proposed framework has an excellent performance in quantitative and visual evaluation.},
  langid = {american},
  keywords = {Adaptation models,Deep learning,Denoising,electrocardiogram (ECG),Electrocardiography,half quadratic splitting (HQS),neural network,Neural networks,Noise reduction,Signal processing algorithms,sparse representation,Wavelet transforms},
  annotation = {titleTranslation: 心電図信号に対するスパース表現アルゴリズムに基づくディープニューラルネットワークデノイジングモデル\\
abstractTranslation: 心電図（ECG）のノイズ除去は心臓病の診断に非常に重要である。従来のECGノイズ除去モデルには、ノイズの種類が単一であることや、ディープニューラルネットワークの解釈性が低いことなどの問題がある。提案手法の革新性は、従来の手法の貴重な成果をニューラルネットワークの設計に取り入れ、両者の橋渡しをすることである。そのため、本研究では、スパース表現に基づく新しい解釈可能なディープデノイジングフレームワークを提案し、反復解法プロセスとして、ノイズ除去法をスパース表現に分解するために半二次分割（HQS）アルゴリズムを適用する。さらに、新しい重み分布（WD）モジュールを設計し、経験値の代わりにECG相関に基づく適応的ハイパーパラメータを抽出し、ハイパーパラメータ選択の効率を大幅に改善する。提案手法の公平性と有効性を実証するために、異なるデータ前処理技術を用いた4つの異なるノイズ除去モデルを比較に用いた。広範な実験的検証とシミュレーション研究により、提案フレームワークが定量的・視覚的評価において優れた性能を持つことが実証された。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\I6CNMY6M\\Hou et al. - 2023 - Deep Neural Network Denoising Model Based on Sparse Representation Algorithm for ECG Signal.pdf;C\:\\Users\\furuh\\Zotero\\storage\\QSRLC958\\10063205.html}
}

@article{hoyerNonnegativeMatrixFactorization2004,
  title = {Non-Negative {{Matrix Factorization}} with {{Sparseness Constraints}}},
  author = {Hoyer, P.},
  year = {2004},
  month = aug,
  journal = {ArXiv},
  urldate = {2023-10-15},
  abstract = {Non-negative matrix factorization (NMF) is a recently developed technique for finding parts-based, linear representations of non-negative data. Although it has successfully been applied in several applications, it does not always result in parts-based representations. In this paper, we show how explicitly incorporating the notion of 'sparseness' improves the found decompositions. Additionally, we provide complete MATLAB code both for standard NMF and for our extension. Our hope is that this will further the application of these methods to solving novel data-analysis problems.},
  keywords = {No DOI found},
  file = {C:\Users\furuh\Zotero\storage\5JT8B3XR\Hoyer - 2004 - Non-negative Matrix Factorization with Sparseness .pdf}
}

@inproceedings{hsiehLimitsMinmaxOptimization2021,
  title = {The Limits of Min-Max Optimization Algorithms: Convergence to Spurious Non-Critical Sets},
  shorttitle = {The Limits of Min-Max Optimization Algorithms},
  booktitle = {{{ICML}}},
  author = {Hsieh, Ya-Ping and Mertikopoulos, P. and Cevher, V.},
  year = {2021},
  abstract = {This paper characterize the convergence properties of a wide class of zeroth-, first-, and (scalable) second-order methods in non-convex/non-concave problems and shows that these state-of-the-art min-max optimization algorithms may converge with arbitrarily high probability to attractors that are in no way min- max optimal or even stationary. Compared to minimization problems, the min-max landscape in machine learning applications is considerably more convoluted because of the existence of cycles and similar phenomena. Such oscillatory behaviors are well-understood in the convex-concave regime, and many algorithms are known to overcome them. In this paper, we go beyond the convex-concave setting and we characterize the convergence properties of a wide class of zeroth-, first-, and (scalable) second-order methods in non-convex/non-concave problems. In particular, we show that these state-of-the-art min-max optimization algorithms may converge with arbitrarily high probability to attractors that are in no way min-max optimal or even stationary. Spurious convergence phenomena of this type can arise even in two-dimensional problems, a fact which corroborates the empirical evidence surrounding the formidable difficulty of training GANs.},
  keywords = {No DOI found},
  file = {C:\Users\furuh\Zotero\storage\46TP3JEW\Hsieh et al_2021_The limits of min-max optimization algorithms.pdf}
}

@article{hsiehNuclearNormMinimization,
  title = {Nuclear {{Norm Minimization}} via {{Active Subspace Selection}}},
  author = {Hsieh, Cho-Jui and Olsen, Peder A},
  abstract = {We describe a novel approach to optimizing matrix problems involving nuclear norm regularization and apply it to the matrix completion problem. We combine methods from non-smooth and smooth optimization. At each step we use the proximal gradient to select an active subspace. We then find a smooth, convex relaxation of the smaller subspace problems and solve these using second order methods. We apply our methods to matrix completion problems including Netflix dataset, and show that they are more than 6 times faster than stateof-the-art nuclear norm solvers. Also, this is the first paper to scale nuclear norm solvers to the Yahoo-Music dataset, and the first time in the literature that the efficiency of nuclear norm solvers can be compared and even compete with non-convex solvers like Alternating Least Squares (ALS).},
  langid = {english},
  keywords = {No DOI found},
  file = {C:\Users\furuh\Zotero\storage\GJ52MECJ\Hsieh and Olsen - Nuclear Norm Minimization via Active Subspace Sele.pdf}
}

@article{hsuApproximationPowerTwoLayer2021,
  title = {On the {{Approximation Power}} of {{Two-Layer Networks}} of {{Random ReLUs}}},
  author = {Hsu, Daniel and Sanford, Clayton and Servedio, Rocco A. and {Vlatakis-Gkaragkounis}, Emmanouil-Vasileios},
  year = {2021},
  month = feb,
  doi = {10.48550/arXiv.2102.02336},
  urldate = {2022-12-16},
  abstract = {This paper considers the following question: how well can depth-two ReLU networks with randomly initialized bottom-level weights represent smooth functions? We give near-matching upper- and lower-bounds for \$L\_2\$-approximation in terms of the Lipschitz constant, the desired accuracy, and the dimension of the problem, as well as similar results in terms of Sobolev norms. Our positive results employ tools from harmonic analysis and ridgelet representation theory, while our lower-bounds are based on (robust versions of) dimensionality arguments.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\38A72RWQ\Hsu et al_2021_On the Approximation Power of Two-Layer Networks of Random ReLUs.pdf}
}

@article{huangComprehensiveMultiviewRepresentation2024,
  title = {Comprehensive {{Multiview Representation Learning}} via {{Deep Autoencoder-Like Nonnegative Matrix Factorization}}},
  author = {Huang, Haonan and Zhou, Guoxu and Zhao, Qibin and He, Lifang and Xie, Shengli},
  year = {2024},
  month = may,
  journal = {IEEE Transactions on Neural Networks and Learning Systems},
  volume = {35},
  number = {5},
  pages = {5953--5967},
  issn = {2162-2388},
  doi = {10.1109/TNNLS.2023.3304626},
  urldate = {2025-02-12},
  abstract = {Learning a comprehensive representation from multiview data is crucial in many real-world applications. Multiview representation learning (MRL) based on nonnegative matrix factorization (NMF) has been widely adopted by projecting high-dimensional space into a lower order dimensional space with great interpretability. However, most prior NMF-based MRL techniques are shallow models that ignore hierarchical information. Although deep matrix factorization (DMF)-based methods have been proposed recently, most of them only focus on the consistency of multiple views and have cumbersome clustering steps. To address the above issues, in this article, we propose a novel model termed deep autoencoder-like NMF for MRL (DANMF-MRL), which obtains the representation matrix through the deep encoding stage and decodes it back to the original data. In this way, through a DANMF-based framework, we can simultaneously consider the multiview consistency and complementarity, allowing for a more comprehensive representation. We further propose a one-step DANMF-MRL, which learns the latent representation and final clustering labels matrix in a unified framework. In this approach, the two steps can negotiate with each other to fully exploit the latent clustering structure, avoid previous tedious clustering steps, and achieve optimal clustering performance. Furthermore, two efficient iterative optimization algorithms are developed to solve the proposed models both with theoretical convergence analysis. Extensive experiments on five benchmark datasets demonstrate the superiority of our approaches against other state-of-the-art MRL methods.},
  langid = {english},
  keywords = {Automation,Clustering,Convergence,Data models,Decoding,deep matrix factorization (DMF),Feature extraction,multiview learning,nonnegative matrix factorization (NMF),Representation learning,Tensors},
  annotation = {abstractTranslation: マルチビューデータから包括的な表現を学ぶことは、多くの現実世界のアプリケーションで重要です。非陰性マトリックス因数分解（NMF）に基づくMultiView表現学習（MRL）は、高次元空間を優れた解釈可能性を備えた低次の寸法空間に投影することにより広く採用されています。ただし、以前のNMFベースのMRL技術のほとんどは、階層情報を無視する浅いモデルです。ディープマトリックス因数分解（DMF）ベースのメソッドが最近提案されていますが、それらのほとんどは複数のビューの一貫性にのみ焦点を当てており、面倒なクラスタリングステップを持っています。上記の問題に対処するために、この記事では、MRL（DANMF-MRL）のディープオートエンコーダーのようなNMFと呼ばれる新しいモデルを提案します。このようにして、DANMFベースのフレームワークを通じて、マルチビューの一貫性と相補性を同時に考慮して、より包括的な表現を可能にします。さらに、1段階のDANMF-MRLを提案します。これは、統一されたフレームワークで潜在的な表現と最終的なクラスタリングラベルマトリックスを学習します。このアプローチでは、2つのステップが互いに交渉して、潜在的なクラスタリング構造を完全に活用し、以前の退屈なクラスタリングステップを回避し、最適なクラスタリングパフォーマンスを実現できます。さらに、理論的収束分析で提案されたモデルを解決するために、2つの効率的な反復最適化アルゴリズムが開発されています。 5つのベンチマークデータセットでの広範な実験は、他の最先端のMRLメソッドに対するアプローチの優位性を示しています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\WYMVKISC\\Huang et al. - 2024 - Comprehensive Multiview Representation Learning via Deep Autoencoder-Like Nonnegative Matrix Factori.pdf;C\:\\Users\\furuh\\Zotero\\storage\\6AYNDIAA\\10241999.html}
}

@misc{huangEfficientDerivativefreeBayesian2022,
  title = {Efficient {{Derivative-free Bayesian Inference}} for {{Large-Scale Inverse Problems}}},
  author = {Huang, Daniel Zhengyu and Huang, Jiaoyang and Reich, Sebastian and Stuart, Andrew M.},
  year = {2022},
