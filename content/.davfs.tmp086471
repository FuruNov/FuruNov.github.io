@article{ErGongLassoniDuisurusureLiLunniJidukuQingBaoLiangGuiZhun2023,
  title = {Lassoに対するsure理論に基づく情報量規準},
  author = {二宮, 嘉行},
  year = {2023},
  journal = {日本統計学会誌},
  volume = {53},
  number = {1},
  pages = {29--47},
  doi = {10.11329/jjssj.53.29},
  abstract = {説明変数の候補がたくさんあるときの回帰分析手法として，今やスパース推定は標準手法となっている．一方，スパース推定における正則化パラメータの選択については，たとえスパース推定のためのAICがシンプルな形で得られていて，かつ目的が良い予測をしようというものであっても，必ずしもそのAICは用いられておらず，つまり標準手法は定まっていないように見受けられる．本稿では，そういった標準手法が定まっていないケース，正確には正規線形回帰分析でLASSOを用いるケースで，LASSOとAICを組み合わせて推定したモデルの性能評価を数値実験でおこなう．具体的には，LASSOとAICを組み合わせたとき，リッジ正則化法とAICを組み合わせたとき，最尤法と通常のAICを組み合わせてベストサブセット回帰を用いたとき，およびLASSOと交差検証法を組み合わせたときを，予測二乗誤差の評価を通じて比較する．また，その交差検証法で，データの分割の仕方で推定結果がどのくらい違ってくるのかを，予測二乗誤差や選ばれたモデルの自由度のばらつきを数値評価することで確認する．このLASSOのためのAICはSURE理論により導かれるが，それほど知られていないように見受けられるため，最後に僅かに一般化した設定で導出をおこなう．},
  langid = {american},
  keywords = {,AIC},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\E76Q472A\\二宮 - 2023 - Lassoに対するsure理論に基づく情報量規準.pdf;C\:\\Users\\furuh\\Zotero\\storage\\VHFUQXJ5\\ja.html}
}

@article{erichsonSparsePrincipalComponent2020,
  title = {Sparse {{Principal Component Analysis}} via {{Variable Projection}}},
  author = {Erichson, N. Benjamin and Zheng, Peng and Manohar, Krithika and Brunton, Steven L. and Kutz, J. Nathan and Aravkin, Aleksandr Y.},
  year = {2020},
  month = jan,
  journal = {SIAM Journal on Applied Mathematics},
  volume = {80},
  number = {2},
  eprint = {1804.00341},
  primaryclass = {stat},
  pages = {977--1002},
  issn = {0036-1399, 1095-712X},
  doi = {10.1137/18M1211350},
  urldate = {2024-12-31},
  abstract = {Sparse principal component analysis (SPCA) has emerged as a powerful technique for modern data analysis, providing improved interpretation of low-rank structures by identifying localized spatial structures in the data and disambiguating between distinct time scales. We demonstrate a robust and scalable SPCA algorithm by formulating it as a value-function optimization problem. This viewpoint leads to a flexible and computationally efficient algorithm. Further, we can leverage randomized methods from linear algebra to extend the approach to the large-scale (big data) setting. Our proposed innovation also allows for a robust SPCA formulation which obtains meaningful sparse principal components in spite of grossly corrupted input data. The proposed algorithms are demonstrated using both synthetic and real world data, and show exceptional computational efficiency and diagnostic performance.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Machine Learning,Statistics - Machine Learning},
  annotation = {abstractTranslation: スパース主成分分析 (SPCA) は、最新のデータ分析の強力な手法として登場し、データ内の局所的な空間構造を特定し、異なる時間スケール間の曖昧さをなくすことで、低ランク構造の解釈を改善します。値関数最適化問題として定式化することにより、堅牢でスケーラブルな SPCA アルゴリズムを実証します。この観点は、柔軟で計算効率の高いアルゴリズムにつながります。さらに、線形代数のランダム化手法を活用して、アプローチを大規模 (ビッグデータ) 設定に拡張することができます。私たちが提案するイノベーションにより、入力データがひどく破損しているにもかかわらず、意味のある疎な主成分を取得する堅牢な SPCA 定式化も可能になります。提案されたアルゴリズムは、合成データと現実世界のデータの両方を使用して実証され、卓越した計算効率と診断パフォーマンスを示します。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\MBGIG3I9\\Erichson et al. - 2020 - Sparse Principal Component Analysis via Variable Projection.pdf;C\:\\Users\\furuh\\Zotero\\storage\\5KNJHBP4\\1804.html}
}

@inproceedings{esserImprovedRepresentationLearning2023,
  title = {Improved {{Representation Learning Through Tensorized Autoencoders}}},
  booktitle = {Proceedings of {{The}} 26th {{International Conference}} on {{Artificial Intelligence}} and {{Statistics}}},
  author = {Esser, Pascal and Mukherjee, Satyaki and Sabanayagam, Mahalakshmi and Ghoshdastidar, Debarghya},
  year = {2023},
  month = apr,
  pages = {8294--8307},
  publisher = {PMLR},
  issn = {2640-3498},
  urldate = {2023-10-18},
  abstract = {The central question in representation learning is what constitutes a good or meaningful representation. In this work we argue that if we consider data with inherent cluster structures, where clusters can be characterized through different means and covariances, those data structures should be represented in the embedding as well. While Autoencoders (AE) are widely used in practice for unsupervised representation learning, they do not fulfil the above condition on the embedding as they obtain a single representation of the data. To overcome this we propose a meta-algorithm that can be used to extend an arbitrary AE architecture to a tensorized version (TAE) that allows for learning cluster-specific embeddings while simultaneously learning the cluster assignment. For the linear setting we prove that TAE can recover the principle components of the different clusters in contrast to principle component of the entire data recovered by a standard AE. We validate this on planted models and for general, non-linear and convolutional AEs we empirically illustrate that tensorizing the AE is beneficial in clustering and de-noising tasks.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\4LS6V2WI\Esser et al. - 2023 - Improved Representation Learning Through Tensorize.pdf}
}

@inproceedings{everaertGIOGradientInformation2023,
  title = {{{GIO}}: {{Gradient Information Optimization}} for {{Training Dataset Selection}}},
  shorttitle = {{{GIO}}},
  booktitle = {The {{Twelfth International Conference}} on {{Learning Representations}}},
  author = {Everaert, Dante and Potts, Christopher},
  year = {2023},
  month = oct,
  urldate = {2024-06-17},
  abstract = {It is often advantageous to train models on a subset of the available train examples, because the examples are of variable quality or because one would like to train with fewer examples, without sacrificing performance. We present Gradient Information Optimization (GIO), a scalable, task-agnostic approach to this data selection problem that requires only a small set of (unlabeled) examples representing a target distribution. GIO begins from a natural, information-theoretic objective that is intractable in practice. Our contribution is in showing that it can be made highly scalable through a simple relaxation of the objective and a highly efficient implementation. In experiments with machine translation, spelling correction, and image recognition, we show that GIO delivers outstanding results with very small train sets. These findings are robust to different representation models and hyperparameters for GIO itself. GIO is task- and domain-agnostic and can be applied out-of-the-box to new datasets and domains. We open source a pip-installable implementation of the algorithm as "pip install grad-info-opt".},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\8BMTJSEP\Everaert and Potts - 2023 - GIO Gradient Information Optimization for Trainin.pdf}
}

@misc{fabila-carrascoPermutationEntropyGraph2021,
  title = {Permutation {{Entropy}} for {{Graph Signals}}},
  author = {{Fabila-Carrasco}, John Stewart and Tan, Chao and Escudero, Javier},
  year = {2021},
  month = oct,
  number = {arXiv:2110.00628},
  eprint = {2110.00628},
  primaryclass = {cs, math},
  publisher = {arXiv},
  urldate = {2024-06-12},
  abstract = {Entropy metrics (for example, permutation entropy) are nonlinear measures of irregularity in time series (onedimensional data). Some of these entropy metrics can be generalised to data on periodic structures such as a grid or lattice pattern (two-dimensional data) using its symmetry, thus enabling their application to images. However, these metrics have not been developed for signals sampled on irregular domains, defined by a graph. Here, we define for the first time an entropy metric to analyse signals measured over irregular graphs by generalising permutation entropy, a well-established nonlinear metric based on the comparison of neighbouring values within patterns in a time series. Our algorithm is based on comparing signal values on neighbouring nodes, using the adjacency matrix. We show that this generalisation preserves the properties of classical permutation for time series and the recent permutation entropy for images, and it can be applied to any graph structure with synthetic and real signals. We expect the present work to enable the extension of other nonlinear dynamic approaches to graph signals.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Discrete Mathematics,Mathematics - Combinatorics},
  file = {C:\Users\furuh\Zotero\storage\VNLSVEVE\Fabila-Carrasco et al. - 2021 - Permutation Entropy for Graph Signals.pdf}
}

@inproceedings{fagnouAcceleratedTrainingIterative2024,
  title = {Accelerated Training through Iterative Gradient Propagation along the Residual Path},
  booktitle = {The {{Thirteenth International Conference}} on {{Learning Representations}}},
  author = {Fagnou, Erwan and Caillon, Paul and Delattre, Blaise and Allauzen, Alexandre},
  year = {2024},
  month = oct,
  urldate = {2025-04-26},
  abstract = {Despite being the cornerstone of deep learning, backpropagation is criticized for its inherent sequentiality, which can limit the scalability of very deep models. Such models faced convergence issues due to vanishing gradient, later resolved using residual connections. Variants of these are now widely used in modern architectures. However, the computational cost of backpropagation remains a major burden, accounting for most of the training time. Taking advantage of residual-like architectural designs, we introduce Highway backpropagation, a parallelizable iterative algorithm that approximates backpropagation, by alternatively i) accumulating the gradient estimates along the residual path, and ii) backpropagating them through every layer in parallel. This algorithm is naturally derived from a decomposition of the gradient as the sum of gradients flowing through all paths, and is adaptable to a diverse set of common architectures, ranging from ResNets and Transformers to recurrent neural networks. Through an extensive empirical study on a large selection of tasks and models, we evaluate Highway-BP and show that major speedups can be achieved with minimal performance degradation.},
  langid = {english},
  keywords = {Now Reading},
  annotation = {abstractTranslation: ディープラーニングの基礎であるバックプロパゲーションは、その本質的な逐次性から、非常に深いモデルのスケーラビリティを制限する可能性があると批判されています。このようなモデルは、勾配消失の問題に直面しましたが、その後、残差接続を使用して解決されました。これらの変形は、現在、最新のアーキテクチャで広く使用されています。しかし、バックプロパゲーションの計算コストは依然として大きな負担であり、トレーニング時間の大部分を占めています。残差に似たアーキテクチャ設計を利用して、ハイウェイバックプロパゲーションを導入します。これは、バックプロパゲーションを近似する並列化可能な反復アルゴリズムであり、i) 残差パスに沿って勾配推定値を累積し、ii) それらをすべてのレイヤーを通して並列にバックプロパゲートします。このアルゴリズムは、すべてのパスを流れる勾配の合計として勾配を分解することから自然に導き出され、ResNetやTransformerからリカレントニューラルネットワークまで、多様な一般的なアーキテクチャに適応可能です。大規模なタスクとモデルの選択に関する広範な実証研究を通じて、Highway-BPを評価し、パフォーマンスの低下を最小限に抑えながら大幅な高速化が達成できることを示します。},
  file = {C:\Users\furuh\Zotero\storage\DBD7DS8U\Fagnou et al. - 2024 - Accelerated training through iterative gradient propagation along the residual path.pdf}
}

@article{faliniReviewSelectionCriteria2022,
  title = {A Review on the Selection Criteria for the Truncated {{SVD}} in {{Data Science}} Applications},
  author = {Falini, Antonella},
  year = {2022},
  month = dec,
  journal = {Journal of Computational Mathematics and Data Science},
  volume = {5},
  pages = {100064},
  issn = {2772-4158},
  doi = {10.1016/j.jcmds.2022.100064},
  urldate = {2024-07-01},
  abstract = {The Singular Value Decomposition (SVD) is one of the most used factorizations when it comes to Data Science applications. In particular, given the big size of the processed matrices, in most of the cases, a truncated SVD algorithm is employed. In the following manuscript, we review some of the state-of-the-art approaches considered for the selection of the number of components (i.e., singular values) to retain to apply the truncated SVD. Moreover, three new approaches based on the Kullback--Leibler divergence and on unsupervised anomaly detection algorithms, are introduced. The revised methods are then compared on some standard benchmarks in the image processing context.},
  keywords = {Component selection,Image processing,SVD,Truncated SVD},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\QJ3LWIMZ\\Falini - 2022 - A review on the selection criteria for the truncat.pdf;C\:\\Users\\furuh\\Zotero\\storage\\DENEAC2Z\\S2772415822000244.html}
}

@inproceedings{fanFactorGroupSparseRegularization2019,
  title = {Factor {{Group-Sparse Regularization}} for {{Efficient Low-Rank Matrix Recovery}}},
  booktitle = {Neural {{Information Processing Systems}}},
  author = {Fan, Jicong and Ding, Lijun and Chen, Yudong and Udell, Madeleine},
  year = {2019},
  month = nov,
  urldate = {2024-09-29},
  abstract = {This paper develops a new class of nonconvex regularizers for low-rank matrix recovery. Many regularizers are motivated as convex relaxations of the {\textbackslash}emph\{matrix rank\} function. Our new factor group-sparse regularizers are motivated as a relaxation of the {\textbackslash}emph\{number of nonzero columns\} in a factorization of the matrix. These nonconvex regularizers are sharper than the nuclear norm; indeed, we show they are related to Schatten-\$p\$ norms with arbitrarily small \$0 {$<$} p {\textbackslash}leq 1\$. Moreover, these factor group-sparse regularizers can be written in a factored form that enables efficient and effective nonconvex optimization; notably, the method does not use singular value decomposition. We provide generalization error bounds for low-rank matrix completion which show improved upper bounds for Schatten-\$p\$ norm reglarization as \$p\$ decreases. Compared to the max norm and the factored formulation of the nuclear norm, factor group-sparse regularizers are more efficient, accurate, and robust to the initial guess of rank. Experiments show promising performance of factor group-sparse regularization for low-rank matrix completion and robust principal component analysis.},
  langid = {english},
  annotation = {abstractTranslation: 本論文では、低ランク行列回復のための新しいクラスの非凸正則化器を開発する。多くの正則化の動機付けは、｛行列のランク｝関数の凸緩和である。我々の新しい因子群-疎正則化器は、行列の因数分解における{$\Gamma$}emph\{非ゼロ列の数\}の緩和として動機づけられる。これらの非凸正則化は核ノルムよりもシャープであり、実際、任意に小さい\$0＜p{$\leqq$}1\$でSchatten-\$p\$ノルムに関係することを示す。さらに、これらの因子群-疎正則化因子は、効率的かつ効果的な非凸最適化を可能にする因数分解形式で書くことができる。我々は、低ランク行列補完の一般化誤差境界を提供し、\$p\$が減少するにつれてSchatten-\$p\$ノルム再正則化の上界が改善されることを示す。最大ノルムや核ノルムの因数化定式化と比較して、因子群-疎正則化はより効率的で正確であり、ランクの初期推測に対してロバストである。実験により、低ランク行列補完とロバスト主成分分析に対する因子群-疎正則化の有望な性能が示された。},
  file = {C:\Users\furuh\Zotero\storage\FLUUXUF8\Fan et al. - 2019 - Factor Group-Sparse Regularization for Efficient Low-Rank Matrix Recovery.pdf}
}

@misc{fangDepGraphAnyStructural2023,
  title = {{{DepGraph}}: {{Towards Any Structural Pruning}}},
  shorttitle = {{{DepGraph}}},
  author = {Fang, Gongfan and Ma, Xinyin and Song, Mingli and Mi, Michael Bi and Wang, Xinchao},
  year = {2023},
  month = mar,
  number = {arXiv:2301.12900},
  eprint = {2301.12900},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2301.12900},
  urldate = {2024-10-21},
  abstract = {Structural pruning enables model acceleration by removing structurally-grouped parameters from neural networks. However, the parameter-grouping patterns vary widely across different models, making architecture-specific pruners, which rely on manually-designed grouping schemes, non-generalizable to new architectures. In this work, we study a highly-challenging yet barely-explored task, any structural pruning, to tackle general structural pruning of arbitrary architecture like CNNs, RNNs, GNNs and Transformers. The most prominent obstacle towards this goal lies in the structural coupling, which not only forces different layers to be pruned simultaneously, but also expects all removed parameters to be consistently unimportant, thereby avoiding structural issues and significant performance degradation after pruning. To address this problem, we propose a general and \{fully automatic\} method, {\textbackslash}emph\{Dependency Graph\} (DepGraph), to explicitly model the dependency between layers and comprehensively group coupled parameters for pruning. In this work, we extensively evaluate our method on several architectures and tasks, including ResNe(X)t, DenseNet, MobileNet and Vision transformer for images, GAT for graph, DGCNN for 3D point cloud, alongside LSTM for language, and demonstrate that, even with a simple norm-based criterion, the proposed method consistently yields gratifying performances.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computer Vision and Pattern Recognition,Favorite},
  annotation = {abstractTranslation: 構造的刈り込みは、ニューラルネットワークから構造的にグループ化されたパラメータを除去することで、モデルの高速化を可能にする。しかし、パラメータのグループ化パターンはモデルによって大きく異なるため、手作業で設計されたグループ化スキームに依存するアーキテクチャ固有のプルーナは、新しいアーキテクチャに対して汎用性がない。本研究では、CNN、RNN、GNN、Transformerのような任意のアーキテクチャの一般的な構造刈り込みに取り組むために、非常に挑戦的でありながらほとんど研究されていないタスクである構造刈り込みを研究する。この目標に向けた最も顕著な障害は、構造的な結合にあり、異なる層を同時に刈り込まなければならないだけでなく、全ての削除されたパラメータが一貫して重要でないことを期待し、それによって構造的な問題と刈り込み後の大幅な性能劣化を回避する。この問題に対処するために、我々は、レイヤー間の依存関係を明示的にモデル化し、プルーニングのために結合されたパラメータを包括的にグループ化する、一般的で｛完全自動的｝な方法である｛依存グラフ｝（DepGraph）を提案する。本研究では、ResNe(X)t、DenseNet、MobileNet、Vision transformerなどの画像、GATなどのグラフ、DGCNNなどの3次元点群、LSTMなどの言語など、様々なアーキテクチャとタスクで本手法を広範囲に評価し、単純なノルムベースの基準でも、提案手法が一貫して満足のいく性能をもたらすことを実証する。\\
titleTranslation: DepGraph：あらゆる構造的刈り込みに向けて},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\C5M85VCF\\Fang et al. - 2023 - DepGraph Towards Any Structural Pruning.pdf;C\:\\Users\\furuh\\Zotero\\storage\\67WQLLS6\\2301.html}
}

