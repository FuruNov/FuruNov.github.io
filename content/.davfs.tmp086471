@inproceedings{gotteBlockSparseTensorTrain2021b,
  title = {A {{Block-Sparse Tensor Train Format}} for {{Sample-Efficient High-Dimensional Polynomial Regression}}},
  booktitle = {Frontiers in {{Applied Mathematics}} and {{Statistics}}},
  author = {G{\"o}tte, Michael and Schneider, Reinhold and Trunschke, Philipp},
  year = {2021},
  month = sep,
  volume = {7},
  pages = {702486},
  issn = {2297-4687},
  doi = {10.3389/fams.2021.702486},
  urldate = {2024-04-07},
  abstract = {Low-rank tensors are an established framework for the parametrization of multivariate polynomials. We propose to extend this framework by including the concept of block-sparsity to efficiently parametrize homogeneous, multivariate polynomials with low-rank tensors. This provides a representation of general multivariate polynomials as a sum of homogeneous, multivariate polynomials, represented by block-sparse, low-rank tensors. We show that this sum can be concisely represented by a single block-sparse, low-rank tensor.             We further prove cases, where low-rank tensors are particularly well suited by showing that for banded symmetric tensors of homogeneous polynomials the block sizes in the block-sparse multivariate polynomial space can be bounded independent of the number of variables.             We showcase this format by applying it to high-dimensional least squares regression problems where it demonstrates improved computational resource utilization and sample efficiency.},
  file = {C:\Users\furuh\Zotero\storage\KCWCUKFM\Götte et al. - 2021 - A Block-Sparse Tensor Train Format for Sample-Effi.pdf}
}

@article{goujonLearningWeaklyConvex2024,
  title = {Learning {{Weakly Convex Regularizers}} for {{Convergent Image-Reconstruction Algorithms}}},
  author = {Goujon, Alexis and Neumayer, Sebastian and Unser, Michael},
  year = {2024},
  month = mar,
  journal = {SIAM Journal on Imaging Sciences},
  volume = {17},
  number = {1},
  pages = {91--115},
  publisher = {{Society for Industrial and Applied Mathematics}},
  doi = {10.1137/23M1565243},
  urldate = {2025-02-04},
  abstract = {.We present a gradient-based heuristic method for supervised learning of sparsity-promoting regularizers for denoising signals and images. Sparsity-promoting regularization is a key ingredient in solving modern signal reconstruction problems; however, the operators underlying these regularizers are usually either designed by hand or learned from data in an unsupervised way. The recent success of supervised learning (e.g., with convolutional neural networks) in solving image reconstruction problems suggests that it could be a fruitful approach to designing regularizers. Towards this end, we propose to denoise signals using a variational formulation with a parametric, sparsity-promoting regularizer, where the parameters of the regularizer are learned to minimize the mean squared error of reconstructions on a training set of ground truth image and measurement pairs. Training involves solving a challenging bilevel optimization problem; we derive an expression for the gradient of the training loss using the closed-form solution of the denoising problem and provide an accompanying gradient descent algorithm to minimize it. Our experiments with structured 1D signals and natural images indicate that the proposed method can learn an operator that outperforms well-known regularizers (total variation, DCT-sparsity, and unsupervised dictionary learning) and collaborative filtering for denoising.},
  langid = {english},
  annotation = {abstractTranslation: 。シグナルと画像を除去するためのスパース促進正統派の監視された学習のためのグラデーションベースのヒューリスティック方法を提示します。スパース促進の正則化は、最新の信号再構成の問題を解決する上で重要な要素です。ただし、これらの正規化剤の根底にあるオペレーターは、通常、手で設計されているか、監視されていない方法でデータから学習されます。画像の再構築の問題を解決する際の監視された学習（畳み込みニューラルネットワークなど）の最近の成功は、それが正規者を設計するための実りあるアプローチである可能性があることを示唆しています。この目的に向けて、パラメトリックでスパース促進する正規者を使用した変分配合を使用してシグナルを除去することを提案します。そこでは、正規者のパラメーターが、グラウンドトゥルースイメージと測定ペアのトレーニングセットでの再構成の平均二乗エラーを最小限に抑えるために学習されます。トレーニングには、挑戦的なバイレベル最適化問題を解決することが含まれます。除去問題の閉形式ソリューションを使用して、トレーニング損失の勾配の式を導き出し、それを最小化するために付随する勾配降下アルゴリズムを提供します。構造化された1Dシグナルと自然画像を使用した実験は、提案された方法が、よく知られている正統派（総変動、DCT-sparsity、および監視されていない辞書学習）よりも優れているオペレーターを学習できることを示しています。},
  file = {C:\Users\furuh\Zotero\storage\BVFNB52G\Goujon et al. - 2024 - Learning Weakly Convex Regularizers for Convergent Image-Reconstruction Algorithms.pdf}
}

@article{goulartAlternatingGroupLasso2020,
  title = {Alternating {{Group Lasso}} for {{Block-Term Tensor Decomposition}} and {{Application}} to {{ECG Source Separation}}},
  author = {Goulart, Jose Henrique De Morais and De Oliveira, Pedro Marinho Ramos and Farias, Rodrigo Cabral and Zarzoso, Vicente and Comon, Pierre},
  year = {2020},
  journal = {IEEE Transactions on Signal Processing},
  volume = {68},
  pages = {2682--2696},
  issn = {1053-587X, 1941-0476},
  doi = {10.1109/TSP.2020.2985591},
  urldate = {2024-02-23},
  abstract = {In some applications, blind source separation can be performed by computing an approximate block-term tensor decomposition (BTD), under much milder constraints than matrix-based techniques. However, choosing the BTD model structure (i.e., the number of blocks and their ranks) is a difficult problem, and the standard least-squares formulation can be ill-posed. This paper proposes an alternating group lasso algorithm to compute approximate low-rank BTDs. It solves, in a provably convergent manner, a well-posed mixed-norm regularized tensor approximation problem that allows estimating the model parameters and its structure jointly. A variant is also put forward for dealing with linearly constrained blocks, motivated by the problem of blind separation of sums of complex exponentials, which can be cast as a low-rank Hankel-structured block-term tensor approximation problem. An experimental comparison with a standard nonlinear least-squares algorithm on synthetic tensor data indicates that the proposed algorithm is much more robust with respect to initialization. We also apply the constrained variant to the extraction of atrial activity from semi-synthetic and real-world electrocardiogram recordings during atrial fibrillation episodes. Our results show its ability to consistently select an adequate structure and to extract multiple signals which can be physiologically interpreted as atrial fibrillation patterns.},
  langid = {american},
  annotation = {abstractTranslation: アプリケーションによっては、ブロック項テンソル分解(BTD)を近似的に計算することで、行列ベースの手法よりもはるかに穏やかな制約の下でブラインド音源分離を行うことができる。しかし、BTDモデル構造（すなわち、ブロック数とそのランク）の選択は困難な問題であり、標準的な最小二乗法は非論理的である。本稿では、近似的な低ランクBTDを計算するための交互群ラッソアルゴリズムを提案する。これは、モデルパラメータとその構造を共同で推定することができる、よく解かれた混合ノルム正則化テンソル近似問題を、証明可能な収束方法で解くものである。また、線形制約のあるブロックを扱うための変形も提案され、これは複素指数和のブラインド分離問題に動機づけられ、低ランクのハンケル構造ブロック項テンソル近似問題としてキャストすることができる。合成テンソルデータを用いた標準的な非線形最小二乗法アルゴリズムとの実験的比較により、提案アルゴリズムは初期化に関してより頑健であることが示される。また、心房細動エピソード中の半合成心電図記録と実世界の心電図記録から心房活動を抽出するために、制約付き変法を適用する。その結果、適切な構造を一貫して選択し、心房細動パターンとして生理学的に解釈できる複数の信号を抽出する能力が示された。},
  file = {C:\Users\furuh\Zotero\storage\J9RPNVF3\Goulart et al. - 2020 - Alternating Group Lasso for Block-Term Tensor Deco.pdf}
}

