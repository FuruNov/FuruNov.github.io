@article{leStructuredSupportExploration2021,
  title = {Structured {{Support Exploration}} for {{Multilayer Sparse Matrix Factorization}}},
  author = {Le, Quoc-Tung and Gribonval, Remi},
  year = {2021},
  month = jun,
  journal = {ICASSP 2021 - 2021 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
  pages = {3245--3249},
  publisher = {IEEE},
  address = {Toronto, ON, Canada},
  doi = {10.1109/ICASSP39728.2021.9414238},
  urldate = {2023-10-09},
  abstract = {Matrix factorization with sparsity constraints plays an important role in many machine learning and signal processing problems such as dictionary learning, data visualization, dimension reduction. Among the most popular tools for sparse matrix factorization are proximal algorithms, a family of algorithms based on proximal operators. In this paper, we address two problems with the application of proximal algorithms to sparse matrix factorization. On the one hand, we analyze a weakness of proximal algorithms in sparse matrix factorization: the premature convergence of the support. A remedy is also proposed to address this problem. On the other hand, we describe a new tractable proximal operator called Generalized Hungarian Method, associated to so-called k-regular matrices, which are useful for the factorization of a class of matrices associated to fast linear transforms. We further illustrate the effectiveness of our proposals by numerical experiments on the Hadamard Transform and magnetoencephalography matrix factorization.},
  isbn = {9781728176055},
  file = {C:\Users\furuh\Zotero\storage\YIB929QU\Le and Gribonval - 2021 - Structured Support Exploration for Multilayer Spar.pdf}
}

@article{leusGraphSignalProcessing2023,
  title = {Graph {{Signal Processing}}: {{History}}, Development, Impact, and Outlook},
  shorttitle = {Graph {{Signal Processing}}},
  author = {Leus, Geert and Marques, Antonio G. and Moura, Jos{\'e} M.F. and Ortega, Antonio and Shuman, David I},
  year = {2023},
  month = jun,
  journal = {IEEE Signal Processing Magazine},
  volume = {40},
  number = {4},
  pages = {49--60},
  issn = {1558-0792},
  doi = {10.1109/MSP.2023.3262906},
  urldate = {2024-06-27},
  abstract = {Signal processing (SP) excels at analyzing, processing, and inferring information defined over regular (first continuous, later discrete) domains such as time or space. Indeed, the last 75 years have shown how SP has made an impact in areas such as communications, acoustics, sensing, image processing, and control, to name a few. With the digitalization of the modern world and the increasing pervasiveness of data-collection mechanisms, information of interest in current applications oftentimes arises in non-Euclidean, irregular domains. Graph SP (GSP) generalizes SP tasks to signals living on non-Euclidean domains whose structure can be captured by a weighted graph. Graphs are versatile, able to model irregular interactions, easy to interpret, and endowed with a corpus of mathematical results, rendering them natural candidates to serve as the basis for a theory of processing signals in more irregular domains.},
  keywords = {Acoustics,Aerospace electronics,Image processing,Mathematical models,Rendering (computer graphics),Sensors,Signal processing},
  file = {C:\Users\furuh\Zotero\storage\DDGRCJ2J\Leus et al. - 2023 - Graph Signal Processing History, development, imp.pdf}
}

@article{levinEffectSmoothParametrizations2024,
  title = {The Effect of Smooth Parametrizations on Nonconvex Optimization Landscapes},
  author = {Levin, Eitan and Kileel, Joe and Boumal, Nicolas},
  year = {2024},
  month = mar,
  journal = {Mathematical Programming},
  eprint = {2207.03512},
  primaryclass = {cs, math},
  issn = {0025-5610, 1436-4646},
  doi = {10.1007/s10107-024-02058-3},
  urldate = {2024-09-22},
  abstract = {We develop new tools to study landscapes in nonconvex optimization. Given one optimization problem, we pair it with another by smoothly parametrizing the domain. This is either for practical purposes (e.g., to use smooth optimization algorithms with good guarantees) or for theoretical purposes (e.g., to reveal that the landscape satisfies a strict saddle property). In both cases, the central question is: how do the landscapes of the two problems relate? More precisely: how do desirable points such as local minima and critical points in one problem relate to those in the other problem? A key finding in this paper is that these relations are often determined by the parametrization itself, and are almost entirely independent of the cost function. Accordingly, we introduce a general framework to study parametrizations by their effect on landscapes. The framework enables us to obtain new guarantees for an array of problems, some of which were previously treated on a case-by-case basis in the literature. Applications include: optimizing low-rank matrices and tensors through factorizations; solving semidefinite programs via the Burer-Monteiro approach; training neural networks by optimizing their weights and biases; and quotienting out symmetries.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Mathematics - Numerical Analysis,Mathematics - Optimization and Control},
  annotation = {abstractTranslation: 我々は、非凸最適化におけるランドスケープの研究のための新しいツールを開発する。ある最適化問題が与えられたとき、その領域を滑らかにパラメトリック化することによって、別の最適化問題と対にする。これは、実用的な目的（例えば、良い保証のある滑らかな最適化アルゴリズムを使用するため）か、理論的な目的（例えば、ランドスケープが厳密な鞍の性質を満たすことを明らかにするため）のどちらかである。いずれの場合も、中心的な問題は、2つの問題のランドスケープがどのように関連しているかということである。より正確には、一方の問題における局所極小点や臨界点などの望ましい点は、他方の問題におけるそれらとどのように関連しているのか、ということである。本論文の重要な発見は、これらの関係はパラメトリゼーション自体によって決定されることが多く、コスト関数にはほとんど依存しないということである。従って、我々はパラメトリゼーションがランドスケープに与える影響を研究するための一般的な枠組みを導入する。このフレームワークにより、従来はケースバイケースで扱われていた様々な問題に対して新たな保証を得ることができる。応用例としては、因数分解による低ランク行列やテンソルの最適化、Burer-Monteiroアプローチによる半正定値プログラムの解法、重みとバイアスの最適化によるニューラルネットワークの訓練、対称性の商の取り出しなどがある。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\2PT9FHRE\\Levin et al. - 2024 - The effect of smooth parametrizations on nonconvex optimization landscapes.pdf;C\:\\Users\\furuh\\Zotero\\storage\\B6ZKYQ4D\\2207.html}
}

@article{levinFindingStationaryPoints2023,
  title = {Finding Stationary Points on Bounded-Rank Matrices: A Geometric Hurdle and a Smooth Remedy},
  shorttitle = {Finding Stationary Points on Bounded-Rank Matrices},
  author = {Levin, Eitan and Kileel, Joe and Boumal, Nicolas},
  year = {2023},
  month = may,
  journal = {Mathematical Programming},
  volume = {199},
  number = {1},
  pages = {831--864},
  issn = {1436-4646},
  doi = {10.1007/s10107-022-01851-2},
  urldate = {2025-04-17},
  abstract = {We consider the problem of provably finding a stationary point of a smooth function to be minimized on the variety of bounded-rank matrices. This turns out to be unexpectedly delicate. We trace the difficulty back to a geometric obstacle: On a nonsmooth set, there may be sequences of points along which standard measures of stationarity tend to zero, but whose limit points are not stationary. We name such events apocalypses, as they can cause optimization algorithms to converge to non-stationary points. We illustrate this explicitly for an existing optimization algorithm on bounded-rank matrices. To provably find stationary points, we modify a trust-region method on a standard smooth parameterization of the variety. The method relies on the known fact that second-order stationary points on the parameter space map to stationary points on the variety. Our geometric observations and proposed algorithm generalize beyond bounded-rank matrices. We give a geometric characterization of apocalypses on general constraint sets, which implies that Clarke-regular sets do not admit apocalypses. Such sets include smooth manifolds, manifolds with boundaries, and convex sets. Our trust-region method supports parameterization by any complete Riemannian manifold.},
  langid = {english},
  keywords = {49J53,65K10,90C26,90C46,Clarke regularity,Low-rank matrices,Nonsmooth sets,Riemannian optimization,Singular algebraic varieties,Stationarity,Tangent cones,Variational analysis},
  file = {C:\Users\furuh\Zotero\storage\LCHYQGTM\Levin et al. - 2023 - Finding stationary points on bounded-rank matrices a geometric hurdle and a smooth remedy.pdf}
}

