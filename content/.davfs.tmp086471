@article{hammondSpectralGraphWavelet2019,
  title = {The {{Spectral Graph Wavelet Transform}}: {{Fundamental Theory}} and {{Fast Computation}}},
  shorttitle = {The {{Spectral Graph Wavelet Transform}}},
  author = {Hammond, David K. and Vandergheynst, Pierre and Gribonval, R{\'e}mi},
  editor = {Stankovi{\'c}, Ljubi{\v s}a and Sejdi{\'c}, Ervin},
  year = {2019},
  journal = {Vertex-Frequency Analysis of Graph Signals},
  pages = {141--175},
  publisher = {Springer International Publishing},
  address = {Cham},
  doi = {10.1007/978-3-030-03574-7_3},
  urldate = {2024-06-19},
  abstract = {The spectral graph wavelet transform (SGWT) defines wavelet transforms appropriate for data defined on the vertices of a weighted graph. Weighted graphs provide an extremely flexible way to model the data domain for a large number of important applications (such as data defined on vertices of social networks, transportation networks, brain connectivity networks, point clouds, or irregularly sampled grids). The SGWT is based on the spectral decomposition of the {\textbackslash}(N{\textbackslash}times N{\textbackslash}) graph Laplacian matrix {\textbackslash}({\textbackslash}mathscr \{L\}{\textbackslash}), where N is the number of vertices of the weighted graph. Its construction is specified by designing a real-valued function g which acts as a bandpass filter on the spectrum of {\textbackslash}({\textbackslash}mathscr \{L\}{\textbackslash}), and is analogous to the Fourier transform of the ``mother wavelet'' for the continuous wavelet transform. The wavelet operators at scale s are then specified by {\textbackslash}(T\_g{\textasciicircum}s = g(s{\textbackslash}mathscr \{L\}){\textbackslash}), and provide a mapping from the input data {\textbackslash}(f{\textbackslash}in {\textbackslash}mathbb \{R\}{\textasciicircum}N{\textbackslash}) to the wavelet coefficients at scale s. The individual wavelets {\textbackslash}({\textbackslash}psi \_\{s,n\}{\textbackslash}) centered at vertex n, for scale s, are recovered by localizing these operators by applying them to a delta impulse, i.e. {\textbackslash}({\textbackslash}psi \_\{s,n\} = T\_g{\textasciicircum}s {\textbackslash}delta \_n{\textbackslash}). The wavelet scales may be discretized to give a graph wavelet transform producing a finite number of coefficients. In this work we also describe a fast algorithm, based on Chebyshev polynomial approximation, which allows computation of the SGWT without needing to compute the full set of eigenvalues and eigenvectors of {\textbackslash}({\textbackslash}mathscr \{L\}{\textbackslash}).},
  isbn = {9783030035730 9783030035747},
  annotation = {abstractTranslation:  スペクトルグラフウェーブレット変換（SGWT）は、加重グラフの頂点上に定義されたデータに適したウェーブレット変換を定義する。加重グラフは、多くの重要なアプリケーション（ソーシャルネットワーク、交通ネットワーク、脳結合ネットワーク、点群、または不規則にサンプリングされたグリッドの頂点上で定義されたデータなど）のデータ領域をモデル化する非常に柔軟な方法を提供します。SGWTは、グラフラプラシアン行列のスペクトル分解に基づく。その構成は、実数値関数gを設計することによって規定され、これは、連続ウェーブレット変換の「マザーウェーブレット」のフーリエ変換に類似している。そして、スケールsのウェーブレット演算子は、(T\_g{\textasciicircum}s = g(smathscr \{L\})㎟)で指定され、入力データ(㎟in ㎟mathbb \{R\}{\textasciicircum}N㎟)からスケールsのウェーブレット係数へのマッピングを提供する。頂点nを中心とする個々のウェーブレットは、スケールsに対して、これらの演算子をデルタインパルスに適用することによって局在化させることによって、すなわち(A)((A)psi \_\{s,n\} = T\_g{\textasciicircum}s(A)delta \_n\vphantom\{\}) によって回復される。ウェーブレットのスケールを離散化して、有限個の係数を生成するグラフ・ウェーブレット変換を与えることができる。この研究では、Chebyshev多項式近似に基づく高速アルゴリズムも記述しており、これによってSGWTの固有値と固有ベクトルの完全なセットを計算する必要がない。},
  file = {C:\Users\furuh\Zotero\storage\HEM47ESH\Hammond et al. - 2019 - The Spectral Graph Wavelet Transform Fundamental .pdf}
}

@article{hammondWaveletsGraphsSpectral2011,
  title = {Wavelets on Graphs via Spectral Graph Theory},
  author = {Hammond, David K. and Vandergheynst, Pierre and Gribonval, R{\'e}mi},
  year = {2011},
  month = mar,
  journal = {Applied and Computational Harmonic Analysis},
  volume = {30},
  number = {2},
  pages = {129--150},
  issn = {10635203},
  doi = {10.1016/j.acha.2010.04.005},
  urldate = {2023-04-17},
  abstract = {We propose a novel method for constructing wavelet transforms of functions defined on the vertices of an arbitrary finite weighted graph. Our approach is based on defining scaling using the graph analogue of the Fourier domain, namely the spectral decomposition of the discrete graph Laplacian L. Given a wavelet generating kernel g and a scale parameter t, we define the scaled wavelet operator Tgt = g(tL). The spectral graph wavelets are then formed by localizing this operator by applying it to an indicator function. Subject to an admissibility condition on g, this procedure defines an invertible transform. We explore the localization properties of the wavelets in the limit of fine scales. Additionally, we present a fast Chebyshev polynomial approximation algorithm for computing the transform that avoids the need for diagonalizing L. We highlight potential applications of the transform through examples of wavelets on graphs corresponding to a variety of different problem domains.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\6PWT9YU8\Hammond et al. - 2011 - Wavelets on graphs via spectral graph theory.pdf}
}

