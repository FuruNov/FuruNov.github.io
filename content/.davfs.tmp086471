@misc{idaFastRegularizedDiscrete2023,
  title = {Fast {{Regularized Discrete Optimal Transport}} with {{Group-Sparse Regularizers}}},
  author = {Ida, Yasutoshi and Kanai, Sekitoshi and Adachi, Kazuki and Kumagai, Atsutoshi and Fujiwara, Yasuhiro},
  year = {2023},
  month = mar,
  number = {arXiv:2303.07597},
  eprint = {2303.07597},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2303.07597},
  urldate = {2025-04-12},
  abstract = {Regularized discrete optimal transport (OT) is a powerful tool to measure the distance between two discrete distributions that have been constructed from data samples on two different domains. While it has a wide range of applications in machine learning, in some cases the sampled data from only one of the domains will have class labels such as unsupervised domain adaptation. In this kind of problem setting, a group-sparse regularizer is frequently leveraged as a regularization term to handle class labels. In particular, it can preserve the label structure on the data samples by corresponding the data samples with the same class label to one group-sparse regularization term. As a result, we can measure the distance while utilizing label information by solving the regularized optimization problem with gradient-based algorithms. However, the gradient computation is expensive when the number of classes or data samples is large because the number of regularization terms and their respective sizes also turn out to be large. This paper proposes fast discrete OT with group-sparse regularizers. Our method is based on two ideas. The first is to safely skip the computations of the gradients that must be zero. The second is to efficiently extract the gradients that are expected to be nonzero. Our method is guaranteed to return the same value of the objective function as that of the original method. Experiments show that our method is up to 8.6 times faster than the original method without degrading accuracy.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Machine Learning,Statistics - Machine Learning},
  annotation = {abstractTranslation: 正則化離散最適輸送(OT)は、異なる2つのドメイン上のデータサンプルから構成された2つの離散分布間の距離を測定するための強力なツールです。機械学習において幅広い応用範囲を持つ一方、一部のケースでは、教師なしドメイン適応など、一方のドメインからのサンプルデータのみがクラスラベルを持つ場合があります。このような問題設定では、クラスラベルを扱うための正則化項として、グループスパース正則化が頻繁に利用されます。特に、同じクラスラベルを持つデータサンプルを1つのグループスパース正則化項に対応付けることで、データサンプル上のラベル構造を保持することができます。その結果、勾配ベースのアルゴリズムによる正則化最適化問題を解くことで、ラベル情報を利用した距離測定が可能になります。しかし、クラス数やデータサンプル数が大きい場合、正則化項の数とそのサイズも大きくなるため、勾配計算は高価になります。本論文は、グループスパース正則化を用いた高速な離散OTを提案します。私たちの方法は2つのアイデアに基づいています。1つ目は、必ずゼロになる勾配の計算を安全にスキップすることです。2つ目は、ゼロではないと予想される勾配を効率的に抽出することです。私たちの方法は、元の方法と同じ目的関数の値を返すことが保証されています。実験により、私たちの方法は精度を低下させることなく、元の方法よりも最大8.6倍高速であることが示されました。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\M5BDREYL\\Ida et al. - 2023 - Fast Regularized Discrete Optimal Transport with Group-Sparse Regularizers.pdf;C\:\\Users\\furuh\\Zotero\\storage\\I2IKIFAK\\2303.html}
}

@inproceedings{idaFastRegularizedDiscrete2023a,
  title = {Fast Regularized Discrete Optimal Transport with Group-Sparse Regularizers},
  booktitle = {Proceedings of the {{Thirty-Seventh AAAI Conference}} on {{Artificial Intelligence}} and {{Thirty-Fifth Conference}} on {{Innovative Applications}} of {{Artificial Intelligence}} and {{Thirteenth Symposium}} on {{Educational Advances}} in {{Artificial Intelligence}}},
  author = {Ida, Yasutoshi and Kanai, Sekitoshi and Adachi, Kazuki and Kumagai, Atsutoshi and Fujiwara, Yasuhiro},
  year = {2023},
  month = feb,
  series = {{{AAAI}}'23/{{IAAI}}'23/{{EAAI}}'23},
  volume = {37},
  pages = {7980--7987},
  publisher = {AAAI Press},
  doi = {10.1609/aaai.v37i7.25965},
  urldate = {2025-04-12},
  abstract = {Regularized discrete optimal transport (OT) is a powerful tool to measure the distance between two discrete distributions that have been constructed from data samples on two different domains. While it has a wide range of applications in machine learning, in some cases the sampled data from only one of the domains will have class labels such as unsupervised domain adaptation. In this kind of problem setting, a group-sparse regularizer is frequently leveraged as a regularization term to handle class labels. In particular, it can preserve the label structure on the data samples by corresponding the data samples with the same class label to one group-sparse regularization term. As a result, we can measure the distance while utilizing label information by solving the regularized optimization problem with gradient-based algorithms. However, the gradient computation is expensive when the number of classes or data samples is large because the number of regularization terms and their respective sizes also turn out to be large. This paper proposes fast discrete OT with group-sparse regularizers. Our method is based on two ideas. The first is to safely skip the computations of the gradients that must be zero. The second is to efficiently extract the gradients that are expected to be nonzero. Our method is guaranteed to return the same value of the objective function as that of the original method. Experiments show that our method is up to 8.6 times faster than the original method without degrading accuracy.},
  isbn = {978-1-57735-880-0},
  file = {C:\Users\furuh\Zotero\storage\I5RGEN47\Ida et al. - 2023 - Fast regularized discrete optimal transport with group-sparse regularizers.pdf}
