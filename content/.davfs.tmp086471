@inproceedings{heFullyConnectedTensor2025,
  title = {Fully {{Connected Tensor Network}} Based {{Brain Structural Feature Extraction}} for {{Early Alzheimer}}'s {{Disease Detection}}},
  booktitle = {{{ICASSP}} 2025 - 2025 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {He, Fei and Li, Xinyue and Zhu, Ce and Zhang, Fan and Liu, Yipeng},
  year = {2025},
  month = apr,
  pages = {1--5},
  issn = {2379-190X},
  doi = {10.1109/ICASSP49660.2025.10888844},
  urldate = {2025-03-14},
  abstract = {Alzheimer's disease (AD) is an incurable neurodegenerative disease that involves structural changes in the brain. Early diagnosis of AD helps provide timely treatment and delay its progressive process. Many studies have been conducted based on brain images to detect AD. However, these works are mostly designed based on multi-modal brain data. The existing methods on uni-modal data, e.g., diffusion magnetic resonance imaging (dMRI) data, are not very effective or inexplainable. In this work, we propose the first tensor-based method for detecting early-stage AD. First, the brain data are segmented into blocks and concatenated as high-order tensors. The structural information in each block is preserved. Second, the fully connected tensor network (FCTN) is adopted. FCTN has strong expression capability for high-order data. This is the first work that exploits the advantage of FCTN for structural feature extraction. In the classification experiments, our method surpasses the existing methods 5\% to 15\% in accuracy.},
  langid = {english},
  keywords = {Accuracy,Alzheimer's disease,Alzheimer's Disease,Delays,diffusion magnetic resonance imaging,Feature extraction,fully connected tensor network,Image segmentation,Magnetic resonance,Magnetic resonance imaging,Now Reading,Signal processing,Speech processing,structural feature extraction,Tensors},
  annotation = {abstractTranslation: アルツハイマー病（AD）は、脳の構造的変化を伴う不治の神経変性疾患です。 ADの早期診断は、タイムリーな治療を提供し、その進行性プロセスを遅らせるのに役立ちます。 ADを検出するために、脳画像に基づいて多くの研究が行われています。ただし、これらの作品は、主にマルチモーダルの脳データに基づいて設計されています。 Uni-Modalデータの既存の方法、例えば、拡散磁気共鳴画像（DMRI）データは、あまり効果的でも不可能でもありません。この作業では、初期段階の広告を検出するための最初のテンソルベースの方法を提案します。まず、脳のデータはブロックにセグメント化され、高次のテンソルとして連結されます。各ブロックの構造情報は保持されます。第二に、完全に接続されたテンソルネットワーク（FCTN）が採用されています。 FCTNには、高次のデータに対して強い表現能力があります。これは、構造的特徴抽出のためにFCTNの利点を活用する最初の作業です。分類実験では、我々の方法では、既存の方法を5％から15％の精度を上回ります。},
  file = {C:\Users\furuh\Zotero\storage\JBRHBG8J\He et al. - 2025 - Fully Connected Tensor Network based Brain Structural Feature Extraction for Early Alzheimer’s Disea.pdf}
}

