@misc{heinTotalVariationHypergraphs2013,
  title = {The {{Total Variation}} on {{Hypergraphs}} - {{Learning}} on {{Hypergraphs Revisited}}},
  author = {Hein, Matthias and Setzer, Simon and Jost, Leonardo and Rangapuram, Syama Sundar},
  year = {2013},
