  title = {A Dual Algorithm for the Solution of Nonlinear Variational Problems via Finite Element Approximation},
  author = {Gabay, Daniel and Mercier, Bertrand},
  year = {1976},
  month = jan,
  journal = {Computers \& Mathematics with Applications},
  volume = {2},
  number = {1},
  pages = {17--40},
  issn = {0898-1221},
  doi = {10.1016/0898-1221(76)90003-1},
  urldate = {2025-02-24},
  abstract = {For variational problems of the form Infv{$\in$}V\{f(Av)+g(v)\}, we propose a dual method which decouples the difficulties relative to the functionals f and g from the possible ill-conditioning effects of the linear operator A. The approach is based on the use of an Augmented Lagrangian functional and leads to an efficient and simply implementable algorithm. We study also the finite element approximation of such problems, compatible with the use of our algorithm. The method is finally applied to solve several problems of continuum mechanics.},
