@article{kurodaBlockSparseRecoveryOptimal2022,
  title = {Block-{{Sparse Recovery}} with {{Optimal Block Partition}}},
  author = {Kuroda, Hiroki and Kitahara, Daichi},
  year = {2022},
  month = mar,
  journal = {IEEE Transactions on Signal Processing},
  publisher = {TechRxiv},
  doi = {10.36227/techrxiv.14538552.v3},
  urldate = {2022-06-08},
  abstract = {This paper presents a convex recovery method for block-sparse signals whose block partitions are unknown a priori. We first introduce a nonconvex penalty function, where the block partition is adapted for the signal of interest by minimizing the mixed l2/l1 norm over all possible block partitions. Then, by exploiting a variational representation of the l2 norm, we derive the proposed penalty function as a suitable convex relaxation of the nonconvex one. For a block-sparse recovery model designed with the proposed penalty, we develop an iterative algorithm which is guaranteed to converge to a globally optimal solution. Numerical experiments demonstrate the effectiveness of the proposed method.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\LFSHWBGQ\Kuroda_Kitahara_2022_Block-Sparse Recovery with Optimal Block Partition.pdf}
}

@inproceedings{kurodaConvexPenaltyBlockSparse2021,
  title = {A {{Convex Penalty}} for {{Block-Sparse Signals}} with {{Unknown Structures}}},
  booktitle = {{{ICASSP}} 2021 - 2021 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {Kuroda, Hiroki and Kitahara, Daichi and Hirabayashi, Akira},
  year = {2021},
  month = jun,
  pages = {5430--5434},
  issn = {2379-190X},
  doi = {10.1109/icassp39728.2021.9414340},
  abstract = {We propose a novel convex penalty for block-sparse signals whose block partitions are unknown a priori. We first introduce a nonconvex penalty function, where the block partition is adjusted for the signal of interest by minimizing the mixed {$\ell$}2/{$\ell$}1 norm over all possible block partitions. Then, by exploiting a variational representation of the {$\ell$}2 norm, we derive the proposed penalty function as a suitable convex relaxation of the nonconvex penalty. For the resulting regularization model, we provide a proximal splitting-based algorithm which is guaranteed to converge to an optimal solution. Numerical experiments show the effectiveness of the proposed penalty.},
  keywords = {Acoustics,Block-sparsity,Conferences,convex regularization,Minimization,Numerical models,Partitioning algorithms,proximal splitting algorithm,Signal processing,Signal processing algorithms,unknown partition},
  file = {C:\Users\furuh\Zotero\storage\9CRRKXQL\Kuroda et al_2021_A Convex Penalty for Block-Sparse Signals with Unknown Structures.pdf}
}

@inproceedings{kurodaGraphStructuredSparseRegularization2022,
  title = {Graph-{{Structured Sparse Regularization Via Convex Optimization}}},
  booktitle = {Proceedings of {{International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}}},
  author = {Kuroda, Hiroki and Kitahara, Daichi},
  year = {2022},
  month = may,
  pages = {5538--5542},
  publisher = {IEEE},
  address = {Singapore, Singapore},
  doi = {10.1109/ICASSP43922.2022.9747190},
  urldate = {2024-05-10},
  abstract = {In this paper, we present a novel convex method for the graphstructured sparse recovery. While various structured sparsities can be represented as the graph-structured sparsity, graphstructured sparse recovery remains to be a challenging nonconvex problem. To solve this difficulty, we propose a convex penalty function which automatically identifies the relevant subgraph of an underlying graph. We design a graphstructured recovery model using the proposed penalty, and develop its first-order iterative solver which consists only of simple operations such as closed-form proximity operators and difference operator on the graph. Numerical experiments show that the proposed method has better estimation accuracy than the existing convex regularizations using fixed structures.},
  copyright = {https://doi.org/10.15223/policy-029},
  isbn = {978-1-6654-0540-9},
  langid = {english},
  annotation = {abstractTranslation: 本論文では、グラフ構造スパース復元のための新規な凸最適化手法を提案する。様々な構造スパース性はグラフ構造スパース性として表現できる一方、グラフ構造スパース復元は依然として困難な非凸問題である。この困難を解決するため、基礎となるグラフの関連部分グラフを自動的に識別する凸ペナルティ関数を提案する。提案したペナルティを用いてグラフ構造復元モデルを設計し、閉形式の近接作用素やグラフ上の差分作用素といった単純な演算のみからなる一階反復解法を開発する。数値実験により、提案手法は固定構造を用いた既存の凸正則化よりも優れた推定精度を持つことが示された。},
  file = {C:\Users\furuh\Zotero\storage\T6YES2KQ\Kuroda and Kitahara - 2022 - Graph-Structured Sparse Regularization Via Convex .pdf}
}

