  doi = {10.1109/ICASSP49660.2025.10888632},
  urldate = {2025-03-13},
  abstract = {Real-world graph signals are inherently time-varying and evolve smoothly, making the characterization of such data challenging. We propose a novel approach for reconstructing missing time-varying graph data by leveraging the assumption that the latent variable responsible for generating this data evolves according to nonlinear dynamics. To learn these dynamics, we employ a Koopman autoencoder, and apply graph embedding techniques to map the graph data into a latent space. While existing approaches require known time-invariant Laplacian matrices, our proposed approach can perform reconstruction without needing these matrices, which can also be time-varying. Simulation results show that our method surpasses baseline approaches, achieving a reduction in reconstruction error by 47\% to 61\% compared to alternative methods, while effectively reconstructing time-varying graphs with dynamic structures.},
  langid = {english},
  keywords = {Acoustics,Autoencoders,Data models,graph embedding,graph signals,Koopman autoencoder,Laplace equations,Laplacian matrix,Nonlinear dynamical systems,Signal reconstruction,Simulation,Speech processing,time-varying graphs,Time-varying systems,Topology},
  annotation = {abstractTranslation: 実際のグラフ信号は本質的に時変であり、スムーズに進化しているため、そのようなデータの特性評価が困難になります。このデータの生成に責任がある潜在変数が非線形ダイナミクスに従って進化するという仮定を活用することにより、欠落している時変データデータを再構築するための新しいアプローチを提案します。これらのダイナミクスを学ぶために、Koopman Autoencoderを使用し、グラフ埋め込み手法を適用して、グラフデータを潜在空間にマッピングします。既存のアプローチでは、既知の時間不変のラプラシアンマトリックスが必要ですが、提案されたアプローチは、これらのマトリックスを必要とせずに再構築を実行できます。シミュレーション結果は、私たちの方法がベースラインアプローチを上回り、代替方法と比較して再構築誤差の減少を47％〜61％達成し、動的構造を使用して時変グラフを効果的に再構築することを示しています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\ARJM5AUQ\\Krishnan et al. - 2025 - Graph Signal Reconstruction via Koopman Autoencoder.pdf;C\:\\Users\\furuh\\Zotero\\storage\\2JLJVED2\\10888632.html}
}

@article{krishnaSpectralGraphWavelet2023,
  title = {Spectral {{Graph Wavelet Transform-Based Feature Representation}} for {{Automated Classification}} of {{Emotions From EEG Signal}}},
  author = {Krishna, Rahul and Das, Kritiprasanna and Meena, Hemant Kumar and Pachori, Ram Bilas},
  year = {2023},
  month = dec,
  journal = {IEEE Sensors Journal},
  volume = {23},
  number = {24},
  pages = {31229--31236},
  issn = {1530-437X, 1558-1748, 2379-9153},
  doi = {10.1109/JSEN.2023.3330090},
  urldate = {2024-06-03},
  abstract = {Electroencephalogram (EEG) monitors the brain's electrical activity and carries useful information regarding the subject's emotional states. Due to the nonstationary and being complex in nature, proper signal-processing techniques are necessary to get meaningful interpretations. The EEG signal has been represented using a graph by incorporating the temporal dependency. In this article, a novel feature based on spectral graph wavelet transform (SGWT) for representing EEG signals has been proposed by considering the interdependency among different samples of EEG signals. SGWT is effective in finding multiscale information at the local level as well as the global level. These multiscale representations allow for the extraction of information about the EEG signal at different scales. The SGWT coefficients are used to develop machine-learning classifiers for emotion identification. Principal component analysis (PCA) is also used for feature reduction. The proposed framework is evaluated based on a publicly available SEED dataset with the help of extensive experiments. The \$\{k\}\$ -nearest neighbor (KNN) classifier provides 97.3\% accuracy with a standard deviation of 1.2\%. The SGWT-based representation has achieved 12.7\% higher accuracy compared to the raw EEG signal, which shows the usefulness of the proposed approach. Our model for emotion recognition attains superior classification performance compared to state-of-the-art methods. Finally, the investigation of interdependency among the samples of EEG signals reveals that the SGWT-based representation of EEG signals is a useful tool for analyzing EEG signals.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html}
}

@inproceedings{kruegerOutofDistributionGeneralizationRisk2021,
  title = {Out-of-{{Distribution Generalization}} via {{Risk Extrapolation}} ({{REx}})},
  booktitle = {{{ICML}}},
  author = {Krueger, David and Caballero, Ethan and Jacobsen, J. and Zhang, Amy and Binas, Jonathan and Priol, R{\'e}mi Le and Courville, Aaron C.},
  year = {2021},
  abstract = {This work introduces the principle of Risk Extrapolation (REx), and shows conceptually how this principle enables extrapolation, and demonstrates the effectiveness and scalability of instantiations of REx on various OoD generalization tasks. Generalizing outside of the training distribution is an open challenge for current machine learning systems. A weak form of out-of-distribution (OoD) generalization is the ability to successfully interpolate between multiple observed distributions. One way to achieve this is through robust optimization, which seeks to minimize the worst-case risk over convex combinations of the training distributions. However, a much stronger form of OoD generalization is the ability of models to extrapolate beyond the distributions observed during training. In pursuit of strong OoD generalization, we introduce the principle of Risk Extrapolation (REx). REx can be viewed as encouraging robustness over affine combinations of training risks, by encouraging strict equality between training risks. We show conceptually how this principle enables extrapolation, and demonstrate the effectiveness and scalability of instantiations of REx on various OoD generalization tasks. Our code can be found at this https URL.},
  keywords = {No DOI found},
  file = {C:\Users\furuh\Zotero\storage\C9R3LDZ7\Krueger et al_2021_Out-of-Distribution Generalization via Risk Extrapolation (REx).pdf}
}

