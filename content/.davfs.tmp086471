@article{hurProposalMillimeterWaveChannel2016,
  title = {Proposal on {{Millimeter-Wave Channel Modeling}} for {{5G Cellular System}}},
  author = {Hur, Sooyoung and Baek, Sangkyu and Kim, Byungchul and Chang, Youngbin and Molisch, Andreas F. and Rappaport, Theodore S. and Haneda, Katsuyuki and Park, Jeongho},
  year = {2016},
  month = apr,
  journal = {IEEE Journal of Selected Topics in Signal Processing},
  volume = {10},
  number = {3},
  pages = {454--469},
  issn = {1932-4553, 1941-0484},
  doi = {10.1109/JSTSP.2016.2527364},
  urldate = {2023-07-31},
  abstract = {This paper presents 28 GHz wideband propagation channel characteristics for millimeter wave (mmWave) urban cellular communication systems. The mmWave spectrum is considered as a key-enabling feature of 5G cellular communication systems to provide an enormous capacity increment; however, mmWave channel models are lacking today. The paper compares measurements conducted with a spherical scanning 28 GHz channel sounder system in the urban street-canyon environments of Daejeon, Korea and NYU campus, Manhattan, with ray-tracing simulations made for the same areas. Since such scanning measurements are very costly and time-intensive, only a relatively small number of channel samples can be obtained. The measurements are thus used to quantify the accuracy of a ray-tracer; the ray-tracer is subsequently used to obtain a large number of channel samples to fill gaps in the measurements. A set of mmWave radio propagation parameters is presented based on both the measurement results and ray-tracing, and the corresponding channel models following the 3GPP spatial channel model (SCM) methodology are also described.}
}

@article{huTensorNuclearNorm2025,
  title = {Tensor {{Nuclear Norm}} Based {{Multi-channel Atomic Representation}} for {{Robust Face Recognition}}},
  author = {Hu, Yutao and Wang, Yulong and Wang, Libin and Li, Han and Chen, Hong and Tang, Yuan Yan},
  year = {2025},
  journal = {IEEE Transactions on Image Processing},
  pages = {1--1},
  issn = {1941-0042},
  doi = {10.1109/TIP.2025.3539472},
  urldate = {2025-02-24},
  abstract = {Numerous representation-based classification (RC) methods have been developed for face recognition due to their decent model interpretability and robustness against noise. Most existing RC methods primarily characterize the gray-scale reconstruction error image (single-channel data) in two ways: the one-dimensional (1-D) pixel-based error model and the two-dimensional (2-D) gray-scale image-matrix-based error model. The former measures the reconstruction error pixel by pixel, while the latter leverages 2-D structural information of the gray-scale error image, such as the low-rank property. However, when applying these methods to different color channels of a test color face image (multi-channel data) separately and independently, they neglect the three-dimensional (3-D) structural correlations among distinct color channels. In real-world scenarios, face images are often contaminated with complex noise, including contiguous occlusion and random pixel corruption, which pose significant challenges to these approaches and can lead to a decline in performance. In this paper, we propose a Tensor Nuclear Norm based Robust Multi-channel Atomic Representation (TNN-RMAR) framework with application to color face recognition. The proposed method has the following three critical ingredients: (1) We propose a 3-D color image-tensor-based error model, which can take full advantage of the 3-D structural information of the color error image. (2) To leverage the 3-D structural information of the color error image, we model it as a 3-order tensor {$\varepsilon$} and exploit its low-rank property with the tensor nuclear norm. Given that multiple color channels in a color image are generally corrupted at the same positions, we design a tube-wise tailored loss function to further leverage its tube-wise structure. (3) We devise the multi-channel atomic norm (MAN) regularization for the representation coeffcient matrix, which allows us to jointly harness the correlation information of coeffcients in different color channels. In addition, we also devise an effcient algorithm to solve the TNN-RMAR framework based on the alternating direction method of multipliers (ADMM) framework. By leveraging TNN-RMAR as a general platform, we also develop several novel robust multi-channel RC methods. Experimental results on benchmark real-world databases validate the effectiveness and robustness of the proposed framework for robust color face recognition.},
  langid = {english},
  keywords = {3-D error model,Colored noise,Face recognition,Image color analysis,Image reconstruction,multi-channel atomic representation,robust face recognition,Robustness,Solid modeling,tensor nuclear norm,Tensors,Three-dimensional displays,Training,Vectors},
  annotation = {abstractTranslation: 多数の表現ベースの分類（RC）メソッドは、まともなモデルの解釈可能性とノイズに対する堅牢性のために、顔認識のために開発されています。ほとんどの既存のRCメソッドは、主に1次元（1-d）ピクセルベースのエラーモデルと2次元（2-D）グレースケールの2つの方法で、グレースケール再構成エラーイメージ（シングルチャネルデータ）を特徴づけています。画像マトリックスベースのエラーモデル。前者はピクセルごとに再構成エラーピクセルを測定し、後者は低ランクのプロパティなどのグレースケールエラー画像の2D構造情報をレバレッジします。ただし、これらのメソッドをテストカラーフェイスイメージ（マルチチャネルデータ）の異なるカラーチャネルに個別に適用する場合、個別のカラーチャネル間の3次元（3-D）構造相関を無視します。実際のシナリオでは、顔の画像は、隣接する閉塞やランダムピクセルの腐敗など、複雑なノイズで汚染されることがよくあり、これらのアプローチに大きな課題をもたらし、パフォーマンスの低下につながる可能性があります。このホワイトペーパーでは、色の表認識を適用したテンソル核基準ベースの堅牢なマルチチャネル原子表現（TNN-RMAR）フレームワークを提案します。提案された方法には、次の3つの重要な成分があります。（1）3Dカラー画像テンソルベースのエラーモデルを提案します。これは、カラーエラー画像の3D構造情報を最大限に活用できます。 （2）カラーエラー画像の3D構造情報を活用するために、3次テンソル{$\varepsilon$}としてモデル化し、テンソル核規範と低ランクの特性を活用します。カラー画像の複数のカラーチャネルが一般に同じ位置で破損していることを考えると、チューブごとの構造をさらに活用するために、チューブワイズワイズのテーラード損失関数を設計します。 （3）表現係数マトリックスのマルチチャネル原子標準（MAN）正則化を考案します。これにより、さまざまなカラーチャネルの係数の相関情報を共同で活用できます。さらに、乗数（ADMM）フレームワークの交互方向方法に基づいてTNN-RMARフレームワークを解決するための効率的なアルゴリズムも考案します。 TNN-RMARを一般的なプラットフォームとして活用することにより、いくつかの新しい堅牢なマルチチャネルRCメソッドも開発します。ベンチマークの実験結果RealWorldデータベースは、堅牢な色の顔認識のための提案されたフレームワークの有効性と堅牢性を検証します。},
  file = {C:\Users\furuh\Zotero\storage\CD4UJUSV\10891337.html}
}

@article{huUnsupervisedFeatureSelection2025,
  title = {Unsupervised {{Feature Selection}} for {{High-Order Embedding Learning}} and {{Sparse Learning}}},
  author = {Hu, Zebiao and Wang, Jian and Ma{\'n}dziuk, Jacek and Ren, Zhongxin and Pal, Nikhil R.},
  year = {2025},
  journal = {IEEE Transactions on Cybernetics},
  pages = {1--14},
  issn = {2168-2275},
  doi = {10.1109/TCYB.2025.3546658},
  urldate = {2025-03-24},
  abstract = {The majority of the unsupervised feature selection methods usually explore the first-order similarity of the data while ignoring the high-order similarity of the instances, which makes it easy to construct a suboptimal similarity graph. Furthermore, such methods, often are not suitable for performing feature selection due to their high complexity, especially when the dimensionality of the data is high. To address the above issues, a novel method, termed as unsupervised feature selection for high-order embedding learning and sparse learning (UFSHS), is proposed to select useful features. More concretely, UFSHS first takes advantage of the high-order similarity of the original input to construct an optimal similarity graph that accurately reveals the essential geometric structure of high-dimensional data. Furthermore, it constructs a unified framework, integrating high-order embedding learning and sparse learning, to learn an appropriate projection matrix with row sparsity, which helps to select an optimal subset of features. Moreover, we design a novel alternative optimization method that provides different optimization strategies according to the relationship between the number of instances and the dimensionality, respectively, which significantly reduces the computational complexity of the model. Even more amazingly, the proposed optimization strategy is shown to be applicable to ridge regression, broad learning systems and fuzzy systems. Extensive experiments are conducted on nine public datasets to illustrate the superiority and efficiency of our UFSHS.},
  langid = {english},
  keywords = {Classification algorithms,Clustering algorithms,Embedding learning,Feature extraction,feature selection,Filtering algorithms,geometric structure,High dimensional data,high-order similarity,Learning systems,Linear programming,Optimization,Petroleum,sparse learning,Sparse matrices},
  annotation = {abstractTranslation: ほとんどの教師なし特徴選択手法は、データの1次類似性を探索する一方で、インスタンスの高次類似性を無視するため、最適でない類似グラフを構築しやすい。さらに、このような手法は、特にデータの次元が高い場合、その高い複雑さのために特徴選択に適さないことが多い。上記の課題に対処するため、高次埋め込み学習とスパース学習のための教師なし特徴選択法（UFSHS）と呼ばれる新規手法を提案する。より具体的には、UFSHSはまず、元の入力の高次類似性を活用して、高次元データの本質的な幾何学的構造を正確に明らかにする最適な類似グラフを構築する。さらに、高次埋め込み学習とスパース学習を統合した統一フレームワークを構築し、行スパース性を有する適切な射影行列を学習することで、最適な特徴部分集合を選択する。さらに、インスタンス数と次元数の関係に応じて異なる最適化戦略を提供する新規な交互最適化手法を設計し、モデルの計算複雑さを大幅に削減する。さらに驚くべきことに、提案された最適化戦略は、リッジ回帰、ブロードラーニングシステム、ファジィシステムに適用できることが示されている。9つの公開データセットを用いた広範な実験により、UFSHSの優位性と効率性を示す。}
}

@article{iacovacciVisibilityGraphsImage2020,
  title = {Visibility {{Graphs}} for {{Image Processing}}},
  author = {Iacovacci, Jacopo and Lacasa, Lucas},
  year = {2020},
  month = apr,
  journal = {IEEE Transactions on Pattern Analysis and Machine Intelligence},
  volume = {42},
  number = {4},
  pages = {974--987},
  issn = {0162-8828, 2160-9292, 1939-3539},
  doi = {10.1109/TPAMI.2019.2891742},
  urldate = {2024-07-08},
  abstract = {The family of image visibility graphs (IVG/IHVGs) have been recently introduced as simple algorithms by which scalar fields can be mapped into graphs. Here we explore the usefulness of such{\textbackslash}an operator in the scenario of image processing and image classification. We demonstrate that the link architecture of the image visibility graphs encapsulates relevant information on the structure of the images and we explore their potential as image filters. We introduce several graph features, including the novel concept of Visibility Patches, and show through several examples that these features are highly informative, computationally efficient and universally applicable for general pattern recognition and image classification tasks.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  file = {C:\Users\furuh\Zotero\storage\8MC39DR2\Iacovacci and Lacasa - 2020 - Visibility Graphs for Image Processing.pdf}
}

@inproceedings{iatropoulosKernelMemoryNetworks2022,
  title = {Kernel {{Memory Networks}}: {{A Unifying Framework}} for {{Memory Modeling}}},
  shorttitle = {Kernel {{Memory Networks}}},
  booktitle = {Advances in {{Neural Information Processing Systems}}},
  author = {Iatropoulos, Georgios and Brea, Johanni and Gerstner, Wulfram},
  year = {2022},
  month = may,
  urldate = {2023-10-14},
  abstract = {We consider the problem of training a neural network to store a set of patterns with maximal noise robustness. A solution, in terms of optimal weights and state update rules, is derived by training each individual neuron to perform either kernel classification or interpolation with a minimum weight norm. By applying this method to feed-forward and recurrent networks, we derive optimal models, termed kernel memory networks, that include, as special cases, many of the hetero- and auto-associative memory models that have been proposed over the past years, such as modern Hopfield networks and Kanerva's sparse distributed memory. We modify Kanerva's model and demonstrate a simple way to design a kernel memory network that can store an exponential number of continuous-valued patterns with a finite basin of attraction. The framework of kernel memory networks offers a simple and intuitive way to understand the storage capacity of previous memory models, and allows for new biological interpretations in terms of dendritic non-linearities and synaptic cross-talk.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\ZCKI6TN4\Iatropoulos et al. - 2022 - Kernel Memory Networks A Unifying Framework for M.pdf}
}

@inproceedings{idaFastBlockCoordinate2023,
  title = {Fast {{Block Coordinate Descent}} for {{Non-Convex Group Regularizations}}},
  booktitle = {Proceedings of {{The}} 26th {{International Conference}} on {{Artificial Intelligence}} and {{Statistics}}},
  author = {Ida, Yasutoshi and Kanai, Sekitoshi and Kumagai, Atsutoshi},
  year = {2023},
  month = apr,
  pages = {2481--2493},
  publisher = {PMLR},
  issn = {2640-3498},
  urldate = {2025-05-31},
  abstract = {Non-convex sparse regularizations with group structures are useful tools for selecting important feature groups. For optimization with these regularizations, block coordinate descent (BCD) is a standard solver that iteratively updates each parameter group. However, it suffers from high computation costs for a large number of parameter groups. The state-of-the-art method prunes unnecessary updates in BCD by utilizing bounds on the norms of the parameter groups. Unfortunately, since it computes the bound for each iteration, the computation cost still tends to be high when the updates are not sufficiently pruned. This paper proposes a fast BCD for non-convex group regularizations. Specifically, it selects a small subset of the parameter groups from all the parameter groups on the basis of the bounds and performs BCD on the subset. The subset grows step by step in accordance with the bounds during optimization. Since it computes the bounds only when selecting and growing the subsets, the total cost for computing the bounds is smaller than in the previous method. In addition, we theoretically guarantee the convergence of our method. Experiments show that our method is up to four times faster than the state-of-the-art method and 68 times faster than the original BCD without any loss of accuracy.   グループ構造を持つ非凸スパース正則化は、重要な特徴グループを選択するための便利なツールです。これらの正則化による最適化のために、ブロック座標降下法 (BCD) は、各パラメーター グループを反復的に更新する標準ソルバーです。ただし、多数のパラメータグループに対して高い計算コストが発生します。最先端の手法では、パラメーター グループのノルムの境界を利用して、BCD の不要な更新を排除します。残念ながら、各イテレーションの境界を計算するため、更新が十分にプルーニングされていない場合、計算コストは依然として高くなる傾向があります。この論文では、非凸群正則化のための高速 BCD を提案します。具体的には、境界に基づいてすべてのパラメーター・グループからパラメーター・グループの小さなサブセットを選択し、サブセットに対して BCD を実行します。サブセットは、最適化中に境界に従って段階的に成長します。サブセットを選択して拡張するときにのみ境界を計算するため、境界の計算にかかる合計コストは前の方法よりも小さくなります。さらに、理論的には、私たちの方法の収束を保証します。実験によると、私たちの方法は、精度を損なうことなく、最先端の方法よりも最大4倍、元のBCDよりも68倍高速です。},
  langid = {english},
  annotation = {abstractTranslation: グループ構造を持つ非凸スパース正則化は、重要な特徴グループを選択するための有用なツールです。これらの正則化による最適化のために、ブロック座標降下法 (BCD) は、各パラメータグループを反復的に更新する標準的なソルバーです。ただし、多数のパラメータグループに対して高い計算コストが発生します。最先端の手法では、パラメータグループのノルムの境界を利用して、BCD の不要な更新を排除します。残念ながら、各イテレーションで境界を計算するため、更新が十分にプルーニングされていない場合、計算コストは依然として高くなる傾向があります。この論文では、非凸群正則化のための高速 BCD を提案します。具体的には、境界に基づいてすべてのパラメータグループからパラメータグループの小さなサブセットを選択し、サブセットに対して BCD を実行します。サブセットは、最適化中に境界に従って段階的に成長します。サブセットを選択して拡張するときにのみ境界を計算するため、境界の計算にかかる合計コストは前の方法よりも小さくなります。さらに、理論的には、私たちの方法の収束を保証します。実験によると、私たちの方法は、精度を損なうことなく、最先端の方法よりも最大4倍、元のBCDよりも68倍高速です。},
  file = {C:\Users\furuh\Zotero\storage\P8CYLXQZ\Ida et al. - 2023 - Fast Block Coordinate Descent for Non-Convex Group Regularizations.pdf}
}

