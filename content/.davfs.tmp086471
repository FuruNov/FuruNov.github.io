@article{JMLR:v26:19-159,
  title = {Rank-One Convexification for Sparse Regression},
  author = {Atamturk, Alper and Gomez, Andres},
  year = {2025},
  journal = {Journal of Machine Learning Research},
  volume = {26},
  number = {35},
  pages = {1--50},
  abstract = {Sparse regression models are increasingly prevalent due to their ease of interpretability and superior out-of-sample performance. However, the exact model of sparse regression with an {$\ell$}0-constraint restricting the support of the estimators is a challenging ({\textbackslash}NP-hard) non-convex optimization problem. In this paper, we derive new strong convex relaxations for sparse regression. These relaxations are based on the convex-hull formulations for rank-one quadratic terms with indicator variables. The new relaxations can be formulated as semidefinite optimization problems in an extended space and are stronger and more general than the state-of-the-art formulations, including the perspective reformulation and formulations with the reverse Huber penalty and the minimax concave penalty functions. Furthermore, the proposed rank-one strengthening can be interpreted as a non-separable, non-convex, unbiased sparsity-inducing regularizer, which dynamically adjusts its penalty according to the shape of the error function without inducing bias for the sparse solutions. In our computational experiments with benchmark datasets, the proposed conic formulations are solved within seconds and result in near-optimal solutions (with 0.4{\textbackslash}\% optimality gap on average) for non-convex {$\ell$}0-problems. Moreover, the resulting estimators also outperform alternative convex approaches, such as lasso and elastic net regression, from a statistical perspective, achieving high prediction accuracy and good interpretability.},
  langid = {english},
  keywords = {No DOI found,Now Reading},
  annotation = {abstractTranslation: スパース回帰モデルは、解釈の容易さと優れたサンプル外性能のために、ますます普及しています。しかし、推定量に対するサポートを制限するl0制約を持つスパース回帰の正確なモデルは、困難な（NP困難な）非凸最適化問題です。本稿では、スパース回帰のための新しい強力な凸緩和を導出します。これらの緩和は、指示変数を伴うランク1の2次項に対する凸包定式化に基づいています。新しい緩和は、拡張された空間における半正定値最適化問題として定式化でき、パースペクティブ再定式化、逆フーバーペナルティおよびミニマックス凹ペナルティ関数を用いた定式化を含む、最先端の定式化よりも強力で一般的です。さらに、提案されたランク1の強化は、非分離的、非凸、不偏なスパース性誘導正則化子として解釈でき、スパース解に対するバイアスを誘発することなく、誤差関数の形状に応じてペナルティを動的に調整します。ベンチマークデータセットを用いた計算実験では、提案された錐最適化定式化は数秒以内に解かれ、非凸l0問題に対してほぼ最適な解（平均で0.4％の最適性ギャップ）をもたらします。さらに、得られた推定量は、統計的な観点からも、lassoやelastic net回帰などの代替的な凸アプローチよりも優れており、高い予測精度と優れた解釈可能性を実現します。},
  file = {C:\Users\furuh\Zotero\storage\R8GSFDRA\Atamturk と Gomez - 2025 - Rank-one convexification for sparse regression.pdf}
}

@book{johnwrightHighDimensionalDataAnalysis2022,
  title = {High-{{Dimensional Data Analysis}} with {{Low-Dimensional Models}}: {{Principles}}, {{Computation}}, and {{Applications}}},
  shorttitle = {High-{{Dimensional Data Analysis}} with {{Low-Dimensional Models}}},
  author = {{John Wright} and {Yi Ma}},
  year = {2022},
  month = jan,
  edition = {1},
  publisher = {Cambridge University Press},
  doi = {10.1017/9781108779302},
  urldate = {2024-12-24},
  abstract = {Connecting theory with practice, this systematic and rigorous introduction covers the fundamental principles, algorithms and applications of key mathematical models for high-dimensional data analysis. Comprehensive in its approach, it provides unified coverage of many different low-dimensional models and analytical techniques, including sparse and low-rank models, and both convex and non-convex formulations. Readers will learn how to develop efficient and scalable algorithms for solving real-world problems, supported by numerous examples and exercises throughout, and how to use the computational tools learnt in several application contexts. Applications presented include scientific imaging, communication, face recognition, 3D vision, and deep networks for classification. With code available online, this is an ideal textbook for senior and graduate students in computer science, data science, and electrical engineering, as well as for those taking courses on sparsity, low-dimensional structures, and high-dimensional data. Foreword by Emmanuel Cand{\`e}s.},
  copyright = {https://www.cambridge.org/core/terms},
  isbn = {978-1-108-77930-2 978-1-108-48973-7},
  langid = {american},
  file = {C:\Users\furuh\Zotero\storage\JCSYKX9L\Wright と Ma - 2022 - High-Dimensional Data Analysis with Low-Dimensional Models Principles, Computation, and Application.pdf}
}

