@article{klusTensorbasedDynamicMode2018,
  title = {Tensor-Based Dynamic Mode Decomposition},
  author = {Klus, Stefan and Gel{\ss}, Patrick and Peitz, Sebastian and Sch{\"u}tte, Christof},
  year = {2018},
  month = jul,
  journal = {Nonlinearity},
  volume = {31},
  number = {7},
  pages = {3359--3380},
  issn = {0951-7715, 1361-6544},
