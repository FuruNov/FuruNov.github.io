@inproceedings{jiangExposingExploitingFineGrained2022,
  title = {Exposing and {{Exploiting Fine-Grained Block Structures}} for {{Fast}} and {{Accurate Sparse Training}}},
  booktitle = {Advances in {{Neural Information Processing Systems}}},
  author = {Jiang, Peng and Hu, Lihan and Song, Shihui},
  year = {2022},
  month = may,
  urldate = {2023-10-14},
  abstract = {Sparse training is a popular technique to reduce the overhead of training large models. Although previous work has shown promising results for nonstructured sparse models, it is still unclear whether a sparse model with structural constraints can be trained from scratch to high accuracy. In this work, we study the dynamic sparse training for a class of sparse models with shuffled block structures. Compared to nonstructured models, such fine-grained structured models are more hardware-friendly and can effectively accelerate the training process. We propose an algorithm that keeps adapting the sparse model while maintaining the active parameters in shuffled blocks. We conduct experiments on a variety of networks and datasets and obtain positive results. In particular, on ImageNet, we achieve dense accuracy for ResNet50 and ResNet18 at 0.5 sparsity. On CIFAR10/100, we show that dense accuracy can be recovered at 0.6 sparsity for various models. At higher sparsity, our algorithm can still match the accuracy of nonstructured sparse training in most cases, while reducing the training time by up to 5x due to the fine-grained block structures in the models.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\XQXKDT5S\Jiang et al. - 2022 - Exposing and Exploiting Fine-Grained Block Structu.pdf}
}

@misc{jiangFantasticGeneralizationMeasures2019,
  title = {Fantastic {{Generalization Measures}} and {{Where}} to {{Find Them}}},
  author = {Jiang, Yiding and Neyshabur, Behnam and Mobahi, Hossein and Krishnan, Dilip and Bengio, Samy},
  year = {2019},
  month = dec,
  number = {arXiv:1912.02178},
  eprint = {1912.02178},
  primaryclass = {cs, stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1912.02178},
  urldate = {2023-06-11},
  abstract = {Generalization of deep networks has been of great interest in recent years, resulting in a number of theoretically and empirically motivated complexity measures. However, most papers proposing such measures study only a small set of models, leaving open the question of whether the conclusion drawn from those experiments would remain valid in other settings. We present the first large scale study of generalization in deep networks. We investigate more then 40 complexity measures taken from both theoretical bounds and empirical studies. We train over 10,000 convolutional networks by systematically varying commonly used hyperparameters. Hoping to uncover potentially causal relationships between each measure and generalization, we analyze carefully controlled experiments and show surprising failures of some measures as well as promising measures for further research.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning,Statistics - Machine Learning},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\K36EQNBV\\Jiang et al. - 2019 - Fantastic Generalization Measures and Where to Fin.pdf;C\:\\Users\\furuh\\Zotero\\storage\\3GC4SM33\\1912.html}
}

@article{jiangFrameletRepresentationTensor2020,
  title = {Framelet {{Representation}} of {{Tensor Nuclear Norm}} for {{Third-Order Tensor Completion}}},
  author = {Jiang, Tai-Xiang and Ng, Michael K. and Zhao, Xi-Le and Huang, Ting-Zhu},
  year = {2020},
  journal = {IEEE Transactions on Image Processing},
  volume = {29},
  eprint = {1909.06982},
  primaryclass = {cs, eess},
  pages = {7233--7244},
  issn = {1057-7149, 1941-0042},
  doi = {10.1109/TIP.2020.3000349},
  urldate = {2023-09-02},
  abstract = {The main aim of this paper is to develop a framelet representation of the tensor nuclear norm for third-order tensor completion. In the literature, the tensor nuclear norm can be computed by using tensor singular value decomposition based on the discrete Fourier transform matrix, and tensor completion can be performed by the minimization of the tensor nuclear norm which is the relaxation of the sum of matrix ranks from all Fourier transformed matrix frontal slices. These Fourier transformed matrix frontal slices are obtained by applying the discrete Fourier transform on the tubes of the original tensor. In this paper, we propose to employ the framelet representation of each tube so that a framelet transformed tensor can be constructed. Because of framelet basis redundancy, the representation of each tube is sparsely represented. When the matrix slices of the original tensor are highly correlated, we expect the corresponding sum of matrix ranks from all framelet transformed matrix frontal slices would be small, and the resulting tensor completion can be performed much better. The proposed minimization model is convex and global minimizers can be obtained. Numerical results on several types of multi-dimensional data (videos, multispectral images, and magnetic resonance imaging data) have tested and shown that the proposed method outperformed the other testing methods.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Computer Vision and Pattern Recognition,Electrical Engineering and Systems Science - Image and Video Processing},
  annotation = {abstractTranslation: 本論文の主な目的は、3次テンソル補完のためのテンソル核ノルムのフレームレット表現を開発することである。文献では、テンソル核ノルムは離散フーリエ変換行列に基づくテンソル特異値分解を用いて計算することができ、テンソル補完は全てのフーリエ変換行列正面スライスからの行列ランクの和の緩和であるテンソル核ノルムの最小化によって行うことができる。これらのフーリエ変換された行列の正面スライスは、元のテンソルの管に離散フーリエ変換を適用することで得られる。本論文では、フレームレット変換されたテンソルを構築するために、各管のフレームレット表現を採用することを提案する。フレームレット基底の冗長性のため、各管の表現は疎である。元のテンソルの行列スライスが高い相関を持つ場合、全てのフレームレット変換された行列の正面スライスからの対応する行列ランクの総和は小さくなり、結果としてテンソル補完はより良く実行できると期待される。提案する最小化モデルは凸であり、大域的な最小化器が得られる。数種類の多次元データ（ビデオ、マルチスペクトル画像、磁気共鳴画像データ）に対する数値実験の結果、提案手法が他のテスト手法を凌駕することが示された。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\VWYAVHEJ\\Jiang et al. - 2020 - Framelet Representation of Tensor Nuclear Norm for.pdf;C\:\\Users\\furuh\\Zotero\\storage\\M3N7JGQX\\1909.html}
}

@inproceedings{jiangOneForwardEnough2023,
  title = {One {{Forward}} Is {{Enough}} for {{Neural Network Training}} via {{Likelihood Ratio Method}}},
  booktitle = {The {{Twelfth International Conference}} on {{Learning Representations}}},
  author = {Jiang, Jinyang and Zhang, Zeliang and Xu, Chenliang and Yu, Zhaofei and Peng, Yijie},
  year = {2023},
  month = oct,
  urldate = {2024-06-17},
  abstract = {While backpropagation (BP) is the mainstream approach for gradient computation in neural network training, its heavy reliance on the chain rule of differentiation constrains the designing flexibility of network architecture and training pipelines. We avoid the recursive computation in BP and develop a unified likelihood ratio (ULR) method for gradient estimation with only one forward propagation. Not only can ULR be extended to train a wide variety of neural network architectures, but the computation flow in BP can also be rearranged by ULR for better device adaptation. Moreover, we propose several variance reduction techniques to further accelerate the training process. Our experiments offer numerical results across diverse aspects, including various neural network training scenarios, computation flow rearrangement, and fine-tuning of pre-trained models. All findings demonstrate that ULR effectively enhances the flexibility of neural network training by permitting localized module training without compromising the global objective and significantly boosts the network robustness.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\R4E9T4JA\Jiang et al. - 2023 - One Forward is Enough for Neural Network Training .pdf}
}

@article{jiangRobustDictionaryLearning2015,
  title = {Robust {{Dictionary Learning}} with {{Capped}} 1-{{Norm}}},
  author = {Jiang, Wenhao and Nie, Feiping and Huang, Heng},
  year = {2015},
  abstract = {Expressing data vectors as sparse linear combinations of basis elements (dictionary) is widely used in machine learning, signal processing, and statistics. It has been found that dictionaries learned from data are more effective than off-the-shelf ones. Dictionary learning has become an important tool for computer vision. Traditional dictionary learning methods use quadratic loss function which is known sensitive to outliers. Hence they could not learn the good dictionaries when outliers exist. In this paper, aiming at learning dictionaries resistant to outliers, we proposed capped 1-norm based dictionary learning and an efficient iterative re-weighted algorithm to solve the problem. We provided theoretical analysis and carried out extensive experiments on real word datasets and synthetic datasets to show the effectiveness of our method.},
  langid = {english},
  keywords = {No DOI found},
  file = {C:\Users\furuh\Zotero\storage\3WIKAYSN\Jiang et al. - Robust Dictionary Learning with Capped 1-Norm.pdf}
}

@article{jiangTensorialMultiViewClustering2022,
  title = {Tensorial {{Multi-View Clustering}} via {{Low-Rank Constrained High-Order Graph Learning}}},
  author = {Jiang, Guangqi and Peng, Jinjia and Wang, Huibing and Mi, Zetian and Fu, Xianping},
  year = {2022},
  month = aug,
  journal = {IEEE Transactions on Circuits and Systems for Video Technology},
  volume = {32},
  number = {8},
  pages = {5307--5318},
  issn = {1558-2205},
  doi = {10.1109/TCSVT.2022.3143848},
  urldate = {2025-02-18},
  abstract = {Multi-view clustering aims to partition multi-view data into different categories by optimally exploring the consistency and complementary information from multiple sources. However, most existing multi-view clustering algorithms heavily rely on the similarity graphs from respective views and fail to comprehend multiple views holistically. Moreover, due to the noise and redundancy maintained in the original data, the original errors of multiple similarity graphs will continue to accumulate in the process of constructing consistent graphs. These situations always lead to the limitation to effective fuse the essential information from multiple views, which always influences the clustering performance and cries out for reliable solutions. Based on the above considerations, we propose a novel method termed Tensorial Multi-view Clustering (TMvC), which learns high-order graph by low-rank tensor constraint to uncover the essential information stored in multiple views. TMvC first learns the Laplacian graphs of all views and stacks them into a tensor which can be viewed as a high-order graph. With the high-order graph, consistency and complementary information from different views can be propagated smoothly across all views. Then, based on low-rank constraint, high-order graph is constrained in the horizontal and vertical directions to better uncover the inter-view and inter-class correlations between multi-view data, which is of vital importance for multi-view clustering. Extensive experiments on document and image datasets demonstrate that TMvC can achieve the state-of-the-art performance for multi-view clustering.},
  langid = {english},
  keywords = {Clustering algorithms,Correlation,High-order graph learning,Laplace equations,low-rank constraint,multi-view clustering,Optimization,Redundancy,Task analysis,Tensors},
  annotation = {abstractTranslation: Multi-View Clusteringは、複数のソースからの一貫性と補完的な情報を最適に調査することにより、マルチビューデータをさまざまなカテゴリに分割することを目的としています。ただし、ほとんどの既存のマルチビュークラスタリングアルゴリズムは、それぞれのビューから類似性グラフに大きく依存しており、複数のビューを全体的に理解できません。さらに、元のデータに維持されているノイズと冗長性により、複数の類似性グラフの元の誤差は、一貫したグラフを構築するプロセスで蓄積し続けます。これらの状況は、常に複数のビューから重要な情報を効果的に融合するための制限につながります。これは、常にクラスタリングパフォーマンスに影響を与え、信頼できるソリューションを求めて叫びます。上記の考慮事項に基づいて、複数のビューに保存されている重要な情報を明らかにするために、低ランクテンソル制約による高次グラフを学習するテンソリアルマルチビュークラスタリング（TMVC）と呼ばれる新しい方法を提案します。 TMVCはまず、すべてのビューのラプラシアングラフを学習し、それらを高次グラフと見なすことができるテンソルにそれらを積み重ねます。高次のグラフを使用すると、さまざまなビューからの一貫性と補完的な情報をすべてのビューでスムーズに伝播できます。次に、低ランクの制約に基づいて、高次のグラフは水平方向と垂直方向に制約され、マルチビューデータ間のインタービューとクラス間の相関をよりよく明らかにします。これは、マルチビュークラスタリングにとって非常に重要です。ドキュメントおよび画像データセットに関する広範な実験は、TMVCがマルチビュークラスタリングの最先端のパフォーマンスを達成できることを示しています。},
  file = {C:\Users\furuh\Zotero\storage\9F58MB3R\9684399.html}
}

