@article{liNewSparseRegularization2024a,
  title = {New Sparse Regularization Approach for Extracting Transient Impulses from Fault Vibration Signal of Rotating Machinery},
  author = {Li, Qing},
  year = {2024},
  month = mar,
  journal = {Mechanical Systems and Signal Processing},
  volume = {209},
  pages = {111101},
  issn = {0888-3270},
  doi = {10.1016/j.ymssp.2023.111101},
  urldate = {2024-12-09},
  abstract = {Fault impulses induced by localized failure is critical for fault diagnosis and degradation prognostics of rotating machinery, however, weak transient fault impulses are always submerged in heavy noise and unrelated components. To overcome this bottleneck issue, a novel approach named smoothing sparse low-rank matrix (SSLRM) associated with asymmetric and singular value decomposition (SVD) penalty regularizers is proposed, for the first time. To be specific, the asymmetric and SVD penalty regularizers are utilized to alleviate the issues of underestimation deficiency of traditional sparse regularization, where the Parseval theorem in wavelet framework and smoothing operation are conducted, so as to enhance the sparsity of the estimated transient impulses while restraining the unrelated interference. Meanwhile, the strict convexity of the cost function is proved theatrically, and the effective optimization algorithm with fast convergence speed based upon the alternating direction method of multipliers (ADMM) is proposed through splitting the optimization function into two simple sub-parts. The simulated case and two experimental cases regarding bearings failure in corn thresher and gear-root crack failure in reducer are investigated for theoretical verification of the proposed approach, the results indicate that diagnosis accuracy and fault impulses amplitude of the algorithm are superior to the state-of-the-art benchmarks.},
  langid = {american},
  keywords = {Asymmetric penalty regularizer,Fault diagnosis,Impulses extraction,Smoothing SLRM},
  annotation = {abstractTranslation: 回転機械の故障診断や劣化予知には、局所的な故障によって誘発される故障インパルスが重要であるが、弱い過渡故障インパルスは常に大きなノイズや無関係な成分に埋もれてしまう。このボトルネック問題を克服するために、非対称および特異値分解(SVD)ペナルティ正則化に関連する平滑化スパース低ランク行列(SSLRM)という新しいアプローチを初めて提案する。具体的には、非対称正則化とSVDペナルティ正則化を利用することで、従来のスパース正則化の推定不足の問題を緩和し、ウェーブレットフレームワークにおけるパースバルの定理と平滑化演算を行うことで、無関係な干渉を抑制しつつ、推定された過渡インパルスのスパース性を向上させる。一方、コスト関数の厳密な凸性が劇的に証明され、最適化関数を2つの単純なサブパートに分割することにより、交互方向乗数法（ADMM）に基づく収束速度の速い効果的な最適化アルゴリズムが提案された。提案されたアプローチの理論的検証のため、コーン脱穀機のベアリング故障と減速機のギア根元クラック故障に関するシミュレーションケースと2つの実験ケースを調査し、その結果、本アルゴリズムの診断精度と故障インパルス振幅は、最先端のベンチマークよりも優れていることが示された。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\CZGI6325\\Li - 2024 - New sparse regularization approach for extracting transient impulses from fault vibration signal of.pdf;C\:\\Users\\furuh\\Zotero\\storage\\433XZXWX\\S0888327023010099.html}
}

@article{linFilterSketchNetwork2022,
  title = {Filter {{Sketch}} for {{Network Pruning}}},
  author = {Lin, Mingbao and Cao, Liujuan and Li, Shaojie and Ye, Qixiang and Tian, Yonghong and Liu, Jianzhuang and Tian, Qi and Ji, Rongrong},
  year = {2022},
  month = dec,
  journal = {IEEE Transactions on Neural Networks and Learning Systems},
  volume = {33},
  number = {12},
  pages = {7091--7100},
  issn = {2162-237X, 2162-2388},
  doi = {10.1109/TNNLS.2021.3084206},
  urldate = {2023-10-22},
  abstract = {We propose a novel network pruning approach by information preserving of pretrained network weights (filters). Network pruning with the information preserving is formulated as a matrix sketch problem, which is efficiently solved by the off-the-shelf frequent direction method. Our approach, referred to as FilterSketch, encodes the second-order information of pretrained weights, which enables the representation capacity of pruned networks to be recovered with a simple fine-tuning procedure. FilterSketch requires neither training from scratch nor data-driven iterative optimization, leading to a several-orders-of-magnitude reduction of time cost in the optimization of pruning. Experiments on CIFAR-10 show that FilterSketch reduces 63.3\% of floating-point operations (FLOPs) and prunes 59.9\% of network parameters with negligible accuracy cost for ResNet-110. On ILSVRC-2012, it reduces 45.5\% of FLOPs and removes 43.0\% of parameters with only 0.69\% accuracy drop for ResNet-50. Our code and pruned models can be found at https://github.com/lmbxmu/FilterSketch.},
  file = {C:\Users\furuh\Zotero\storage\JMGD8YRR\Lin et al. - 2022 - Filter Sketch for Network Pruning.pdf}
}

