  title = {Principal {{Component Analysis Based}} on {{L1-Norm Maximization}}},
  author = {Kwak, Nojun},
  year = {2008},
  month = sep,
  journal = {IEEE Transactions on Pattern Analysis and Machine Intelligence},
  volume = {30},
