@misc{lemhadriLassoNetNeuralNetwork2021,
  title = {{{LassoNet}}: {{A Neural Network}} with {{Feature Sparsity}}},
  shorttitle = {{{LassoNet}}},
  author = {Lemhadri, Ismael and Ruan, Feng and Abraham, Louis and Tibshirani, Robert},
  year = {2021},
  month = jun,
  number = {arXiv:1907.12207},
  eprint = {1907.12207},
  primaryclass = {cs, stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1907.12207},
  urldate = {2022-11-27},
  abstract = {Much work has been done recently to make neural networks more interpretable, and one obvious approach is to arrange for the network to use only a subset of the available features. In linear models, Lasso (or \${\textbackslash}ell\_1\$-regularized) regression assigns zero weights to the most irrelevant or redundant features, and is widely used in data science. However the Lasso only applies to linear models. Here we introduce LassoNet, a neural network framework with global feature selection. Our approach enforces a hierarchy: specifically a feature can participate in a hidden unit only if its linear representative is active. Unlike other approaches to feature selection for neural nets, our method uses a modified objective function with constraints, and so integrates feature selection with the parameter learning directly. As a result, it delivers an entire regularization path of solutions with a range of feature sparsity. On systematic experiments, LassoNet significantly outperforms state-of-the-art methods for feature selection and regression. The LassoNet method uses projected proximal gradient descent, and generalizes directly to deep networks. It can be implemented by adding just a few lines of code to a standard neural network.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Machine Learning,Statistics - Machine Learning},
  annotation = {abstractTranslation: 最近、ニューラルネットワークをより解釈しやすくするために多くの研究が行われており、1つの明白なアプローチは、利用可能な特徴のサブセットのみを使用するようにネットワークをアレンジすることである。線形モデルでは、Lasso（または\$ell\_1\$正則化）回帰は、最も無関係な特徴や冗長な特徴にゼロの重みを割り当て、データサイエンスで広く使用されている。しかし、Lassoは線形モデルにしか適用できません。ここでは、大域的な特徴選択を行うニューラルネットワーク・フレームワークであるLassoNetを紹介します。我々のアプローチは階層を強制します。具体的には、ある特徴はその線形代表がアクティブである場合にのみ隠れユニットに参加できます。ニューラルネットの特徴選択に対する他のアプローチとは異なり、我々の手法は制約条件付きの修正目的関数を使用するため、特徴選択をパラメータ学習と直接統合します。その結果、様々な特徴スパース性を持つ解の正則化パス全体を提供する。系統的な実験では、LassoNetは特徴選択と回帰のための最先端の手法を大幅に凌駕しました。LassoNet法は投影近接勾配降下を使用し、ディープ・ネットワークに直接一般化します。標準的なニューラルネットワークに数行のコードを追加するだけで実装できる。},
  file = {C:\Users\furuh\Zotero\storage\PIHZXK7S\Lemhadri et al_2021_LassoNet.pdf}
}

