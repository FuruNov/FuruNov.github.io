@article{huangNewMeasureModel2021,
  title = {A {{New Measure}} of {{Model Redundancy}} for {{Compressed Convolutional Neural Networks}}},
  author = {Huang, Feiqing and Si, Yuefeng and Zheng, Yao and Li, Guodong},
  year = {2021},
  month = dec,
  journal = {ArXiv},
  urldate = {2023-11-22},
  abstract = {While recently many designs have been proposed to improve the model efficiency of convolutional neural networks (CNNs) on a fixed resource budget, theoretical understanding of these designs is still conspicuously lacking. This paper aims to provide a new framework for answering the question: Is there still any remaining model redundancy in a compressed CNN? We begin by developing a general statistical formulation of CNNs and compressed CNNs via the tensor decomposition, such that the weights across layers can be summarized into a single tensor. Then, through a rigorous sample complexity analysis, we reveal an important discrepancy between the derived sample complexity and the naive parameter counting, which serves as a direct indicator of the model redundancy. Motivated by this finding, we introduce a new model redundancy measure for compressed CNNs, called the \$K/R\$ ratio, which further allows for nonlinear activations. The usefulness of this new measure is supported by ablation studies on popular block designs and datasets.},
  keywords = {No DOI found},
  file = {C:\Users\furuh\Zotero\storage\ES7YCSHW\Huang et al. - 2021 - A New Measure of Model Redundancy for Compressed C.pdf}
}

@article{huangNonconvexGroupSparsity2020,
  title = {Nonconvex {{Group Sparsity Signal Decomposition}} via {{Convex Optimization}} for {{Bearing Fault Diagnosis}}},
  author = {Huang, Weiguo and Li, Ning and Selesnick, Ivan and Shi, Juanjuan and Wang, Jun and Mao, Lei and Jiang, Xingxing and Zhu, Zhongkui},
  year = {2020},
  month = jul,
  journal = {IEEE Transactions on Instrumentation and Measurement},
  volume = {69},
  number = {7},
  pages = {4863--4872},
  issn = {1557-9662},
  doi = {10.1109/TIM.2019.2955795},
  urldate = {2025-02-18},
  abstract = {Bearing fault diagnosis is critical for rotating machinery condition monitoring since it is a key component of rotating machines. One of the challenges for bearing fault diagnosis is to accurately realize fault feature extraction from original vibration signals. To tackle this problem, the novel group sparsity signal decomposition method is proposed in this article. For the sparsity within and across groups' property of the bearing vibration signals, the nonconvex group separable penalty is introduced to construct the objective function, leading to that the noise between the adjacent impulses can be eliminated and the impulses can be effectively extracted. Furthermore, since the penalty function is nonconvex, the convexity condition of the corresponding objective function to the global minimum is discussed. In addition, to improve the efficiency of parameter selection, this article presents an adaptive regularization parameter selection strategy. Simulation and experimental studies show that compared with the traditional method, the proposed method can better preserve the target components and reducing uncorrelated interference components for bearing fault diagnosis.},
  langid = {english},
  keywords = {Bearing fault diagnosis,Convex functions,convex optimization,Fault diagnosis,feature extraction,Feature extraction,Linear programming,signal decomposition,Signal resolution,Transient analysis,Vibrations},
  annotation = {abstractTranslation: ベアリング障害の診断は、回転機の監視を回転させるために重要です。これは、回転機の重要なコンポーネントであるためです。障害診断を支えることの課題の1つは、元の振動信号からの障害特徴抽出を正確に実現することです。この問題に取り組むために、この記事では、新しいグループSparsity Signal分解方法を提案しています。ベアリング振動信号のグループ内およびグループ間のスパース性の場合、目的関数を構築するために非凸グループ分離可能なペナルティが導入され、隣接するインパルス間のノイズが排除され、インパルスが効果的に抽出できることになります。さらに、ペナルティ関数は非凸であるため、グローバル最小値に対応する目的関数の凸状態について説明します。さらに、パラメーター選択の効率を向上させるために、この記事では、適応的な正則化パラメーター選択戦略を紹介します。シミュレーションと実験的研究は、従来の方法と比較して、提案された方法がターゲットコンポーネントをよりよく維持し、障害診断のための無相関干渉成分を減らすことができることを示しています。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\HNMILJV8\\Huang et al. - 2020 - Nonconvex Group Sparsity Signal Decomposition via Convex Optimization for Bearing Fault Diagnosis.pdf;C\:\\Users\\furuh\\Zotero\\storage\\CX9NVQ4U\\8911515.html}
}

@article{huangNonconvexRegularizerHomotopybased2025,
  title = {Nonconvex Regularizer and Homotopy-Based Sparse Optimization: {{Convergent}} Algorithms and Applications},
  shorttitle = {Nonconvex Regularizer and Homotopy-Based Sparse Optimization},
  author = {Huang, Zilin and Jiang, Lanfan and Cao, Weiwei and Zhu, Wenxing},
  year = {2025},
  journal = {Journal of Industrial and Management Optimization},
  pages = {0--0},
  publisher = {{Journal of Industrial and Management Optimization}},
  issn = {1547-5816},
  doi = {10.3934/jimo.2025022},
  urldate = {2025-02-24},
  abstract = {Non-convex optimization regularized with a sparsity function has many applications in machine learning and other fields. Non-convex relaxation of the sparsity function often leads to more effective sparse optimization algorithms. In this paper, we propose a new weighted regularizer to approximate the sparsity function, and derive a weighted thresholding operator for the sparse optimization problem with the regularizer. Then, iterative weighted thresholding algorithms are designed, followed with an acceleration by using Nesterov's acceleration method and non-monotone line search. Under the Kurdyka-{\L}ojasiewicz (KL) property, the smoothness and the appropriate convexity assumptions, we prove that the two algorithms are convergent and the convergence rates are \$ O(\{1\}/\{k\}) \$ and \$ O(\{1\}/\{k{\textasciicircum}2\}) \$ respectively, where \$ k \$ is the iteration counter. Moreover, we develop convergent practical homotopy algorithms by invoking the two iterative weighted thresholding algorithms as subroutines respectively. A series of numerical experiments demonstrate that our algorithms are superior in both average recovery rate and average running time for the sparse recovery problem, and are competitive in solution quality and average running time for the logistic regression problem, compared to state-of-the-art algorithms.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  annotation = {abstractTranslation: スパース機能で正規化された非凸最適化には、機械学習やその他の分野で多くのアプリケーションがあります。スパース機能の非凸緩和は、しばしばより効果的なスパース最適化アルゴリズムにつながります。このホワイトペーパーでは、スパース機能に近似するための新しい加重正規者を提案し、正規者のまばらな最適化問題の加重しきい値演算子を導き出します。次に、反復加重しきい値アルゴリズムが設計され、その後、Nesterovの加速法と非モノトーンライン検索を使用して加速が行われます。 Kurdyka-Wojasiewicz（KL）プロパティ、滑らかさ、適切な凸性の仮定の下で、2つのアルゴリズムが収束し、収束速度が\$ o（\{1\}/\{k\}）\$および\$ o（\{1\}）であることを証明します。 /\{k{\textasciicircum}2\}）\$それぞれ、\$ k \$は反復カウンターです。さらに、2つの反復加重しきい値をサブルーチンとして呼び出すことにより、収束実用的なホモトピーアルゴリズムを開発します。一連の数値実験は、私たちのアルゴリズムが、スパースの回復問題の平均回復率と平均実行時間の両方で優れていることを示しており、最先端と比較して、ロジスティック回帰問題のソリューション品質と平均実行時間が競争力があることを示しています。アートアルゴリズム。},
  file = {C:\Users\furuh\Zotero\storage\4UYXR7Q2\Huang et al. - 2025 - Nonconvex regularizer and homotopy-based sparse optimization Convergent algorithms and applications.pdf}
}

