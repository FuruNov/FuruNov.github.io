  pages = {1--84},
  abstract = {Simple structure and other common principles of factor rotation do not in general provide strong grounds for attributing explanatory significance to the factors which they select. In contrast, it is shown that an extension of Cattell's principle of rotation to Proportional Profiles (PP) offers a basis for determining explanatory factors for three-way or higher order multi-mode data. Conceptual models are developed for two basic patterns of multi-mode data variation, system- and object-variation, and PP analysis is found to apply in the system-variation case.},
  langid = {english},
  keywords = {No DOI found},
  file = {C:\Users\furuh\Zotero\storage\U932CJ8Y\Harshman - FOUNDATIONS OF THE PARAFAC PROCEDURE MODELS AND C.pdf}
