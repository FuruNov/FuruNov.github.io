@misc{boyerCompressedSensingStructured2016,
  title = {Compressed Sensing with Structured Sparsity and Structured Acquisition},
  author = {Boyer, Claire and Bigot, J{\'e}r{\'e}mie and Weiss, Pierre},
  year = {2016},
  month = jun,
  number = {arXiv:1505.01619},
  eprint = {1505.01619},
  primaryclass = {cs, math},
  publisher = {arXiv},
  urldate = {2022-10-01},
  abstract = {Compressed Sensing (CS) is an appealing framework for applications such as Magnetic Resonance Imaging (MRI). However, up-to-date, the sensing schemes suggested by CS theories are made of random isolated measurements, which are usually incompatible with the physics of acquisition. To reflect the physical constraints of the imaging device, we introduce the notion of blocks of measurements: the sensing scheme is not a set of isolated measurements anymore, but a set of groups of measurements which may represent any arbitrary shape (parallel or radial lines for instance). Structured acquisition with blocks of measurements are easy to implement, and provide good reconstruction results in practice. However, very few results exist on the theoretical guarantees of CS reconstructions in this setting. In this paper, we derive new CS results for structured acquisitions and signals satisfying a prior structured sparsity. The obtained results provide a recovery probability of sparse vectors that explicitly depends on their support. Our results are thus support-dependent and offer the possibility for flexible assumptions on the sparsity structure. Moreover, the results are drawing-dependent, since we highlight an explicit dependency between the probability of reconstructing a sparse vector and the way of choosing the blocks of measurements. Numerical simulations show that the proposed theory is faithful to experimental observations.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Information Theory},
  annotation = {abstractTranslation: 圧縮センシング(CS)は、磁気共鳴イメージング(MRI)のようなアプリケーションにとって魅力的なフレームワークである。しかし、これまでのところ、CS理論が提案するセンシングスキームは、ランダムな孤立した計測で構成されており、通常、撮影の物理的な制約とは相容れない。イメージングデバイスの物理的制約を反映するために、我々は計測ブロックの概念を導入する。計測ブロックを用いた構造化収集は実装が容易であり、実際に良好な再構成結果を得ることができる。しかし、この設定におけるCS再構成の理論的保証に関する結果はほとんど存在しない。本論文では、構造化収集と、事前の構造化スパース性を満たす信号に対する新しいCS結果を導出する。得られた結果は、サポートに明示的に依存するスパースベクトルの復元確率を提供する。従って、我々の結果はサポートに依存し、スパース構造に対する柔軟な仮定の可能性を提供する。さらに、スパースベクトルの復元確率と測定ブロックの選択方法との間の明示的な依存関係を強調するため、結果は描画に依存する。数値シミュレーションにより、提案した理論が実験結果に忠実であることを示す。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\UE88FHPN\\Boyer et al_2016_Compressed sensing with structured sparsity and structured acquisition.pdf;C\:\\Users\\furuh\\Zotero\\storage\\LEG5RQSE\\1505.html}
}

@article{boyerCompressedSensingStructured2019,
  title = {Compressed Sensing with Structured Sparsity and Structured Acquisition},
  author = {Boyer, Claire and Bigot, J{\'e}r{\'e}mie and Weiss, Pierre},
  year = {2019},
  month = mar,
  journal = {Applied and Computational Harmonic Analysis},
  volume = {46},
  number = {2},
  pages = {312--350},
  issn = {1063-5203},
  doi = {10.1016/j.acha.2017.05.005},
  urldate = {2025-01-18},
  abstract = {Compressed Sensing (CS) is an appealing framework for applications such as Magnetic Resonance Imaging (MRI). However, up-to-date, the sensing schemes suggested by CS theories are made of random isolated measurements, which are usually incompatible with the physics of acquisition. To reflect the physical constraints of the imaging device, we introduce the notion of blocks of measurements: the sensing scheme is not a set of isolated measurements anymore, but a set of groups of measurements which may represent any arbitrary shape (parallel or radial lines for instance). Structured acquisition with blocks of measurements are easy to implement, and provide good reconstruction results in practice. However, very few results exist on the theoretical guarantees of CS reconstructions in this setting. In this paper, we derive new CS results for structured acquisitions and signals satisfying a prior structured sparsity. The obtained results provide a recovery probability of sparse vectors that explicitly depends on their support. Our results are thus support-dependent and offer the possibility for flexible assumptions on the sparsity structure. Moreover, the results are drawing-dependent, since we highlight an explicit dependency between the probability of reconstructing a sparse vector and the way of choosing the blocks of measurements. Numerical simulations show that the proposed theory is faithful to experimental observations.},
  keywords = {Blocks of measurements,Compressed sensing,Exact recovery,minimization,MRI,Structured sparsity},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\LPGAD2TZ\\Boyer et al. - 2019 - Compressed sensing with structured sparsity and structured acquisition.pdf;C\:\\Users\\furuh\\Zotero\\storage\\YY85DTXQ\\S1063520317300489.html}
}

@inproceedings{bozaTwoSparseMatrices2024,
  title = {Two {{Sparse Matrices}} Are {{Better}} than {{One}}: {{Sparsifying Neural Networks}} with {{Double Sparse Factorization}}},
  shorttitle = {Two {{Sparse Matrices}} Are {{Better}} than {{One}}},
  booktitle = {The {{Thirteenth International Conference}} on {{Learning Representations}}},
  author = {Bo{\v z}a, Vladim{\'i}r and Macko, Vladim{\'i}r},
  year = {2024},
  month = oct,
  urldate = {2025-04-25},
  abstract = {Neural networks are often challenging to work with due to their large size and complexity. To address this, various methods aim to reduce model size by sparsifying or decomposing weight matrices, such as magnitude pruning and low-rank or block-diagonal factorization. In this work, we present Double Sparse Factorization (DSF), where we factorize each weight matrix into two sparse matrices. Although solving this problem exactly is computationally infeasible, we propose an efficient heuristic based on alternating minimization via ADMM that achieves state-of-the-art results, enabling unprecedented sparsification of neural networks. For instance, in a one-shot pruning setting, our method can reduce the size of the LLaMA2-13B model by 50\% while maintaining better performance than the dense LLaMA2-7B model. We also compare favorably with Optimal Brain Compression, the state-of-the-art layer-wise pruning approach for convolutional neural networks. Furthermore, accuracy improvements of our method persist even after further model fine-tuning. Code available at: https://github.com/usamec/double\_sparse},
  langid = {english},
  annotation = {abstractTranslation: ニューラルネットワークは、その規模の大きさや複雑さから扱うのが難しいことが多い。この課題に対処するため、重み行列を疎にしたり分解したりすることでモデルサイズを削減することを目的とした様々な手法が存在し、例えば、Magnitude PruningやLow-Rank Factorization、Block-Diagonal Factorizationなどがある。本研究では、Double Sparse Factorization (DSF) を提案する。DSFでは、各重み行列を2つの疎な行列に分解する。この問題を厳密に解くことは計算上不可能であるが、ADMMによる交互最小化に基づく効率的なヒューリスティックを提案し、最先端の結果を達成し、ニューラルネットワークの前例のない疎化を可能にする。例えば、One-Shot Pruningの設定において、我々の手法はLLaMA2-13Bモデルのサイズを50\%削減しつつ、DenseなLLaMA2-7Bモデルよりも優れた性能を維持できる。また、Convolutional Neural Networkに対する最先端のLayer-Wise Pruning手法であるOptimal Brain Compressionと比較しても、優位性を示す。さらに、我々の手法による精度向上は、モデルのさらなるFine-Tuning後も持続する。コードは以下で入手可能: https://github.com/usamec/double\_sparse},
  file = {C:\Users\furuh\Zotero\storage\6XR9K94N\Boža と Macko - 2024 - Two Sparse Matrices are Better than One Sparsifying Neural Networks with Double Sparse Factorizatio.pdf}
}

@article{bradleyDifferentiableSparseCoding,
  title = {Differentiable {{Sparse Coding}}},
  author = {Bradley, David M and Bagnell, J Andrew},
  abstract = {Prior work has shown that features which appear to be biologically plausible as well as empirically useful can be found by sparse coding with a prior such as a laplacian (L1) that promotes sparsity. We show how smoother priors can preserve the benefits of these sparse priors while adding stability to the Maximum A-Posteriori (MAP) estimate that makes it more useful for prediction problems. Additionally, we show how to calculate the derivative of the MAP estimate efficiently with implicit differentiation. One prior that can be differentiated this way is KL-regularization. We demonstrate its effectiveness on a wide variety of applications, and find that online optimization of the parameters of the KL-regularized model can significantly improve prediction performance.},
  langid = {english},
  keywords = {No DOI found},
  annotation = {abstractTranslation:  先行研究では、経験的に有用であると同時に生物学的にもっともらしいと思われる特徴は、スパース性を促進するラプラシアン（L1）のような事前分布を用いたスパースコーディングによって発見できることが示されている。我々は、より平滑な事前分布を用いることで、このような疎な事前分布の利点を維持しつつ、予測問題により有用な最大事後推定（MAP）に安定性を持たせる方法を示す。さらに、MAP推定値の導関数を暗黙微分で効率的に計算する方法を示す。この方法で微分できる事前分布の1つがKL正則化である。KL正則化の有効性を様々なアプリケーションで実証し、KL正則化モデルのパラメータをオンラインで最適化することで、予測性能が大幅に向上することを見出す。},
  file = {C:\Users\furuh\Zotero\storage\N7Y5MDC4\Bradley and Bagnell - Differentiable Sparse Coding.pdf}
}

@article{brahimGraphFourierTransform2020,
  title = {Graph {{Fourier}} Transform of {{fMRI}} Temporal Signals Based on an Averaged Structural Connectome for the Classification of Neuroimaging},
  author = {Brahim, Abdelbasset and Farrugia, Nicolas},
  year = {2020},
  month = jun,
  journal = {Artificial Intelligence in Medicine},
  volume = {106},
  pages = {101870},
  issn = {0933-3657},
  doi = {10.1016/j.artmed.2020.101870},
  urldate = {2024-08-28},
  abstract = {Graph signal processing (GSP) is a framework that enables the generalization of signal processing to multivariate signals described on graphs. In this paper, we present an approach based on Graph Fourier Transform (GFT) and machine learning for the analysis of resting-state functional magnetic resonance imaging (rs-fMRI). For each subject, we use rs-fMRI time series to compute several descriptive statistics in regions of interest (ROI). Next, these measures are considered as signals on an averaged structural graph built using tractography of the white matter of the brain, defined using the same ROI. GFT of these signals is computed using the structural graph as a support, and the obtained feature vectors are subsequently benchmarked in a supervised learning setting. Further analysis suggests that GFT using structural connectivity as a graph and the standard deviation of fMRI time series as signals leads to more accurate supervised classification using a world-wide multi-site database known as ABIDE (Autism Brain Imaging Data Exchange) when compared to several other statistical metrics. Moreover, the proposed approach outperforms several approaches, based on using functional connectomes or complex functional network measures as features for classification.},
  langid = {american},
  keywords = {Classification,Graph signal processing,Machine learning,Neuroimaging,Resting-state analysis},
  annotation = {abstractTranslation: グラフ信号処理（GSP）は、グラフ上に記述された多変量信号に対する信号処理の一般化を可能にするフレームワークである。本論文では、グラフフーリエ変換(GFT)と機械学習に基づく、安静状態機能的磁気共鳴画像(rs-fMRI)の解析アプローチを紹介する。各被験者について、rs-fMRI時系列を用いて、関心領域（ROI）におけるいくつかの記述統計量を計算する。次に、これらの指標を、同じROIを用いて定義された脳白質のトラクトグラフィーを用いて構築された平均化された構造グラフ上の信号とみなす。これらの信号のGFTが構造グラフをサポートとして計算され、得られた特徴ベクトルが教師あり学習の設定でベンチマークされる。さらに分析を進めると、構造的連結性をグラフとして用い、fMRI時系列の標準偏差を信号として用いるGFTは、ABIDE（Autism Brain Imaging Data Exchange）として知られる世界規模のマルチサイトデータベースを用いて、他のいくつかの統計的指標と比較して、より正確な教師あり分類を導くことが示唆された。さらに、提案されたアプローチは、機能的コネクトームや複雑な機能的ネットワーク尺度を分類のための特徴として用いたいくつかのアプローチを凌駕する。},
  file = {C:\Users\furuh\Zotero\storage\3FCCS7DQ\Brahim と Farrugia - 2020 - Graph Fourier transform of fMRI temporal signals based on an averaged structural connectome for the.pdf}
}

