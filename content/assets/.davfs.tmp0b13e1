  pages = {32--41},
  issn = {1558-0792},
  doi = {10.1109/MSP.2013.2265316},
  urldate = {2025-02-01},
  abstract = {This article provides a general overview of time-frequency (T-F) reassignment and synchrosqueezing techniques applied to multicomponent signals, covering the theoretical background and applications. We explain how synchrosqueezing can be viewed as a special case of reassignment enabling mode reconstruction and place emphasis on the interest of using such T-F distributions throughout with illustrative examples.},
  langid = {english},
  keywords = {Chirp modulation,Smoothing methods,Spectrogram,Time-frequency analysis,Transforms,Uncertainty},
  annotation = {abstractTranslation: この記事では、理論的背景とアプリケーションをカバーする多成分信号に適用される時間周波数（T-F）の再割り当てと同期技術の一般的な概要を説明します。同期は、モードの再構築を可能にする再割り当てを可能にする特別なケースと見なされ、そのようなT-f分布を実証済みの例で使用する関心に重点を置く方法を説明します。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\GJU3RSLE\\Auger et al. - 2013 - Time-Frequency Reassignment and Synchrosqueezing An Overview.pdf;C\:\\Users\\furuh\\Zotero\\storage\\MR23B8UC\\6633061.html}
}

