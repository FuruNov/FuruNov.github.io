  month = oct,
  urldate = {2024-06-17},
  abstract = {Given the ever-increasing size of modern neural networks, the significance of sparse architectures has surged due to their accelerated inference speeds and minimal memory demands. When it comes to global pruning techniques, Iterative Magnitude Pruning (IMP) still stands as a state-of-the-art algorithm despite its simple nature, particularly in extremely sparse regimes. In light of the recent finding that the two successive matching IMP solutions are linearly connected without a loss barrier, we propose Sparse Weight Averaging with Multiple Particles (SWAMP), a straightforward modification of IMP that achieves performance comparable to an ensemble of two IMP solutions. For every iteration, we concurrently train multiple sparse models, referred to as particles, using different batch orders yet the same matching ticket, and then weight average such models to produce a single mask. We demonstrate that our method consistently outperforms existing baselines across different sparsities through extensive experiments on various neural network structures and data.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\3XKG5EWS\Choi et al. - 2023 - Sparse Weight Averaging with Multiple Particles fo.pdf}
}

@misc{choMachineLearningLecture2025,
  title = {Machine {{Learning}}: A {{Lecture Note}}},
  shorttitle = {Machine {{Learning}}},
  author = {Cho, Kyunghyun},
  year = {2025},
  month = may,
  number = {arXiv:2505.03861},
  eprint = {2505.03861},
  primaryclass = {cs},
  doi = {10.48550/arXiv.2505.03861},
  urldate = {2025-05-16},
  abstract = {This lecture note is intended to prepare early-year master's and PhD students in data science or a related discipline with foundational ideas in machine learning. It starts with basic ideas in modern machine learning with classification as a main target task. These basic ideas include loss formulation, backpropagation, stochastic gradient descent, generalization, model selection as well as fundamental blocks of artificial neural networks. Based on these basic ideas, the lecture note explores in depth the probablistic approach to unsupervised learning, covering directed latent variable models, product of experts, generative adversarial networks and autoregressive models. Finally, the note ends by covering a diverse set of further topics, such as reinforcement learning, ensemble methods and meta-learning. After reading this lecture note, a student should be ready to embark on studying and researching more advanced topics in machine learning and more broadly artificial intelligence.},
  archiveprefix = {arXiv},
  file = {C:\Users\furuh\Zotero\storage\FN9783YR\Cho - 2025 - Machine Learning a Lecture Note.pdf}
}

@article{choudhuryTrilateralFilterHigh2005,
  title = {The Trilateral Filter for High Contrast Images and Meshes},
  author = {Choudhury, Prasun and Tumblin, Jack},
  year = {2005},
  journal = {ACM SIGGRAPH 2005 Courses on   - SIGGRAPH '05},
  pages = {5},
  publisher = {ACM Press},
  address = {Los Angeles, California},
  doi = {10.1145/1198555.1198565},
  urldate = {2024-05-20},
  abstract = {We present a new, single-pass nonlinear filter for edge-preserving smoothing and visual detail removal for N dimensional signals in computer graphics, image processing and computer vision applications. Built from two modified forms of Tomasi and Manduchi's bilateral filter, the new "trilateral" filter smoothes signals towards a sharply-bounded, piecewise-linear approximation. Unlike bilateral filters or anisotropic diffusion methods that smooth towards piecewise constant solutions, the trilateral filter provides stronger noise reduction and better outlier rejection in high-gradient regions, and it mimics the edge-limited smoothing behavior of shock-forming PDEs by region finding with a fast min-max stack. Yet the trilateral filter requires only one user-set parameter, filters an input signal in a single pass, and does not use an iterative solver as required by most PDE methods. Like the bilateral filter, the trilateral filter easily extends to N-dimensional signals, yet it also offers better performance for many visual applications including appearance-preserving contrast reduction problems for digital photography and denoising polygonal meshes.},
  langid = {english}
}

@article{chouMoreLessInducing2023,
  title = {More Is Less: Inducing Sparsity via Overparameterization},
  shorttitle = {More Is Less},
  author = {Chou, Hung-Hsu and Maly, Johannes and Rauhut, Holger},
  year = {2023},
  month = apr,
  journal = {Information and Inference: A Journal of the IMA},
  volume = {12},
  number = {3},
  pages = {1437--1460},
  issn = {2049-8772},
  doi = {10.1093/imaiai/iaad012},
  urldate = {2024-09-22},
  abstract = {In deep learning it is common to overparameterize neural networks, that is, to use more parameters than training samples. Quite surprisingly training the neural network via (stochastic) gradient descent leads to models that generalize very well, while classical statistics would suggest overfitting. In order to gain understanding of this implicit bias phenomenon we study the special case of sparse recovery (compressed sensing) which is of interest on its own. More precisely, in order to reconstruct a vector from underdetermined linear measurements, we introduce a corresponding overparameterized square loss functional, where the vector to be reconstructed is deeply factorized into several vectors. We show that, if there exists an exact solution, vanilla gradient flow for the overparameterized loss functional converges to a good approximation of the solution of minimal `1-norm. The latter is well-known to promote sparse solutions. As a by-product, our results significantly improve the sample complexity for compressed sensing via gradient flow/descent on overparameterized models derived in previous works. The theory accurately predicts the recovery rate in numerical experiments. Our proof relies on a analyzing a certain Bregman divergence of the flow. This bypasses the obstacles caused by non-convexity and should be of independent interest.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  annotation = {abstractTranslation: ディープラーニングでは、ニューラルネットワークをオーバーパラメーター化するのが一般的だ。驚くことに、（確率的）勾配降下法によってニューラルネットワークを訓練すると、非常によく一般化するモデルが得られるが、古典的な統計学ではオーバーフィッティングが示唆される。この暗黙のバイアス現象を理解するために、我々はスパース回復（圧縮センシング）の特殊なケースを研究する。より正確には、過小決定された線形測定値からベクトルを再構成するために、対応する過パラメータ化された平方損失関数を導入する。厳密解が存在する場合、過パラメータ化された損失関数に対するバニラ勾配流は、最小 `1-normの解の良い近似に収束することを示す。後者はスパース解を促進することがよく知られている。副産物として、我々の結果は、過去の研究で導出されたオーバーパラメータ化モデルに対する勾配流／降下による圧縮センシングのサンプル複雑度を大幅に改善する。この理論は、数値実験における回復率を正確に予測する。我々の証明は、フローのあるブレグマン発散の解析に依存している。これは非凸による障害を回避するものであり、独立に興味深いものである。},
  file = {C:\Users\furuh\Zotero\storage\B2I5X8N2\Chou et al. - 2023 - More is less inducing sparsity via overparameterization.pdf}
}

@misc{chowdhuryBayesianApproachDiscovering2025,
  title = {A {{Bayesian Approach}} for {{Discovering Time- Delayed Differential Equation}} from {{Data}}},
  author = {Chowdhury, Debangshu and Chakraborty, Souvik},
  year = {2025},
  month = jan,
  number = {arXiv:2501.02934},
  eprint = {2501.02934},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2501.02934},
  urldate = {2025-01-10},
  abstract = {Time-delayed differential equations (TDDEs) are widely used to model complex dynamic systems where future states depend on past states with a delay. However, inferring the underlying TDDEs from observed data remains a challenging problem due to the inherent nonlinearity, uncertainty, and noise in real-world systems. Conventional equation discovery methods often exhibit limitations when dealing with large time delays, relying on deterministic techniques or optimization-based approaches that may struggle with scalability and robustness. In this paper, we present BayTiDe - Bayesian Approach for Discovering Time-Delayed Differential Equations from Data, that is capable of identifying arbitrarily large values of time delay to an accuracy that is directly proportional to the resolution of the data input to it. BayTiDe leverages Bayesian inference combined with a sparsity-promoting discontinuous spike-and-slab prior to accurately identify time-delayed differential equations. The approach accommodates arbitrarily large time delays with accuracy proportional to the input data resolution, while efficiently narrowing the search space to achieve significant computational savings. We demonstrate the efficiency and robustness of BayTiDe through a range of numerical examples, validating its ability to recover delayed differential equations from noisy data.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Machine Learning,Physics - Computational Physics,Statistics - Machine Learning},
  annotation = {abstractTranslation: 時間遅延微分方程式 (TDDE) は、将来の状態が過去の状態に遅れて依存する複雑な動的システムをモデル化するために広く使用されています。ただし、実世界のシステムには固有の非線形性、不確実性、ノイズがあるため、観測データから基礎となる TDDE を推測することは依然として困難な問題です。従来の方程式発見手法は、大きな時間遅延を処理する場合に限界が生じることが多く、スケーラビリティや堅牢性に問題がある可能性のある決定論的手法や最適化ベースのアプローチに依存しています。この論文では、BayTiDe - データから時間遅延微分方程式を発見するためのベイジアン アプローチを紹介します。これは、任意の大きな値の時間遅延を、それに入力されるデータの解像度に正比例する精度で識別することができます。 BayTiDe は、時間遅延微分方程式を正確に特定する前に、スパース性を促進する不連続なスパイク アンド スラブと組み合わせたベイズ推論を活用します。このアプローチは、入力データの解像度に比例した精度で任意の大きな時間遅延に対応しながら、検索空間を効率的に狭めて大幅な計算量の節約を達成します。さまざまな数値例を通じて BayTiDe の効率とロバスト性を実証し、ノイズの多いデータから遅延微分方程式を回復する能力を検証します。},
  file = {C:\Users\furuh\Zotero\storage\MRXAKJQY\Chowdhury と Chakraborty - 2025 - A Bayesian Approach for Discovering Time- Delayed Differential Equation from Data.pdf}
}

