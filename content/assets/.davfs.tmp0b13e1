@article{bulatMatrixTensorDecompositions2019,
  title = {Matrix and Tensor Decompositions for Training Binary Neural Networks},
  author = {Bulat, Adrian and Kossaifi, Jean and Tzimiropoulos, Georgios and Pantic, M.},
  year = {2019},
  month = apr,
  journal = {ArXiv},
  urldate = {2023-12-01},
  abstract = {This paper is on improving the training of binary neural networks in which both activations and weights are binary. While prior methods for neural network binarization binarize each filter independently, we propose to instead parametrize the weight tensor of each layer using matrix or tensor decomposition. The binarization process is then performed using this latent parametrization, via a quantization function (e.g. sign function) applied to the reconstructed weights. A key feature of our method is that while the reconstruction is binarized, the computation in the latent factorized space is done in the real domain. This has several advantages: (i) the latent factorization enforces a coupling of the filters before binarization, which significantly improves the accuracy of the trained models. (ii) while at training time, the binary weights of each convolutional layer are parametrized using real-valued matrix or tensor decomposition, during inference we simply use the reconstructed (binary) weights. As a result, our method does not sacrifice any advantage of binary networks in terms of model compression and speeding-up inference. As a further contribution, instead of computing the binary weight scaling factors analytically, as in prior work, we propose to learn them discriminatively via back-propagation. Finally, we show that our approach significantly outperforms existing methods when tested on the challenging tasks of (a) human pose estimation (more than 4\% improvements) and (b) ImageNet classification (up to 5\% performance gains).},
  keywords = {No DOI found},
  file = {C:\Users\furuh\Zotero\storage\KU7X7MJG\Bulat et al. - 2019 - Matrix and tensor decompositions for training bina.pdf}
}

@inproceedings{bulusuSupportRecovery1Bit2025,
  title = {Support {{Recovery}} in 1-{{Bit Compressed Sensing}} with {{Burst Sparse Noise}}},
  booktitle = {{{ICASSP}} 2025 - 2025 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {Bulusu, Saikiran and Gandikota, Venkata and Varshney, Pramod K.},
  year = {2025},
  month = apr,
  pages = {1--5},
  issn = {2379-190X},
  doi = {10.1109/ICASSP49660.2025.10890340},
  urldate = {2025-03-14},
  abstract = {1-bit compressed sensing (1bCS) is a quantized signal acquisition technique to compress high-dimensional sparse signals. The goal is to design sensing matrices A {$\in$} {$\mathbb{R}$}m{\texttimes}n with the fewest possible rows that enable efficient and accurate recovery of sparse signals x {$\in$} {$\mathbb{R}$}n from 1-bit measurements of the form sign(Ax). This work focuses on recovering the support of sparse signals from noisy 1-bit measurements, specifically in presence of adversarial noise. Existing methods handle random noise, or small number of adversarial sign flips. We demonstrate that exact support recovery is impossible when a constant fraction of measurements are affected by adversarial noise. Hence, we design sensing matrices that can reliably recover support in presence of (b, c)-burst noise, tolerating a constant fraction of errors concentrated in O(log m) blocks.},
  langid = {english},
  keywords = {1-bit Compressed Sensing,Accuracy,Acoustics,Compressed sensing,Noise,Noise measurement,Reliability engineering,Sensors,Sparse matrices,Sparsity Pattern,Speech processing,Support Recovery,Union Free Families},
  annotation = {abstractTranslation: 1ビット圧縮センシング（1BCS）は、高次元のスパース信号を圧縮するための量子化信号取得技術です。目標は、センシングマトリックスA{$\in$}RM{\texttimes}Nを設計することで、フォームサイン（AX）の1ビット測定からスパース信号の効率的かつ正確な回復を可能にする可能な限り少ない行を使用します。この作業は、騒々しい1ビット測定から、特に敵対的なノイズの存在下からのスパース信号のサポートを回復することに焦点を当てています。既存のメソッドは、ランダムノイズ、または少数の敵対的なサインフリップを処理します。一定の測定値が敵対的なノイズの影響を受ける場合、正確なサポート回復が不可能であることを実証します。したがって、（b、c）バーストノイズの存在下でサポートを確実に回復できるセンシングマトリックスを設計し、O（log m）ブロックに濃縮された一定のエラーの割合を許容します。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\2426DPKR\\Bulusu et al. - 2025 - Support Recovery in 1-Bit Compressed Sensing with Burst Sparse Noise.pdf;C\:\\Users\\furuh\\Zotero\\storage\\XUYL4XTR\\10890340.html}
}

