@article{brediesIteratedHardShrinkage2008,
  title = {Iterated {{Hard Shrinkage}} for {{Minimization Problems}} with {{Sparsity Constraints}}},
  author = {Bredies, Kristian and Lorenz, Dirk A.},
  year = {2008},
  month = jan,
  journal = {SIAM Journal on Scientific Computing},
  volume = {30},
  number = {2},
  pages = {657--683},
  issn = {1064-8275, 1095-7197},
  doi = {10.1137/060663556},
  urldate = {2024-07-27},
  abstract = {A new iterative algorithm for the solution of minimization problems in infinite-dimensional Hilbert spaces which involve sparsity constraints in form of \${\textbackslash}ell{\textasciicircum}\{p\}\$-penalties is proposed. In contrast to the well-known algorithm considered by Daubechies, Defrise, and De Mol, it uses hard instead of soft shrinkage. It is shown that the hard shrinkage algorithm is a special case of the generalized conditional gradient method. Convergence properties of the generalized conditional gradient method with quadratic discrepancy term are analyzed. This leads to strong convergence of the iterates with convergence rates \${\textbackslash}mathcal\{O\}(n{\textasciicircum}\{-1/2\})\$ and \${\textbackslash}mathcal\{O\}({\textbackslash}lambda{\textasciicircum}n)\$ for \$p=1\$ and \$1 {$<$} p {\textbackslash}leq 2\$, respectively. Numerical experiments on image deblurring, backwards heat conduction, and inverse integration are given.},
  langid = {english}
}

@article{brediesTotalGeneralizedVariation2010,
  title = {Total {{Generalized Variation}}},
  author = {Bredies, Kristian and Kunisch, Karl and Pock, Thomas},
  year = {2010},
  month = jan,
  journal = {SIAM Journal on Imaging Sciences},
  volume = {3},
  number = {3},
  pages = {492--526},
  issn = {1936-4954},
  doi = {10.1137/090769521},
  urldate = {2024-05-23},
  abstract = {The novel concept of total generalized variation of a function u is introduced, and some of its essential properties are proved. Differently from the bounded variation seminorm, the new concept involves higher-order derivatives of u. Numerical examples illustrate the high quality of this functional as a regularization term for mathematical imaging problems. In particular this functional selectively regularizes on different regularity levels and, as a side effect, does not lead to a staircasing effect.},
  langid = {english},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\47MSVC9B\\Bredies et al. - 2010 - Total Generalized Variation.pdf;C\:\\Users\\furuh\\Zotero\\storage\\N6JINNQD\\jsai2024_tutorial.pdf}
}

@misc{brehmerDoesEquivarianceMatter2024,
  title = {Does Equivariance Matter at Scale?},
  author = {Brehmer, Johann and Behrends, S{\"o}nke and de Haan, Pim and Cohen, Taco},
  year = {2024},
  month = oct,
  number = {arXiv:2410.23179},
  eprint = {2410.23179},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2410.23179},
  urldate = {2025-01-30},
  abstract = {Given large data sets and sufficient compute, is it beneficial to design neural architectures for the structure and symmetries of each problem? Or is it more efficient to learn them from data? We study empirically how equivariant and non-equivariant networks scale with compute and training samples. Focusing on a benchmark problem of rigid-body interactions and on general-purpose transformer architectures, we perform a series of experiments, varying the model size, training steps, and dataset size. We find evidence for three conclusions. First, equivariance improves data efficiency, but training non-equivariant models with data augmentation can close this gap given sufficient epochs. Second, scaling with compute follows a power law, with equivariant models outperforming non-equivariant ones at each tested compute budget. Finally, the optimal allocation of a compute budget onto model size and training duration differs between equivariant and non-equivariant models.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning}
}

