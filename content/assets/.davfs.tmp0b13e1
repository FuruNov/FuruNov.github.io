  title = {Efficient and {{Modular Implicit Differentiation}}},
  author = {Blondel, Mathieu and Berthet, Quentin and Cuturi, Marco and Frostig, Roy and Hoyer, Stephan and {Llinares-L'opez}, Felipe and Pedregosa, Fabian and Vert, Jean-Philippe},
