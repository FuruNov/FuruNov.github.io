@article{andriushchenkoSGDLargeStep2023b,
  title = {{{SGD}} with {{Large Step Sizes Learns Sparse Features}}},
  author = {Andriushchenko, Maksym and Varre, Aditya Vardhan and {Pillaud-Vivien}, Loucas and Flammarion, Nicolas},
  year = {2023},
  month = jun,
  urldate = {2023-10-14},
  abstract = {We showcase important features of the dynamics of the Stochastic Gradient Descent (SGD) in the training of neural networks. We present empirical observations that commonly used large step sizes (i) may lead the iterates to jump from one side of a valley to the other causing *loss stabilization*, and (ii) this stabilization induces a hidden stochastic dynamics that *biases it implicitly* toward simple predictors. Furthermore, we show empirically that the longer large step sizes keep SGD high in the loss landscape valleys, the better the implicit regularization can operate and find sparse representations. Notably, no explicit regularization is used: the regularization effect comes solely from the SGD dynamics influenced by the large step sizes schedule. Therefore, these observations unveil how, through the step size schedules, both gradient and noise drive together the SGD dynamics through the loss landscape of neural networks. We justify these findings theoretically through the study of simple neural network models as well as qualitative arguments inspired from stochastic processes. This analysis allows us to shed new light on some common practices and observed phenomena when training deep networks.},
  langid = {english},
  keywords = {No DOI found},
  file = {C:\Users\furuh\Zotero\storage\M3UQRGBY\Andriushchenko et al. - 2023 - SGD with Large Step Sizes Learns Sparse Features.pdf}
}

@misc{anonymizedauthorsAdvancedTVAL3Enhanced,
  title = {Advanced {{TVAL3}} for {{Enhanced CT Image}}  {{Reconstruction}}},
  author = {{Anonymized Authors}},
  abstract = {Traditional Total Variation Augmented Lagrangian Alternating Direction (TVAL3) algorithms with convex anisotropic and isotropic TV regularizers have demonstrated effectiveness in compressive sensing applications, including computed tomography (CT). However, convex regularization may limit edge and boundary preservation, especially with sparse measurements. In this work, we propose an enhanced TVAL3 algorithm that integrates nonconvex lp-norm total variation (0 {$<$} p {$<$} 1) for improved reconstruction quality. We develop the Advanced Nonmonotone Alternating Direction Algorithm based on the Augmented Lagrangian method, which leverages a nonmonotone line search and the Chebyshev method to enhance the numerical convergence and the computational efficiency. Numerical experiments on CT image reconstruction with limited projections demonstrate that the proposed approach outperforms TVAL3, achieving superior edge and boundary preservation.},
  langid = {english},
  annotation = {abstractTranslation: 従来の凸な異方性および等方性 TV 正則化項を用いた Total Variation Augmented Lagrangian Alternating Direction (TVAL3) アルゴリズムは、コンピュータ断層撮影 (CT) を含む圧縮センシングアプリケーションにおいて有効性を示してきました。しかしながら、凸正則化は、特にスパースな測定の場合に、エッジおよび境界の保存を制限する可能性があります。本研究では、再構成品質を向上させるために、非凸 lp-ノルム Total Variation (0 {$<$} p {$<$} 1) を統合した改良型 TVAL3 アルゴリズムを提案します。非単調ラインサーチとチェビシェフ法を活用し、数値的収束と計算効率を向上させる、Augmented Lagrangian 法に基づく Advanced Nonmonotone Alternating Direction Algorithm を開発します。限定的な投影による CT 画像再構成に関する数値実験により、提案手法が TVAL3 を上回り、優れたエッジおよび境界保存を達成することが示されています。},
  file = {C:\Users\furuh\Zotero\storage\H29RFUWJ\Advanced TVAL3 for Enhanced CT Image  Reconstruction.pdf}
}

