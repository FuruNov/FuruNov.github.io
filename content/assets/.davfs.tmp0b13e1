@misc{bershatskyLoTRLowTensor2024,
  title = {{{LoTR}}: {{Low Tensor Rank Weight Adaptation}}},
  shorttitle = {{{LoTR}}},
  author = {Bershatsky, Daniel and Cherniuk, Daria and Daulbaev, Talgat and Mikhalev, Aleksandr and Oseledets, Ivan},
  year = {2024},
  month = feb,
  number = {arXiv:2402.01376},
  eprint = {2402.01376},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2402.01376},
  urldate = {2024-02-21},
  abstract = {In this paper we generalize and extend an idea of low-rank adaptation (LoRA) of large language models (LLMs) based on Transformer architecture. Widely used LoRA-like methods of fine-tuning LLMs are based on matrix factorization of gradient update. We introduce LoTR, a novel approach for parameter-efficient fine-tuning of LLMs which represents a gradient update to parameters in a form of tensor decomposition. Low-rank adapter for each layer is constructed as a product of three matrices, and tensor structure arises from sharing left and right multipliers of this product among layers. Simultaneous compression of a sequence of layers with low-rank tensor representation allows LoTR to archive even better parameter efficiency then LoRA especially for deep models. Moreover, the core tensor does not depend on original weight dimension and can be made arbitrary small, which allows for extremely cheap and fast downstream fine-tuning.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computation and Language,Computer Science - Machine Learning},
  annotation = {abstractTranslation: 本稿では、Transformerアーキテクチャに基づく大規模言語モデル（LLM）の低ランク適応（LoRA）のアイデアを一般化し、拡張します。LLMのファインチューニングに広く用いられているLoRA類似の手法は、勾配更新の行列分解に基づいています。我々は、パラメータ効率の良いLLMのファインチューニングのための新しいアプローチであるLoTRを導入します。LoTRは、パラメータへの勾配更新をテンソル分解の形式で表現します。各層の低ランクアダプターは、3つの行列の積として構築され、この積の左および右の乗数を層間で共有することによってテンソル構造が生じます。低ランクテンソル表現を用いた層のシーケンスの同時圧縮により、LoTRは特に深いモデルにおいてLoRAよりも優れたパラメータ効率を達成できます。さらに、コアテンソルは元の重みの次元に依存せず、任意に小さくすることができるため、非常に安価で高速なダウンストリームファインチューニングが可能になります。},
  file = {C:\Users\furuh\Zotero\storage\Z234IJML\Bershatsky et al. - 2024 - LoTR Low Tensor Rank Weight Adaptation.pdf}
}

@inproceedings{bertrandL1FasterBetter2022,
  title = {Beyond {{L1}}: {{Faster}} and {{Better Sparse Models}} with Skglm},
  shorttitle = {Beyond {{L1}}},
  booktitle = {Advances in {{Neural Information Processing Systems}}},
  author = {Bertrand, Quentin and Klopfenstein, Quentin and Bannier, Pierre-Antoine and Gidel, Gauthier and Massias, Mathurin},
  year = {2022},
  month = may,
  urldate = {2023-10-14},
  abstract = {We propose a new fast algorithm to estimate any sparse generalized linear model with convex or non-convex separable penalties. Our algorithm is able to solve problems with millions of samples and features in seconds, by relying on coordinate descent, working sets and Anderson acceleration. It handles previously unaddressed models, and is extensively shown to improve state-of-art algorithms. We provide a flexible, scikit-learn compatible package, which easily handles customized datafits and penalties.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\4UU3UBBQ\Bertrand et al. - 2022 - Beyond L1 Faster and Better Sparse Models with sk.pdf}
}

@article{bertranReconstructionAttacksMachine,
  title = {Reconstruction {{Attacks}} on {{Machine Unlearning}}: {{Simple Models}} Are {{Vulnerable}}},
  author = {Bertran, Martin and Tang, Shuai and Kearns, Michael and Morgenstern, Jamie and Roth, Aaron and Wu, Zhiwei Steven},
  abstract = {Machine unlearning is motivated by desire for data autonomy: a person can request to have their data's influence removed from deployed models, and those models should be updated as if they were retrained without the person's data. We show that, counter-intuitively, these updates expose individuals to high-accuracy reconstruction attacks which allow the attacker to recover their data in its entirety, even when the original models are so simple that privacy risk might not otherwise have been a concern. We show how to mount a near-perfect attack on the deleted data point from linear regression models. We then generalize our attack to other loss functions and architectures, and empirically demonstrate the effectiveness of our attacks across a wide range of datasets (capturing both tabular and image data). Our work highlights that privacy risk is significant even for extremely simple model classes when individuals can request deletion of their data from the model.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\ZCE8RBYG\Bertran et al. - Reconstruction Attacks on Machine Unlearning Simple Models are Vulnerable.pdf}
}

@misc{bertsimasBestSubsetSelection2015,
  title = {Best {{Subset Selection}} via a {{Modern Optimization Lens}}},
  author = {Bertsimas, Dimitris and King, Angela and Mazumder, Rahul},
  year = {2015},
  month = jul,
  number = {arXiv:1507.03133},
  eprint = {1507.03133},
  publisher = {arXiv},
  urldate = {2024-11-11},
  abstract = {In the last twenty-five years (1990-2014), algorithmic advances in integer optimization combined with hardware improvements have resulted in an astonishing 200 billion factor speedup in solving Mixed Integer Optimization (MIO) problems. We present a MIO approach for solving the classical best subset selection problem of choosing \$k\$ out of \$p\$ features in linear regression given \$n\$ observations. We develop a discrete extension of modern first order continuous optimization methods to find high quality feasible solutions that we use as warm starts to a MIO solver that finds provably optimal solutions. The resulting algorithm (a) provides a solution with a guarantee on its suboptimality even if we terminate the algorithm early, (b) can accommodate side constraints on the coefficients of the linear regression and (c) extends to finding best subset solutions for the least absolute deviation loss function. Using a wide variety of synthetic and real datasets, we demonstrate that our approach solves problems with \$n\$ in the 1000s and \$p\$ in the 100s in minutes to provable optimality, and finds near optimal solutions for \$n\$ in the 100s and \$p\$ in the 1000s in minutes. We also establish via numerical experiments that the MIO approach performs better than \{{\textbackslash}texttt \{Lasso\}\} and other popularly used sparse learning procedures, in terms of achieving sparse solutions with good predictive power.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Mathematics - Optimization and Control,Statistics - Computation,Statistics - Machine Learning,Statistics - Methodology},
  annotation = {abstractTranslation: 過去25年間(1990-2014年)、整数最適化におけるアルゴリズムの進歩とハードウェアの改良が相まって、混合整数最適化(MIO)問題を解くのに2,000億倍という驚異的なスピードアップをもたらした。我々は、\$n\$個の観測値が与えられた線形回帰において、\$p\$個の特徴量から\$k\$個の特徴量を選択するという古典的な最適部分集合選択問題を解くためのMIOアプローチを提案する。我々は、証明可能な最適解を求めるMIOソルバーのウォーム・スタートとして使用する、高品質の実行可能解を求めるための最新の一次連続最適化手法の離散的拡張を開発する。結果として得られるアルゴリズムは、(a)アルゴリズムを早期に終了させても、その準最適性が保証された解を提供し、(b)線形回帰の係数に対する側方制約に対応でき、(c)最小絶対偏差損失関数に対する最良の部分集合解を見つけることに拡張する。様々な合成データセットと実データセットを用いて、我々のアプローチが\$n\$が1000台、\$p\$が100台の問題を数分で証明可能な最適性で解き、\$n\$が100台、\$p\$が1000台の問題を数分で最適解に近い解を見つけることを実証する。また、MIOアプローチが、良好な予測力を持つ疎な解を得るという点で、\{texttt \{Lasso\}\}や他のよく使われる疎な学習手続きよりも性能が良いことを数値実験により証明する。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\8RXD5ZIX\\Bertsimas et al. - 2015 - Best Subset Selection via a Modern Optimization Lens.pdf;C\:\\Users\\furuh\\Zotero\\storage\\9DXUMK44\\1507.html}
}

