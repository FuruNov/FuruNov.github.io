@misc{bentoConvergenceDescentMethods2024,
  title = {Convergence of {{Descent Methods}} under {{Kurdyka-{\L}ojasiewicz Properties}}},
  author = {Bento, G. C. and Mordukhovich, B. S. and Mota, T. S. and Nesterov, Yu},
  year = {2024},
  month = jun,
  number = {arXiv:2407.00812},
  eprint = {2407.00812},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2407.00812},
  urldate = {2025-02-09},
  abstract = {This paper develops the novel convergence analysis of a generic class of descent methods in nonsmooth and nonconvex optimization under several versions of the Kurdyka-{\textbackslash}L ojasiewicz (KL) property. Along other results, we prove the finite termination of generic algorithms under the KL property with lower exponents. Specifications are given to convergence rates of some particular algorithms including inexact reduced gradient methods and the boosted algorithm in DC programming. It revealed, e.g., that the lower exponent KL property in the DC framework is incompatible with the gradient Lipschitz continuity for the plus function around a local minimizer. On the other hand, we show that the above inconsistency observation may fail if the Lipschitz continuity is replaced by merely the gradient continuity.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Optimization and Control},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\8GYFH4NR\\Bento et al. - 2024 - Convergence of Descent Methods under Kurdyka-Łojasiewicz Properties.pdf;C\:\\Users\\furuh\\Zotero\\storage\\DYVW6D9Z\\2407.html}
}

