@article{badirliGradientBoostingNeural2020,
  title = {Gradient {{Boosting Neural Networks}}: {{GrowNet}}},
  shorttitle = {Gradient {{Boosting Neural Networks}}},
  author = {Badirli, Sarkhan and Liu, Xuanqing and Xing, Zhengming and Bhowmik, Avradeep and Keerthi, S.},
