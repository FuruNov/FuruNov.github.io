@article{ahmadi-aslCrossTensorApproximation2021,
  title = {Cross {{Tensor Approximation Methods}} for {{Compression}} and {{Dimensionality Reduction}}},
  author = {{Ahmadi-Asl}, Salman and Caiafa, Cesar F. and Cichocki, Andrzej and Phan, Anh Huy and Tanaka, Toshihisa and Oseledets, Ivan and Wang, Jun},
  year = {2021},
  journal = {IEEE Access},
  volume = {9},
  pages = {150809--150838},
  issn = {2169-3536},
  doi = {10.1109/ACCESS.2021.3125069},
  urldate = {2024-02-27},
  abstract = {Cross Tensor Approximation (CTA) is a generalization of Cross/skeleton matrix and CUR Matrix Approximation (CMA) and is a suitable tool for fast low-rank tensor approximation. It facilitates interpreting the underlying data tensors and decomposing/compressing tensors so that their structures, such as nonnegativity, smoothness, or sparsity, can be potentially preserved. This paper reviews and extends stateof-the-art deterministic and randomized algorithms for CTA with intuitive graphical illustrations. We discuss several possible generalizations of the CMA to tensors, including CTAs: based on fiber selection, slice-tube selection, and lateral-horizontal slice selection. The main focus is on the CTA algorithms using Tucker and tubal SVD (t-SVD) models while we provide references to other decompositions such as Tensor Train (TT), Hierarchical Tucker (HT), and Canonical Polyadic (CP) decompositions. We evaluate the performance of the CTA algorithms by extensive computer simulations to compress color and medical images and compare their performance.},
  langid = {english},
  file = {C:\Users\furuh\Zotero\storage\BMDLZ9GA\Ahmadi-Asl et al. - 2021 - Cross Tensor Approximation Methods for Compression.pdf}
}

@misc{ahmadi-aslRandomizedAlgorithmTensor2024,
  title = {A {{Randomized Algorithm}} for {{Tensor Singular Value Decomposition}} Using an {{Arbitrary Number}} of {{Passes}}},
  author = {{Ahmadi-Asl}, Salman and Phan, Anh-Huy and Cichocki, Andrzej},
  year = {2024},
  month = jan,
  number = {arXiv:2207.12542},
  eprint = {2207.12542},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2207.12542},
  urldate = {2025-01-31},
  abstract = {Efficient and fast computation of a tensor singular value decomposition (t-SVD) with a few passes over the underlying data tensor is crucial because of its many potential applications. The current/existing subspace randomized algorithms need (2q+2) passes over the data tensor to compute a t-SVD, where q is a non-negative integer number (power iteration parameter). In this paper, we propose an efficient and flexible randomized algorithm that can handle any number of passes q, which not necessary need be even. The flexibility of the proposed algorithm in using fewer passes naturally leads to lower computational and communication costs. This advantage makes it particularly appropriate when our task calls for several tensor decompositions or when the data tensors are huge. The proposed algorithm is a generalization of the methods developed for matrices to tensors. The expected/ average error bound of the proposed algorithm is derived. Extensive numerical experiments on random and real-world data sets are conducted, and the proposed algorithm is compared with some baseline algorithms. The extensive computer simulation experiments demonstrate that the proposed algorithm is practical, efficient, and in general outperforms the state of the arts algorithms. We also demonstrate how to use the proposed method to develop a fast algorithm for the tensor completion problem.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Numerical Analysis,Mathematics - Numerical Analysis},
  annotation = {abstractTranslation: 基礎となるデータテンソル上の数パスを使用したテンソル特異値分解（T-SVD）の効率的かつ高速な計算は、多くの潜在的なアプリケーションのために重要です。現在/既存のサブスペースランダム化アルゴリズムが必要（2Q+2）がデータテンソルを通過してT-SVDを計算します。Qは非陰性整数数（電源イテレーションパラメーター）です。このホワイトペーパーでは、必要ではない任意のパスQを処理できる効率的で柔軟なランダム化されたアルゴリズムを提案します。より少ないパスを使用する際に提案されたアルゴリズムの柔軟性は、自然に計算コストと通信コストの削減につながります。この利点は、タスクがいくつかのテンソル分解を呼び出す場合、またはデータテンソルが膨大な場合に特に適切です。提案されたアルゴリズムは、マトリックスのテンソルのために開発された方法の一般化です。提案されたアルゴリズムの予想/平均エラーバウンドが導出されます。ランダムおよび実際のデータセットに関する広範な数値実験が行われ、提案されたアルゴリズムがいくつかのベースラインアルゴリズムと比較されます。広範なコンピューターシミュレーション実験は、提案されたアルゴリズムが実用的で効率的であり、一般的に芸術のアルゴリズムを上回ることを示しています。また、提案された方法を使用して、テンソル完了問題の高速アルゴリズムを開発する方法も示します。},
  file = {C\:\\Users\\furuh\\Zotero\\storage\\NPSLSWI5\\Ahmadi-Asl et al. - 2024 - A Randomized Algorithm for Tensor Singular Value Decomposition using an Arbitrary Number of Passes.pdf;C\:\\Users\\furuh\\Zotero\\storage\\3TR43XK2\\2207.html}
}

@article{ahmadiStructureLearningDeep2024,
  title = {Structure {{Learning}} for {{Deep Neural Networks}} with {{Competitive Synaptic Pruning}}},
  author = {Ahmadi, Aghil and Mahboobi Esfanjani, Reza},
  year = {2024},
  month = nov,
  journal = {Journal of Electrical and Computer Engineering Innovations (JECEI)},
  publisher = {Shahid Rajaee Teacher Training University},
  issn = {2322-3952},
  doi = {10.22061/jecei.2024.11017.758},
  urldate = {2024-11-08},
  abstract = {Background and Objectives: A predefined structure is usually employed for deep neural networks, which results in over- or underfitting, heavy processing load, and storage overhead. Training along with pruning can decrease redundancy in deep neural networks; however, it may lead to a decrease in accuracy.Methods: In this note, we provide a novel approach for structure optimization of deep neural networks based on competition of connections merged with brain-inspired synaptic pruning. The efficiency of each network connection is continuously assessed in the proposed scheme based on the global gradient magnitude criterion, which also considers positive scores for strong and more effective connections and negative scores for weak connections. But a connection with a weak score is not removed quickly; instead, it is eliminated when its net score reaches a predetermined threshold. Moreover, the pruning rate is obtained distinctly for each layer of the network.Results: Applying the suggested algorithm to a neural network model of a distillation column in a noisy environment demonstrates its effectiveness and applicability.Conclusion: The proposed method, which is inspired by connection competition and synaptic pruning in the human brain, enhances learning speed, preserves accuracy, and reduces costs due to its smaller network size. It also handles noisy data more efficiently by continuously assessing network connections},
  langid = {english},
  annotation = {abstractTranslation: 背景と目的通常、ディープニューラルネットワークには事前定義された構造が採用されるが、その結果、過剰適合や過小適合が発生し、処理負荷が高くなり、ストレージのオーバーヘッドが発生する。刈り込みを伴うトレーニングは、ディープニューラルネットワークの冗長性を減少させることができるが、精度の低下につながる可能性がある：方法：このノートでは、脳から着想を得たシナプス刈り込みと結合した接続の競合に基づく、ディープニューラルネットワークの構造最適化のための新しいアプローチを提供する。提案方式では、各ネットワーク接続の効率は大域的な勾配の大きさの基準に基づいて連続的に評価され、強い接続やより効果的な接続には正のスコアが、弱い接続には負のスコアが考慮される。しかし、弱いスコアの接続はすぐに除去されるのではなく、そのネットスコアが所定の閾値に達したときに除去される。さらに、刈り込み率はネットワークの各層ごとに区別して求められる：結果：ノイズの多い環境における蒸留塔のニューラルネットワークモデルに提案アルゴリズムを適用することで、その有効性と適用性が実証された：人間の脳における接続競合とシナプス刈り込みに着想を得た提案手法は、学習速度を向上させ、精度を維持し、ネットワークサイズを小さくすることでコストを削減する。また、ネットワーク接続を継続的に評価することで、ノイズの多いデータをより効率的に扱うことができる。},
  file = {C:\Users\furuh\Zotero\storage\JXNFKC2K\article_2215.html}
}

