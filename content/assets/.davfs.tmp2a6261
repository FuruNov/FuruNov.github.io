@article{bandaraNanoporeDataAnalysis2021,
  title = {Nanopore {{Data Analysis}}: {{Baseline Construction}} and {{Abrupt Change-Based Multilevel Fitting}}},
  shorttitle = {Nanopore {{Data Analysis}}},
  author = {Bandara, Y. M. Nuwan D. Y. and Saharia, Jugal and Karawdeniya, Buddini I. and Kluth, Patrick and Kim, Min Jun},
  year = {2021},
  month = aug,
  journal = {Analytical Chemistry},
  volume = {93},
  number = {34},
  pages = {11710--11718},
  publisher = {American Chemical Society},
  issn = {0003-2700},
  doi = {10.1021/acs.analchem.1c01646},
  urldate = {2024-11-30},
  abstract = {Solid-state nanopore technology delivers single-molecule resolution information, and the quality of the deliverables hinges on the capability of the analysis platform to extract maximum possible events and fit them appropriately. In this work, we present an analysis platform with four baseline fitting methods adaptive to a wide range of nanopore traces (including those with a step or abrupt changes where pre-existing platforms fail) to maximize extractable events (2{\texttimes} improvement in some cases) and multilevel event fitting capability. The baseline fitting methods, in the increasing order of robustness and computational cost, include arithmetic mean, linear fit, Gaussian smoothing, and Gaussian smoothing and regressed mixing. The performance was tested with ultra-stable to vigorously fluctuating current profiles, and the event count increased with increasing fitting robustness prominently for vigorously fluctuating profiles. Turning points of events were clustered using the dbscan method, followed by segmentation into preliminary levels based on abrupt changes in the signal level, which were then iteratively refined to deduce the final levels of the event. Finally, we show the utility of clustering for multilevel DNA data analysis, followed by the assessment of protein translocation profiles.},
  langid = {american},
  annotation = {abstractTranslation: 固体ナノポア技術は1分子分解能の情報を提供するが、その成果物の質は、可能な限り最大限の事象を抽出し、それらを適切に適合させる解析プラットフォームの能力にかかっている。本研究では、抽出可能なイベントを最大化（場合によっては2倍向上）し、マルチレベルのイベントフィッティング機能を持つ、幅広いナノポア・トレース（既存のプラットフォームが失敗するような段差や急激な変化を含む）に適応する4つのベースライン・フィッティング法を備えた解析プラットフォームを紹介する。ベースラインのフィッティング手法は、ロバスト性と計算コストの高い順に、算術平均、線形フィット、ガウス・スムージング、ガウス・スムージングと回帰混合を含む。超安定から激しく変動する電流プロファイルで性能をテストしたところ、激しく変動するプロファイルでは、フィッティングのロバスト性が高くなるにつれてイベント数が顕著に増加した。イベントのターニングポイントはdbscan法を用いてクラスタリングされ、その後、信号レベルの急激な変化に基づいて予備レベルにセグメンテーションされた。最後に、マルチレベルDNAデータ解析におけるクラスタリングの有用性を示し、続いてタンパク質転座プロファイルの評価を行う。},
  file = {C:\Users\furuh\Zotero\storage\DGYGGLFJ\Bandara et al. - 2021 - Nanopore Data Analysis Baseline Construction and Abrupt Change-Based Multilevel Fitting.pdf}
}

@article{banertGeneralDoubleproximalGradient2019,
  title = {A General Double-Proximal Gradient Algorithm for d.c. Programming},
  author = {Banert, Sebastian and Bo{\textcommabelow t}, Radu Ioan},
  year = {2019},
  month = nov,
  journal = {Mathematical Programming},
  volume = {178},
  number = {1},
  pages = {301--326},
  issn = {1436-4646},
  doi = {10.1007/s10107-018-1292-2},
  urldate = {2025-02-04},
  abstract = {The possibilities of exploiting the special structure of d.c. programs, which consist of optimising the difference of convex functions, are currently more or less limited to variants of the DCA proposed by Pham Dinh Tao and Le Thi Hoai An in 1997. These assume that either the convex or the concave part, or both, are evaluated by one of their subgradients. In this paper we propose an algorithm which allows the evaluation of both the concave and the convex part by their proximal points. Additionally, we allow a smooth part, which is evaluated via its gradient. In the spirit of primal-dual splitting algorithms, the concave part might be the composition of a concave function with a linear operator, which are, however, evaluated separately. For this algorithm we show that every cluster point is a solution of the optimisation problem. Furthermore, we show the connection to the Toland dual problem and prove a descent property for the objective function values of a primal-dual formulation of the problem. Convergence of the iterates is shown if this objective function satisfies the Kurdyka--{\L}ojasiewicz property. In the last part, we apply the algorithm to an image processing model.},
  langid = {english},
  keywords = {49M29,65K05,90C26,Convergence analysis,d.c. programming,Kurdyka-Lojasiewicz property,Proximal-gradient algorithm,Toland dual},
  annotation = {abstractTranslation: D.C.の特別な構造を活用する可能性凸関数の違いを最適化することで構成されるプログラムは、1997年にPham Dinh TaoとLe Thi Hoaiによって提案されたDCAのバリエーションに多かれ少なかれ制限されています。それらのサブグレードグレード剤の1つによって評価されます。この論文では、近位点で凹状と凸部分の両方を評価できるアルゴリズムを提案します。さらに、勾配を介して評価される滑らかな部分を許可します。原始二重分割アルゴリズムの精神では、凹状の部分は、線形演算子を使用した凹機能の組成である可能性がありますが、これは個別に評価されます。このアルゴリズムでは、すべてのクラスターポイントが最適化問題の解決策であることを示します。さらに、Tolandの二重問題とのつながりを示し、問題の原始二重の定式化の目的関数値の降下特性を証明します。この目的関数がKurdyka -- Wojasiewiczプロパティを満たしている場合、反復液の収束が示されます。最後の部分では、画像処理モデルにアルゴリズムを適用します。},
  file = {C:\Users\furuh\Zotero\storage\QQ6LPD3I\Banert と Boț - 2019 - A general double-proximal gradient algorithm for d.c. programming.pdf}
}

@article{BanTianFeiTusupasuZhiYueZuiXiaoHuaniyoruXinHaoFuYuanFeiTuXingZhiYuniyoruarugorizumuGuiDaonoAnDingHua2023,
  title = {非凸スパース制約最小化による信号復元：非凸性制御によるアルゴリズム軌道の安定化},
  author = {坂田, 綾香 and 小渕, 智之},
